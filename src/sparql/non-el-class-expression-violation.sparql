# Violation: a class carries a non-EL class expression and is not on the
# allowlist below.
#
# The release is reasoned with ELK (OWL 2 EL). Class expressions outside EL
# (unionOf, complementOf, allValuesFrom, cardinality, oneOf, disjointUnionOf)
# are silently ignored during classification, so any parent that depends on
# them is missing from the release. The classes listed below already carry
# such expressions (mostly cell-line "derives_from" groupings and measurement
# unions, see EBISPOT/efo#2792) and are grandfathered until they are
# remodelled. Anything else is a violation.
#
# Maintaining the allowlist:
#   - remodel a class into EL and remove its line (the list is the work queue);
#   - never add a line without a documented reason in the PR: the correct fix
#     for a new term is to avoid the construct, e.g. write
#     has_disease_location some X rather than (X or part_of some X).
#
# Run against efo-edit.owl and components/efo_equivalent_class_axioms.owl (the
# files EFO authors), not the merged release, whose imported ontologies carry
# their own non-EL axioms that are not EFO's to change.

prefix owl: <http://www.w3.org/2002/07/owl#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix efo: <http://www.ebi.ac.uk/efo/>
prefix obo: <http://purl.obolibrary.org/obo/>

SELECT DISTINCT ?cls ?label ?construct
WHERE {
  {
    { ?node owl:unionOf ?x . BIND("unionOf" AS ?construct) }
    UNION { ?node owl:complementOf ?x . BIND("complementOf" AS ?construct) }
    UNION { ?node owl:allValuesFrom ?x . BIND("allValuesFrom" AS ?construct) }
    UNION { ?node owl:oneOf ?x . BIND("oneOf" AS ?construct) }
    UNION { ?node owl:disjointUnionOf ?x . BIND("disjointUnionOf" AS ?construct) }
    UNION {
      ?node ?cardinalityProperty ?x .
      FILTER (?cardinalityProperty IN (owl:cardinality, owl:minCardinality, owl:maxCardinality,
                                       owl:qualifiedCardinality, owl:minQualifiedCardinality,
                                       owl:maxQualifiedCardinality))
      BIND("cardinality" AS ?construct)
    }

    # The named class whose axiom contains the expression. The second path only
    # walks class-expression structure, so it does not pass through another
    # named class and report its subclasses too.
    ?cls (rdfs:subClassOf|owl:equivalentClass|owl:disjointWith|owl:disjointUnionOf) ?expression .
    ?expression (owl:intersectionOf|owl:unionOf|owl:complementOf|rdf:first|rdf:rest|owl:someValuesFrom|owl:allValuesFrom|owl:onClass)* ?node .
    FILTER (isIRI(?cls))
    OPTIONAL { ?cls rdfs:label ?label }
  }
  MINUS {
    VALUES ?cls {
    obo:BTO_0001093    # WEHI-231 cell [unionOf; efo-edit]
    obo:BTO_0001948    # JURKAT E-6.1 cell [unionOf; efo-edit]
    obo:BTO_0002279    # J-774 cell [unionOf; efo-edit]
    obo:BTO_0002599    # RBA-2 cell [unionOf; efo-edit]
    obo:BTO_0004264    # INC-2 cell [unionOf; efo-edit]
    obo:CHEBI_114785   #  [unionOf; efo-edit]
    obo:CHEBI_16236    #  [unionOf; efo-edit]
    obo:CHEBI_18243    #  [unionOf; efo-edit]

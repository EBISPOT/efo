AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0100832> "2011-06-09T05:58:09Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Eye floaters")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Flitting flies")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Mouches volantes")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Myodeopsia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Myodesopsia")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Spots in front of eyes")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Vitreous condensations")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Vitreous debris")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Vitreous opacities")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100832> "Vitreous veils")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0100832> "HP:0100832")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0100832> "Vitreous floaters are described as vitreous condensations (or vitreous debris or vitreous opacities) as a finding upon ophthalmological examination. Floaters can take many forms from little dots, circles, lines, to clouds or cobwebs. The floaters are created by a shadow of the floating vitreal debris that is projected onto the retina, which is described as a veil.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100832> "Vitreous floaters")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100832> <http://purl.obolibrary.org/obo/HP_0004327>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100832> <http://purl.obolibrary.org/obo/HP_6001103>)


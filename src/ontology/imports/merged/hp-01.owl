AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0100705> "2011-04-03T02:33:49Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100705> "Abnormality of the glial cells")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0100705> "HP:0100705")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0100705> "Glia are nonneuronal cells of the nervous system that provide physical support, respond to injury, regulate the composition of the extracellular milieu, guide neuronal migration during development, and exchange metabolites with neurons.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100705> "Abnormal glial cell morphology")

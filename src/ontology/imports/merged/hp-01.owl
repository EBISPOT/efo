# Class: <http://purl.obolibrary.org/obo/HP_0100323> (Juvenile aseptic necrosis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0009-0006-4530-3154>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0100323> "Juvenile aseptic necrosis comprises a group of orthopedic diseases characterized by interruption of the blood supply of a bone, followed by localized bony necrosis most often of the epiphyses of bones of children or teenagers.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0100323> "2010-08-10T04:02:42Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0100323> "Aseptic epiphyseal necrosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0100323> "HP:0100323")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0100323> "Causes may be rapid growth, heredity, trauma or overuse and anatomic conformation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100323> "Juvenile aseptic necrosis")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100323> <http://purl.obolibrary.org/obo/HP_0010885>)

# Class: <http://purl.obolibrary.org/obo/HP_0100324> (Scleroderma)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0009-0006-4530-3154>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0100324> "A chronic autoimmune phenomenon characterized by fibrosis (or hardening) and vascular alterations of the skin.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0100324> "2010-08-10T04:14:42Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0100324> "HP:0001594")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0100324> "HP:0007426")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100324> "Progressive systemic scleroderma")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100324> "Pseudoscleroderma")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0100324> "HP:0100324")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0100324> "A chronic autoimmune phenomenon characterised by fibrosis (or hardening), vascular alterations, and autoantibodies. Sclerosis of the skin occurs in association with disorders as diverse as mixed connective tissue disease and systemic sclerosis. This term is intended to represent the phenotypic feature scleroderma rather than a particular disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100324> "Scleroderma")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100324> <http://purl.obolibrary.org/obo/HP_0001072>)


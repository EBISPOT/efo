# Class: <http://purl.obolibrary.org/obo/HP_0100523> (Liver abscess)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0100523> "A localized, circumscribed collection of purulent material (pus) within the liver parenchyma, typically resulting from a bacterial, parasitic, or fungal infection. Unlike hepatitis, which is often diffuse, an abscess is a focal lesion.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0100523> <https://orcid.org/0000-0001-7601-9822>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0100523> <https://orcid.org/0000-0001-9382-150X>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0100523> <https://orcid.org/0000-0002-2029-0733>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0100523> <https://orcid.org/0000-0002-3577-9021>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0100523> <https://orcid.org/0000-0002-4315-9105>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0100523> <https://orcid.org/0009-0004-8124-8864>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0100523> "2010-12-20T11:13:14Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0100523> "HP:0001400")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100523> "Hepatic abscess")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100523> "Liver abscess")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100523> "Purulent hepatic collection")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0100523> "HP:0100523")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0100523> "Unlike hepatitis, which is typically a diffuse inflammatory process, a liver abscess is a focal, localized collection of pus within the liver parenchyma. In addition to being a secondary complication of biliary or intra-abdominal infections, it is a characteristic manifestation of phagocytic defects (e.g., chronic granulomatous disease) and specific innate immune defects, such as NEMO deficiency.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100523> "Liver abscess")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0100523> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000470> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MPATH_608> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0002107>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100523> <http://purl.obolibrary.org/obo/HP_0025615>)

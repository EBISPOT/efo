# Class: <http://purl.obolibrary.org/obo/HP_0100731> (Transverse facial cleft)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:DDD_jhurst") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0100731> "A horizontal cleft of the face, varying from slight widening of the mouth, to a cleft extending to the ear.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0100731> "2011-06-06T05:03:42Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100731> "Lateral facial cleft")

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100021> "Cerebral paralysis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0100021> "HP:0100021")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100021> "Cerebral palsy")

AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0100028> "An aberrant or ectopic thyroid gland may occur anywhere along the path of initial descent of the thyroid. A total failure to descend contrasts with the incomplete descent of the thyroid, in which case the resulting final resting point of the gland may be high in the neck or just below the hyoid bone. Apart from an abnormal descent, accessory thyroid tissue can also occur, arising from remnants of the thyroglossal duct anywhere along the path of the thyroglossal duct tract.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100028> "Ectopic thyroid")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0100028> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000628> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0002046>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100028> <http://purl.obolibrary.org/obo/HP_0008188>)

# Class: <http://purl.obolibrary.org/obo/HP_0100030> (Accessory ectopic thyroid tissue)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0009-0006-4530-3154>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0100030> "Accessory ectopic thyroid tissue arising from remnants of the thyroglossal duct anywhere along the path of the thyroglossal duct tract.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0100030> "2010-06-10T10:25:46Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0100030> "HP:0100030")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0100030> "While the accessory thyroid tissue may be functional, it is generally insufficient for normal function if the main thyroid gland is entirely removed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100030> "Accessory ectopic thyroid tissue")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0100030> <http://purl.obolibrary.org/obo/HP_0100028>)


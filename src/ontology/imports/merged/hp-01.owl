AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0009-0006-4530-3154>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0100614> "A general term for inflammation of the muscles without respect to the underlying cause.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0100614> "2010-12-28T11:14:59Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0100614> "Muscle inflammation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0100614> "HP:0100614")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0100614> "Many such conditions are considered likely to be caused by autoimmune conditions, rather than directly due to infection, although autoimmune conditions can be activated or exacerbated by infections. It is also a documented side effect of the lipid-lowering drugs such as statins and fibrates. Elevation of creatine kinase in blood is indicative of myositis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0100614> "Myositis")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:CNA") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:DAN") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Cyclin") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000029191> "A protein that consists of a copy of the Cyclin, N-terminal domain (Pfam:PF00134). This class includes the G1/S cyclins, essential for the control of the cell cycle at the G1/S transition, and the G2/M cyclins, essential for the control of the cell cycle at the G2/M transition.")

# Class: <http://purl.obolibrary.org/obo/PR_000029187> (ribosomal protein S6 kinase alpha)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10411321") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:CNA") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000029187> "A protein that has a core domain composition consisting of a Protein kinase domain (Pfam:PF00069) followed by a Protein kinase C terminal domain (Pfam:PF00433) and another copy of the a Protein kinase domain (Pfam:PF00069). Prototype members of this class act downstream of ERK1/2 signaling pahtway. There are two functional kinase domains that are activated in a sequential manner by a series of phosphorylations.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PR_000029187> "PIRSF:PIRSF000606")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10411321") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000029187> "MAPK-activated protein kinase-1")

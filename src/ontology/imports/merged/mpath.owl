AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/MPATH_608> "mouse_pathology.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MPATH_608> "MPATH:608")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MPATH_608> "Generally occur following damage or infection with subsequent inflammatory response. Result of the body`s defensive reaction to foreign material.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MPATH_608> "abscess")
SubClassOf(<http://purl.obolibrary.org/obo/MPATH_608> <http://purl.obolibrary.org/obo/MPATH_607>)


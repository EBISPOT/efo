AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Index_finger") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0003622> "2nd digit of the manus.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0003622> "indicis")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0003622> "Anurans lack manual digit 1, so manual digit 2 is the digit after the prepollex (Phenotype RCN Oct 2012)")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasScope> "NCBITaxon:8782") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:10220427") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PhenoscapeRCN") Annotation(rdfs:seeAlso "UBERON:0012261") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0003622> "This class represents the standard tetrapod configuration. Wagner proposes that avian digits I,II,III develop from C2,C3,C4. To support this scheme we have separate classes representing the avian digits (here called alula, manual digit, major digit).")

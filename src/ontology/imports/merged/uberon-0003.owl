AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "OBOL:automatic") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Third_metatarsal_bone") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0003652> "A metatarsal bone that distally_connected_to a proximal phalanx of pedal digit 3[Automatically generated definition].")

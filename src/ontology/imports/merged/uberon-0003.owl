AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0009466") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Infundibulum_of_uterine_tube") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0003984> "The funnel-like expansion of the abdominal extremity of the uterine tube[MP].")

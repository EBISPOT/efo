AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Red_pulp#Sinusoids") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0003910> "Wide vessels in the spleen that drain into trabecular veins[WP].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://www.informatics.jax.org/greenbook/chapters/chapter13.shtml") <http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/UBERON_0003910> <http://purl.obolibrary.org/obo/NCBITaxon_10088>)

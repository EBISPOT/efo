# Class: <http://purl.obolibrary.org/obo/HP_0000787> (Kidney stone)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28079115") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000787> "Kidney stones (calculi) are mineral concretions in the renal calyces and pelvis that are found free or attached to the renal papillae.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000787> "HP:0000102")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000787> "Kidney stones")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000787> "Nephrolithiasis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000787> "Renal calculi")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000787> "Renal stones")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000787> "HP:0000787")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000787> "Nephrolithiasis is derived from the Greek words nephros (kidney) and lithos (stone) and the suffix iasis (process) and refers to the condition of having one or more kidney stones. In practice, nephrolithiasis is used interchangably. In contrast to nephrolithiasis, diffuse renal parenchymal calcification is called nephrocalcinosis. Stones that develop in the urinary tract (known as nephrolithiasis or urolithiasis) form when the urine becomes excessively supersaturated with respect to a mineral, leading to crystal formation, growth, aggregation and retention within the kidneys. Crystals or foreign bodies can act as a nidus for further stone formation. The resulting kidney stones (calculi) lead to symptoms if they become impacted in the ureter.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000787> "Kidney stone")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000787> <http://purl.obolibrary.org/obo/HP_0012210>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000543> "HP:0001148")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000543> "HP:0001484")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000543> "Pale optic disc")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000543> "Disc pallor")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000543> "Pale optic discs")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000543> "HP:0000543")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000543> "Optic disc pallor can be judged clinically with serial color photographs or by comparison to the other eye. The pallor reflects replacement of dead axons by glial tissue. The loss of the small capillaries within the nerve accounts for the shift from orange-pink to white.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000543> "Optic disc pallor")

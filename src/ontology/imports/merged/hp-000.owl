AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002693> "HP:0002693")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002693> "Abnormal skull base morphology")

# Class: <http://purl.obolibrary.org/obo/HP_0002380> (Fasciculations)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002380> "Fasciculations are observed as small, local, involuntary muscle contractions (twitching) visible under the skin. Fasciculations result from increased irritability of an axon (which in turn is often a manifestation of disease of a motor neuron). This leads to sporadic discharges of all the muscle fibers controlled by the axon in isolation from other motor units.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0002380> "HP:0002468")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0002380> "HP:0007092")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002380> "Fasciculation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002380> "Muscle fasciculation")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-6908-9849>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nlm.nih.gov/medlineplus/ency/article/003296.htm") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002380> "Muscle twitch")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002380> "HP:0002380")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002380> "This finding can be visible clinically and can be demonstrated by electromyography (EMG).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002380> "Fasciculations")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002380> <http://purl.obolibrary.org/obo/HP_0004305>)

# Class: <http://purl.obolibrary.org/obo/HP_0002381> (Aphasia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27384070") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002381> "An acquired language impairment of some or all of the abilities to produce or comprehend speech and to read or write.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0002381> "HP:0002357")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002381> "Difficulty finding words")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002381> "Losing words")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002381> "Loss of words")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002381> "HP:0002381")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002381> "Aphasia is caused by brain injury. The most common cause is stroke, but aphasia can also be caused by other factors such as head trauma, brain tumors, or infections. The terms aphasia and dysphasia are usually considered to be synonymous, but the word dysphasia has been used inconsistently and it is recommended to no longer use the term dysphasia.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002381> "Aphasia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002381> <http://purl.obolibrary.org/obo/HP_0002167>)

# Class: <http://purl.obolibrary.org/obo/HP_0002383> (Infectious encephalitis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24365426") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002383> "A disorder of the brain caused by an infectious agent that presents with fever, headache, and an altered level of consciousness. There may also be focal or multifocal neurologic deficits, and focal or generalized seizure activity.")

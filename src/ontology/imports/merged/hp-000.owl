AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0008428> "HP:0000942")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0008428> "Vertebral clefts")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0008428> "HP:0008428")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0008428> "Cleft vertebrae result when there are two, instead of one, primary ossification centers in a vertebral body. An unossified cartilaginous brdige may be observed radiographically with the shape of a cleft. If the two ossification centers are ventral/dorsal, a coronal cleft is observed, and if the two ossification centers are left/right, than a sagittal cleft is observed.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0008428> "Vertebral clefting")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0008428> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001786> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0002412>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0008428> <http://purl.obolibrary.org/obo/HP_0003312>)


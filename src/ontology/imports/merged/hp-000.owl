# Class: <http://purl.obolibrary.org/obo/HP_0005932> (Abnormal renal corticomedullary differentiation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22528889") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0005932> "An abnormality of corticomedullary differentiation (CMD) on diagnostic imaging such as magnetic resonance imaging, computer tomography, or sonography. CMD is a difference in the visualization of cortex and medulla.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0005932> "2008-03-27T03:21:00Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0005932> "HP:0005932")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0005932> "On T1-weighted magnetic resonance imaging, the signal intensity of the normal renal cortex is typically higher than medulla, resulting in easily visualized corticomedullary differentiation (CMD). Loss of CMD can be seen in disorders such as glomerulonephritis, acute tubular necrosis, end-stage chronic renal failure, obstructive hydronephrosis, and acute allograft rejection. Progressive corticomedullary differentiation (CMD) can be visualized as an echogenic cortex and a hypoechoic medulla. This CMD should be visible during the midtrimester sonographic evaluation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0005932> "Abnormal renal corticomedullary differentiation")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0005932> <http://purl.obolibrary.org/obo/HP_0011035>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0005932> <http://purl.obolibrary.org/obo/HP_0100957>)


# Class: <http://purl.obolibrary.org/obo/HP_0000162> (Glossoptosis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125428") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000162> "Posterior displacement of the tongue into the pharynx, i.e., a tongue that is mislocalised posteriorly.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/HP_0000162> "Posterior displacement of the tongue")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000162> "Lingual retraction")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000162> "Retraction of the tongue")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000162> "HP:0000162")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000162> "Presumably, use of the suffix ptosis refers to the situation where the patient is supine, and the displacement is downward. Strictly speaking, the term glossoptosis indicates falling of the tongue and thus can also be forward displacement; however by convention it is only used for backward displacement. Glossoptosis may cause obstruction of the airway.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000162> "Glossoptosis")

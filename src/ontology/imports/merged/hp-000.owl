# Class: <http://purl.obolibrary.org/obo/HP_0009908> (Anterior creases of earlobe)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19152421") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0009908> "Sharply demarcated, typically linear and approximately horizontal, indentations in the outer surface of the ear lobe.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0009908> "2009-05-01T03:00:22Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0009908> "HP:0008604")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009908> "Earlobe crease")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009908> "Transverse earlobe creases")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0009908> "HP:0009908")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0009908> "Shallow grooves or indentations are quite common, especially in large lobes. Ear lobe creases may arise postnatally. Posterior helical pits can be a related finding but should be assessed and coded separately.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0009908> "Anterior creases of earlobe")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0009908> <http://purl.obolibrary.org/obo/HP_0000363>)


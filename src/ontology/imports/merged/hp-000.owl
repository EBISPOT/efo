AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0004279> "Short hands")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0004279> "Short palms")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0004279> "HP:0004279")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0004279> "This term refers to a developmental finding resulting in short palms. This term is reserved for individuals with shortening of all four metacarpals 2-5. Individuals with fewer than four shortened metacarpals (in a eudactylous hand, the metacarpals of F2-5) should be coded as Metacarpal, short. See the entry for Hand, small for a discussion of this finding. \"Short hand\" should not be used as it is a bundle of two readily separable terms, Fingers, short (which, as noted above, can itself be a bundled term) and Palm, short.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0004279> "Short palm")

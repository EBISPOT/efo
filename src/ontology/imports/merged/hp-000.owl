AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0006897> "Affected individuals may experience diplopia as well as esotropia or convergent strabismus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0006897> "Abducens palsy")

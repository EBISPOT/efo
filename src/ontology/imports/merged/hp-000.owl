AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001083> "Lens dislocation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0001083> "HP:0001083")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0001083> "Ectopia lentis")

# Class: <http://purl.obolibrary.org/obo/HP_0000677> (Oligodontia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125428") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31468724") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000677> "The absence of six or more teeth from the normal series by a failure to develop.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000677> "HP:0000702")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000677> "Failure of development of more than six teeth")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000677> "Partial anodontia")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000677> "Missing more than six teeth")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000677> "Number of teeth decreased by more than six")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000677> "HP:0000677")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000677> "The diagnosis of oligodontia requires a radiograph, as is true for anodontia and for the other designation of tooth agenesis, hypodontia. The terms hypodontia and oligodontia are sometimes used interchangeably in the literature while on other occasions hypodontia is used for selective agenesis of six or less missing teeth while oligodontia is applied when there are more than six missing teeth. Tooth agenesis or oligodontia/hypodontia can be mistaken for delayed eruption and again a radiograph is needed for diagnosis. Absence of teeth may be congenital (tooth agenesis) or acquired. The incidence of congenital absence of teeth is different depending on the type and position of the tooth [Gorlin et al, 2001].")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000677> "Oligodontia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000677> <http://purl.obolibrary.org/obo/HP_0001592>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0009907> "HP:0009907")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0009907> "The earlobe does not have a dependent portion.")

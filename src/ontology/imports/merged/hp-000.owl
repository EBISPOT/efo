AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0001933> "Purpura measure 0.3-1 cm (3-10 mm), whereas petechiae measure less than 3 mm, and ecchymoses greater than 1 cm.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0001933> "Subcutaneous hemorrhage")

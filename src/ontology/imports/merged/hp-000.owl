AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002021> "HP:0002021")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002021> "Pyloric stenosis occurs in the first few months of life.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002021> "Pyloric stenosis")

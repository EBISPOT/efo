AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002075> "Inability to perform rapid, alternating movements. Dysdiadochokinesis is generally related to a cerebellar lesion.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002075> "Dysdiadochokinesis")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002075> <http://purl.obolibrary.org/obo/HP_0001251>)


# Class: <http://purl.obolibrary.org/obo/HP_0009926> (Epiphora)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-0986-4123>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:DDD_ncarter") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28003974") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0009926> "Abnormally increased lacrimation, that is, excessive tearing (watering eye).")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0009926> "2009-05-02T10:52:28Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0009926> "HP:0001486")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009926> "Increased lacrimation")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009926> "Increased tears")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009926> "Tearing")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009926> "Watery eyes")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0009926> "HP:0009926")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0009926> "Epiphora or tearing is the presence of a watering eye, which is a common complaint for referrals to oculoplastics clinics for evaluation. The etiology of tearing can be divided into two categories: reflex tearing and reduced tear outflow. Reflex tearing is usually secondary to dry eye, inflammation, allergy or other ocular surface disorders, whereas primary hypersecretion of the lacrimal glands is rare. Reduced tear outflow is due to eyelid malposition, tear pump dysfunction caused by eyelid laxity, or obstruction at any portion of the nasaolacrimal drainage system.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0009926> "Epiphora")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0009926> <http://purl.obolibrary.org/obo/HP_0000632>)


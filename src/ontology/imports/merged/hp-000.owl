# Class: <http://purl.obolibrary.org/obo/HP_0002373> (Febrile seizure (within the age range of 3 months to 6 years))

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10353950") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125841") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30078767") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:6779259") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002373> "A febrile seizure is any type of seizure (most often a generalized tonic-clonic seizure) occurring with fever (at least 38 degrees Celsius) but in the absence of central nervous system infection, severe metabolic disturbance or other alternative precipitant in children between the ages of 3 months and 6 years.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0002373> "HP:0002175")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0002373> "HP:0007102")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002373> "Febrile convulsion")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002373> "Febrile seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002373> "Seizures, febrile, in early childhood")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002373> "Seizures, generalized, associated with fever")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002373> "HP:0002373")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002373> "Typically febrile seizures are limited to the age range of 3 months to 6 years and not accompanied or preceded by afebrile seizures; in this case febrile seizures are not considered indicative of epilepsy. When febrile seizures occur prior to the age of 3 months, or continue beyond the 6th birthday, or when a person has both febrile seizures and afebrile generalized tonic-clonic seizures then a diagnosis of Febrile Seizures Plus (an epilepsy syndrome) may be made.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002373> "Febrile seizure (within the age range of 3 months to 6 years)")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002373> <http://purl.obolibrary.org/obo/HP_0032894>)


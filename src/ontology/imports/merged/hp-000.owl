AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002500> "White matter abnormalities")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002500> "White matter alterations")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0002500> "Cortical white matter abnormalities seen on MRI")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002500> "HP:0002500")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002500> "This finding can be demonstrated by magnetic resonance imaging, especially with t2 signaling. The cerebral white matter is the region of the central nervous system that consists mostly of glial cells and myelinated axons that interconnect the various regions of the cerebrum and the lower brain centers. It is located in the subcortex.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002500> "Abnormal cerebral white matter morphology")

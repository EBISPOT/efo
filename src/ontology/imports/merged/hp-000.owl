# Class: <http://purl.obolibrary.org/obo/HP_0002322> (Resting tremor)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22675666") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002322> "A resting tremor occurs when muscles are at rest and becomes less noticeable or disappears when the affected muscles are moved. Resting tremors are often slow and coarse.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002322> "Rest tremor")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002322> "Resting tremor")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002322> "Tremor at rest")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0002322> "Parkinsonian tremor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002322> "HP:0002322")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002322> "Resting tremor vanishes with active movement, but typically reappears after a few seconds when the arms are held outstretched (reemergent tremor). In Parkinson disease, rest tremor frequency is usually in the low to mid-range (3-6 Hz), and the amplitude is quite variable, from less than 1 cm to over 10 cm in width.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002322> "Resting tremor")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002322> <http://purl.obolibrary.org/obo/HP_0001337>)


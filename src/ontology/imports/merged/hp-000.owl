AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0005262> "Abnormal synovial membrane morphology")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0005262> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/UBERON_0007617>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

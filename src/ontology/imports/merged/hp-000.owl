# Class: <http://purl.obolibrary.org/obo/HP_0001655> (Patent foramen ovale)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:DDD_dbrown") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0001655> "Failure of the foramen ovale to seal postnatally, leaving a potential conduit between the left and right cardiac atria.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/HP_0001655> "Fyler:2020")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/HP_0001655> "ICD-10:Q21.1")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#abbreviation>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001655> "PFO")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001655> "Persistent foramen ovale")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0001655> "HP:0001655")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0001655> "The foramen ovale is located in the atrial septum and is essential for proper fetal circulation. With separation from the placenta and with the first few breaths, the left atrium fills with blood returning from the lungs and closes the foramen ovale. Subsequently, during the first years of life, the foramen ovale seals shut.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0001655> "Patent foramen ovale")

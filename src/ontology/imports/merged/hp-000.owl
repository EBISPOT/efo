# Class: <http://purl.obolibrary.org/obo/HP_0008682> (Renal tubular epithelial necrosis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0008682> "Coagulative necrosis of tubular epithelial cells, defined as cells with increased cytoplasmic eosinophilia and nucleus that has a condensed chromatin pattern with fuzzy nuclear contour or has barely visible nuclear basophilic staining. The extent of cortical tubular necrosis is scoredsemiquantitatively as none, mild (less than 25% tubules with necrosis), moderate (25-50 percent), and severe (over 50%).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0008682> "Acute tubular necrosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0008682> "Renal tubular necrosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0008682> "HP:0008682")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0008682> "Renal tubular epithelial necrosis is a histomorphological definition that corresponds to the clinical term of acture tubular necrosis. Acute death of renal tubular cells that usually results from prolonged renal ischemia, nephrotoxins, or sepsis. The clinical course of acute tubular necrosis may be divided into initiation, maintenance, and recovery phases.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0008682> "Renal tubular epithelial necrosis")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0008682> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000647> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0009773>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000389>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0008682> <http://purl.obolibrary.org/obo/HP_0000091>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0008682> <http://purl.obolibrary.org/obo/HP_0032618>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0007894> "Decreased fundus pigmentation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0007894> "Depigmented fundus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0007894> "Hypopigmentation of the fundus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0007894> "HP:0007894")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0007894> "Fundus hypopigmentation is consistently observed in albinism. Pigmentation is also reduced with age in some individuals, high myopia, and in chronic inflammation, such as Harada disease. Ocular pigmentation is essential for normal vision, and persons with ocular albinism tend to have severely reduced visual acuity often associated with nystagmus, strabismus, and photophobia.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0007894> "Fundus hypopigmentation")

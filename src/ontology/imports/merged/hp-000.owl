AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0002494> <https://orcid.org/0000-0002-7367-663X>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002494> "Abnormal REM sleep")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002494> "HP:0002494")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002494> "Abnormal rapid eye movement sleep")

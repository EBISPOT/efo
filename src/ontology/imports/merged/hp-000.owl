AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000219> "Decreased height of upper lip vermilion")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000219> "Decreased volume of upper lip")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000219> "Decreased volume of upper lip vermilion")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000219> "Thin upper lip")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000219> "Thin vermilion border of upper lip")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/HP_0000219> "Thin red part of the upper lip")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000219> "Thin upper lips")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000219> "HP:0000219")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000219> "Normal values for the height of the vermilion are available [Farkas, 1981], but measurements are not commonly used. Most clinicians determine this feature subjectively or use the Likert scale for Caucasians and African Americans [Astley and Clarren, 2000]. The height of the vermilion of the upper lip varies among ethnic groups, and the vermilion should be compared to a population of same ethnic background. The thinness of the upper lip vermilion is sensitive to facial expression. On profile view, a thin vermilion is less convex than usual. A thin upper lip vermilion may be associated with a smooth philtrum and an absence of the Cupid's bow, but these should be assessed separately.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000219> "Thin upper lip vermilion")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0000219> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000592> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001834>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000219> <http://purl.obolibrary.org/obo/HP_0000233>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000219> <http://purl.obolibrary.org/obo/HP_0011339>)


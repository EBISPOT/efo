AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0008733> "HP:0008733")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0008733> "Dysplastic testis")

# Class: <http://purl.obolibrary.org/obo/HP_0000668> (Hypodontia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-9338-3017>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31468724") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000668> "The absence of five or less teeth from the normal series by a failure to develop.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000668> "Failure of development of between one and six teeth")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000668> "Missing between one and six teeth")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000668> "HP:0000668")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000668> "Hypodontia needs to be confirmed by X-rays. The terms hypodontia and oligodontia have been used interchangeably in literature but these define two different clinical entities. Hypodontia has been used to define exclusively the absence of permanent teeth and excluding third molars, but the absence of any deciduous and permanent teeth, including third molars, should be called hypodontia as well.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000668> "Hypodontia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000668> <http://purl.obolibrary.org/obo/HP_0001592>)


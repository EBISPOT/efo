# Class: <http://purl.obolibrary.org/obo/HP_0004398> (Peptic ulcer)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28242110") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0004398> "The term peptic ulcer refers to acid peptic injury of the digestive tract, resulting in mucosal break reaching the submucosa. Peptic ulcers are usually located in the stomach or proximal duodenum, but they can also be found in the esophagus or Meckel's diverticulum. Infection with Helicobacter pylori and the use of non steroidal antiinflammatory drugs (NSAIDs) or aspirin are the main risk factors of both gastric and duodenal peptic ulcers.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0004398> "2008-03-18T09:14:00Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6548-5200>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0004398> "Sore in the lining of gastrointestinal tract")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0004398> "HP:0004398")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0004398> "Symptoms of peptic ulcer disease have limited predictive value because they are non-specific. Patients with duodenal ulcers typically feel hungry or have nocturnal abdominal pain. By contrast, patients with gastric ulcers have postprandial abdominal pain, nausea, vomiting, and weight loss. Patients with untreated peptic ulcer disease typically have relapsing symptoms because of spontaneous healing and relapse while the causal factor (eg, H pylori infection or NSAID use) persists.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0004398> "Peptic ulcer")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0004398> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000470> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MPATH_579> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0005409>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0004398> <http://purl.obolibrary.org/obo/HP_0034274>)


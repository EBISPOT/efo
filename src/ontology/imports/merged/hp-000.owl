# Class: <http://purl.obolibrary.org/obo/HP_0001837> (Broad toe)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0001837> "Visible increase in width of the non-hallux digit without an increase in the dorso-ventral dimension.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001837> "Broad toe")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001837> "Wide toe")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0001837> "HP:0001837")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0001837> "Note that the girth may be increased in a broad toe, but this must be distinguished from Macrodactyly because in Macrodactyly the length is increased as well. The affected digit should be specified. Note that this assessment may be difficult when the toes are short. This term is not used for the first digit, see Broad hallux. If all five digits are broad, both terms should be used for that patient.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0001837> "Broad toe")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0001837> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000600> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001466>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0001837> <http://purl.obolibrary.org/obo/HP_0001780>)

# Class: <http://purl.obolibrary.org/obo/HP_0001838> (Rocker bottom foot)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0001838> "The presence of both a prominent heel and a convex contour of the sole.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0001838> "HP:0001835")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0001838> "HP:0004693")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0001838> "HP:0010218")
AnnotationAssertion(Annotation(rdfs:label "Vertical talus") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/HP_0001838> "MEDDRA:10066242")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001838> "Congenital vertical talus")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001838> "Rocker bottom feet")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001838> "Rocker bottom foot")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001838> "Rocker-bottom feet")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001838> "Rockerbottom feet")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0001838> "HP:0001838")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0001838> "Congenital vertical talus is characterized by pes valgus, a rigid flatfoot deformity (as opposed to a flexible calcaneovalgus foot) caused by a malpositioned navicular bone at the neck of the talus; the ankle is in severe equinus and the forefoot in dorsiflexion, rocker bottom-like, accompanied by contraction of the talonavicular, deltoid and calcaneal cuboidal ligaments. The foot examination usually reveals a rigid foot with a \"reversed\" arch, a convex plantar surface, and a deep crease on the lateral dorsal side of the foot. The ankle joint is plantarflexed, while the midfoot and forefoot are extended upward. Lateral foot radiographs are helpful in confirming the diagnosis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0001838> "Rocker bottom foot")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0001838> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001854> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0002395>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0001838> <http://purl.obolibrary.org/obo/HP_0008365>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0001838> <http://purl.obolibrary.org/obo/HP_5210430>)

# Class: <http://purl.obolibrary.org/obo/HP_0001840> (Metatarsus adductus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0001840> "The metatarsals are deviated medially (tibially), that is, the bones in the front half of the foot bend or turn in toward the body.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0001840> "HP:0001768")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0001840> "HP:0010217")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001840> "Forefoot varus")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6548-5200>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001840> "Front half of foot turns inward")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001840> "Metatarsus adductovarsus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001840> "Metatarsus varus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001840> "Sickle foot")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001840> "Sickled feet")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0001840> "Intoe")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0001840> "HP:0001840")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0001840> "Metatarsus varus (adductus) is one of the most common foot deformities, that is defined as a transverse plane deformity in Lisfranc's (tarsometatarsal) joints in which the metatarsals are deviated medially. The relationship between talus and calcaneus is normal. On inspection the toes angle abruptly towards the midline, creating a C-shaped lateral foot border with a prominent styloid process of the 5th metatarsal. The result is that the forefoot is twisted inwards relative to the heel, so that the sole faces the midline.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0001840> "Metatarsus adductus")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0001840> <http://purl.obolibrary.org/obo/HP_0001832>)

# Class: <http://purl.obolibrary.org/obo/HP_0001841> (Preaxial foot polydactyly)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0001841> "Duplication of all or part of the first ray.")

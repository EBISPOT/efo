# Class: <http://purl.obolibrary.org/obo/HP_0002305> (Athetosis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20589866") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002305> "A slow, continuous, involuntary writhing movement that prevents maintenance of a stable posture. Athetosis involves continuous smooth movements that appear random and are not composed of recognizable sub-movements or movement fragments. In contrast to chorea, in athetosis, the same regions of the body are repeatedly involved. Athetosis may worsen with attempts at movement of posture, but athetosis can also occur at rest.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0002305> "HP:0007167")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0002305> "HP:0007316")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002305> "Athetoid movements")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002305> "Involuntary writhing movements")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6548-5200>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002305> "Involuntary writhing movements in fingers, hands, toes, and feet")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002305> "HP:0002305")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002305> "Athetosis derives from the Greek word for 'changeable' or 'unfixed'.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002305> "Athetosis")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002305> <http://purl.obolibrary.org/obo/HP_0004305>)

# Class: <http://purl.obolibrary.org/obo/HP_0002307> (Drooling)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15202698") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19236564") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002307> "Drooling is the overflowing of saliva from the mouth.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002307> "Dribbling")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002307> "Drooling")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0009-0006-4530-3154>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002307> "Sialorrhea")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002307> "HP:0002307")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002307> "Drooling or salivary incontinence is an indication of anupset in the coordinated control mechanism of orofacialmusculature and palato-lingual musculature leading toexcessive pooling of saliva in the anterior mouth andresulting in unintentional loss of saliva from the mouth.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002307> "Drooling")

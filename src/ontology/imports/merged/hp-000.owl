# Class: <http://purl.obolibrary.org/obo/HP_0002091> (Restrictive ventilatory defect)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-4546-6667>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28194273") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002091> "A functional defect characterized by reduced total lung capacity (TLC) not associated with abnormalities of expiratory airflow or airway resistance. Spirometrically, a restrictive defect is defined as FEV1 (forced expiratory volume in 1 second) and FVC (forced vital capacity) less than 80 per cent. Restrictive lung disease may be caused by alterations in lung parenchyma or because of a disease of the pleura, chest wall, or neuromuscular apparatus.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0002091> "HP:0002111")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002091> "Restrictive deficit on pulmonary function testing")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002091> "Restrictive deficit on pulmonary function tests")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002091> "Restrictive respiratory disease")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002091> "Restrictive respiratory insufficiency")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002091> "Restrictive respiratory syndrome")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002091> "Spirometric restriction")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6548-5200>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002091> "Stiff lung or chest wall causing decreased lung volume")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0002091> "Restrictive lung disease")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002091> "HP:0002091")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002091> "The most commonly used term for this feature is restrictive lung disease, but we choose the term Restrictive ventilatory defect to emphasize that this term refers to a phenotypic feature rather than a disease entity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002091> "Restrictive ventilatory defect")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002091> <http://purl.obolibrary.org/obo/HP_0030878>)


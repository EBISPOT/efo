# Class: <http://purl.obolibrary.org/obo/HP_0006585> (Congenital pseudoarthrosis of the clavicle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22295044") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0006585> "The two portions of the clavicle (corresponding to the two primary ossification centers of the clavicle) are connected by a fibrous bridge that is contiguous with the periosteum, and a synovial membrane develops, resulting in a clavicle with a bipartite appearance radiographically. Congenital pseudarthrosis of the clavicle generally presents as a painless mass or swelling over the clavicle.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0006585> "HP:0006612")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0006585> "HP:0006661")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0006585> "Clavicle pseudoarthrosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0006585> "Pseudoarthrosis of clavicle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0006585> "Bipartite clavicle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0006585> "HP:0006585")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0006585> "In congenital pseudarthrosis of the clavicle, the two primary ossification centers fail to unite, probably due to a disruption of diaphyseal membranous ossification. See PMID:22295044, Figure 1, for the radiographic appearance of this feature.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0006585> "Congenital pseudoarthrosis of the clavicle")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0006585> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/HP_0005864> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001105>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

# Class: <http://purl.obolibrary.org/obo/HP_0002516> (Increased intracranial pressure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002516> "An increase of the pressure inside the cranium (skull) and thereby in the brain tissue and cerebrospinal fluid.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002516> "Intracranial hypertension")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002516> "Intracranial pressure elevation")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6548-5200>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002516> "Rise in pressure inside skull")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0002516> "Pseudotumor cerebri")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0002516> "HP:0002516")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002516> "Normal values of intracranial pressure in adults are around 7-15 mm Hg in the supine position. The term pseudotumor cerebri (also: idiopathic intracranial hypertension or benign intracranial hypertension) is the presence of increased intracranial pressure in the absence of a brain tumor or other identifiable cause. It should be coded using this term and negations of appropriate other HPO terms. Increased intracranial pressure can damage tissue, contribute to hydrocephalus, cause brain herniation, and restrict blood supply to the brain.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002516> "Increased intracranial pressure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002516> <http://purl.obolibrary.org/obo/HP_0012640>)


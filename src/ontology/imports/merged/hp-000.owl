AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000232> "In frontal view, with the face relaxed, the apparent height of the lower lip vermilion is excessive and the lower incisors may be visible. On profile view, the vermilion is more convex than usual. An everted lower lip may be viewed as pouting, but this designation is a functional term.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000232> "Everted lower lip vermilion")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0000232> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001597> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001835>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000232> <http://purl.obolibrary.org/obo/HP_0000178>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000232> <http://purl.obolibrary.org/obo/HP_0012472>)

# Class: <http://purl.obolibrary.org/obo/HP_0000233> (Thin vermilion border)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125428") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000233> "Height of the vermilion of the medial part of the lip more than 2 SD below the mean, or apparently reduced height of the vermilion of the lip in the frontal view. The vermilion is the red part of the lips (and confusingly, the vermilion itself is also often referred to as being equivalent the lips).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000233> "HP:0000213")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000233> "Decreased volume of lip")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000233> "Decreased volume of lip vermillion")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000233> "Thin lips")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000233> "Thin vermillion")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000233> "Thin vermilion borders")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000233> "HP:0000233")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000233> "The vermilion is the red part of the lips, and the vermilion border is the rim of paler skin that demarcates the vermilion from the rest of the skin of the face.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000233> "Thin vermilion border")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000233> <http://purl.obolibrary.org/obo/HP_0000159>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009943> "Digitalization of thumb")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009943> "Digitalization of thumbs")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0009943> "HP:0009943")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0009943> "Complete duplication of thumb phalanx")

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000245> "HP:0000245")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000245> "Abnormal paranasal sinus morphology")

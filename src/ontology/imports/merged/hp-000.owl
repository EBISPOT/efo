# Class: <http://purl.obolibrary.org/obo/HP_0005115> (Supraventricular arrhythmia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0005115> "A type of arrhythmia that originates above the ventricles, whereby the electrical impulse propagates down the normal His Purkinje system similar to normal sinus rhythm.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0005115> "2008-03-25T06:37:00Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0005115> "Supraventricular arrhythmias")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0005115> "HP:0005115")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0005115> "Supraventricular arrhythmia includes atrial arrhythmias (atrial tachycardia, atrial flutter, atrial fibrillation), atrioventricular nodal reentrant tachycardia, junctional ectopic tachycardia, atrioventricular reentrant tachycardia (Wolf-Parkinson-White Syndrome), orthodromic or antidromic. Supraventricular arrhythmia is distinct from ventricular tachycardia, which originates in the ventricles.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0005115> "Supraventricular arrhythmia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0005115> <http://purl.obolibrary.org/obo/HP_0011675>)


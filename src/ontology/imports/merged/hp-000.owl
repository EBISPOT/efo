AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001965> "Abnormality of the scalp")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0001965> "Anomaly of scalp")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0001965> "HP:0001965")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0001965> "The scalp of the head has the following five layers: 1) skin and head hair; 2) connective tissue; 3) the aponeurosis (a layer of dense fibrous tissue); 4) loose areolar connective tissue; and 5) the periosteum of the skull bones.")

# Class: <http://purl.obolibrary.org/obo/HP_0000319> (Smooth philtrum)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19152422") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000319> "Flat skin surface, with no ridge formation in the central region of the upper lip between the nasal base and upper vermilion border.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000319> "HP:0000299")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000319> "HP:0000323")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000319> "HP:0004663")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000319> "Decreased depth of philtrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000319> "Flat philtrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000319> "Indistinct philtrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000319> "Philtrum, smooth")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000319> "Shallow philtrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000319> "Simple philtrum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000319> "HP:0000319")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000319> "There is a spectrum of this finding from total absence of the philtral ridges to a some prominence of the ridges. The central groove varies from absent to shallow. Normal values for the frequency of smooth philtrum are available. Grading of the smoothness of the philtrum, used in the assessment of Fetal Alcohol Syndrome, has been developed. This finding is greatly influenced by the facial expression, and care should be taken to evaluate the philtrum when the face is in a neutral position. A smooth philtrum can be associated with a Long philtrum. However, the two findings should be coded separately.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000319> "Smooth philtrum")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0000319> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000407> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0005402>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000319> <http://purl.obolibrary.org/obo/HP_0000288>)


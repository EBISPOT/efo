AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0002062> "The pyramidal tracts comprise both the corticospinal and corticobulbar tracts.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0002062> "Abnormal pyramidal tract morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0002062> <http://purl.obolibrary.org/obo/HP_0002011>)

# Class: <http://purl.obolibrary.org/obo/HP_0002063> (Rigidity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0002063> "Continuous involuntary sustained muscle contraction. When an affected muscle is passively stretched, the degree of resistance remains constant regardless of the rate at which the muscle is stretched. This feature helps to distinguish rigidity from muscle spasticity.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0002063> "Muscle rigidity")

# Class: <http://purl.obolibrary.org/obo/HP_0007035> (Anterior encephalocele)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22069427") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32965839") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0007035> "A type of congenital malformation in which brain tissue protrudes through a defect in the anterior (front) part of the skull.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0007035> "Sincipital encephalocele")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0007035> "HP:0007035")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0007035> "Anterior encephalocele development occurs from abnormal development of the foramen cecum. A diverticulum of dura usually projects anteriorly between the developing nasal and frontal bones at the fonticulus frontalis/foramen cecum. Later in embryogenesis, the diverticulum regresses, and the bone closes. However, if it does not regress, the brain can herniate through the bone defect and form an encephalocele.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0007035> "Anterior encephalocele")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0007035> <http://purl.obolibrary.org/obo/HP_0002084>)


AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6548-5200>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0005110> "Quivering upper heart chambers resulting in irregular heartbeat")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0005110> "HP:0005110")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0005110> "The ventricular response to atrial fibrillation is irregularly irregular because of the large number of atrial impulses that transit the atrioventricular node, making the ventricle partially refractory to further impulses. Atrial fibrillation can cause a number of manifestations including excessive ventricular response with angina pectoris or hypotension in susceptible individuals, syncope, systemic embolization, fatigue, or anxiety. These features should be coded separately.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0005110> "Atrial fibrillation")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0005110> <http://purl.obolibrary.org/obo/HP_0001692>)


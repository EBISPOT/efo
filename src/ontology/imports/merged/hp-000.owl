# Class: <http://purl.obolibrary.org/obo/HP_0009113> (Diaphragmatic weakness)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2509822") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0009113> "A decrease in the strength of the diaphragm.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0009113> "2008-04-05T10:43:00Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0009113> "HP:0005953")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0009113> "HP:0009111")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009113> "Diaphragmatic paraparesis")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0009113> "Weak diaphragm")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0009113> "Diminished diaphragmatic motion")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0009113> "HP:0009113")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0009113> "Diaphragmatic paralysis is an extreme form of diaphragmatic weakness. Weakness of the diaphragm can result from abnormalities at any site along its neuromuscular axis, although it most frequently arises from diseases in the phrenic nerves or from myopathies affecting the diaphragm itself. Presence of diaphragmatic weakness may be suspected from the complaint of dyspnea (particularly on exertion) or orthopnea; or the presence of rapid, shallow breathing or, more importantly, paradoxical inward motion of the abdomen during inspiration on physical examination.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0009113> "Diaphragmatic weakness")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0009113> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001779> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001103>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

# Class: <http://purl.obolibrary.org/obo/HP_0000657> (Oculomotor apraxia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20615230") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0000657> "Ocular motor apraxia is a deficiency in voluntary, horizontal, lateral, fast eye movements (saccades) with retention of slow pursuit movements. The inability to follow objects visually is often compensated by head movements. There may be decreased smooth pursuit, and cancelation of the vestibulo-ocular reflex.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000657> "HP:0000628")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0000657> "HP:0007764")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0000657> "Ocular motor apraxia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0000657> "Defective or absent horizontal voluntary eye movements")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0000657> "HP:0000657")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0000657> "Oculomotor apraxia leads defective or absent horizontal voluntary eye movements with head thrusting to look at objects to the side as well as jerky, abnormal eye movements.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0000657> "Oculomotor apraxia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000657> <http://purl.obolibrary.org/obo/HP_0000496>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0000657> <http://purl.obolibrary.org/obo/HP_0002186>)


# Class: <http://purl.obolibrary.org/obo/HP_0009623> (Proximal placement of thumb)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0009623> "Proximal mislocalization of the thumb.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0009623> "2009-01-29T04:40:23Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0009623> "HP:0001170")

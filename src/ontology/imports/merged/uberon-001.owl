AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0010843> "clavicle cartilage element")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0010843> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0005863> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002387> <http://purl.obolibrary.org/obo/UBERON_0001105>)))

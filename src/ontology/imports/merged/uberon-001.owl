# Class: <http://purl.obolibrary.org/obo/UBERON_0010362> (endoskeleton)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000034") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PSPUB:0000170") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:0000037") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://dx.plos.org/10.1371/journal.pone.0051070") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0010362> "Skeletal subdivision that undergoes indirect development and includes elements that develop as a replacement or substitution of other elements or tissues.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Wikipedia:Endoskeleton") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0010362> "An endoskeleton is an internal support structure of an animal, composed of mineralized tissue. Endoskeleton develops within the skin or in the deeper body tissues. The vertebrate is basically an endoskeleton made up of two types of tissues (bone and cartilage). During early embryonic development the endoskeleton is composed of notochord and cartilage. The notochord in most vertebrates is replaced by vertebral column and cartilage is replaced by bone in most adults. In three phyla and one subclass of animals, endoskeletons of various complexity are found: Chordata, Echinodermata, Porifera, and Coleoidea. An endoskeleton may function purely for support (as in the case of sponges), but often serves as an attachment site for muscle and a mechanism for transmitting muscular forces. A true endoskeleton is derived from mesodermal tissue. Such a skeleton is present in echinoderms and chordates. The poriferan 'skeleton' consists of microscopic calcareous or siliceous spicules or a spongin network. The Coleoidae do not have a true endoskeleton in the evolutionary sense; here, a mollusk exoskeleton evolved into several sorts of internal structure, the 'cuttlebone' of cuttlefish being the best-known version. Yet they do have cartilaginous tissue in their body, even if it is not mineralized, especially in the head, where it forms a primitive cranium. The endoskeleton gives shape,support and protection to the body and provides a mean of locomotion.[Wikipedia:Endoskeleton]t")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010362> "VSAO:0000037")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010362> "Wikipedia:Endoskeleton")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010362> "XAO:0004026")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:curator") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0010362> "replacement skeleton")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0010362> "UBERON:0010362")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0010362> <http://purl.obolibrary.org/obo/uberon/core#human_subset>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0010362> <http://purl.obolibrary.org/obo/uberon/core#mouse_subset>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0010362> "endoskeleton")
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "VSAO") <http://purl.obolibrary.org/obo/UBERON_0010362> <http://purl.obolibrary.org/obo/UBERON_0010912>)
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0010362> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_7742>))
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0010362> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002473> <http://purl.obolibrary.org/obo/UBERON_0010522>))


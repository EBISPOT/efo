AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0014780> "palatine aponeurosis")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0014780> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0006614> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001733>)))

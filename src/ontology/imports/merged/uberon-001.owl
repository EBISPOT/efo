# Class: <http://purl.obolibrary.org/obo/UBERON_0010309> (palpebral bone)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16496288") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Palpebral_(bone)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0010309> "An ossified element investing the upper eyelid.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0010309> "PMID:16496288 says 'invests' the eyelid, is this consistent across taxa?")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0010309> "The most extreme development of the palpebral is found in the armored dino- saur Euoplocephalus tutus, where the bone forms a quarter-sphere and adducts to completely occlude the or- bit (Coombs, 1972; Vickaryous and Russell, 2003). Notwithstanding the superficially similar position, palpe- brals and tarsal plates differ both anatomically and developmentally and are not considered homologous (Gauthier et al., 1988)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/UBERON_0010309> "palpebral")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0010309> "Wikipedia:Palpebral_(bone)")

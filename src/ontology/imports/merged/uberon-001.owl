# Class: <http://purl.obolibrary.org/obo/UBERON_0013631> (sesamoid element)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PSPUB:0000169") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:0000137") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0013631> "Ossicle that develops within bands of dense, regular connective tissue (e.g., tendons and ligaments). Sesamoids are generally located proximate to a bony prominence, over which the dense regular connective tissue wraps, and/or a joint or articulation.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0013631> "VSAO:0000137")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:0000137") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0013631> "sesamoid")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0013631> "UBERON:0013631")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0013631> <http://purl.obolibrary.org/obo/uberon/core#human_subset>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0013631> <http://purl.obolibrary.org/obo/uberon/core#mouse_subset>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0013631> "Sesamoids are often endochondral replacement elements and in addition to bone tissue, may also be composed of articular cartilage, fibrocartilage, hyaline cartilage, and calcified cartilage.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0013631> "sesamoid element")
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "VSAO") <http://purl.obolibrary.org/obo/UBERON_0013631> <http://purl.obolibrary.org/obo/UBERON_0010911>)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:17747") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Internal_orifice_of_the_uterus") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0013759> "internal os")

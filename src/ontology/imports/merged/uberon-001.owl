AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0010309> "palpebral bone")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0010309> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0001474> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001712>)))

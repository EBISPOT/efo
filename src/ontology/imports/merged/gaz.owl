# Class: <http://purl.obolibrary.org/obo/GAZ_00000013> (continent)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GAZ_00000013> "One of the large, unbroken masses of land into which the Earth's surface is divided.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GAZ_00000013> "GAZ:00190836")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GAZ_00000013> "FTT:540")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GAZ_00000013> "GeoNames:CONT")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GAZ_00000013> "TGN:21402")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GAZ_00000013> "TGN:29000")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GAZ_00000013> "CONTIN")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GAZ_00000013> "Continent {alternative name}")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GAZ_00000013> "continent {alternative name}")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GAZ_00000013> "continental region")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GAZ_00000013> "major area")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GAZ_00000013> "GAZ")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GAZ_00000013> "GAZ:00000013")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GAZ_00000013> "continent")
SubClassOf(<http://purl.obolibrary.org/obo/GAZ_00000013> <http://purl.obolibrary.org/obo/GAZ_00000448>)

# Class: <http://purl.obolibrary.org/obo/GAZ_00000448> (geographic location)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GAZ_00000448> "A reference to a place on the Earth, by its name or by its geographical location.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GAZ_00000448> "GAZ:00000467")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GAZ_00000448> "geographic region {alternative name}")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GAZ_00000448> "GAZ")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GAZ_00000448> "GAZ:00000448")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GAZ_00000448> "geographic location")
SubClassOf(<http://purl.obolibrary.org/obo/GAZ_00000448> <http://purl.obolibrary.org/obo/BFO_0000141>)



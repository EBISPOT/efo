# Object Property: <http://purl.obolibrary.org/obo/pr#lacks_part> (lacks_part)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:DAN") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/pr#lacks_part> "A negation of the has_part relation.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/pr#lacks_part> "protein")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/pr#lacks_part> "lacks_part")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#is_transitive> <http://purl.obolibrary.org/obo/pr#lacks_part> "false"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/pr#lacks_part> "lacks_part")




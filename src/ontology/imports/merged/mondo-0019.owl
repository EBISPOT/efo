AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:C98873") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019012> "An extremely rare autosomal recessive syndrome characterized by premature closure of cranial sutures leading to cone-shaped head, fusion of the digits, and the presence of more digits than normal. It may be associated with heart defects, single horseshoe-shaped kidney, short stature, undescended testes, and mild mental retardation.")

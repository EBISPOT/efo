# Class: <http://purl.obolibrary.org/obo/MONDO_0019033> (primary cutis verticis gyrata)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:671") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0019033> "Cutis verticis gyrata (CVG) is a progressive cutaneous disorder predominantly affecting males and characterized by hypertrophy and thickening of the skin of the scalp forming convoluted furrows with deep, tender, and cerebriform cutaneous folds. Hair is usually normal in the furrows and sparse on the folds. CG can be isolated (essential CVG) or associated with other abnormalities such as intellectual deficit, epilepsy, cataract, blindness, and deafness (non essential CVG).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0019033> "GARD:0001643")

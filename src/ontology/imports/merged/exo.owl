# Class: <http://purl.obolibrary.org/obo/ExO_0000000> (exposure stressor)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "CTD:curators") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ExO_0000000> "An agent, stimulus, activity, or event that causes stress or tension on an organism and interacts with an exposure_receptor during an exposure event.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/ExO_0000000> "2010-09-21T02:43:50Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/ExO_0000000> "exposure_stressor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ExO_0000000> "ExO:0000000")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ExO_0000000> "exposure stressor")
SubClassOf(<http://purl.obolibrary.org/obo/ExO_0000000> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002434> <http://purl.obolibrary.org/obo/ExO_0000001>))

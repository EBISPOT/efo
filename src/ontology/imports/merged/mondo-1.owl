AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1060216> "TSEN2-related neurodevelopmental disorder with or without thrombotic microangiopathy")
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://clinicalgenome.org/affiliation/40069/") <http://purl.obolibrary.org/obo/MONDO_1060216> <http://purl.obolibrary.org/obo/MONDO_0002254>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_1060216> <http://purl.obolibrary.org/obo/MONDO_0100500>)


AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MONDO:patterns/disease_series_by_gene") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0001-9310-0163") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1060165> "Any neutropenia in which the cause of the disease is a mutation in the ELANE gene.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_1060165> "https://github.com/monarch-initiative/mondo/issues/9459"^^xsd:anyURI)

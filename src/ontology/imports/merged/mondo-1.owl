AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27076228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28302518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicalgenome.org/affiliation/40080") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1060136> "A group of disorders caused by a variation in PIK3R1 gene that produces a structurally altered but present p85α protein, disrupting PI3K signaling and leading to features such as immune deficiency, autoimmunity, short stature, and distinct facial and skeletal features.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_1060136> "https://github.com/monarch-initiative/mondo/issues/9011"^^xsd:anyURI)

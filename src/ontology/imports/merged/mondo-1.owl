# Class: <http://purl.obolibrary.org/obo/MONDO_1060244> (THG1L-related epileptic encephalopathy)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33682303") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0001-9310-0163") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1060244> "Any genetic developmental and epileptic encephalopathy in which the cause of the disease is a biallelic variation in the THG1L gene, characterized by profound developmental delay, microcephaly, intractable epilepsy, and cerebellar hypoplasia.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_1060244> "https://github.com/monarch-initiative/mondo/issues/10172"^^xsd:anyURI)

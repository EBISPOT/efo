AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_1010145> "This is a distinct entity from MONDO:0012656 lethal congenital contractural syndrome 3.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1010145> "PIP5K1C-related neurodevelopmental disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_1010145> <http://purl.obolibrary.org/obo/MONDO_0100500>)


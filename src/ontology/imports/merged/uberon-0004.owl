# Class: <http://purl.obolibrary.org/obo/UBERON_0004301> (middle phalanx)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://orcid.org/0000-0002-6601-2165") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0004301> "A phalanx located between proximal and distal phalanges.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0004301> "consider using numbering system, and axioms to the effect that there is a single middle phalanx per finger in humans. This should perhaps be renamed 'intermediate phalanx', leaving the term middle phalanx open for the specific intermediate phalanx of a 3-phalanx digit")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "WP") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0004301> "Intermediate phalanges are bones found in the limbs of most vertebrates. In humans, they are the bones of the finger and toe which lie in the middle, between the two wrinkly joints. The thumb and big toe do not have intermediate phalanges. In most other vertebrates, they have a corresponding place in their limbs, whether they be paw, wing, hoof or fin")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0004301> "in some groups such as whales, there are multiple intermediate phalanges")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0004301> "AAO:0010677")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0004301> "EMAPA:35572")

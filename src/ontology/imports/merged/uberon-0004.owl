AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "WP") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0004771> "Fish don't have choanae, instead they have two pairs of external nostrils")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0004771> "In addition to tetrapods, the lungfish has internal nostrils too. In tetrapods the exhalant nostril (choana) empties into the buccal cavity.")

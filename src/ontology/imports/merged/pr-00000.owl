AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000000701> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000000701> "modulatory voltage-gated potassium channel subunit KCNG")

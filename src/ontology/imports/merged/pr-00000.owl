AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000001355> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000001355> "immunoglobulin gamma Fc receptor II/III/IV")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000001355> <http://purl.obolibrary.org/obo/CHEBI_36080>)


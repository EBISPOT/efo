AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000001810> "CSF-1/PDGF receptor-type tyrosine-protein kinase")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000001810> <http://purl.obolibrary.org/obo/CHEBI_36080>)


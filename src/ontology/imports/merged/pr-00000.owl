AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000000675> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000000675> "platelet-derived growth factor with CUB domain")

# Class: <http://purl.obolibrary.org/obo/PR_000000002> (E3 ubiquitin ligase SFC complex Skp1 subunit)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:CNA") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000000002> "A protein that has a core domain composition consisting of an N-terminal Skp1 family, tetramerisation domain (Pfam:PF03931) followed by a Skp1 family, dimerisation domain (Pfam:PF01466). Skp1 proteins bind several F-box-containing proteins, and are involved in the ubiquitin protein degradation pathway.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PR_000000002> "PIRSF:PIRSF028729")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/PR_000000002> "protein")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PR_000000002> "PR:000000002")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000000002> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000000002> "E3 ubiquitin ligase SFC complex Skp1 subunit")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000000002> <http://purl.obolibrary.org/obo/CHEBI_36080>)

# Class: <http://purl.obolibrary.org/obo/PR_000000003> (HLH DNA-binding protein inhibitor)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20219281") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:CNA") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000000003> "A protein that belongs to the clade D of the bHLH proteins (see PMID:20219281) with a core domain composition consisting of a helix-loop-helix DNA-binding domain (Pfam:PF00010) (HLH), common to the basic HLH family of transcription factors, but lacking the DNA binding domain to the consensus E box response element (CANNTG). By binding to basic HLH transcription factors, proteins in this class regulate gene expression.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20219281") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/PR_000000003> "bHLH clade D")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8018712") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/PR_000000003> "bHLH class V")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PR_000000003> "PIRSF:PIRSF005808")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000000003> "DNA-binding protein inhibitor ID")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/PR_000000003> "protein")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PR_000000003> "ID protein")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PR_000000003> "PR:000000003")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000000003> "Category=family.")

# Class: <http://purl.obolibrary.org/obo/PR_000003505> (leukocyte granule-associated proteinase)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11790262") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7952649") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8929545") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000003505> "A trypsin that is a serine protease of the granules from mast cells, cytotoxic T lymphocytes and/or natural killer cells. Leukocyte granule-associated proteinase is a component of the immune system that protect higher organisms against viral infection and cellular transformation. Members of this class have features that are strongly conserved including: consensus sequences at their N-termini and around the three catalytic residues, activation from zymogenic forms, and conserved disulphide bridges.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/PR_000003505> "protein")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PR_000003505> "PR:000003505")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000003505> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000003505> "leukocyte granule-associated proteinase")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000003505> <http://purl.obolibrary.org/obo/PR_000027795>)


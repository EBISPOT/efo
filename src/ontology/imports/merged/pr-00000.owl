AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000001785> "prominin")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000001785> <http://purl.obolibrary.org/obo/CHEBI_36080>)


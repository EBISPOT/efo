AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000000024> "Rho-associated protein kinase")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000000024> <http://purl.obolibrary.org/obo/CHEBI_36080>)

# Class: <http://purl.obolibrary.org/obo/PR_000000025> (ribosomal protein S6 kinase beta)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:CNA") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000000025> "A protein that specifically phosphorylates ribosomal protein S6 in response to insulin and other mitogens. It has a core domain composition consisting of a Protein kinase domain (Pfam:PF00069) followed by a Protein kinase C terminal domain (Pfam:PF00433).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PR_000000025> "PIRSF:PIRSF000605")

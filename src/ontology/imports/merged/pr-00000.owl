# Class: <http://purl.obolibrary.org/obo/PR_000001044> (cystic fibrosis transmembrane conductance regulator)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9922375") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:CNA") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000001044> "A chloride channel protein that is a translation product of the human CFTR gene or a 1:1 ortholog thereof. Involved in the transport of chloride ions. The characteristic domain composition of the functional isoform consists of two modules of a membrane-spanning domain (ABC transporter transmembrane region) followed by a nucleotide-binding domain (ABC transporter domains), separated by an intracellular regulatory domain (R-domain). It also contains a C-terminal PDZ-binding region. The R-domain is an inhibitory domain of CFTR, and phosphorylation of the R-domain removes this inhibition, allowing activation of chloride flux.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PR_000001044> "IUPHARobj:707")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PR_000001044> "PIRSF:PIRSF002777")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000001044> "ATP-binding cassette sub-family C member 7")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000001044> "ATP-binding cassette transporter sub-family C member 7")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:DNx") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/pr#PRO-short-label>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000001044> "CFTR")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000001044> "cAMP-dependent chloride channel")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000001044> "channel conductance-controlling ATPase")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/PR_000001044> "protein")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/pr#Gene-based>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PR_000001044> "ABCC7")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PR_000001044> "PR:000001044")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000001044> "Category=gene. Note: The open conformation of the CFTR channel is stabilized via interaction of its N-terminal region with other proteins, most notably filamin. [PRO:DAN, PMID:29779042]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000001044> "cystic fibrosis transmembrane conductance regulator")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000001044> <http://purl.obolibrary.org/obo/PR_000044678>)


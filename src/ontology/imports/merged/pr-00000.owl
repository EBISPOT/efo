AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000000019> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000000019> "mitogen-activated protein kinase")

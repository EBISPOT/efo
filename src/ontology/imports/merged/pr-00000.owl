AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/PR_000001407> "carcinoma antigen GA733")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PR_000001407> "PR:000001407")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000001407> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000001407> "tumor-associated calcium signal transducer")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000001407> <http://purl.obolibrary.org/obo/CHEBI_36080>)


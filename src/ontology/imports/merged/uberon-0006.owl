AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BTO:0001232") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006530> "seminal plasma")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31287811") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35203131") Annotation(rdfs:comment "CURATOR NOTE A secretion from the glands of the male reproductive system in some aquatic animals that contains sperm and is sprayed onto the eggs.") <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/UBERON_0006530> "milt")

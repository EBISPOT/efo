# Class: <http://purl.obolibrary.org/obo/UBERON_0006597> (quadrate bone)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "AAO:0000525") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Quadrate_bone") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0006597> "Ossified pars articularis of the palatoquadrate cartilage.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/UBERON_0006597> <http://purl.obolibrary.org/obo/NCBITaxon_40674>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "TAO:0000621") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0006597> "In snakes, the quadrate bone has become elongated and very mobile, and contributes greatly to their ability to swallow very large prey items. In mammals the articular and quadrate bones have migrated to the middle ear and are known as the malleus and incus.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0006597> "Endochondral bone that commonly articulates with the ectopterygoid anteriorly, the metapterygoid dorsally, and the symplectic postero-medially. The quadrate is formed from the posterior part of the palatoquadrate cartilage, or pars quadrata. The quadrate is a paired bone.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VHOG:0000689") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/UBERON_0006597> "quadrate - incus")

SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0002-5002-8648") <http://purl.obolibrary.org/obo/MONDO_0013576> <http://purl.obolibrary.org/obo/MONDO_0003847>)

# Class: <http://purl.obolibrary.org/obo/SO_0000104> (polypeptide)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "SO:ma") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/SO_0000104> "A sequence of amino acids linked by peptide bonds which may lack appreciable tertiary structure and may not be liable to irreversible denaturation.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/SO_0000104> "SO:0000358")
AnnotationAssertion(Annotation(rdfs:label "wiki") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/SO_0000104> "http://en.wikipedia.org/wiki/Polypeptide")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/SO_0000104> "protein")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/SO_0000104> "sequence")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/SO_0000104> "SO:0000104")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/SO_0000104> <http://purl.obolibrary.org/obo/so#SOFA>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/SO_0000104> "This term is mapped to MGED. Do not obsolete without consulting MGED ontology. The term 'protein' was merged with 'polypeptide'. Although 'protein' was a sequence_attribute and therefore meant to describe the quality rather than an actual feature, it was being used erroneously. It is replaced by 'peptidyl' as the polymer attribute.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/SO_0000104> "polypeptide")
SubClassOf(<http://purl.obolibrary.org/obo/SO_0000104> <http://purl.obolibrary.org/obo/SO_0001411>)
SubClassOf(<http://purl.obolibrary.org/obo/SO_0000104> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/so#derives_from> <http://purl.obolibrary.org/obo/SO_0000316>))


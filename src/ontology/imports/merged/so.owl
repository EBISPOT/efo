AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/SO_0000010> "protein_coding")
SubClassOf(<http://purl.obolibrary.org/obo/SO_0000010> <http://purl.obolibrary.org/obo/SO_0000401>)


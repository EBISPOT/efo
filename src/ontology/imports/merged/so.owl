# Class: <http://purl.obolibrary.org/obo/SO_0000185> (primary_transcript)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "SO:ma") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/SO_0000185> "A transcript that in its initial state requires modification to be functional.")
AnnotationAssertion(Annotation(rdfs:label "wiki") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/SO_0000185> "http://en.wikipedia.org/wiki/Primary_transcript")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/SO_0000185> "INSDC_feature:prim_transcript")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/SO_0000185> "primary transcript")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/SO_0000185> "sequence")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/SO_0000185> "SO:0000185")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/SO_0000185> <http://purl.obolibrary.org/obo/so#SOFA>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/SO_0000185> "See \"precursor_RNA\" (SO:0002393) for RNA which may be the result of post-transcriptional processing. If the RNA in question is known not to have been processed, use this class (\"primary_transcript\"). On 9 Sep 2025, Removed \"has_exact_synonym : INSDC_feature:precursor_RNA\" and \"has_exact_synonym : precursor RNA\" from the annotation for this class at the request of Terence Murphy of NCBI. See GitHub Issue #655.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/SO_0000185> "primary_transcript")
SubClassOf(<http://purl.obolibrary.org/obo/SO_0000185> <http://purl.obolibrary.org/obo/SO_0000673>)


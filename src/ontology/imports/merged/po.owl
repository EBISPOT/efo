AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0471245194") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0005848> "A portion of xylem (PO:0005352) tissue that develops from a vascular cambium (PO:0005598).")

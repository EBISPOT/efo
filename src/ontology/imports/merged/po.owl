SubClassOf(<http://purl.obolibrary.org/obo/PO_0009005> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/PO_0025025>))
SubClassOf(<http://purl.obolibrary.org/obo/PO_0009005> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/PO_0005029>))


# Class: <http://purl.obolibrary.org/obo/PO_0020037> (mesocotyl)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0471244554") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "POC:Laurel_Cooper") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PO_0020037> "A stem internode (PO:0020142) that is the part of a plant embryo axis (PO:0019018) or a seedling stem (PO:0009047) above the scutellum (PO:0020110) and below the coleoptile (PO:0020033).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PO_0020037> "PO_GIT:343")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "POC:Maria_Alejandra_Gandolfo") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/po#Spanish>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0020037> "mesoc&#243tile (Spanish, exact)")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NIG:Yukiko_Yamazaki") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/po#Japanese>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PO_0020037> "中胚軸 (Japanese, exact)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/PO_0020037> "plant_anatomy")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PO_0020037> "PO:0020037")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PO_0020037> "Occurs in grasses. In grasses, the hypocotyl and cotyledon may not be visible and may be represented by the scutellar node and scutellum, making the mesocotyl similar to the epicotyl in other taxa. Elongation of the mesocotyl during seedling growth pushes the coleoptile above the soil surface.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PO_0020037> "mesocotyl")
SubClassOf(<http://purl.obolibrary.org/obo/PO_0020037> <http://purl.obolibrary.org/obo/PO_0020142>)


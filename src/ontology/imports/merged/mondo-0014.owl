AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GARD:0027859") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0014337> <http://purl.obolibrary.org/obo/mondo#gard_rare>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0014337> <http://purl.obolibrary.org/obo/mondo#rare>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0014337> "A tubulinopathy syndrome often associated with microtubule dysfunction, malformations of the corpus callosum, enlarged ventricles, dysgyria, abnormal basal ganglia, cerebellar vermis hypoplasia/dysplasia, and decreased white matter, due to heterozygous variants in TUBB2A. Individuals may present with variable combinations of malformations of the corpus callosum, enlarged ventricles, dysgyria, abnormal basal ganglia, cerebellar vermis hypoplasia/dysplasia, and decreased white matter. Epilepsy, speech impairment, and motor impairment are also frequent features.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0014337> "complex cortical dysplasia with other brain malformations 5")

# Class: <http://purl.obolibrary.org/obo/MONDO_0011109> (multiple epiphyseal dysplasia, Lowry type)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:166016") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0011109> "Multiple epiphyseal dysplasia, Lowry type is a rare primary bone dysplasia characterized by small, flat epiphyses (esp. the capital femoral epiphyses), rhizomelic shortening of limbs, cleft of secondary palate, micrognathia, mild joint contractures and facial dysmorphism (incl. mildly upward-slanting palpebral fissures, hypertelorism, broad nasal tip). Additionally reported features include scoliosis, genu valgum, mild pectus excavatum, platyspondyly, dislocated radial heads, brachydactyly, hypoplastic fibulae and talipes equinovarus.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0011109> "GARD:0017013")

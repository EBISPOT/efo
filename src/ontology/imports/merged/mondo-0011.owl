AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOID:0050814") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21129728") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.orpha.net/consor/cgi-bin/OC_Exp.php?lng=EN&Expert=363417") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.sciencedirect.com/science/article/pii/S1769721213002449") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0011533> "An autosomal recessive disease that is characterized by brachydactyly, hyperphalangism of digits, facial dysmorphism, dental anomalies, sensorineural hearing loss, delayed motor and mental development, and growth retardation and has material basis in homozygous mutation in the CHSY1 gene.")

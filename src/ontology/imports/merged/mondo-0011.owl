AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOID:0081362") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "OMIM:602342") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:487825") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0011213> "Pierpont syndrome")

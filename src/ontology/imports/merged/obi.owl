AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/OBI_0003099> "https://github.com/obi-ontology/obi/issues/1406")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0003099> "matrix assisted laser desorption ionization imaging mass spectrometry assay")
SubClassOf(<http://purl.obolibrary.org/obo/OBI_0003099> <http://purl.obolibrary.org/obo/OBI_0000470>)

# Class: <http://purl.obolibrary.org/obo/OBI_0003100> (multiplexed ion beam imaging assay)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/OBI_0003100> <http://purl.obolibrary.org/obo/IAO_0000120>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBI_0003100> "A cytometry time of flight assay in which molecules of interest on or in cells are imaged through a system in which samples are labeled with multiple different rare-earth tagged antibodies. A primary ion beam is ued to rasterize sections under vacuum, releasing showers of secondary ions detected by cytometry time of flight mass spectrometry."@en)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OBI_0003100> "Michelle Giglio")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OBI_0003100> "Rebecca Jackson")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/OBI_0003100> "Suvarna Nadendla")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/OBI_0003100> "https://github.com/obi-ontology/obi/issues/1407")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBI_0003100> "multiplexed ion beam imaging assay")
SubClassOf(<http://purl.obolibrary.org/obo/OBI_0003100> <http://purl.obolibrary.org/obo/OBI_0002115>)

# Class: <http://purl.obolibrary.org/obo/OBI_0003105> (single-cell combinatorial indexing RNA sequencing assay)


AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:352636") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018128> "Phalangeal microgeodic syndrome is a rare primary osteolysis characterized by multiple small osteolytic areas and sclerosis in the phalanges of one or both hands associated with swelling and redness of the phalanges. Condition is benign, self-limited and may be associated with cold exposure.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0018128> "GARD:0021524")

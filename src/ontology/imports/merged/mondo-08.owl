AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "OMIM:145420") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:1519") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0800025> "Brachycephalofrontonasal dysplasia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0800025> "craniofrontonasal dysplasia, Teebi type")

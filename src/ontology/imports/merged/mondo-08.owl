# Class: <http://purl.obolibrary.org/obo/MONDO_0800466> (disorder of GNAS inactivation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29072892") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicalgenome.org/affiliation/40060/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0800466> "Any endocrine system disorder in which the cause of the disease is inactivation of the GNAS gene. Phenotypes include pseudohypoparathyroidism Ia, Ib, and Ic (PHP-Ia, -Ib, -Ic), pseudopseudohypoparathyroidism (PPHP), progressive osseous heteroplasia (POH), and osteoma cutis (OC).")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_0800466> "https://github.com/monarch-initiative/mondo/issues/6882"^^xsd:anyURI)

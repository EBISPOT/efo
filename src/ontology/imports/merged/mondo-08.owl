AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0800456> "SYNCRIP-related neurodevelopmental disorder")
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:34157790") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0001-9310-0163") <http://purl.obolibrary.org/obo/MONDO_0800456> <http://purl.obolibrary.org/obo/MONDO_0100500>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0800457> (HNRNPC-related neurodevelopmental disorder)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MONDO:patterns/disease_series_by_gene") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37541189") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0001-9310-0163") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0800457> "Any neurodevelopmental disorder in which the cause of the disease is a variation in the HNRNPC gene. It is characterized by global developmental delay, intellectual disability, behavioral abnormalities, and subtle facial dysmorphism. It is caused by heterozygous HNRNPC germline variants.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_0800457> "https://github.com/monarch-initiative/mondo/issues/6964"^^xsd:anyURI)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27606499") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32499606") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34953066") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700324> "A human disease in which the cause of the disease is a variation in the SMAD6 gene, and characterized by craniosynostosis with congenital heart disease and/or radioulnar synostosis.")

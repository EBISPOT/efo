AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0700116> "MONDO:0700116")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GARD:0026362") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0700116> <http://purl.obolibrary.org/obo/mondo#gard_rare>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0700116> <http://purl.obolibrary.org/obo/mondo#rare>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700116> "microcephaly with lissencephaly and/or hydranencephaly")
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://www.clinicalgenome.org/affiliation/40020/") <http://purl.obolibrary.org/obo/MONDO_0700116> <http://purl.obolibrary.org/obo/MONDO_0001149>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0700116> <http://purl.obolibrary.org/obo/MONDO_0100500>)

# Class: <http://purl.obolibrary.org/obo/MONDO_0700117> (SLC6A3-related dopamine transporter deficiency syndrome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21112253") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24613933") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28749637") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicalgenome.org/affiliation/40097/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700117> "A complex movement disorder characterized by tremor, rigidity, bradykinesia, chorea, reduced facial expression, and Parkinsonism-dystonia. This disease is caused by loss of function variants in the SLC6A3 gene, which impair the dopamine transporter protein. The onset of this disease ranges from infancy to adulthood.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_0700117> "https://github.com/monarch-initiative/mondo/issues/5523"^^xsd:anyURI)

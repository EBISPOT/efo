# Class: <http://purl.obolibrary.org/obo/MONDO_0700325> (Parkes Weber syndrome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:90307") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0700325> "A rare congenital complex vascular malformation syndrome characterized by overgrowth of a limb (most commonly a leg) involving bones and soft tissue, in association with capillary malformations usually in the form of port-wine stains and multiple arteriovenous fistulas with high-flow arteriovenous shunting. The latter can also lead to other severe complications including abnormal bleeding and heart failure. Lymphatic malformations may also be present.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_0700325> "https://github.com/monarch-initiative/mondo/issues/9816"^^xsd:anyURI)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:MEDGEN") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:equivalentTo") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0700325> "MEDGEN:1808056")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:equivalentTo") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0700325> "Orphanet:90307")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MEDGEN:1808056") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:MEDGEN") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:equivalentTo") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0700325> "UMLS:C5574870")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "doi:10.1097/JOVA.0000000000000076") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0001-9310-0163") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/mondo#ABBREVIATION>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0700325> "PWS")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0700325> "MONDO:0700325")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Orphanet:90307") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0700325> <http://purl.obolibrary.org/obo/mondo#ordo_disorder>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Orphanet:90307") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0700325> <http://purl.obolibrary.org/obo/mondo#orphanet_rare>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0700325> <http://purl.obolibrary.org/obo/mondo#rare>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0700325> "OMIM merged its original \"Parkes Weber syndrome\" (PWS) entry (OMIM:608355) into 'capillary malformation-arteriovenous malformation 1' (CM-AVM1, MONDO:0020783, OMIM:608354); they mention that it is a specific type of CMAVM. However, PWS is a distinct clinical syndrome with documented genetic overlap with CM-AVM1 (RASA1; not all PWS cases are caused by variation in RASA1) and potentially CM-AVM2 (EPHB4). PWS patients present with distinctive clinical features: a large congenital cutaneous capillary malformation (port-wine stain) affecting an entire limb, combined with multiple micro-AVFs and excessive soft-tissue and skeletal overgrowth of that affected limb. This limb overgrowth—involving both bone and soft tissue—is the defining feature that distinguishes Parkes Weber syndrome from other CM-AVM1 presentations. [https://orcid.org/0000-0001-9310-0163, DOI:10.1097/JOVA.0000000000000076]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0700325> "Parkes Weber syndrome")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0700325> <http://identifiers.org/medgen/1808056>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0700325> <http://linkedlifedata.com/resource/umls/id/C5574870>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0700325> <http://www.orpha.net/ORDO/Orphanet_90307>)
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "doi:10.1097/JOVA.0000000000000076") <http://purl.obolibrary.org/obo/MONDO_0700325> <http://purl.obolibrary.org/obo/MONDO_0024287>)


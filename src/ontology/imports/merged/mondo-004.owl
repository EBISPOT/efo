AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "OMIM:617875") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24706814") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0044327> "An autosomal dominant disease characterized by adult-onset of liver cysts arising from the bile duct epithelium, caused by heterozygous mutation in the LRP5 gene. Some patients may develop a few kidney cysts, but these are often incidental and do not result in renal failure.")

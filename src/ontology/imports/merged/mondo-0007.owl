AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:C130993") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0007478> "An autosomal dominant form of Kenny-Caffey Syndrome due to mutation(s) in the FAM111A gene, encoding protein FAM111A. This condition is characterized by transient hypocalcemia, delayed closure of the anterior fontanel, eye anomalies, including microphthalmia, proportionate short stature, and cortical thickening and medullary stenosis of the tubular bones.")

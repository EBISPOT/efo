# Class: <http://purl.obolibrary.org/obo/UBERON_0008199> (chin)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAO:0002254") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Chin") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0008199> "A subdivision of the face that is the anteriormost part of the lower jaw region.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0008199> "mental")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0008199> "In humans, the chin is the lowermost part of the face. It is formed by the lower front of the mandible. The chin developed as a point of muscular attachment facilitating minute movements of the lips associated with speech. In human evolution, the chin is a cladistic apomorphy, partially defining anatomically modern Humans as distinct from archaic forms")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MA:th") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0008199> "EMAPA:37827")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Dorsal_venous_arch_of_the_foot") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0008783> "The dorsal venous arch of the foot is a superficial vein that connects the small saphenous vein and the great saphenous vein. Anatomically, it is defined by where the dorsal veins of the first and fifth digit, respectively, meet the great saphenous vein and small saphenous vein.")

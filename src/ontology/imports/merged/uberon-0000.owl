SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0000934> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BSPO_0005001> <http://purl.obolibrary.org/obo/UBERON_0013235>))

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0000001> "gross anatomical part")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0000001> <http://purl.obolibrary.org/obo/UBERON_0000465>)

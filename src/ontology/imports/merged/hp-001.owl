# Class: <http://purl.obolibrary.org/obo/HP_0011587> (Abnormal branching pattern of the aortic arch)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:DDD_dbrown") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011587> "A deviance from the norm of the origin or course of the right brachiocephalic artery, the left common carotid artery, the left subclavian artery or the proximal vertebral arteries.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011587> "2012-04-08T01:34:42Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011587> "HP:0011587")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011587> "The normal aortic arch crosses the left mainstem bronchus and descends in the left paravertebral gutter. The coronary arteries arise from the aortic sinuses. The first branch of the aorta is normally the right brachiocephalic artery, then the left common carotid artery, then the left subclavian artery. Abnormal branching refers to any deviance from the norm of the origin or course of these branches or the proximal vertebral arteries. An anomaly of the aortic arch that results in complete encirclement of the trachea and esophagus by vascular structures is a vascular ring.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011587> "Abnormal branching pattern of the aortic arch")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011587> <http://purl.obolibrary.org/obo/HP_0012303>)

# Class: <http://purl.obolibrary.org/obo/HP_0011590> (Double aortic arch)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:DDD_dbrown") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15148283") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15564538") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011590> "A conenital abnormality of the aortic arch in which the two embryonic aortc arches form a vascular ring that surrounds the trachea or esophagus and then join to form the descending aorta. Double aortic arch can cause symptoms because of compression of the esophagus (dysphagia, cyanosis while eating) or trachea (stridor).")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011590> "2012-04-08T01:46:10Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/HP_0011590> "Fyler:2761")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011590> "HP:0011590")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011590> "Double aortic arch")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011590> <http://purl.obolibrary.org/obo/HP_0011587>)


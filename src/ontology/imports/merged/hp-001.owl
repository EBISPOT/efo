AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010804> "2010-06-26T02:32:35Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0010804> "HP:0100895")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010804> "Inverted V-shaped upper lip")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0010804> "Tented mouth")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0010804> "Tented upper lip")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010804> "HP:0010804")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010804> "This finding is distinguished from an Exaggerated Cupid's bow by the alteration of the shape of the oral aperture.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010804> "Tented upper lip vermilion")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010804> <http://purl.obolibrary.org/obo/HP_0011339>)


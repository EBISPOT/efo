# Class: <http://purl.obolibrary.org/obo/HP_0011926> (Proximal placement of hallux)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011926> "Proximal mislocalization of the big toe from its normal position.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011926> "2012-06-09T03:29:59Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011926> "Proximal placement of big toe")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011926> "Proximally placed halluces")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011926> "HP:0011926")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011926> "Thumb placement index greater than 0.55; or, the base of the thumb appears closer to the wrist than is typical. The technique for the thumb placement index is described in detail [Malina et al., 1973; Hall et al., 2007]. Briefly, the thumb placement index is the distance from the proximal crease of the index finger to the angle of the first interdigital space divided by the distance from the proximal crease of the index finger to the wrist flexion crease at the base of the thumb. This term should not be used with Preaxial polydactyly.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011926> "Proximal placement of hallux")

# Class: <http://purl.obolibrary.org/obo/HP_0011298> (Prominent digit pad)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011298> "A soft tissue prominence of the ventral aspects of the fingertips or toe tips.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011298> "2012-02-11T07:18:29Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011298> "Prominent digit pad")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011298> "HP:0011298")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011298> "The prominence of the finger or toe pads varies throughout life, being greater in neonates and dependent on the state of hydration. This term should not be used if the digit has clubbing. Note that the synonym \"fetal fingertip pads\" should not be interpreted to mean that the prominent pad necessarily was present in this individual since fetal life. We do not endorse the use of the term \"Persistent fetal pads\" as this term implies knowledge of the natural history of this finding, which may or may not be known.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011298> "Prominent digit pad")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011298> <http://purl.obolibrary.org/obo/HP_0011356>)

# Class: <http://purl.obolibrary.org/obo/HP_0011300> (Broad fingertip)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011300> "Increased width of the distal segment of a finger.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011300> "2012-02-11T11:18:08Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011300> "Broad fingertip")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-5316-1399>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011300> "Broad fingertips")

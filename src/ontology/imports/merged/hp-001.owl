AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011841> "If untreated, ventricular flutter typically progresses to ventricular fibrillation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011841> "Ventricular flutter")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011841> <http://purl.obolibrary.org/obo/HP_0031676>)


AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0012269> "Glycogen functions as a secondary short term energy storage in muscle.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0012269> "Abnormal muscle glycogen content")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0012269> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000070> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CHEBI_28087> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001630>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011193> "EEG with focal sharp transient waves of a duration less than 80 msec.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011193> "2011-11-19T10:50:36Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011193> "HP:0011193")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011193> "EEG with focal spikes")

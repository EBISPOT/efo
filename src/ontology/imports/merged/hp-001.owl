AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0012257> "Absent inner dynein arms")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0012257> <http://purl.obolibrary.org/obo/HP_0200106>)


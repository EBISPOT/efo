AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010813> "Extra hair swirls")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010813> "Extra hair whorl")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010813> "Supernumary hair swirls")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010813> "Supernumary hair whorl")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010813> "HP:0010813")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010813> "Most individuals have one clockwise hair whorl at a single point on the scalp lateral to the midline but close to the vertex of the skull. Five percent of the population has two whorls. A double hair whorl is sometimes referred to as a double crown. In 10%, whorl direction is counter-clockwise.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010813> "Abnormal number of hair whorls")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0010813> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000070> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0014381>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010813> <http://purl.obolibrary.org/obo/HP_0010721>)

# Class: <http://purl.obolibrary.org/obo/HP_0010814> (Abnormal position of hair whorl)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125436") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010814> "Hair growth from a single point on the scalp in any location other than lateral to the midline and close to the vertex of the skull.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010814> "2010-07-05T11:13:42Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010814> "Abnormal location of hair swirl")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010814> "Abnormal position of hair whorl")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010814> "HP:0010814")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010814> "Placement of hair whorl should be described as parietal, vertex, eccentric, etc. In addition, the number of hair whorls should be noted. Five percent of the population has two whorls.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010814> "Abnormal position of hair whorl")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0010814> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000140> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0014381>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010814> <http://purl.obolibrary.org/obo/HP_0010721>)

# Class: <http://purl.obolibrary.org/obo/HP_0010815> (Nevus sebaceous)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010815> "A congenital, hairless plaque consisting of overgrown epidermis, sebaceous glands, hair follicles, apocrine glands and connective tissue. They are a variant of epidermal naevi. Sebaceous naevi most often appear on the scalp, but they may also arise on the face, neck or forehead. At birth, a sevaceous nevus typically appears as a solitary, smooth, yellow-orange hairless patch. Sebaceous naevi become more pronounced around adolescence, often appearing bumpy, warty or scaly.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010815> "2010-07-10T12:07:03Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010815> "Naevus sebaceous")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010815> "Organoid nevus")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010815> "Sebaceous mole")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010815> "Sebaceous naevus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010815> "Sebaceous nevus")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010815> "HP:0010815")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010815> "Nevus sebaceous")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010815> <http://purl.obolibrary.org/obo/HP_0010816>)

# Class: <http://purl.obolibrary.org/obo/HP_0010816> (Epidermal nevus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20542174") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010816> "Epidermal naevi are due to an overgrowth of the epidermis and may be present at birth (50%) or develop during childhood.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010816> "2010-07-10T12:12:32Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0010816> "Epidermal nevi")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010816> "HP:0010816")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010816> "Epidermal nevus arises from a defect in the ectoderm and in general are due to an overgrowth of keratinocytes. Subclasses of epidermal nevus include Linear epidermal naevus, epidermolytic epidermal naevus, acantholytic epidermal naevus, linear porokeratosis, and systematized epidermal naevus. Several other conditions are also characterized by benign overgrowth of the epidermis and its appendages (organoid naevi), including inflammatory linear verrucous epidermal naevus, sebaceous naevus, sweat gland naevi, comedone naevus, and Becker naevus.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010816> "Epidermal nevus")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010816> <http://purl.obolibrary.org/obo/HP_0003764>)

# Class: <http://purl.obolibrary.org/obo/HP_0010818> (Generalized tonic seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11580774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276064") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010818> "A generalized tonic seizure is a type of generalized motor seizure characterized by bilateral limb stiffening or elevation, often with neck stiffening without a subsequent clonic phase. The tonic activity can be a sustained abnormal posture, either in extension or flexion, sometimes accompanied by tremor of the extremities.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010818> "2010-07-10T03:03:51Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0010818> "HP:0002184")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010818> "Generalised hypertonic seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010818> "Generalised tonic seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010818> "Generalised tonic seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010818> "Generalized hypertonic seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010818> "Generalized tonic seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0010818> "Hypertonic seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010818> "HP:0010818")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010818> "Characterized by a sudden increase in muscle tone whereby the body, arms, or legs make sudden stiffening movements and consciousness is usually preserved. Tonic seizures can occur during sleep. Tonic seizures usually affect both sides of the body, and cause a fall if the affected person was standing when the seizure started.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010818> "Generalized tonic seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010818> <http://purl.obolibrary.org/obo/HP_0032677>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010818> <http://purl.obolibrary.org/obo/HP_0032792>)

# Class: <http://purl.obolibrary.org/obo/HP_0010819> (Atonic seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-1735-8178>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11580774") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010819> "Atonic seizure is a type of motor seizure characterized by a sudden loss or diminution of muscle tone without apparent preceding myoclonic or tonic event lasting about 1 to 2 seconds, involving head, trunk, jaw, or limb musculature.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010819> "2010-07-10T03:13:06Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0010819> "HP:0002124")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010819> "Astatic seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010819> "Astatic seizures")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010819> "Atonic seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010819> "Drop attacks")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010819> "Drop seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010819> "Hypotonic seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0010819> "Hypotonic seizures")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0010819> "Sudden loss of muscle tone")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010819> "HP:0010819")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010819> "This term describes the initial semiology of the seizure without specifying whether the onset is focal or generalized. Thus it can be used for coding atonic seizures when the onset is not known.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010819> "Atonic seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010819> <http://purl.obolibrary.org/obo/HP_0020219>)


# Class: <http://purl.obolibrary.org/obo/HP_0011705> (First degree atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:DDD_dbrown") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011705> "Delay of conduction through the atrioventricular node, which is manifested as prolongation of the PR interval in the electrocardiogram (EKG). All atrial impulses reach the ventricles.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011705> "2012-04-11T07:17:18Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011705> "HP:0011705")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011705> "The conduction of the cardiac impulse through the atrioventricular node is manifested in the EKG by the PR interval, which is normally less that 200 milliseconds in adults. Normal values are age-dependent in children, but normal values are less that 160 milliseconds in young children.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011705> "First degree atrioventricular block")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011705> <http://purl.obolibrary.org/obo/HP_0001678>)

# Class: <http://purl.obolibrary.org/obo/HP_0011706> (Second degree atrioventricular block)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:DDD_dbrown") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011706> "An intermittent atrioventricular block with failure of some atrial impulses to conduct to the ventricles, i.e., some but not all atrial impulses are conducted through the atrioventricular node and trigger ventricular contraction.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011706> "2012-04-11T07:22:35Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011706> "HP:0011706")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011136> "Absent sweat glands")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011136> "Lack of sweat glands")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011136> "HP:0011136")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011136> "Aplasia of the sweat glands")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0011136> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001483> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/UBERON_0001820>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011136> <http://purl.obolibrary.org/obo/HP_0011135>)

# Class: <http://purl.obolibrary.org/obo/HP_0011138> (Abnormal skin adnexa morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011138> "An abnormality of the skin adnexa (skin appendages), which are specialized skin structures located within the dermis and focally within the subcutaneous fatty tissue, comprising three histologically distinct structures: (1) the pilosebaceous unit (hair follicle and sebaceous glands); (2) the eccrine sweat glands; and (3) the apocrine glands.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011138> "2011-06-19T06:25:34Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011138> "Abnormal skin appendage")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011138> "Abnormality of skin adnexa morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011138> "HP:0011138")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011138> "Abnormal skin adnexa morphology")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0011138> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0006003>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011138> <http://purl.obolibrary.org/obo/HP_0001574>)

# Class: <http://purl.obolibrary.org/obo/HP_0011139> (Gastric duplication)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011139> "Gastric duplication is a usually cystic malformation of gastrointestinal tract, usually attached to the greater curvature of the stomach and has no communication with the stomach.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011139> "2011-06-25T08:57:09Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011139> "Gastric duplication cyst")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011139> "HP:0011139")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011139> "Gastric duplication usually presents as gastric outlet obstruction. They are usually spherical in form, do not communicate with the stomach, and are generally localized at the greater curvature. In some cases they may exhibit adhesion to the pancreas and even communicate with aberrant pancreatic ducts. Gastric duplication is more frequent in females. It is generally either diagnosed in infancy because of symptoms of gastric outlet obstruction or is an incidental finding in adulthood.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011139> "Gastric duplication")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0011139> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001473> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002314> <http://purl.obolibrary.org/obo/UBERON_0000945>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011139> <http://purl.obolibrary.org/obo/HP_0002577>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011139> <http://purl.obolibrary.org/obo/HP_0011140>)

# Class: <http://purl.obolibrary.org/obo/HP_0011140> (Gastrointestinal duplication)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21218094") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011140> "A spherical hollow structure with a smooth muscle coat, lined by a mucous membrane, and attached to any part of the gastrointestinal tract, from the base of the tongue to the anus.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011140> "2011-06-25T09:02:50Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#abbreviation>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011140> "GI duplication")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011140> "HP:0011140")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011140> "Gastrointestinal duplication")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0011140> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001473> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0005409>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011140> <http://purl.obolibrary.org/obo/HP_0012718>)

# Class: <http://purl.obolibrary.org/obo/HP_0011141> (Age-related cataract)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15708105") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011141> "A type of cataract (opacification of the lens) that forms during the course of aging.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011141> "2011-06-27T09:41:38Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011141> "Clouding of the lens of the eye with age")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011141> "HP:0011141")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011141> "The lens is formed from ectodermal tissue and contains epithelial cells that give rise to lens fibers throughout life, so with increasing age the lens becomes more compact and thicker.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011141> "Age-related cataract")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011141> <http://purl.obolibrary.org/obo/HP_0000518>)

# Class: <http://purl.obolibrary.org/obo/HP_0011142> (Age-related nuclear cataract)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15708105") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011142> "A type of age-related cataract that primarily affects the nucleus of the lens.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011142> "2011-06-27T09:49:20Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011142> "HP:0011142")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011142> "As the lens ages, new layers of fibers are added and the lens nucleus is compressed and becomes harder (nuclear sclerosis cataract), with associated yellowing of the lens. Nuclear sclerosis typically progresses slowly.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011142> "Age-related nuclear cataract")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011142> <http://purl.obolibrary.org/obo/HP_0011141>)

# Class: <http://purl.obolibrary.org/obo/HP_0011143> (Age-related cortical cataract)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15708105") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011143> "A type of age-related cataract that primarily affects the cortex of the lens.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011143> "2011-06-27T09:50:54Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011143> "HP:0011143")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011143> "The cortex of the lens is made of the newest lens fibers. With aging, discrete opacities can develop within the cortex of the lens that typically cause no visual symptoms unless they involve the visual axis or the entire cortex, in which case the lens becomes white and is said to be mature.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011143> "Age-related cortical cataract")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011143> <http://purl.obolibrary.org/obo/HP_0011141>)

# Class: <http://purl.obolibrary.org/obo/HP_0011146> (Dialeptic seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9738682") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011146> "A dialeptic seizure is a type of seizure characterized predominantly by reduced responsiveness or awareness and with subsequent at least partial amnesia of the event.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011146> "2011-10-18T01:47:30Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011146> "Behavioral arrest seizure with impairment of awareness irrespective of onset")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011146> "Behavioural arrest seizure with impairment of awareness irrespective of onset")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011146> "Unknown onset behavioral arrest seizure with impairment of awareness")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011146> "Unknown onset behavioural arrest seizure with impairment of awareness")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011146> "HP:0011146")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011146> "The main ictal manifestation of dialeptic seizures is an alteration of consciousness rather than motor or sensory features. The term describes the pure clinical semiology of a seizure and is used independently of the ictal electrographic findings: it could describe a seizure of focal, generalized or unknown onset. In 2017 the ILAE Commission for Classification and Terminology recommended classifying a seizure as having focal or generalized onset only when there is a high degree of confidence (>80%, arbitrarily chosen to parallel the usual allowable beta error) in the accuracy of this determination.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011146> "Dialeptic seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011146> <http://purl.obolibrary.org/obo/HP_0001250>)

# Class: <http://purl.obolibrary.org/obo/HP_0011147> (Typical absence seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276062") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276064") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:6790275") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011147> "A typical absence seizure is a type of generalized non-motor (absence) seizure characterized by its sudden onset, interruption of ongoing activities, a blank stare, possibly a brief upward deviation of the eyes. Usually the patient will be unresponsive when spoken to. Duration is a few seconds to half a minute with very rapid recovery. Although not always available, an EEG would usually show 3 Hz generalized epileptiform discharges during the event.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011147> "2011-10-18T01:52:22Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011147> "Typical absence")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011147> "Typical absence seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011147> "HP:0011147")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011147> "In 2017 the ILAE Commission for Classification and Terminology recommended classifying a seizure as having focal or generalized onset only when there is a high degree of confidence (>80%, arbitrarily chosen to parallel the usual allowable beta error) in the accuracy of this determination; see Dialeptic seizure. Typical absences have 2 essential components: (1) clinically the impairment of consciousness (absence), and (2) EEG generalized 3 Hz to 4 Hz (less than 2.5 Hz) spike and slow wave discharges.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011147> "Typical absence seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011147> <http://purl.obolibrary.org/obo/HP_0002121>)

# Class: <http://purl.obolibrary.org/obo/HP_0011150> (Myoclonic absence seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-8486-0558>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276062") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276064") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9637609") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011150> "Myoclonic absence seizure is a type of generalized non-motor (absence) seizure characterized by an interruption of ongoing activities, a blank stare and rhythmic three-per-second myoclonic movements, causing ratcheting abduction of the upper limbs leading to progressive arm elevation, and associated with 3 Hz generalized spike-wave discharges on the electroencephalogram. Duration is typically 10-60 s. Whilst impairment of consciousness may not be obvious the ILAE classified this seizure as a generalized non-motor seizure in 2017.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011150> "2011-10-18T02:04:35Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011150> "Myoclonic absence")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011150> "Myoclonic absences")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011150> "HP:0011150")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011150> "Myoclonic absence seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011150> <http://purl.obolibrary.org/obo/HP_0002121>)

# Class: <http://purl.obolibrary.org/obo/HP_0011152> (Early onset absence seizures)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-8486-0558>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011152> "Typical absence seizures starting before the age of 4 years.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011152> "2011-10-18T02:12:41Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-6908-9849>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011152> "Early onset petit mal seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011152> "HP:0011152")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011152> "Early onset absence seizures")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011152> <http://purl.obolibrary.org/obo/HP_0011147>)

# Class: <http://purl.obolibrary.org/obo/HP_0011153> (Focal motor seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-1735-8178>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11580774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276064") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011153> "A type of focal-onset seizure characterized by a motor sign as its initial semiological manifestation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011153> "2011-10-18T02:33:17Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011153> "Focal motor seizures")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011153> "Localised motor seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011153> "Localised motor seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011153> "Localized motor seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-6908-9849>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011153> "Localized motor seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011153> "Partial motor seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-6908-9849>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011153> "Partial motor seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011153> "Segmental motor seizure")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011153> "HP:0011153")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011153> "A motor onset seizure involves motor activity (movement) and may be due to either an increase or decrease in contraction in a muscle or group of muscles. Depending on the muscle groups involved and the way they are affected, the movement features of a motor onset seizure may be simple or more complex.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011153> "Focal motor seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011153> <http://purl.obolibrary.org/obo/HP_0007359>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011153> <http://purl.obolibrary.org/obo/HP_0020219>)

# Class: <http://purl.obolibrary.org/obo/HP_0011157> (Focal sensory seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-1511-5893>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276062") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276064") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011157> "A focal sensory seizure is a type seizure beginning with a subjective sensation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011157> "2011-10-18T02:26:40Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011157> "Focal sensory seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011157> "Partial sensory seizure")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011157> "Sensory aura")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011157> "HP:0011157")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011157> "A focal sensory seizure involves a sensation being experienced at seizure onset, without objective clinical signs of a seizure evident to the observer.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011157> "Focal sensory seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011157> <http://purl.obolibrary.org/obo/HP_0033348>)

# Class: <http://purl.obolibrary.org/obo/HP_0011163> (Focal sensory seizure with somatosensory features)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011163> "A seizure characterized by sensory phenomena including tingling, numbness, electric-shock like sensation, pain, sense of movement, or desire to move as its first clinical manifestation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011163> "2011-10-18T02:29:52Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011163> "Focal somatosensory seizure")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011163> "Partial somatosensory seizure")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011163> "Somatosensory aura")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011163> "Somatosensory auras")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011163> "HP:0011163")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011163> "These seizures involve the sensorimotor cortex.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011163> "Focal sensory seizure with somatosensory features")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011163> <http://purl.obolibrary.org/obo/HP_0011157>)

# Class: <http://purl.obolibrary.org/obo/HP_0011170> (Generalized myoclonic-atonic seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276064") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011170> "A generalized myoclonic-atonic seizure is a type of generalized motor seizure characterized by a myoclonic jerk followed by an atonic motor component.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011170> "2011-11-19T10:00:46Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011170> "Generalised myoclonic-atonic seizure")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011170> "Myoclonic atonic seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011170> "Myoclonic-astatic seizure")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011170> "HP:0011170")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011170> "A myoclonic-tonic seizure was previously called a myoclonic-astatic seizure. ILAE2017 does not currently consider myoclonic-atonic seizures to be a form of myoclonic seizure which is why it is classified as a motor seizure.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011170> "Generalized myoclonic-atonic seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011170> <http://purl.obolibrary.org/obo/HP_0032677>)

# Class: <http://purl.obolibrary.org/obo/HP_0011172> (Complex febrile seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125841") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:972656") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011172> "A febrile seizure that has any of the following features: focal semiology (or associated with post-ictal neurologic abnormalities beyond drowsiness, such as a Todd's paresis), prolonged seizure beyond 15 minutes, or recurring (occurring more than once) in a 24 hour period.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011172> "2011-11-19T10:10:00Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011172> "Complex febrile convulsion")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#plural_form>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011172> "Complex febrile seizures")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011172> "Complex fever fit")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011172> "HP:0011172")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011172> "Children presenting with a prolonged seizure stopped with anticonvulsive therapy (i.e., diazepam) before the 15th minute should be classified within this group.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011172> "Complex febrile seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011172> <http://purl.obolibrary.org/obo/HP_0002373>)

# Class: <http://purl.obolibrary.org/obo/HP_0011182> (Interictal epileptiform activity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011182> "Epileptiform activity refers to distinctive EEG waves or complexes distinguished from background activity found in in a proportion of human subjects with epilepsy, but which can also be found in subjects without seizures. Interictal epileptiform activity refers to such activity that occurs in the absence of a clinical or subclinical seizure.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011182> "2011-11-19T10:32:25Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011182> "Epileptiform EEG discharges")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011182> "HP:0011182")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011182> "Epileptiform EEG discharges include small sharp spikes (SSSs), wicket spikes, 14- and 6-Hz positive spikes, phantom spike and waves, psychomotor variant, subclinical rhythmic EEG discharges of adults (SREDA), and midline theta rhythm.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011182> "Interictal epileptiform activity")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011182> <http://purl.obolibrary.org/obo/HP_0025373>)

# Class: <http://purl.obolibrary.org/obo/HP_0011185> (EEG with focal epileptiform discharges)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011185> "EEG discharges recorded in particular areas of a localized (focal) abnormality in cerebral electrical activity recorded along the scalp by electroencephalography (EEG).")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011185> "2011-11-19T10:39:02Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0011185> "HP:0010840")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011185> "Focal EEG Abnormality")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011185> "HP:0011185")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011185> "Note that a focal EEG abnormality is not synonymous with \"focal epileptiform discharges\" because a focal EEG abnormality is not necessarily epileptiform (e.g., it could be a focal slowing).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011185> "EEG with focal epileptiform discharges")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011185> <http://purl.obolibrary.org/obo/HP_0011182>)

# Class: <http://purl.obolibrary.org/obo/HP_0011189> (Bilateral multifocal epileptiform discharges)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011189> "Epileptiform discharges being identified at multiple locations in both hemispheres.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011189> "2011-11-19T10:47:23Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011189> "HP:0011189")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011189> "Bilateral multifocal epileptiform discharges")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011189> <http://purl.obolibrary.org/obo/HP_0010841>)


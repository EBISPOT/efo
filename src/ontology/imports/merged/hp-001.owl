# Class: <http://purl.obolibrary.org/obo/HP_0011995> (Atrial septal dilatation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7758185") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011995> "A bulging of the interatrial septum towards one side. In adults, atrial septal aneurysm can be defined as a protrusion of the aneurysm of >10 mm beyond the plane of the atrial septum as measured by transesophageal echocardiography.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011995> "2012-07-19T11:35:07Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/HP_0011995> "Atrial septal aneurysm")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011995> "HP:0011995")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011995> "Atrial septal aneurysm formation may be secondary to raised interatrial pressure gradients, producing a bulging septal shift toward the low-pressure side. However, it has been also found in patients with normal atrial pressures, suggesting a primary (congenital) malformation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011995> "Atrial septal dilatation")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011995> <http://purl.obolibrary.org/obo/HP_0011994>)

# Class: <http://purl.obolibrary.org/obo/HP_0011999> (Paranoia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34618805") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011999> "The feeling and belief that one is being targeted or is a focus of negative or untoward actions, overt or covert, from others. The affected individual expresses a concern that people are in general against the individual and are engaging in subtle behaviors to make things difficult for them. The origins of such thinking may arise from real events and become amplified over time. Paranoia may also arise in the absence of any action or interaction between the person and their environment.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0011999> <https://orcid.org/0000-0001-7062-8192>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0011999> <https://orcid.org/0000-0001-7941-2961>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0011999> <https://orcid.org/0000-0001-9221-9226>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0011999> <https://orcid.org/0000-0002-0183-1637>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0011999> <https://orcid.org/0000-0003-1785-7126>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0011999> <https://orcid.org/0000-0003-2291-6952>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0011999> <https://orcid.org/0000-0003-4958-6025>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011999> "2012-07-19T01:00:23Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011999> "Paranoia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011999> "HP:0011999")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011999> "Paranoia is defined as a non-delusional state characterized by a vague sense that 'everyone and anyone' is unfavorable towards one as in 'the whole world hates me'. A persecutory delusion is, in contrast, typically fixed and focused - as in 'my neighbor is pumping poison into my house'.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011999> "Paranoia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011999> <http://purl.obolibrary.org/obo/HP_5200242>)


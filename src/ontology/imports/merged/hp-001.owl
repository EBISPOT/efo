AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0012760> "HP:5200103")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0012760> "HP:5200131")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012760> "Impaired social interaction")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012760> "Impaired social interactions")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-9112-5148>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-4142-7153>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-6670-9157>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-9593-5508>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012760> "Impaired social reciprocity")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012760> "Poor social interactions")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0012760> "HP:0012760")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0012760> "Reciprocity can be assessed by determining the extent to which a child demonstrates activity similar to that of peers or of the examiner (e.g., playing the same game), shows turn-taking behavior, or recognizes the intentions of the other person and contributes to an activity that a peer or the examiner has initiated. In the diagnostic process, it may be difficult to decide whether limitations in social behavior of children with intellectual disability (ID) are due to a co-occurring autism spectrum disorder (ASD) and are often unduly attributed to the ID, a phenomenon also known as diagnostic overshadowing. This term is intended to apply to impaired social reciprocity that is not attributed to ID.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0012760> "Reduced social responsiveness")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0012760> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001236> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/NBO_0000011>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

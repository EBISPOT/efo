AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0012185> "Constrictive median neuropathy is the major clinical feature of carpal tunnel syndrome.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0012185> "Constrictive median neuropathy")

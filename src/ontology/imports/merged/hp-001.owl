AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010877> "HP:0010877")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010877> "Monocular strabismus")

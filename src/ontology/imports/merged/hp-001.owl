# Class: <http://purl.obolibrary.org/obo/HP_0011198> (EEG with generalized epileptiform discharges)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "HPO_CONTRIBUTOR:jalbers") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011198> "EEG discharges recorded on the entire scalp typically seen in persons with epilepsy.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011198> "2011-11-19T11:15:46Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0011198> "HP:0010842")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011198> "EEG with generalised epileptiform discharges")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011198> "HP:0011198")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011198> "Spikes (<70 ms) and sharp waves (70-200 ms) are sharp transient waves that have a strong association with epilepsy. No difference is noted in terms of clinical significance of spikes and sharp waves. Significant spikes usually are followed by a slow wave.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011198> "EEG with generalized epileptiform discharges")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011198> <http://purl.obolibrary.org/obo/HP_0011182>)


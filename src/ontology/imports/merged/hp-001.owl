AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012668> "Situational syncope")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012668> "Vasovagal episode")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0012668> "HP:0012668")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0012668> "Vasovagal syncope")

# Class: <http://purl.obolibrary.org/obo/HP_0010926> (Aculeiform cataract)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10521291") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9718335") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010926> "A kind of nuclear cataract characterized by fiberglasslike or needlelike crystals projecting in different directions, through or close to the axial region of the lens.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010926> "2010-12-19T03:47:35Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010926> "Fasciculiform cataract")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010926> "Frosted cataract")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010926> "Needle-shaped cataract")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010926> "HP:0010926")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010926> "This phenotype is characterized by fiberglasslike or needlelike crystals projecting in different directions, through or close to the axial region of the lens. Some crystals may be 11 mm in length, and their biochemical composition is not known. This type of cataract is considered to be different from the corraliform cataract, which does not show the needlelike projections. This opacity does not appear to respect the sutures or the direction of the lens fibers (Francois 1963) and appears to originate from the fetal and postnatal nuclei, suggesting a congenital origin with some postnatal progression, if any. See Figure 1 of PMID:10521291.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010926> "Aculeiform cataract")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010926> <http://purl.obolibrary.org/obo/HP_0100018>)


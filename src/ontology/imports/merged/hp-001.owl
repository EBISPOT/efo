# Class: <http://purl.obolibrary.org/obo/HP_0012520> (Dilation of Virchow-Robin spaces)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17620468") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23867200") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25564639") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0012520> "Increased dimensions of the Virchow-Robin spaces (also known as perivascular spaces), which surround the walls of vessels as they course from the subarachnoid space through the brain parenchyma. Perivascular spaces are commonly microscopic, and not visible on conventional neuroimaging. This term refers to an increase of size of these spaces such that they are visible on neuroimaging (usually magnetic resonance imaging). The dilatations are regular cavities that always contain a patent artery.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0012520> "2013-12-09T07:17:47Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012520> "Dilated Virchow-Robin spaces")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012520> "Perivascular spaces")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0012520> "Dilated cerebral perivascular spaces")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0012520> "HP:0012520")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0012520> "Virchow-Robin spaces are commonly seen at magnetic resonance imaging. These perivascular spaces as fluid-filled spaces that follow the typical course of a vessel as it goes through gray or white matter. The spaces have signal intensity similar to that of cerebrospinal fluid (CSF) on all magnetic resonance sequences.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0012520> "Dilation of Virchow-Robin spaces")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0012520> <http://purl.obolibrary.org/obo/HP_0100659>)


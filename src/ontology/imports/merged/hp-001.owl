# Class: <http://purl.obolibrary.org/obo/HP_0012255> (Dynein arm defect of respiratory motile cilia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19606528") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0012255> "An anomaly of the dynein arms of motile cilia. This feature is usually appreciated by electron microscopy.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0012255> "2013-04-07T09:20:03Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0012255> "HP:0012255")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0012255> "The peripheral microtubules in the canonical 9 + 2 microtubular pattern of motile cilia are studded with dynein arms that contain adenosine triphosphatases and act as molecular motors to effect the sliding of the peripheral microtubular pairs relative to one another.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0012255> "Dynein arm defect of respiratory motile cilia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0012255> <http://purl.obolibrary.org/obo/HP_0005938>)


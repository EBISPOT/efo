AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010614> "HP:0010614")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010614> "Fibroma")

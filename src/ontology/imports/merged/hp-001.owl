AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010759> "Prominence of the intermaxillary bone")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010759> "Prominence of the primary palate bone")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010759> "Prominent premaxilla")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010759> "HP:0010759")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010759> "As a consequence of prominence of the premaxilla, the overlying structures, the nose and philtrum, may appear prominent. There is increased convexity of the face and an increased nasolabial angle. In the presence of a normal sized mandible, retrognathia may be appreciated.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010759> "Prominence of the premaxilla")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0010759> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001482> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0002244>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

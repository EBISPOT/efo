AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/HP_0010316> "ICD-10:Q22.5")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010316> "Ebstein's anomaly")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010316> "Ebstein's anomaly of the tricuspid valve")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010316> "Ebstein's malformation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010316> "HP:0010316")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010316> "Ebstein's anomaly is often associated with a hypoplastic right ventricle, patent foramen ovale, and a degree of cyanosis dependent on the amount if inadequacy of the tricuspid valve. Ebstein's anomaly may be associated with Wolf-Parkinson-White syndrome or other arrythmias.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010316> "Ebstein anomaly of the tricuspid valve")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010316> <http://purl.obolibrary.org/obo/HP_0001702>)


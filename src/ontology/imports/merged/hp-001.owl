# Class: <http://purl.obolibrary.org/obo/HP_0012470> (Setting-sun eye phenomenon)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17030938") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0012470> "An ophthalmologic sign in young children resulting from upward-gaze paresis. In this condition, the eyes appear driven downward, the sclera may be seen between the upper eyelid and the iris, and part of the lower pupil may be covered by the lower eyelid.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0012470> "2013-11-26T05:40:01Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012470> "Setting-sun eye phenomenon")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012470> "Sun setting eyes")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0012470> "Sunsetting eye")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0012470> "Eyes fixed downward")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0012470> "HP:0012470")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0012470> "Setting-sun eye phenomenon can also be transiently elicited in healthy infants up to 7 months of age by changes of position or removal of light (benign setting-sun phenomenon). When persistent, this sign is one of the most frequent markers of elevated intracranial pressure.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0012470> "Setting-sun eye phenomenon")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0012470> <http://purl.obolibrary.org/obo/HP_0000597>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010550> "HP:0010550")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010550> "Paraplegia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010550> <http://purl.obolibrary.org/obo/HP_0010551>)

# Class: <http://purl.obolibrary.org/obo/HP_0010551> (Paraplegia/paraparesis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010551> "Weakness of both lower extremities with sparing of the upper extremities. Paraplegia refers to a severe or complete loss of strength, whereas paraparesis refers to a relatively mild loss of strength.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010551> "2009-10-01T08:36:05Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010551> "HP:0010551")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010551> "Paraplegia/paraparesis")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010551> <http://purl.obolibrary.org/obo/HP_0010549>)

# Class: <http://purl.obolibrary.org/obo/HP_0010554> (Cutaneous finger syndactyly)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010554> "A soft tissue continuity in the A/P axis between two fingers that extends distally to at least the level of the proximal interphalangeal joints, or a soft tissue continuity in the A/P axis between two fingers that lies significantly distal to the flexion crease that overlies the metacarpophalangeal joint of the adjacent fingers.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010554> "2009-10-07T10:59:57Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0010554> "HP:0001214")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0010554> "HP:0005637")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0010554> "HP:0006054")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0010554> "HP:0006220")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010554> "Cutaneous syndactyly of fingers")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010554> "Cutaneous syndactyly of hands")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16200145") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010554> "Webbed fingers")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010554> "Webbed skin of fingers")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010554> "HP:0010554")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010554> "We have set an arguably arbitrary threshold to distinguish the object form the subjective finding. While severe degrees of cutaneous syndactyly are clearly objective, more subtle degrees are subjective. We set this threshold to distinguish these two situations. The digits (or parts of) are joined together by tissue that is not normally present between the digits at that point in the P/D axis. A modifier of \"complete\" may be used if the cutaneous syndactyly extends to the distal end of the nail bed of the digits. The affected digits should be specified. Note that the unqualified term \"syndactyly\" is no longer allowed as it is unclear whether this refers to bony or cutaneous syndactyly.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010554> "Cutaneous finger syndactyly")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010554> <http://purl.obolibrary.org/obo/HP_0006101>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010554> <http://purl.obolibrary.org/obo/HP_0012725>)

# Class: <http://purl.obolibrary.org/obo/HP_0010557> (Overlapping fingers)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19125433") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010557> "A finger resting on the dorsal surface of an adjacent digit when the hand is at rest.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010557> "2009-10-13T09:21:52Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010557> "HP:0010557")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0010557> "Overlapping of the fingers occurring as the result of a deviation of the fingers from their normal position. Fingers that are laterally deviated, but do not rest on top of adjacent fingers should be coded as Clinodactyly.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010557> "Overlapping fingers")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0010557> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001590> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0002389>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002503> <http://purl.obolibrary.org/obo/UBERON_0002389>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010557> <http://purl.obolibrary.org/obo/HP_0004097>)

# Class: <http://purl.obolibrary.org/obo/HP_0010564> (Bifid epiglottis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0010564> "A midline anterior-posterior cleft of the epiglottis that involves at least two-thirds of the epiglottic leaf. It is a useful feature for clinical diagnosis because it appears to be very rare in syndromes other than Pallister-Hall-Syndrome and is also rare as an isolated malformation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0010564> "2009-10-16T02:20:48Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010564> "HP:0010564")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010564> "Bifid epiglottis")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0010564> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000403> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0000388>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010564> <http://purl.obolibrary.org/obo/HP_0005483>)

# Class: <http://purl.obolibrary.org/obo/HP_0010565> (Aplasia/Hypoplasia of the Epiglottis)


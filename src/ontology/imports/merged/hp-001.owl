# Class: <http://purl.obolibrary.org/obo/HP_0011089> (Double tooth)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-9338-3017>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31468724") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0011089> "Fusion of two adjacent teeth.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0011089> "2011-03-11T02:13:26Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5889-4463>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011089> "Conjoined teeth")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011089> "Double tooth")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011089> "Teeth, double")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0011089> "Twinning tooth")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0011089> "HP:0011089")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0011089> "The fusion can be complete or be limited to the crown or the root. Typically, incisors and canines form double teeth. Double teeth are more common in the deciduous dentition and rare in the permanent dentition. Double teeth encompasses fusion, concrescence, and gemination of teeth, which some authors describe with the twinning.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0011089> "Double tooth")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0011089> <http://purl.obolibrary.org/obo/HP_0006482>)


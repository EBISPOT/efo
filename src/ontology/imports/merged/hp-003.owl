# Class: <http://purl.obolibrary.org/obo/HP_0032190> (Abnormal meniscus morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26488288") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032190> "Abnormal structure of the meniscus of the knee, two crescent shape fibrocartilaginous pads that disperse the weight of the body and reduce friction of the knee joint during movement.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032190> "2019-01-15T11:29:05Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032190> "The meniscus is a fibrocartilaginous structure of the knee joint that enables the even distribution of a weight-bearing load across the articular surfaces. The menisci bear between 40 to 70% of the load across the knee, and the rest of the load is transmitted directly to the articular cartilage.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032190> "Abnormal meniscus morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032190> <http://purl.obolibrary.org/obo/HP_0034669>)

# Class: <http://purl.obolibrary.org/obo/HP_0032199> (Abnormal prothrombin time)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29939529") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032199> "Any deviation from the normal amount of time to coagulation in the prothrombin time test, which is a measure of the extrinsic pathway of coagulation. The results of the prothrombin time test are often expressed in terms of the International normalized ratio (INR), which is calculated as a ratio of the patient's prothrombin time (PT) to a control PT standardized for the potency of the thromboplastin reagent developed by the World Health Organization (WHO) using the formula: INR is equal to Patient PT divided by Control PT.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032199> "2019-01-19T15:34:30Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#abbreviation>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032199> "Abnormal PT")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032199> "Abnormal prothrombin time")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032199> <http://purl.obolibrary.org/obo/HP_0012200>)


# Class: <http://purl.obolibrary.org/obo/HP_0032479> (Preimplantation lethality)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27545678") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032479> "It is estimated that about 40-70 percent of human embryos produced in vitro fertilization (IVF) and intracytoplasmic sperm injection (ICSI) are viable embryos, whereas others arrest at different early stages of development. The phenotype of preimplantation lethality is inferred if IVF and ICSI cycles fail because all of an individual's embryos are arrested at early stages of development.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032479> "2019-04-09T12:33:42Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032479> "Early embryonic arrest")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032479> "Preimplantation embryonic lethality")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032479> "Preimplantation lethality")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032479> <http://purl.obolibrary.org/obo/HP_0033335>)

# Class: <http://purl.obolibrary.org/obo/HP_0032523> (Tendon thickening)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24932450") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032523> "An abnormal increase in the thickness (diameter) of a tendon.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032523> "2019-05-26T11:35:27Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032523> "Tendon thickening")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032523> <http://purl.obolibrary.org/obo/HP_0100261>)

# Class: <http://purl.obolibrary.org/obo/HP_0032547> (Low intraocular pressure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26253854") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032547> "An abnormal decrease of the pressure within the eye.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032547> "2019-06-12T10:37:45Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032547> "Ocular hypotony")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032547> "Ocular hypotony is defined statistically as an intraocular pressure (IOP) of less than 6.5 mmHg, three standard deviations below the mean. Clinically significant hypotony is when the IOP is so low that there is resultant visual loss. Hypotony has also been described as low pressure in an individual eye, leading to functional changes and structural changes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032547> "Low intraocular pressure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032547> <http://purl.obolibrary.org/obo/HP_0012632>)

# Class: <http://purl.obolibrary.org/obo/HP_0032565> (Vaginal mucosal ulceration)

AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032565> "2019-06-19T10:17:59Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18427055") rdfs:comment <http://purl.obolibrary.org/obo/HP_0032565> "A breach of the continuity of the mucous membrane of the vagina caused by sloughing out of inflamed necrotic tissue, usually associated with eschars (slough or piece of dead tissue) and with violaceous to erythematous borders.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032565> "Vaginal mucosal ulceration")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032565> <http://purl.obolibrary.org/obo/HP_0000142>)

# Class: <http://purl.obolibrary.org/obo/HP_0032572> (Abnormal urinary nucleobase concentration)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032572> "A deviation from the normal level of a nucleobase in the urine. Nucleobases are nitrogen-containing biological compounds that form nucleosides: adenine (A), cytosine (C), guanine (G), thymine (T), and uracil (U).")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032572> "2019-12-10T07:58:17Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032572> "Abnormal urinary nucleobase concentration")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0032572> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000470> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CHEBI_18282> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001088>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032572> <http://purl.obolibrary.org/obo/HP_0033354>)

# Class: <http://purl.obolibrary.org/obo/HP_0032581> (Abnormal renal interstitial morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25813241") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032581> "Any structural anomaly of the interstitium of the kidney. The renal interstitium is defined as the intertubular, extraglomerular, extravascular space of the kidney. It is bounded on all sides by tubular and vascular basement membranes and is filled with cells, extracellular matrix, and interstitial fluid.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032581> "2019-12-21T06:50:33Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032581> "Abnormal renal interstitial morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032581> <http://purl.obolibrary.org/obo/HP_0012210>)

# Class: <http://purl.obolibrary.org/obo/HP_0032599> (Abnormal renal tubular epithelial morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032599> "Any structural anomaly of the renal tubular epithelial cells (RTEC), a layer of cells in the outer layer of the renal tubule. These cells play a role in the absorption of substances such as glucose and amino from the primary urine.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032599> "2019-12-22T09:54:52Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032599> "Abnormal renal tubular epithelial morphology")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0032599> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000051> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000066> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001231>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032599> <http://purl.obolibrary.org/obo/HP_0000091>)


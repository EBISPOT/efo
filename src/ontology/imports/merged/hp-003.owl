# Class: <http://purl.obolibrary.org/obo/HP_0030016> (Dyspareunia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:1225983") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16391543") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030016> "Recurrent or persistent genital pain associated with sexual intercourse.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0030016> "In females, dyspareunia can develop secondary to medical problems such as vestibulitis, vaginal atrophy, or vaginal infection. It can be either physiologically or psychologically based, or a combination of the two. In males, dyspareunia may be related to conditions of the prepuce, glans penis, penile shaft, testicles, and urethra and prostate gland.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030016> "Dyspareunia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030016> <http://purl.obolibrary.org/obo/HP_0000080>)


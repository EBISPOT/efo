AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032436> "C-reactive protein (CRP) is produced by the liver, and increases in concentration in response to inflammation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032436> "Abnormal circulating C-reactive protein concentration")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0032436> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000070> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PR_P02741> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000178>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))

# Class: <http://purl.obolibrary.org/obo/HP_0030957> (Ventricular septal aneurysm)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030957> "A bowing (bulging to one side) of the interventricular septum of more than 15 mm on either side in adults and 5 mm in children during normal cardiac motion.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0030957> "2017-03-17T20:01:17Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/HP_0030957> "Ventricular septal dilatation")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0030957> "Interventricular septal aneuryms may involve either the membranous or muscular portion of the interventricular septum. Membranous interventricular septal aneurysm is more common.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030957> "Ventricular septal aneurysm")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030957> <http://purl.obolibrary.org/obo/HP_0010438>)

# Class: <http://purl.obolibrary.org/obo/HP_0030958> (Membranous ventricular septal aneurysm)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:5846101") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:6018320") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030958> "Bowing (bulging out) of the membranous part of the interventricular septum of more than 10-15 mm into the cavity of an adjacent ventricle (usually into the right ventricle).")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0030958> "2017-03-17T20:04:30Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/HP_0030958> "Fyler:2346")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-5208-3432>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0030958> "Interventricular septum membranous part aneurysm")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/HP_0030958> "Aneurysm of the membranous ventricular septum")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0030958> "The pars membranacea is the last portion of the septum formed in the fetus, is lo-cated between the left and right ventricles in front of the tricuspid valve, and between the left ventricle and the right atrium, behind the tricuspid valve. It lies in close proximity to the aortic and atrioventricular valves and is considered to be the weakest part of the ventricular septum. The aneurysms of the membranous portion usually measure 1 to 2 cm in all diameters and their walls are composed of fibrous tissue forming thick trabeculae when seen from the left ventricle. They can project into different portions of the right ventricle or right atrium.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030958> "Membranous ventricular septal aneurysm")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0030958> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000470> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MPATH_90> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0004666>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030958> <http://purl.obolibrary.org/obo/HP_0030957>)

# Class: <http://purl.obolibrary.org/obo/HP_0030961> (Microspherophakia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35015420") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030961> "Microspherophakia is a rare congenital anomaly characterized by the abnormal spherical shape of the crystalline lens. It is characterized by an increased anteroposterior thickness of the lens associated with reduced equatorial diameter. The primary pathology lies in the development of zonules. The condition is often bilateral and is characterized by small, thick, and spherical lenses.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0030961> "2017-04-18T12:55:01Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030961> "Microspherophakia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030961> <http://purl.obolibrary.org/obo/HP_0008063>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030961> <http://purl.obolibrary.org/obo/HP_0034375>)


# Class: <http://purl.obolibrary.org/obo/HP_0031508> (Abnormal circulating thyroid hormone concentration)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28932413") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031508> "Any deviation from the normal range of the hormones produced by the thyroid gland.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0031508> "2017-09-21T01:56:23Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031508> "Abnormal thyroid hormone level")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0031508> "Thyroid hormones (TH) are involved in the regulation of metabolism, proliferation, and growth of most tissues. Serum TH levels are tightly controlled by the hypothalamic, pituitary, and thyroid (HPT) axis to deliver appropriate amounts of TH to target tissues. The two major THs (T3 and T4) are iodothyrosines synthesized by the thyroid gland under the control of thyrotropin/thyroid stimulating hormone (TSH), a glycoprotein heterodimer that is produced by the pituitary gland. TSH, in turn, is regulated by thyrotropin releasing hormone (TRH), a tripeptide generated by the hypothalamus that is released into its own portal system to reach the pituitary. Both the production of TRH and TSH are under negative feedback control determined by the circulating free TH concentrations.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0031508> "Abnormal circulating thyroid hormone concentration")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0031508> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000070> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CHEBI_24431> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <http://purl.obolibrary.org/obo/CHEBI_60311>)) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000178>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0031508> <http://purl.obolibrary.org/obo/HP_0002926>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0031508> <http://purl.obolibrary.org/obo/HP_0003117>)


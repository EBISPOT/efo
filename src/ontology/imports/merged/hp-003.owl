AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032996> "Abnormal cystatin-C level")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032996> "The cysteine protease inhibitor cystatin C is thought to be secreted by most cells and eliminated in the kidneys, so its concentration in plasma is diagnostic of kidney function.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032996> "Abnormal circulating cystatin-C concentration")

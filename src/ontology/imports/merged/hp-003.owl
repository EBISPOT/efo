SubClassOf(<http://purl.obolibrary.org/obo/HP_0031657> <http://purl.obolibrary.org/obo/HP_0011025>)

# Class: <http://purl.obolibrary.org/obo/HP_0031676> (Monomorphic ventricular tachycardia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031676> "A type of ventricular tachycardia that is characterized by uniform QRS complexes within each lead (i.e., each QRS is identical or nearly so).")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0031676> "2017-12-17T17:06:28Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0031676> "Monomorphic VT originates from a single ventricular focus.")

# Class: <http://purl.obolibrary.org/obo/HP_0031034> (Abnormal circulating insulin-like growth factor-binding protein acid labile subunit concentration)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8816745") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031034> "Any deviation from the normal concentration of insulin-like growth factor-binding protein acid labile subunit in the blood circulation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0031034> "2017-05-27T11:20:49Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031034> "Abnormal insulin-like growth factor-binding protein complex acid labile subunit level")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0031034> "Insulin like growth factor binding protein acid labile subunit (IGFALS; Entrez Gene ID 3483) acts in the insulin-like growth (IGF) system by binding circulating IGF1 in a ternary complex with binding protein (IGFBP)-3 to prevent IGF1 from crossing the endothelial barrier. This term refers specifically to the circulating concentration of the acid-labile subunit.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0031034> "Abnormal circulating insulin-like growth factor-binding protein acid labile subunit concentration")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0031034> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000070> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PR_P35858> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000178>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0031034> <http://purl.obolibrary.org/obo/HP_0010876>)

# Class: <http://purl.obolibrary.org/obo/HP_0031038> (Spermatogenesis maturation arrest)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21684558") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031038> "Maturation arrest (MA) is defined as germ cells that fail to complete maturation. Uniform MA is characterized by spermatogenic arrest at the same stage of spermatogenesis throughout the seminiferous tubules. MA is subcategorized into early MA, in which only spermatogonia or spermatocytes are found, and late MA, in which spermatids are detected without spermatozoa.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0031038> "2017-05-27T11:49:05Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031038> "Meiotic maturation arrest of spermatogenesis")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0031038> "Maturation arrest (MA) of spermatogenesis is diagnosed on histology as interruption of spermatogenesis before the final stage without impairment of Sertoli or Leydig cells. It is considered a condition of irreversible or absolute infertility.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0031038> "Spermatogenesis maturation arrest")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0031038> <http://purl.obolibrary.org/obo/HP_0008669>)

# Class: <http://purl.obolibrary.org/obo/HP_0031039> (Spermatocyte maturation arrest)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21684558") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031039> "A type of spermatogenesis maturation arrest in which the block of developmental occurs in the spermatocyte stage. Testicular histology shows seminiferous tubules with Sertoli cells, spermatogonial cells and spermatocytes but no further differentiated cells like round spermatids.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0031039> "2017-05-27T11:50:54Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031039> "Spermatocyte arrest")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031039> "Spermatocyte meiotic arrest")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031039> "Spermatocytic arrest")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0031039> "Spermatocyte maturation arrest")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0031039> <http://purl.obolibrary.org/obo/HP_0031038>)

# Class: <http://purl.obolibrary.org/obo/HP_0031047> (Paraproteinemia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17403946") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031047> "An abnormal immunoglobulin or part of an Ig (light chain) in the circulation. Paraproteins are typically produced by a clonal population of B-cell derived plasma cells.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0031047> "2017-05-27T14:25:46Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031047> "Monoclonal hypergammaglobulinemia")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0031047> "A paraprotein is a monoclonal immunoglobulin or light chain present in the blood or urine; it is produced by a clonal population of mature B cells, most commonly plasma cells. Plasma cell disorders can be considered as a spectrum of conditions ranging from monoclonal gammopathy of undetermined significance (MGUS), through asymptomatic, to symptomatic myeloma. The frequency of paraprotein-associated heavy chains is IgG, IgA, IgM, IgD (in that order). Light chains may be kappa or lambda. Paraproteins are associated with both malignant and nonmalignant conditions and may lead to complications including neuropathy and nephropathy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0031047> "Paraproteinemia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0031047> <http://purl.obolibrary.org/obo/HP_0010702>)


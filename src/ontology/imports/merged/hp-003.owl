# Class: <http://purl.obolibrary.org/obo/HP_0030466> (Abnormal full-field electroretinogram)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32491415") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030466> "An anomaly observed by full-field electroretinogram (ffERG). The ffERG measures the light-induced electrical activity of the retina at the corneal surface. Specifically, the ffERG records the global or total retinal electrical response to a full-field (Ganzfield) light stimulus. Isolation of the rod and cone components has important diagnostic value in differentiating between various retinal diseases. Modifying the properties of the light-stimulus (wavelength, strength, and flicker rate) as well as the adaptive state of the retina can separate the rod and cone functions of the ffERG.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0030466> "The full-field electroretinogram (ffERG) is an ophthalmologic test that provides non-invasive objective quantitative measures of the electrical activity in the retina. The ffERG represents an electrical response from the retina to a flash of light and measures global retinal function.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030466> "Abnormal full-field electroretinogram")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030466> <http://purl.obolibrary.org/obo/HP_0000512>)

# Class: <http://purl.obolibrary.org/obo/HP_0030469> (Abnormal dark-adapted electroretinogram)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10532405") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030469> "An electroretinographic anomaly detected by dark-adapted full-field ERG. The dark adapted ERG targets rod-pathway function.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0030469> "After a period of dark adaptation (usually 20 to 30 minutes), the retinal rods reach peak sensitivity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030469> "Abnormal dark-adapted electroretinogram")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030469> <http://purl.obolibrary.org/obo/HP_0030466>)


# Class: <http://purl.obolibrary.org/obo/HP_0030242> (Portal vein thrombosis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21960890") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030242> "Thrombosis of the portal vein and/or its tributaries, which include the splenic vein and the superior and inferior mesenteric veins.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0001-6908-9849>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0030242> "Blood clot in portal vein")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0030242> "Portal vein thrombosis (PVT) can occur within the main portal vein, or it can occur in the branches of the portal vein within the liver itself. It can be an occluding thrombus or nonoccluding, with a clot present but continued blood flow through the vessel. The sequela of a long-standing PVT is cavernous formation of the portal vein, which represents bridging collaterals around the occlusion.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030242> "Portal vein thrombosis")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0030242> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/HP_0001977> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0002017>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030242> <http://purl.obolibrary.org/obo/HP_0030247>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030242> <http://purl.obolibrary.org/obo/HP_0031941>)


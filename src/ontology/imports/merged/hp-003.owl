AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0032162> <https://orcid.org/0000-0002-4315-9105>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0032162> <https://orcid.org/0009-0004-8124-8864>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032162> "2018-12-09T12:47:37Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032162> "Recurrent or unusual skin and mucous membrane infections are characteristic of T-cell deficiencies, phagocyte defects, and inborn errors of IL-17 immunity.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032162> "Unusual skin infection")

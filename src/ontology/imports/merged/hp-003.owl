# Class: <http://purl.obolibrary.org/obo/HP_0032647> (Renal tubular epithelial cell apoptosis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-2356-950X>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29537990") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032647> "Increased apoptosis (programmed cell death) of tubular epithelial cells. The cells are rounded with increased eosinophilia and contain fragmented, densely basophilic nuclear debris.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032647> "2020-02-09T09:38:49Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032647> "Renal tubular epithelial cell apoptosis")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032647> <http://purl.obolibrary.org/obo/HP_0032599>)

# Class: <http://purl.obolibrary.org/obo/HP_0032658> (Status epilepticus with prominent motor symptoms)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-1735-8178>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26336950") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032658> "Status epilepticus with prominent motor signs during the prolonged seizure.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032658> "2020-02-22T11:08:29Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032658> "Status epilepticus with prominent motor symptoms")

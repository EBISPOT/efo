# Class: <http://purl.obolibrary.org/obo/HP_0033258> (Sudden unexpected death in epilepsy)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-1735-8178>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-9588-2944>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22191982") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033258> "Sudden unexpected death in epilepsy (SUDEP) is a sudden, unexpected, witnessed or unwitnessed, non-traumatic and non-drowning death, occurring in benign circumstances, in an individual with epilepsy, with or without evidence for a seizure and excluding documented status epilepticus, in which postmortem examination has not revealed a cause of death.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0033258> "2020-11-28T14:34:03Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#abbreviation>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0033258> "SUDEP")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033258> "Sudden unexpected death in epilepsy")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033258> <http://purl.obolibrary.org/obo/HP_0001699>)

# Class: <http://purl.obolibrary.org/obo/HP_0033259> (Non-motor seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2827606") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033259> "A seizure with clinical manifestation but without motor signs (other than possible behavior arrest) as its initial clinical manifestation. The electrographic onset may be generalized, focal, or unknown.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0033259> "2020-11-28T14:43:08Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0033259> "This term may be used to code the non-motor seizures of a person who cannot confirm or exclude subjective seizure experiences that would aid more detailed classification as a generalized non-motor (absence) seizure or type of focal non-motor seizure.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033259> "Non-motor seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033259> <http://purl.obolibrary.org/obo/HP_0001250>)

# Class: <http://purl.obolibrary.org/obo/HP_0033298> (Abnormal circulating complement factor H-related protein 1 concentration)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033298> "Any deviation from the normal concentration of complement factor H-related protein 1 in the blood circulation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0033298> "2020-11-28T21:49:11Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0033298> "Abnormal complement factor H-related protein 1 level")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0033298> "Complement factor H-related protein 1 (CFHR1) is a complement regulator which has been reported to regulate complement by blocking C5 convertase activity and interfering with C5b surface association. CFHR1 also competes with complement factor H (CFH) for binding to C3b, and may act as an antagonist of CFH-directed regulation on cell surfaces.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033298> "Abnormal circulating complement factor H-related protein 1 concentration")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0033298> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000070> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PR_Q03591> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000178>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033298> <http://purl.obolibrary.org/obo/HP_0010876>)


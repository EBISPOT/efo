# Class: <http://purl.obolibrary.org/obo/HP_0031844> (Euphoria)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37636238") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0031844> "Elevation of emotional tone or mood that significantly deviates from normative affective functioning. This state is characterized by an overwhelming and all-encompassing sense of joyous well-being; it is associated with unfounded grandiosity, or grossly inflated self-esteem, rapid speech, impulsivity, and an impaired capacity for self-regulation, irrespective of context.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0031844> <https://orcid.org/0000-0002-1111-7357>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0031844> <https://orcid.org/0000-0002-7954-5235>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0031844> <https://orcid.org/0000-0003-2897-0458>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0031844> <https://orcid.org/0000-0003-4298-5074>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0031844> <https://orcid.org/0000-0003-4618-6544>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0031844> "2018-05-05T15:29:11Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0031844> "HP:0025767")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0031844> "HP:0025768")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Hyperthymia")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Hyperthymic state")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Jubilation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Euphoric mood")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Extreme elation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Inappropriate elation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Abnormally elevated mood")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Excessive joyfulness")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Inappropriately happy")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/HP_0031844> "Pathological cheerfulness")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0031844> "Euphoria may be experienced in the course of normal human activity, including sporting victory, sexual, substance use, or communal spiritual experiences; all manifestations of euphoria refer to profound elation and positive mood experiences. Euphoria in the normal context, is typically very brief and short-lived. Severe pathological euphoria may last hours to days and frequently results in marked impairments in judgment, behavior, and social or occupational functioning.")

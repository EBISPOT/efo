AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030052> "Inguinal freckling")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030052> <http://purl.obolibrary.org/obo/HP_0001480>)


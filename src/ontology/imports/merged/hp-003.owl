# Class: <http://purl.obolibrary.org/obo/HP_0032660> (Convulsive status epilepticus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-1735-8178>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22528274") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26336950") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26900382") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9924914") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032660> "A type of status epilepticus characterized by a prolonged bilateral tonic-clonic seizure, or repeated bilateral tonic-clonic seizures without recovery between.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032660> "2020-02-22T11:14:28Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032660> "Tonic-clonic status epilepticus")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032660> "In 2015, the ILAE Task Force on Classification of Status Epilepticus did proposed that time t1 (indicating the time that emergency treatment should be started because the seizure is unlikely to terminate spontaneously) is 5 minutes and t2 (the time at which long-term consequences of the seizure may be expected) is 30 minutes for convulsive (tonic-clonic) status epilepticus.This 5-minute timeframe has been endorsed by the 2012 Neurocritical Care Society Guidelines and the 2016 American Epilepsy Society Guidelines to guide when emergent treatment for convulsive status epilepticus should start. This term includes convulsive status epilepticus of focal, generalized or unknown onset.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032660> "Convulsive status epilepticus")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032660> <http://purl.obolibrary.org/obo/HP_0002069>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032660> <http://purl.obolibrary.org/obo/HP_0032658>)

# Class: <http://purl.obolibrary.org/obo/HP_0032677> (Generalized-onset motor seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11580774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276064") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032677> "A generalized motor seizure is a type of generalized-onset seizure with predominantly motor (involving musculature) signs. The motor event could consist of an increase (positive) or decrease (negative) in muscle contraction to produce a movement.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032677> "2020-03-14T07:11:14Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032677> "Generalised onset motor seizure")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032677> "Generalised-onset motor seizure")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032677> "Generalized onset motor seizure")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032677> "Generalized-onset motor seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032677> <http://purl.obolibrary.org/obo/HP_0002197>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032677> <http://purl.obolibrary.org/obo/HP_0020219>)

# Class: <http://purl.obolibrary.org/obo/HP_0032679> (Focal non-motor seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276064") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032679> "A type of focal-onset seizure characterized by non-motor signs or symptoms (or behavior arrest) as its initial semiological manifestation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032679> "2020-03-14T07:50:45Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032679> "Focal seizure without motor onset")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032679> "Partial seizure without motor onset")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032679> "Non-motor terms correspond to the earliest prominent sign or symptom.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032679> "Focal non-motor seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032679> <http://purl.obolibrary.org/obo/HP_0007359>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032679> <http://purl.obolibrary.org/obo/HP_0033259>)

# Class: <http://purl.obolibrary.org/obo/HP_0032792> (Tonic seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11580774") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032792> "A tonic seizure is a type of motor seizure characterized by unilateral or bilateral limb stiffening or elevation, often with neck stiffening.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032792> "2020-03-16T13:22:09Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032792> "This term describes the initial semiology of the seizure without specifying whether the onset is focal or generalized. Thus it can be used for coding tonic seizures when the onset is not known. The tonic contraction of muscles can result in a tremor, not to be confused with a clonic phase. This term does not apply to seizures with a tonic phase followed a clonic phase, see bilateral tonic-clonic seizure.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032792> "Tonic seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032792> <http://purl.obolibrary.org/obo/HP_0020219>)

# Class: <http://purl.obolibrary.org/obo/HP_0032794> (Myoclonic seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11580774") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032794> "A myoclonic seizure is a type of motor seizure characterized by sudden, brief (<100 ms) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal). Myoclonus is less regularly repetitive and less sustained than is clonus.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032794> "2020-03-16T13:28:08Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032794> "This term describes the initial semiology of the seizure without specifying whether the onset is focal or generalized. Thus it can be used for coding myoclonic seizures when the onset is not known.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032794> "Myoclonic seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032794> <http://purl.obolibrary.org/obo/HP_0020219>)

# Class: <http://purl.obolibrary.org/obo/HP_0032807> (Neonatal seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33522601") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032807> "A seizure occurring within the neonatal period (28 days beyond the full term date).")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032807> "2020-03-17T06:23:05Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032807> "This term encompasses clinical only (motor or non-motor without electrographic confirmation), electro-clinical and electrographic only seizures. Where the seizure also meets the definition of status epilepticus it should be coded twice.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032807> "Neonatal seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032807> <http://purl.obolibrary.org/obo/HP_0001250>)

# Class: <http://purl.obolibrary.org/obo/HP_0032892> (Infection-related seizure)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032892> "Seizure associated with a presumed or proven infection (excluding infection of the central nervous system) or inflammatory state without an alternative precipitant such as metabolic derangement, and regardless of the presence or absence of a fever.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032892> "2020-03-18T14:01:49Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032892> "This includes seizures in the context of febrile or afebrile infection.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032892> "Infection-related seizure")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032892> <http://purl.obolibrary.org/obo/HP_0001250>)

# Class: <http://purl.obolibrary.org/obo/HP_0032894> (Seizure precipitated by febrile infection)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276060") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032894> "Any form of seizure occurring at the time of a fever (temperature at or above 38.0 degrees Celcius) without infection of the central nervous system, and without an alternative cause such as severe metabolic derangement, occurring at any age.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032894> "2020-03-18T14:01:49Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032894> "Fever induced seizure")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032894> "Typically febrile seizures are limited to the age range of 3 months to 6 years and not accompanied or preceded by afebrile seizures; in this case febrile seizures are not considered indicative of epilepsy. When febrile seizures occur prior to the age of 3 months, or continue beyond the 6th birthday, or when a person has both febrile seizures and afebrile generalized tonic-clonic seizures then a diagnosis of Febrile Seizures Plus (an epilepsy syndrome) may be made.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032894> "Seizure precipitated by febrile infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032894> <http://purl.obolibrary.org/obo/HP_0032892>)

# Class: <http://purl.obolibrary.org/obo/HP_0032943> (Abnormal urine pH)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032943> "A deviation of urine pH from the normal range of 4.5 to 7.8.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032943> "2020-03-22T17:17:31Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032943> "Urine pH typically is 5 as a result of daily net acid excretion. The interpretation of the urine pH depends on the medical context.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032943> "Abnormal urine pH")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032943> <http://purl.obolibrary.org/obo/HP_0003110>)

# Class: <http://purl.obolibrary.org/obo/HP_0032950> (Abnormal renal tubular lumen morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23101152") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032950> "Abnormal structure or form of the lumen (opening) of kidney tubules.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032950> "2020-04-25T08:44:09Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0032950> "Abnormal renal tubular luminal morphology")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032950> "Abnormal renal tubular lumen morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032950> <http://purl.obolibrary.org/obo/HP_0000091>)

# Class: <http://purl.obolibrary.org/obo/HP_0032973> (Abnormal bronchoalveolar lavage fluid morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-0113-912X>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0032973> "Abnormal type or counts of nucleated immune cells and acellular components in bronchoalveolar lavage (BAL) fluid. BAL us performed with a fiberoptic bronchoscope in the wedged position within a selected bronchopulmonary segment. BAL is commonly used to inform the differential diagnosis of interstitial lung disease or to monitor therapeutic interventions.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0032973> "2020-04-28T06:43:21Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0032973> "Red blood cells in the BAL fluid are noted (e.g. present in pulmonary hemorrhage syndromes), but not counted, Similarly epithelial cells are only noted, not included numerically into cell differential.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0032973> "Abnormal bronchoalveolar lavage fluid morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0032973> <http://purl.obolibrary.org/obo/HP_0002088>)


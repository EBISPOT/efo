AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0030159> "Cervical tumour")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030159> "Cervical polyp")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030159> <http://purl.obolibrary.org/obo/HP_0012888>)


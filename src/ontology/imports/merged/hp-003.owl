# Class: <http://purl.obolibrary.org/obo/HP_0030051> (Tip-toe gait)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24757457") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26709689") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0030051> "An abnormal gait pattern characterized by the failure of the heel to contact the floor at the onset of stance during gait.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0030051> "HP:0002394")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/HP_0030051> "HP:0040083")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0030051> "Tiptoe gait")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0030051> "Toe walking")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0030051> "Walking on tiptoes")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0030051> "Tip-toe walking (or simply toe-walking) is common in healthy young children, and should resolve spontaneously by 3 years of age. After this age, tip-toe gait must be differentiated from habitual toe gait, congenital short tendo calcaneus, cerebral palsy, syringomyelia, spinal tumor, hematoma in a lower limb muscle, or neuromuscular diseases like muscular dystrophy, Charcot-Marie-Tooth disease and hereditary sensorimotor neuropathies. If the toe gait persists for 2-3 years, this gait pattern is not considered to be habitual. Therefore, the judgment of habitual toe gait should not be determined without evaluation for other diseases.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0030051> "Tip-toe gait")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0030051> <http://purl.obolibrary.org/obo/HP_0001288>)


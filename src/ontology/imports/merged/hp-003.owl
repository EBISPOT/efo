# Class: <http://purl.obolibrary.org/obo/HP_0033401> (Tissue ischemia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10720362") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26858079") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033401> "Ischemia is defined as a restriction of arterial blood supply to a tissue associated with insufficient oxygenation to support the metabolis requirements of the tissue. Depending on the involved tissues, clinical manifestations may include pain, pallor, lack of pulse, coldness, paresthesia, and paralysis. Additional associated manifestations include hemodynamic parameters (reduced blood pressure distal to the site of restricted arterial supply) and angiographic evidence of arterial occclusion.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0033401> "2021-01-09T15:02:58Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033401> "Tissue ischemia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033401> <http://purl.obolibrary.org/obo/HP_0025323>)

# Class: <http://purl.obolibrary.org/obo/HP_0033405> (Abnormal circulating organic amino compound concentration)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0033405> "Any deviation from the normal concentration of organic amino compound in the blood circulation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0033405> "2021-01-09T15:46:18Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0033405> "Abnormal organic amino compound level")

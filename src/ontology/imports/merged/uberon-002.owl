AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0022438> "UBERON:0022438")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0022438> <http://purl.obolibrary.org/obo/uberon/core#human_subset>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0022438> <http://purl.obolibrary.org/obo/uberon/core#mouse_subset>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0022438> "rostral anterior cingulate cortex")

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0035073> "duct of eccrine sweat gland")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0035073> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0000058> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000423>)))

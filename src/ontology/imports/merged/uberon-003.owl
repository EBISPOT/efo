# Class: <http://purl.obolibrary.org/obo/UBERON_0035608> (dura mater lymph vessel)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOI:10.1038/nature14432") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOI:10.1111/joa.12381") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0035608> "Any lymph vessel that is located in the dura mater of the brain.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000010> <http://purl.obolibrary.org/obo/UBERON_0035608> "while Louveau et al (DOI:10.1038/nature14432) state this is within the CNS (thus overturning dogma about the presence of lymphatics in the CNS), in this ontology the dura")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0035608> "dural lymph vessel")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0035608> "dural lymph vasculature")

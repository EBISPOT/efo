AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0035076> "parotid gland myoepithelium")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0035076> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0000420> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0001831>)))

AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0025267> "2016-12-18T13:24:58Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025267> "Snore")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025267> "Snores")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025267> "Snoring symptoms")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025267> "Snoring")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025267> <http://purl.obolibrary.org/obo/HP_5200283>)


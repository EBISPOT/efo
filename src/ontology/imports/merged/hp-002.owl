# Class: <http://purl.obolibrary.org/obo/HP_0020317> (Abnormal abdominal aorta branch artery morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39350866") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0020317> "A structural anomaly of an artery that originates from the abdominal aorta.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0020317> "2026-02-24T07:16:14Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0020317> "The abdominal aorta extends from the T12 vertebra and terminates at the L4 vertebra. It gives off anterior, lateral, and posterior branches that supply the abdominal viscera and vertebrae at this level, eventually dividing into the common iliac arteries. Upaired branches (and their typical location) comprise the celiac artery (T12), the superior mesenteric artery (L1), the inferior mesenteric artery (L3), and the median sacral artery. Paired branches comprise the middle adrenal arteries, the renal arteries (L1-2), the gonadal arteries (between L2 and L3), the inferior phrenic arteries, and the lumbar arteries. The abdominal aorta bifurcates into right and left common iliac arteries at L4.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0020317> "Abnormal abdominal aorta branch artery morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0020317> <http://purl.obolibrary.org/obo/HP_0011004>)

# Class: <http://purl.obolibrary.org/obo/HP_0020330> (Abnormal circulating inorganic anion concentration)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0020330> "Any deviation from the normal concentration of inorganic anion in the blood circulation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0020330> "2026-03-09T07:31:41Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0020330> "Inorganic anions are negatively charged mineral ions that do not contain carbon-hydrogen bonds. The major clinically important anions are chloride, bicarbonate, and phosphate. Additionally, sulfate, nitrate, nitrite, fluoride, and bromide are measured for certain indications.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0020330> "Abnormal circulating inorganic anion concentration")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0020330> <http://purl.obolibrary.org/obo/HP_0003111>)


# Class: <http://purl.obolibrary.org/obo/HP_0020006> (Ciliary body coloboma)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0020006> "A coloboma of the ciliary body.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0020006> "Ciliary body coloboma")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_0020006> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0000609> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/UBERON_0001775>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_0020006> <http://purl.obolibrary.org/obo/HP_0000589>)

# Class: <http://purl.obolibrary.org/obo/HP_0020007> (Abnormal affect regulation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23216067") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37925091") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0020007> "A disturbance in the processes by which emotional responses are initiated, modulated, sustained, or terminated in a contextually appropriate manner. Abnormal affect regulation involves maladaptive patterns in the generation, intensity, or control of affective experience and expression, leading to inconsistent, excessive, or insufficient modulation of emotion relative to situational demands.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0020007> "2025-10-17T15:13:18Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0020007> "This category encompasses enduring tendencies or dynamic features that influence emotional reactivity and control - such as emotional hypersensitivity, emotional lability, emotional insecurity, and low frustration tolerance. These features represent alterations in the mechanisms governing affective modulation rather than discrete affective states themselves.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0020007> "Abnormal affect regulation")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0020007> <http://purl.obolibrary.org/obo/HP_0025766>)

# Class: <http://purl.obolibrary.org/obo/HP_0020015> (Amyloid deposition by anatomical site)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0020015> "Amyloid deposition categorized according to the anatomical site of deposition.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0020015> "2025-10-26T08:27:41Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0020015> "Amyloid deposition by anatomical site")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0020015> <http://purl.obolibrary.org/obo/HP_0011034>)

# Class: <http://purl.obolibrary.org/obo/HP_0020029> (Abnormal spinal cord white matter morphology)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0020029> "Any structural abnormality affecting the white matter of the spinal cord, including sensory tracts (dorsal columns) and motor tracts (corticospinal tracts). Abnormalities may involve myelin, axons, or tract organization and can result in sensory, motor, or autonomic deficits.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0020029> "2025-10-26T10:02:20Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0020029> "Abnormal spinal cord white matter morphology")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0020029> <http://purl.obolibrary.org/obo/HP_0002143>)

# Class: <http://purl.obolibrary.org/obo/HP_0020045> (Esodeviation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-0986-4123>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0020045> "A manifest or latent ocular deviation in which one or both eyes tends to deviate nasally.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0020045> "2017-12-20T17:20:06Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0020045> "Convergent squint")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0020045> "Convergent strabismus")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0020045> "Esodeviation")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0020045> <http://purl.obolibrary.org/obo/HP_0000486>)

# Class: <http://purl.obolibrary.org/obo/HP_0020046> (Accommodative esotropia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0003-0986-4123>) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0020046> "A form of esotropia (convergent deviation of the eyes) associated with activation of the accommodative reflex.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0020046> "2017-12-20T17:25:43Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0020046> "Accommodative esotropia refers to strabismus (cross of the eyes) that occurs with focusing efforts of the eyes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0020046> "Accommodative esotropia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0020046> <http://purl.obolibrary.org/obo/HP_0000565>)


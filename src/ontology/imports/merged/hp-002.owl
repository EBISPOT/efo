# Class: <http://purl.obolibrary.org/obo/HP_0025236> (Sleep walking)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30458142") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32644427") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0025236> "Ambulation during sleep with lack awareness and limited or no recall of the event.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0025236> <https://orcid.org/0000-0001-6262-8264>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0025236> <https://orcid.org/0000-0001-9446-5121>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0025236> <https://orcid.org/0000-0002-1592-0825>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0025236> <https://orcid.org/0000-0002-4672-4923>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0025236> <https://orcid.org/0000-0002-5554-6946>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0025236> <https://orcid.org/0000-0002-7367-663X>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0025236> "2016-12-14T12:01:00Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://orcid.org/0000-0002-0736-9199>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025236> "Sleep walking")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025236> "Somnambulism")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0025236> "During an episode of sleepwalking, the somnambulating child typically appears clumsy and might perform unusual actions, such as urinating in a closet. Injuries can occur during sleepwalking, including falling downstairs or when leaving the house.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025236> "Sleep walking")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025236> <http://purl.obolibrary.org/obo/HP_0025235>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025236> <http://purl.obolibrary.org/obo/HP_5200300>)

# Class: <http://purl.obolibrary.org/obo/HP_0025245> (Cutaneous cyst)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0025245> "A hollow mass located in the skin that is surrounded by an epithelium-lined wall and is well demarcated from the adjacent tissue. Cysts are often said to be sac-like and may contain serous liquid or semisolid material.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0025245> "2016-12-17T13:11:37Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025245> "Skin cyst")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0025245> "In contrast to cysts, vesicles, pustules and bullae do not have a complete epithelial lining and are therefore less well demarcated.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025245> "Cutaneous cyst")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025245> <http://purl.obolibrary.org/obo/HP_0011355>)

# Class: <http://purl.obolibrary.org/obo/HP_0025246> (Trichilemmal cyst)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0025246> "Nontender, round and firm, but slightly compressible, intradermal or subcutaneous cyst measuring 0.5-5 cm in diameter. Trichilemmal cysts are acquired rather than congenital, and tend to appear on the scalp rather than the face, and to be intradermal rather than subcutaneous.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0025246> "2016-12-17T13:45:04Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025246> "Pilar cyst")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0025246> "Epidermal cysts and trichilemmal cysts are clinically indistinguishable. The wall of the epidermal cyst conserves the epidermal layers, but the wall of the trichilemmal cysts, which arise from the external root sheath, shows palisading of unlayered epithelial cells. Homogeneous horny material that is further degraded to fat and cholesterol forms within both types of cysts.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025246> "Trichilemmal cyst")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025246> <http://purl.obolibrary.org/obo/HP_0025245>)

# Class: <http://purl.obolibrary.org/obo/HP_0025258> (Stiff neck)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0025258> "A sensation of tightness in the neck when attempting to move it, especially after a period of inactivity. Neck stiffness often involves soreness and difficulty moving the neck, especially when trying to turn the head to the side.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0025258> "2016-12-18T01:06:15Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025258> "Neck stiffness")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#layperson>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025258> "Stiff neck")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025258> "Stiff neck")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025258> <http://purl.obolibrary.org/obo/HP_0001387>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025258> <http://purl.obolibrary.org/obo/HP_0005986>)

# Class: <http://purl.obolibrary.org/obo/HP_0025267> (Snoring)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35216759") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0025267> "Deep, noisy breathing during sleep, accompanied by hoarse or harsh sounds, is caused by the vibration of respiratory structures, especially the soft palate. This vibration results in sound due to obstructed air movement during breathing while sleeping.")

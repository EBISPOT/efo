# Class: <http://purl.obolibrary.org/obo/HP_0025534> (Ocular melanocytosis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0025534> "A congenital lesion of the sclera characterized by unilateral patchy but extensive slate-gray or bluish discoloration of the sclera . The conjunctiva are spared.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0025534> "2017-05-18T01:13:19Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025534> "Melanosis oculi")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025534> "Ocular melanosis")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0025534> "In ocular melanocytosis, Intraocular pigmentation is also increased, which contributes to a higher incidence of glaucoma and increases the risk of malignant melanoma.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025534> "Ocular melanocytosis")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025534> <http://purl.obolibrary.org/obo/HP_0000591>)


# Class: <http://purl.obolibrary.org/obo/HP_0025168> (Left ventricular diastolic dysfunction)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12527689") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14594874") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0025168> "Abnormal function of the left ventricule during left ventricular relaxation and filling.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0025168> "2016-12-04T14:01:20Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0025168> "Diastolic left ventricular disease can cause of limitation of exercise tolerance, whether or not ejection fraction is normal. This feature can be assessed by cardiac imaging.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025168> "Left ventricular diastolic dysfunction")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025168> <http://purl.obolibrary.org/obo/HP_0005162>)


AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025337> "Red eye")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025337> <http://purl.obolibrary.org/obo/HP_0008047>)


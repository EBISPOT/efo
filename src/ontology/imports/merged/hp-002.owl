AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0025160> <https://orcid.org/0000-0003-4298-5074>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_0025160> <https://orcid.org/0000-0003-4618-6544>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0025160> "2016-12-04T12:59:10Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025160> "Abnormal temper tantrums")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0025160> <http://purl.obolibrary.org/obo/HP_5200241>)


AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5200005> <https://orcid.org/0000-0003-3777-1389>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_5200005> "2023-03-23T14:48:16Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_5200005> "Pitch refers to the frequency of sound waves (measured in Hertz).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5200005> "Abnormal pitch")

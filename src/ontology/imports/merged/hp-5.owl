AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21331089") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26171570") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33729631") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5201010> "Notch, groove, or scar of the upper lip without noticeable rupture of the lip.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_5201010> "2023-04-03T11:33:58Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_5201010> "If the cleft lip is on only one side, use 'Microform unilateral cleft lip' (HP:5201002). This term was created to be used in association with a left (HP:0012835) or right (HP:0012834) modifier to annotate completeness of a cleft lip.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5201010> "Microform cleft of the upper lip")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5201010> <http://purl.obolibrary.org/obo/HP_0000204>)


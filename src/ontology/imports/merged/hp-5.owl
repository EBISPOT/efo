AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210135> <https://orcid.org/0009-0004-8124-8864>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5210135> "Unusual genitourinary infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210135> <http://purl.obolibrary.org/obo/HP_0011277>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210135> <http://purl.obolibrary.org/obo/HP_0032158>)

# Class: <http://purl.obolibrary.org/obo/HP_5210236> (Unusual fungal skin infection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5210236> "An increased susceptibility to fungal infection of the skin or subcutaneous tissue, as manifested by a recurrent, severe, or atypically distributed fungal lesion, or by an infection caused by an atypical or opportunistic organism. Common manifestations include chronic mucocutaneous candidiasis or subcutaneous mycoses (such as sporotrichosis caused by Sporothrix species.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210236> <https://orcid.org/0000-0001-7601-9822>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210236> <https://orcid.org/0000-0001-9382-150X>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210236> <https://orcid.org/0000-0002-2029-0733>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210236> <https://orcid.org/0000-0002-3577-9021>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210236> <https://orcid.org/0000-0002-4315-9105>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210236> <https://orcid.org/0009-0004-8124-8864>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_5210236> "An unusual fungal skin infection is a hallmark of T-cell deficiencies, inborn errors of IL-17 immunity (e.g., STAT1 gain-of-function, AIRE deficiency), and CARD9 deficiency, which specifically predisposes to deep dermatophytosis and subcutaneous fungal invasion.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5210236> "Unusual fungal skin infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210236> <http://purl.obolibrary.org/obo/HP_0020100>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210236> <http://purl.obolibrary.org/obo/HP_0032162>)

# Class: <http://purl.obolibrary.org/obo/HP_5210251> (Recurrent stomatitis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5210251> "Increased susceptibility to infectious stomatitis, as manifested by recurrent episodes of oral mucosal infection that are unusual in frequency or severity for a healthy individual of the same age.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210251> <https://orcid.org/0000-0001-7601-9822>)

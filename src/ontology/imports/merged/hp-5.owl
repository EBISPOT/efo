# Class: <http://purl.obolibrary.org/obo/HP_5210102> (Unusual Candida infection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5210102> "Increased susceptibility to Candida infections as manifested by recurrent or severe/invasive infection with Candida, or by Candida infection occurring in an unusual anatomical location.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210102> <https://orcid.org/0000-0001-7601-9822>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210102> <https://orcid.org/0000-0001-9382-150X>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210102> <https://orcid.org/0000-0002-2029-0733>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210102> <https://orcid.org/0000-0002-3577-9021>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210102> <https://orcid.org/0000-0002-4315-9105>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210102> <https://orcid.org/0009-0004-8124-8864>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_5210102> "Unusual candidiasis")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_5210102> "Unusual anatomical sites for invasive candida infections include the esophagus, kidneys, stomach, and other organs. Clinical manifestations may also involve mucocutaneous surfaces, such as in chronic mucocutaneous candidiasis (CMC).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5210102> "Unusual Candida infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210102> <http://purl.obolibrary.org/obo/HP_0032255>)

# Class: <http://purl.obolibrary.org/obo/HP_5210121> (Unusual upper respiratory tract infection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5210121> "Increased susceptibility to infection of the upper respiratory tract, as manifested by recurrent or severe infection of the nose, sinuses, pharynx, larynx, or middle ear, or by infection caused by an atypical or opportunistic organism.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210121> <https://orcid.org/0000-0001-7601-9822>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210121> <https://orcid.org/0000-0001-9382-150X>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210121> <https://orcid.org/0000-0002-2029-0733>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210121> <https://orcid.org/0000-0002-3577-9021>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210121> <https://orcid.org/0000-0002-4315-9105>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210121> <https://orcid.org/0009-0004-8124-8864>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_5210121> "Recurrent or severe sinopulmonary infections are characteristic of humoral (B-cell) deficiencies, complement defects, and phagocyte disorders. This phenotype is also frequently observed in combined immunodeficiencies (e.g., DOCK8 deficiency) and hyper-IgE syndromes (e.g., STAT3 deficiency).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5210121> "Unusual upper respiratory tract infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210121> <http://purl.obolibrary.org/obo/HP_0011947>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210121> <http://purl.obolibrary.org/obo/HP_0032158>)

# Class: <http://purl.obolibrary.org/obo/HP_5210123> (Unusual lower respiratory tract infection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5210123> "Increased susceptibility to infection of the lower respiratory tract, as manifested by recurrent or severe infection of the trachea, bronchi, bronchioles, or lung parenchyma, or by infection caused by an atypical or opportunistic organism.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210123> <https://orcid.org/0000-0001-7601-9822>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210123> <https://orcid.org/0000-0001-9382-150X>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210123> <https://orcid.org/0000-0002-2029-0733>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210123> <https://orcid.org/0000-0002-3577-9021>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210123> <https://orcid.org/0000-0002-4315-9105>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210123> <https://orcid.org/0009-0004-8124-8864>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_5210123> "Recurrent lower respiratory tract infections, including bronchiectasis, are characteristic of antibody deficiencies and combined immunodeficiencies.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_5210123> "Unusual lower respiratory tract infection")
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210123> <http://purl.obolibrary.org/obo/HP_0011947>)
SubClassOf(<http://purl.obolibrary.org/obo/HP_5210123> <http://purl.obolibrary.org/obo/HP_0032158>)

# Class: <http://purl.obolibrary.org/obo/HP_5210135> (Unusual genitourinary infection)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_5210135> "Increased susceptibility to infection of the genitourinary tract, as manifested by recurrent or severe cystitis, pyelonephritis, kidney abscess, or vaginal infection, or by genitourinary infection caused by an atypical or opportunistic organism.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210135> <https://orcid.org/0000-0001-7601-9822>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_5210135> <https://orcid.org/0000-0001-9382-150X>)

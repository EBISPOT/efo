AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_145555> "macropolylide")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_145555> <http://purl.obolibrary.org/obo/CHEBI_25106>)


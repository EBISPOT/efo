# Class: <http://purl.obolibrary.org/obo/HP_4000074> (Involuntary vocalization)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31651053") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_4000074> "Production of sound done without will or conscious control. Involuntary vocalizations include tics, stereotypies vocalizations as part of dystonia or chorea, continuous vocalizing behaviors such as groaning or grunting, pathological laughter and crying, and others. These vocalizations are not recognized as socially or culturally appropriate.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_4000074> <https://orcid.org/0000-0001-8430-6039>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_4000074> <https://orcid.org/0000-0002-2592-4715>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_4000074> <https://orcid.org/0000-0002-9593-5508>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_4000074> <https://orcid.org/0000-0003-3777-1389>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_4000074> "2022-03-02T16:17:03Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_4000074> "Involuntary vocalization")
SubClassOf(<http://purl.obolibrary.org/obo/HP_4000074> <http://purl.obolibrary.org/obo/HP_0011442>)


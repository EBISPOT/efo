# Class: <http://purl.obolibrary.org/obo/UBERON_0002242> (nucleus pulposus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MGI:llw2") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0006392") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002242> "The jelly-like substance in the middle of the spinal disc which is a remnant of the notochord.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000010> <http://purl.obolibrary.org/obo/UBERON_0002242> "The nucleus pulposus consists of chondrocytes, collagen fibrils, and proteoglycan aggrecans that have hyaluronic long chains which attract water. Attached to each hyaluronic chain are side chains of chondroitin sulfate and keratan sulfate[Wikipedia:Nucleus_pulposus]")

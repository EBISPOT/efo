# Class: <http://purl.obolibrary.org/obo/PR_000050003> (metabotropic glutamate receptor protein)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:XQ") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000050003> "A glutamate G-protein coupled receptor that is a translation product of the human GRM1 to GRM8 genes, 1:1 orthologs thereof, or a semi-ortholog thereof.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PR_000050003> "IUPHARfam:40")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/PR_000050003> "protein")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/PR_000050003> "PR:000050003")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000050003> "Category=family.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PR_000050003> "metabotropic glutamate receptor protein")
SubClassOf(<http://purl.obolibrary.org/obo/PR_000050003> <http://purl.obolibrary.org/obo/PR_000030038>)

# Class: <http://purl.obolibrary.org/obo/PR_000050007> (E2F protein)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:DAN") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000050007> "A protein that is a translation product of the human E2F1, E2F2, E2F3, E2F4, E2F5, E2F6, E2F7, or E2F8 genes, or 1:1 orthologs thereof.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:DAN") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/pr#PRO-short-label>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000050007> "fam:E2F")

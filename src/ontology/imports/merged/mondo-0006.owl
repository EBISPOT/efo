AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:C35735") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0006404> "A rare, highly aggressive carcinoma that arises from the salivary gland, predominantly the parotid gland. It is characterized by the presence of large pleomorphic malignant cells with abundant cytoplasm. Patients usually present with a rapidly growing mass.")

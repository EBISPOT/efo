AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0006631> "MONDO:0006631")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0006631> "osteoarthritis, toe")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0006631> <http://identifiers.org/medgen/592722>)

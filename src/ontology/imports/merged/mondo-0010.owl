AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:85324") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0010409> "X-linked intellectual disability, Shrimpton type is characterized by the association of severe intellectual deficit with microcephaly, strabismus and short stature. It has been described in three boys from two unrelated families. Transmission is X-linked recessive and the causative gene has been localized to the q12-Xq21.31 region of the X-chromosome.")

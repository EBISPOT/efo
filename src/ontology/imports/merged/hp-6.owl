AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_6001302> "2025-08-31T17:29:42Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_6001302> "Aphakia")
SubClassOf(<http://purl.obolibrary.org/obo/HP_6001302> <http://purl.obolibrary.org/obo/HP_0000517>)

# Class: <http://purl.obolibrary.org/obo/HP_6001426> (Elbow instability)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28160902") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7962147") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_6001426> "Impairment of the ability of the elbow joint to maintain proper anatomical alignment and functional mechanics. Elbow instability is a spectrum from subluxation to dislocation, with corresponding clinical and pathologic features and therapeutic implications.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/HP_6001426> <https://github.com/obophenotype/human-phenotype-ontology/issues/10795>)

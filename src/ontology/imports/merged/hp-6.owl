AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_6001187> "Reduced progranulin level in blood")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_6001187> "Progranulin, a secreted glycoprotein, maintains cerebrocortical viability. It has been identified as an important factor controlling neural function while also suppressing neuroinflammation and playing roles in neuronal lysosome function. Loss of one allele of GRN, the gene encoding progranulin, leads to the development of frontotemporal dementia, and loss of both alleles leads to the development of neuronal ceroid lipofuscinosis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_6001187> "Decreased circulating progranulin concentration")
EquivalentClasses(<http://purl.obolibrary.org/obo/HP_6001187> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PATO_0001997> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/PR_P28799> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000178>))) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002573> <http://purl.obolibrary.org/obo/PATO_0000460>))))
SubClassOf(<http://purl.obolibrary.org/obo/HP_6001187> <http://purl.obolibrary.org/obo/HP_0010876>)

# Class: <http://purl.obolibrary.org/obo/HP_6001302> (Aphakia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_6001302> "Absence of the crystalline lens in the eye, which may be congenital or acquired (e.g., following surgical removal of the lens for cataracts or trauma).")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/HP_6001302> <https://github.com/obophenotype/human-phenotype-ontology/issues/10902>)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_6000531> "Abnormal urinary organic compound level")
SubClassOf(<http://purl.obolibrary.org/obo/HP_6000531> <http://purl.obolibrary.org/obo/HP_0033354>)


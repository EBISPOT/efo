# Class: <http://purl.obolibrary.org/obo/HP_6000818> (Transverse terminal limb defect)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34263545") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_6000818> "A congenital anomaly that appears as an amputation at different levels of the extremity. The limb is missing the terminal (distal) segment(s), with preservation of all the segment(s) proximal to the missing segment.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/HP_6000818> <https://github.com/obophenotype/human-phenotype-ontology/issues/10479>)
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/HP_6000818> <https://orcid.org/0000-0002-0736-9199>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_6000818> "2024-06-29T17:12:42Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_6000818> "Transverse terminal limb reduction")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_6000818> "Terminal transverse limb deficiency is a congenital anomaly that appears as an amputation at different levels of a limb. The limb is missing the terminal (distal) segment(s), with preservation of all the segment(s) proximal to the missing segment.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_6000818> "Transverse terminal limb defect")
SubClassOf(<http://purl.obolibrary.org/obo/HP_6000818> <http://purl.obolibrary.org/obo/HP_0040064>)

# Class: <http://purl.obolibrary.org/obo/HP_6000852> (Megacolon)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_6000852> "Persistent and substantial increase in diameter diameter and length of the colon.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/HP_6000852> <https://github.com/obophenotype/human-phenotype-ontology/issues/8974>)

AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_6000852> "2024-06-30T16:38:56Z"^^xsd:dateTime)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_6000852> "In addition to Hirschspring disease, acute colonic pseudoobstruction, idiopathic megacolon, severe chronic constipation, hypothyroidism, intestinal motility disorders, and toxic Megacolon may present with this feature.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_6000852> "Megacolon")
SubClassOf(<http://purl.obolibrary.org/obo/HP_6000852> <http://purl.obolibrary.org/obo/HP_0002250>)


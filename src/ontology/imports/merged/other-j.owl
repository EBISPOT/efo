############################
#   Annotation Properties
############################

# Annotation Property: <http://purl.obolibrary.org/obo/po#Japanese> (<http://purl.obolibrary.org/obo/po#Japanese>)

SubAnnotationPropertyOf(<http://purl.obolibrary.org/obo/po#Japanese> <http://www.geneontology.org/formats/oboInOwl#SynonymTypeProperty>)




############################
#   Classes
############################

# Class: <http://dbpedia.org/resource/Japan> (Japan)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://dbpedia.org/resource/Japan> "GAZ:00002747")
AnnotationAssertion(rdfs:label <http://dbpedia.org/resource/Japan> "Japan"@en)
SubClassOf(<http://dbpedia.org/resource/Japan> <http://purl.obolibrary.org/obo/GAZ_00000448>)
SubClassOf(<http://dbpedia.org/resource/Japan> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0001025> <http://dbpedia.org/resource/Eastern_Asia>))
SubClassOf(<http://dbpedia.org/resource/Japan> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0001025> <http://purl.obolibrary.org/obo/HANCESTRO_0002>))

# Class: <http://dbpedia.org/resource/Jordan> (Jordan)


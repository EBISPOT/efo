# Class: <http://purl.obolibrary.org/obo/MONDO_0100175> (TTN-related myopathy)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27854229") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29691892") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicalgenome.org/affiliation/40031/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100175> "A disorder of the musculoskeletal system caused by pathogenic variants in the TTN gene encoding the titin protein expressed in striated muscle. These variants are associated with a variety of overlapping congenital and adult-onset myopathies characterized by non-progressive or progressive neck, axial, and limb weakness, joint contractures, early-onset respiratory insufficiency, facial weakness, congenital cardiac anomalies and/or early-onset dilated cardiomyopathy. Histologic findings on skeletal muscle biopsy reveal a wide range of structural abnormalities and can include increased internalized and central nuclei, minicores, and dystrophic changes.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100175> "GARD:0026073")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicalgenome.org/affiliation/40031/") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0100175> "TTN myopathy")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicalgenome.org/affiliation/40031/") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0100175> "congenital myopathy related to TTN")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0100175> "MONDO:0100175")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:CLINGEN") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100175> <http://purl.obolibrary.org/obo/mondo#clingen>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GARD:0026073") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100175> <http://purl.obolibrary.org/obo/mondo#gard_rare>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:OTAR") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100175> <http://purl.obolibrary.org/obo/mondo#otar>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100175> <http://purl.obolibrary.org/obo/mondo#rare>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0100175> "In the absence of evidence supporting distinct differences in molecular mechanisms between the associated disease entities, as well as considerable phenotypic overlap, these entities can be considered part of a clinical spectrum of TTN-related myopathy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100175> "TTN-related myopathy")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100175> <http://purl.obolibrary.org/obo/MONDO_0002320>)
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0002-6601-2165") <http://purl.obolibrary.org/obo/MONDO_0100175> <http://purl.obolibrary.org/obo/MONDO_0016191>)
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://clinicalgenome.org/affiliation/40031/") <http://purl.obolibrary.org/obo/MONDO_0100175> <http://purl.obolibrary.org/obo/MONDO_0019952>)

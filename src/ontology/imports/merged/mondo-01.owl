AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://rarediseases.org/rare-diseases/ryr-1-related-diseases/") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/MONDO_0100150> "RYR1-related disease")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://rarediseases.org/rare-diseases/ryr-1-related-diseases/") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/MONDO_0100150> "RYR1-related disorder")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MONDO:patterns/disease_series_by_gene") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.clinicalgenome.org/affiliation/40061/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100121> "Any congenital myopathy in which the cause of the disease is a mutation in the SCN4A gene. It include is a spectrum of autosomal recessive disorders including congenital myasthenic syndrome, fetal hypokinesia, and congenital myopathy.")

SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100084> <http://purl.obolibrary.org/obo/MONDO_0100545>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100084> <http://purl.obolibrary.org/obo/MONDO_0700223>)


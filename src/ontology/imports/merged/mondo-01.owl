AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0100146> "MONDO:0100146")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:CLINGEN") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100146> <http://purl.obolibrary.org/obo/mondo#clingen>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GARD:0026062") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100146> <http://purl.obolibrary.org/obo/mondo#gard_rare>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:NORD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100146> <http://purl.obolibrary.org/obo/mondo#nord_rare>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:OTAR") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100146> <http://purl.obolibrary.org/obo/mondo#otar>)

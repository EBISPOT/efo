# Class: <http://purl.obolibrary.org/obo/MONDO_0100147> (SATB2 associated disorder)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17377962") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29436146") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31021519") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://clinicalgenome.org/affiliation/40006/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100147> "A syndromic intellectual disability disorder that is characterized by significant neurodevelopmental disabilities with limited to absent speech, behavioral issues, and craniofacial anomalies. Most distinctive features are neurodevelopmental with invariably severely limited speech, cleft or high arched palate, dental anomalies (crowding, macrodontia, abnormal shape), and behavioral issues with or without bone or brain anomalies.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_0100147> "https://github.com/monarch-initiative/mondo/issues/5588"^^xsd:anyURI)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:3010008") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30401461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0002-4650-631X") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100095> "An autosomal recessive neurodegenerative disorder with onset in the first years of life following normal early development, with cyclic episodic deterioration in response to stress, such as infection or febrile illness. The severity is highly variable. The cause is mutations in the ADPRHL2 gene.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_0100095> "https://github.com/monarch-initiative/mondo/issues/9666"^^xsd:anyURI)

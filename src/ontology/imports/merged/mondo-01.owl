# Class: <http://purl.obolibrary.org/obo/MONDO_0100000> (MED12-related intellectual disability syndrome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20301719") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0002-6733-369X") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100000> "An X-linked syndromic intellectual disability that that includes subtypes of the heterogeneous, eponymously named Lujan-Fryns syndrome, X-linked Ohdo syndrome, and Optiz-Kaveggia/ FG syndrome, which is caused by mutations in the gene MED12. The common and most penetrant phenotype shared amongst these disease entities is intellectual disability, with dysgenesis or agenesis of the corpus callosum, blepharophimosis, and marfanoid habitus having variable phenotypic expressivity.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_0100000> "https://github.com/monarch-initiative/mondo/issues/10146"^^xsd:anyURI)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/MONDO_0100000> "https://github.com/monarch-initiative/mondo/issues/5588"^^xsd:anyURI)
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/MONDO_0100000> "2018-03-09T01:45:27Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100000> "GARD:0026013")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MONDO:patterns/disease_series_by_gene") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0100000> "MED12 X-linked syndromic intellectual disability")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0100000> "X-linked syndromic intellectual disability caused by mutation in MED12")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0100000> "MONDO:0100000")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:CLINGEN") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100000> <http://purl.obolibrary.org/obo/mondo#clingen>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GARD:0026013") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100000> <http://purl.obolibrary.org/obo/mondo#gard_rare>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:NORD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100000> <http://purl.obolibrary.org/obo/mondo#nord_rare>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:OTAR") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100000> <http://purl.obolibrary.org/obo/mondo#otar>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100000> <http://purl.obolibrary.org/obo/mondo#rare>)

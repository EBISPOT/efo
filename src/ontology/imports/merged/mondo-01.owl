AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:NORD") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "NORD:253") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100091> <http://purl.obolibrary.org/obo/mondo#nord_rare>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:OTAR") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100091> <http://purl.obolibrary.org/obo/mondo#otar>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100091> <http://purl.obolibrary.org/obo/mondo#rare>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0100091> "Pathophysiology: In PXE, there is mineralization (accumulation of calcium and other minerals) and fragmentation of the elastin-containing fibers in connective tissue, but primarily in the midlaminar layer of the dermis, Bruch's membrane and the midsized arteries.[12] Recent studies hypothesize that PXE is a metabolic disease, and that its features arise because metabolites of vitamin K cannot reach peripheral tissues")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100091> "inherited pseudoxanthoma elasticum")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GARD:0009643") rdfs:seeAlso <http://purl.obolibrary.org/obo/MONDO_0100091> "https://rarediseases.info.nih.gov/diseases/9643/pseudoxanthoma-elasticum"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0100091> <http://identifiers.org/medgen/697574>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0100091> <http://linkedlifedata.com/resource/umls/id/C1274225>)

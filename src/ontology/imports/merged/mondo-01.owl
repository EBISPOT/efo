AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0100062> "MONDO:0100062")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:CLINGEN") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/mondo#clingen>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GARD:0009255") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/mondo#gard_rare>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:NORD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/mondo#nord_rare>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:OTAR") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/mondo#otar>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/mondo#rare>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0100062> "Individuals, both male and female, have been reported with variants in the GABRB3 gene. De novo and familial cases have been reported, with mostly missense and a few nonsense variants identified as causative. These patients have been described in the literature as having a range of phenotypes characterized as epileptic encephalopathy, Lennox-Gastaut syndrome, Dravet syndrome-like, and childhood absence epilepsy. Severity of intellectual disability is variable among reported probands, as is the age of onset of seizure phenotypes. In one case of epileptic encephalopathy, for example, the individual presented with severe intellectual disability while seizures onset at 12 years old. Additionally, individuals have been reported with the same de novo missense variants, and have been described with varying phenotypes. (PMID:26544041, PMID:26704558, PMID:26645412, PMID:26993267, PMID:27476654)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100062> "genetic developmental and epileptic encephalopathy")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/DOID_0112202>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/NCIT_C122814>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0100062> <https://omim.org/phenotypicSeries/PS308350>)

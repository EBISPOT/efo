# Class: <http://purl.obolibrary.org/obo/MONDO_0100337> (SEC61A1 deficiency)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31488840") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.clinicalgenome.org/affiliation/40080/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100337> "Any Mendelian disease in which the cause of the disease is a mutation in the SEC61A1 gene. It is characterized by variable presentation of phenotypes in patients, including autosomal dominant tubulointerstitial kidney disease, primary antibody deficiency, and severe congenital neutropenia.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0100337> "MONDO:0100337")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:CLINGEN") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100337> <http://purl.obolibrary.org/obo/mondo#clingen>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:OTAR") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100337> <http://purl.obolibrary.org/obo/mondo#otar>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0100337> "The term autosomal dominant tubulointerstitial kidney disease (ADTKD), is recommended to be used instead of familial juvenile hyperurecemic nephropathy.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100337> "SEC61A1 deficiency")

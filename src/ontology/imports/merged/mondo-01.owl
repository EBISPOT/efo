AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:equivalentTo") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:pnr") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100062> "OMIMPS:308350")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GARD:0026063") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/MONDO_0100149> <http://purl.obolibrary.org/obo/mondo#gard_rare>)

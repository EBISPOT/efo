AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/NBO_0000007> "other moved mouth parts")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/NBO_0000007> "behavior_ontology")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/NBO_0000007> "mouth movement")
SubClassOf(<http://purl.obolibrary.org/obo/NBO_0000007> <http://purl.obolibrary.org/obo/NBO_0000001>)


# Class: <http://purl.obolibrary.org/obo/NBO_0000001> (body part movement)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NBO_0000001> "A change of place or position of part of an organism that does not involve the entire organism [NBO:SMAC]")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/NBO_0000001> "2011-04-14T01:03:39Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/NBO_0000001> "George Gkoutos")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NBO_0000001> "stationary movement")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/NBO_0000001> "behavior_ontology")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/NBO_0000001> "body part movement")
SubClassOf(<http://purl.obolibrary.org/obo/NBO_0000001> <http://purl.obolibrary.org/obo/NBO_0000338>)

# Class: <http://purl.obolibrary.org/obo/NBO_0000003> (emotional behavior)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "wikipedia:Emotions") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NBO_0000003> "Behavior related to the complex psychophysiological experience of an individual's state of mind as interacting with biochemical (internal) and environmental (external) influences.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/NBO_0000003> "2011-04-14T01:03:39Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/NBO_0000003> "George Gkoutos")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NBO_0000003> "affective behaviour")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NBO_0000003> "mood")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/NBO_0000003> "behavior_ontology")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/NBO_0000003> "emotional behavior")
SubClassOf(<http://purl.obolibrary.org/obo/NBO_0000003> <http://purl.obolibrary.org/obo/NBO_0000313>)

# Class: <http://purl.obolibrary.org/obo/NBO_0000006> (learning and/or memory behavior)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GO:jic") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NBO_0000006> "Behavior related to the acquisition and processing of information and/or the storage and retrieval of this information over time.")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/date> <http://purl.obolibrary.org/obo/NBO_0000006> "2011-04-14T01:03:39Z")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/NBO_0000006> "George Gkoutos")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NBO_0000006> "learning and/or memory behaviour")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/NBO_0000006> "behavior_ontology")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/NBO_0000006> "learning and/or memory behavior")

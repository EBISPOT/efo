AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/NBO_0000009> "locomotory behavior phenotype")
EquivalentClasses(<http://purl.obolibrary.org/obo/NBO_0000009> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000056> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0007626> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000086> <http://purl.obolibrary.org/obo/PATO_0000001>))))

# Class: <http://purl.obolibrary.org/obo/HP_0500022> (Abnormal circulating dehydroepiandrosterone concentration)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27979632") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/HP_0500022> "A deviation from the normal concentration of dehydroepiandrosterone in the circulation.")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/HP_0500022> "2017-05-18T19:38:52Z"^^xsd:dateTime)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#abbreviation>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0500022> "Abnormal serum DHEA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0500022> "Abnormal serum androstenolone level")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0500022> "Abnormal serum dehydroepiandrosterone level")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/HP_0500022> "Dehydroepiandrosterone (DHEA), which is produced in the adrenal glands and the gonads, represents the most abundant circulating steroid hormone. It is a metabolic intermediate in the biosynthesis of the androgen and estrogen sex steroids.")

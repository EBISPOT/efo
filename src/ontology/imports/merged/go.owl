AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0035932> "aldosterone secretion")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0035932> <http://purl.obolibrary.org/obo/GO_0015850>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0035932> <http://purl.obolibrary.org/obo/GO_0035931>)


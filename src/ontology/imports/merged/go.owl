# Class: <http://purl.obolibrary.org/obo/GO_0005777> (peroxisome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:pm") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9302272") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UniProtKB-KW:KW-0576") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0005777> "A small organelle enclosed by a single membrane, and found in most eukaryotic cells. Contains peroxidases and other enzymes involved in a variety of metabolic processes including free radical detoxification, lipid catabolism and biosynthesis, and hydrogen peroxide metabolism.")

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0045259> "hydrogen-transporting ATP synthase complex")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0045259> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0045259> "proton-transporting F-type ATPase complex")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0045259> "GO:0045259")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0045259> "proton-transporting ATP synthase complex")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0045259> <http://purl.obolibrary.org/obo/GO_0016469>)

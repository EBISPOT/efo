AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:bf") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0007249> "canonical NF-kappaB signaling cascade")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0007249> "biological_process")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18292232") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0007249> "p50-dependent NF-kappaB signaling")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0007249> "GO:0007249")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0007249> "canonical NF-kappaB signal transduction")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0007249> <http://purl.obolibrary.org/obo/GO_0141124>)


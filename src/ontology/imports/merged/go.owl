AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0046541> "GO:0046541")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0046541> "saliva secretion")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0046541> <http://purl.obolibrary.org/obo/GO_0007589>)

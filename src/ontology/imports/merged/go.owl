AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0045254> "The catalytic activities of the individual components of this complex are represented by the molecular function terms 'pyruvate dehydrogenase (acetyl-transferring) activity ; GO:0004739' (E1), 'dihydrolipoyllysine-residue acetyltransferase activity ; GO:0004742' (E2), and 'dihydrolipoyl dehydrogenase activity ; GO:0004148' (E3).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0045254> "pyruvate dehydrogenase complex")

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0006911> "phagocytosis, engulfment")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0006911> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0099024> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0006909>)))

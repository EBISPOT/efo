AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0034362> "GO:0034362")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0034362> "low-density lipoprotein particle")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0034362> <http://purl.obolibrary.org/obo/GO_0034358>)


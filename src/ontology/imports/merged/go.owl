# Class: <http://purl.obolibrary.org/obo/GO_0000002> (obsolete mitochondrial genome maintenance)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:ai") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:vw") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0000002> "OBSOLETE. The maintenance of the structure and integrity of the mitochondrial genome; includes replication and segregation of the mitochondrial chromosome.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/GO_0000002> "https://github.com/geneontology/go-ontology/issues/29646"^^xsd:anyURI)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0000002> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0000002> "GO:0000002")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0000002> "This term described phenotypic observations for multiple processes (including transport/lipid metabolism/ DNA metabolism/ fission/ fusion etc)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0000002> "obsolete mitochondrial genome maintenance")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/GO_0000002> "true"^^xsd:boolean)


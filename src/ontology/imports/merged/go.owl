AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0006505> "glycosylphosphatidylinositol metabolism")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0006505> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0006505> "GO:0006505")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0006505> "GPI anchor metabolic process")

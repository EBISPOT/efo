AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0022010> "GO:0022010")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0022010> "central nervous system myelination")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0022010> <http://purl.obolibrary.org/obo/GO_0032291>)

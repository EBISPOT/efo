AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0005901> "caveolar membrane")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0005901> "GO:0005901")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005901> "caveola")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0005901> <http://purl.obolibrary.org/obo/GO_0044853>)


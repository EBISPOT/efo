AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0051932> "synaptic transmission, gamma-aminobutyric acid-ergic")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0051932> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0051932> "GO:0051932")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0051932> "synaptic transmission, GABAergic")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0051932> <http://purl.obolibrary.org/obo/GO_0007268>)


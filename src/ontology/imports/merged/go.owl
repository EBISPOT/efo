AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0045271> "GO:0045271")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0045271> "Note that this term represents a location and not a function; the activity possessed by this complex is mentioned in the definition for the purpose of describing and distinguishing the complex. The function possessed by this complex is represented by the molecular function term 'NADH dehydrogenase (ubiquinone) activity ; GO:0008137'.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0045271> "respiratory chain complex I")

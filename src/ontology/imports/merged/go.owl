AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0001501> "GO:0001501")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0001501> "skeletal system development")

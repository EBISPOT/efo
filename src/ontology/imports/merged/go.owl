AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0051384> "GO:0051384")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0051384> "response to glucocorticoid")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0051384> <http://purl.obolibrary.org/obo/GO_0031960>)


AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0005929> "eukaryotic flagellum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0005929> "microtubule-based flagellum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/GO_0005929> "primary cilium")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0005929> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0005929> "flagellum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0005929> "GO:0005929")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0005929> <http://purl.obolibrary.org/obo/go#goslim_chembl>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0005929> <http://purl.obolibrary.org/obo/go#goslim_drosophila>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0005929> <http://purl.obolibrary.org/obo/go#goslim_generic>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0005929> <http://purl.obolibrary.org/obo/go#goslim_pir>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0005929> "Note that we deem cilium and microtubule-based flagellum to be equivalent. In most eukaryotic species, intracellular sub-components of the cilium, such as the ciliary base and rootlet, are located near the plasma membrane. In Diplomonads such as Giardia, instead, the same ciliary parts are located further intracellularly. Also, 'cilium' may be used when axonemal structure and/or motility are unknown, or when axonemal structure is unusual. For all other cases, please refer to children of 'cilium'. Finally, note that any role of ciliary proteins in sensory events should be captured by annotating to relevant biological process terms.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005929> "cilium")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0005929> <http://purl.obolibrary.org/obo/GO_0043227>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0005929> <http://purl.obolibrary.org/obo/GO_0120025>)

# Class: <http://purl.obolibrary.org/obo/GO_0005228> (intracellular sodium-activated potassium channel activity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mtg_transport") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12628167") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0005228> "Enables the transmembrane transfer of potassium by a channel that opens in response to stimulus by a sodium ion or ions. Transport by a channel involves facilitated diffusion of a solute (by an energy-independent process) involving passage through a transmembrane aqueous pore or channel, without evidence for a carrier-mediated mechanism. Sodium activated potassium channels have distinctive properties, including a large single channel conductance, subconductance states, and a block of single channel currents at positive potentials, similar to inward rectification.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0005228> "intracellular sodium activated potassium channel activity")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0005228> "molecular_function")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0005228> "protein")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0005228> "GO:0005228")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005228> "intracellular sodium-activated potassium channel activity")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0005228> <http://purl.obolibrary.org/obo/GO_0005267>)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0005840> <http://purl.obolibrary.org/obo/go#goslim_generic>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0005840> <http://purl.obolibrary.org/obo/go#goslim_metagenomics>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0005840> <http://purl.obolibrary.org/obo/go#goslim_pir>)

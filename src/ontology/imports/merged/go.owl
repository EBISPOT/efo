AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0035249> "synaptic transmission, glutamatergic")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0035249> <http://purl.obolibrary.org/obo/GO_0007268>)


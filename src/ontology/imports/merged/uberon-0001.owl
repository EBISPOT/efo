# Class: <http://purl.obolibrary.org/obo/UBERON_0001911> (mammary gland)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BTO:0000817") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Mammary_gland") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://orcid.org/0000-0002-6601-2165") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001911> "A specialized accessory gland of the skin of mammals that secretes milk. The gland is typically only developed in females, and regresses in males.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0001911> "Originally this was classified as a female reproductive structure, as it was in the MP in 2011")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0001911> "mammary")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001911> "A mouse mammary gland contains a single duct or sinus, forming 5-10 secondary ducts")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001911> "The male Dayak fruit bat has lactating mammary glands")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001911> "The mammary glands of humans are in the thoracid/breast region. In other mammals they may be located elsewhere on the mammary ridges.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001911> "The BTO class represents the combination of nipple plus lobe")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001911> "The FMA class represents an individule lobe. The nipple is not a part")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001911> "The MA class represents a composite structure, including the nipple, fat, connective tissue, smooth muscle as parts")

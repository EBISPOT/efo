AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11523816") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAO:MAH") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Neuroranium") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFA:0001580") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001703> "Subdivision of skeletal system that surrounds and protects the brain. Includes the skull base, sensory capsules and the central part of the skull roof.")

# Class: <http://purl.obolibrary.org/obo/UBERON_0001986> (endothelium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:63916") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MESH:A10.272.491") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/225") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001986> "A layer of epithelium that lines the heart, blood vessels (endothelium, vascular), lymph vessels (endothelium, lymphatic), and the serous cavities of the body[MESH]. Simple squamous epithelium which lines blood and lymphatic vessels and the heart[FMA].")

# Class: <http://purl.obolibrary.org/obo/UBERON_0001753> (cementum)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000034") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PSPUB:0000170") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:0000062") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://dx.plos.org/10.1371/journal.pone.0051070") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001753> "Odontoid tissue that is deposited by cementoblasts onto dentine tissue and functions to attach teeth, odontodes and other odontogenic derivatives to bone tissue and the integument.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "FMA:55630") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001753> "Substance of tooth produced by cementoblasts; surrounds the dentine of the root of the tooth[FMA:55630].")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001753> "Cementum, the supporting tissue that anchors mammalian and crocodylian teeth into their sockets, differs among species and can have features of dentine, of bone, and of calcified cartilage, as well as unique features. Cementum is deposited by cementoblasts onto existing dentine. As in bone and dentine, cementoblasts produce an organic matrix, the main constituent of which is collagen type I (Bosshardt, 2005), but cementum, dentine, and bone also share a number of important noncollagenous matrix components such as osteopontin, osteocalcin, bone sialoprotein, a2-HS- glycoprotein, dentine matrix protein, dentine sialoprotein, and den- tine phosphoprotein (McKee et al., 1996; Bosshardt, 2005). it has been argued that in all rodents and ruminants, cementum is a form of calcified cartilage[H&W]")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001753> "BTO:0002525")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001753> "CALOHA:TS-2163")

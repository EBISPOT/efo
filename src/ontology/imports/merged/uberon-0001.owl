SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "FMA-abduced-lr") <http://purl.obolibrary.org/obo/UBERON_0001118> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BSPO_0000126> <http://purl.obolibrary.org/obo/UBERON_0002046>))


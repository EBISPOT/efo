AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0471209627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Trigeminal_nerve") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001645> "Cranial nerve that has three branches - the ophthalmic (supplying the skin of the nose and upper jaw), the maxillary and the mandibular (supplying the lower jaw).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:0471888893") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001645> "the ophthalmic usually usually merges with the other two. In some vertebrates, the ophthalmic emerges from the brain separately[Kardong] The trigeminal nerve has 3 branches in mammals - similar branches are present in nonmammalian vertebrates, but in some a separate profundus nerve that corresponds to opthalmic branch in mammls")

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0471209627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Olfactory_nerve") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001579> "Nerve that carries information from the olfactory epithelium to the olfactory bulb[Butler and Hodos].")

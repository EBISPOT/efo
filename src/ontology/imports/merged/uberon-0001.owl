AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMCID:PMC2553264") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Thumb") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001463> "1st (preaxial) digit of the manus[Wikipedia].")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001463> "Not present in Anurans (Phenotype RCN Oct 2012)")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasScope> "NCBITaxon:8782") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:10220427") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PhenoscapeRCN") Annotation(rdfs:seeAlso "UBERON:0012260") <http://purl.obolibrary.org/obo/UBPROP_0000008> <http://purl.obolibrary.org/obo/UBERON_0001463> "This class represents the standard tetrapod configuration. Wagner proposes that avian digits I,II,III develop from C2,C3,C4. To support this scheme we have separate classes representing the avian digits (here called alula, manual digit, major digit).")

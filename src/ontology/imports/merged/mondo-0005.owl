AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NCIT:P378") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0005663> "A neurologic syndrome following injury of the spinal sympathetic nerves of the neck. The injury usually results from arthritis or pinching by the adjacent vertebrae. Symptoms include facial pain, chronic allergies, dizziness, neck pain, ear pain and vertigo.")

SubClassOf(<http://purl.obolibrary.org/obo/UBERON_2000422> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0003278>))
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_2000422> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/UBERON_0003107>))

# Class: <http://purl.obolibrary.org/obo/UBERON_2000424> (opercular lateral line)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFIN:curator") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_2000424> "One of eight distinct lateral lines in the 4-day larva positioned posteriorly to the second arch skeletal element. A sensory system on the surface of the fish, consisting of small sensory patches (neuromasts) distributed in discrete lines over the body surface. The lateral line system is stimulated by local water displacements and vibrations, and detects propulsion of the fish through the water, as well as facilitating shoaling, prey capture, and predator and obstacle avoidance. (See Anatomical Atlas entry for lateral line by T. Whitfield.).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_2000424> "ZFA:0000424")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_2000424> "UBERON:2000424")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_2000424> "opercular lateral line")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_2000424> <http://purl.obolibrary.org/obo/UBERON_2001470>)
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_2000424> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_2001470>))

# Class: <http://purl.obolibrary.org/obo/UBERON_2000425> (anterior lateral line nerve)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFIN:curator") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_2000425> "Cranial nerve which enters the brain between cranial nerves VI and VII; contains afferents and sensory efferents to the anterior lateral line ganglia.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_2000425> "ZFA:0000425")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAO:0000425") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_2000425> "rostral lateral line nerve")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_2000425> "UBERON:2000425")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_2000425> "anterior lateral line nerve")

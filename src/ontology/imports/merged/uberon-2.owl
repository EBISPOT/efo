# Class: <http://purl.obolibrary.org/obo/UBERON_2000549> (posttemporal)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAO:GA_TG") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_2000549> "Dermal bone of the secondary pectoral girdle that attaches the girdle to the skull. Its dorsal process attaches to the epiotic or epioccipital, the ventral process to the intercalar and the body articulates with the supracleithrum. The postotic sensory canal or lateral line runs within or lateral to bone.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_2000549> "ZFA:0000549")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAO:0000549") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_2000549> "post-temporal")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAO:0000549") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_2000549> "postemporal")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAO:0000549") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_2000549> "posttemporale")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "TAO:0000549") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_2000549> "suprascapula")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_2000549> "UBERON:2000549")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_2000549> <http://purl.obolibrary.org/obo/uberon/core#human_subset>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_2000549> <http://purl.obolibrary.org/obo/uberon/core#mouse_subset>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_2000549> "The posttemporal is commonly a Y-shaped bone with two elongate processes. The dorsal process may be equal or longer than the ventral process or the opposite. The ventral process may be absent in some teleosts.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_2000549> "posttemporal")

# Class: <http://purl.obolibrary.org/obo/UBERON_6005037> (insect tracheal primordium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_6005037> "Primordium of a single tracheal metamere of the embryonic/larval tracheal system from its appearance as a placode during stage 11 to the completion of fusion with adjacent tracheal metameres in stage 15/16. There are 10 pairs of tracheal primordia - one pair in each segment from T2 to A8. Each tracheal primordium originates as a slight depression in the lateral ectoderm during stage 10 known as a tracheal placode. During stage 11, these placodes invaginate to form tracheal pits that elongate and branch. These pits close over during stage 13. Fusion of tracheal primordia begins at stage 14 with fusion of the dorsal trunk primordia and is complete by early stage 16.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0002-7073-9172") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_6005037> "P2 TrachP")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_6005037> "TrachP3")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_6005037> "tracheal placode")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_6005037> "UBERON:6005037")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_6005037> "insect tracheal primordium")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_6005037> <http://purl.obolibrary.org/obo/UBERON_0001048>)

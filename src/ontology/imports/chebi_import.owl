        <oboInOwl:hasDbXref>pubmed:28827781</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:28847800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:28859941</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:28870972</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia.en:Low-density_lipoprotein</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>LDL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>beta-lipoproteins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>low-density lipoproteins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:39026</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>low-density lipoprotein</rdfs:label>
    </owl:Class>

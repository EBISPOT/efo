        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">410.945</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">410.17611</chemrof:monoisotopic_mass>

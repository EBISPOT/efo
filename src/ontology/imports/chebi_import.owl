    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25697"/>
        <obo:IAO_0000115>The organic cation formed formally by addition of an ethylene bridge between the nitrogen atoms of 2,2&apos;-bipyridine. Most often available as the dibromide.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:2764-72-9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>kegg.compound:C18577</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ppdb:1541</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>reaxys:3670526</oboInOwl:hasDbXref>

    <!-- http://purl.obolibrary.org/obo/CHEBI_64194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A maleate salt obtained by reaction of paroxetine with one equivalent of maleic acid. Highly potent and selective 5-HT uptake inhibitor that binds with high affinity to the serotonin transporter (Ki = 0.05 nM). Ki values are 1.1, 350 and 1100 nM for inhibition of [3H]-5-HT, [3H]-l-NA and [3H]-DA uptake respectively. Displays minimal affinity for α1-, α2- or β-adrenoceptors, 5-HT&lt;small&gt;&lt;sub&gt;2A&lt;/sub&gt;&lt;/small&gt;, 5-HT&lt;small&gt;&lt;sub&gt;1A&lt;/sub&gt;&lt;/small&gt;, D&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt; or H&lt;small&gt;&lt;sub&gt;1&lt;/sub&gt;&lt;/small&gt; receptors at concentrations below 1000 nM, however displays weak affinity for muscarinic ACh receptors (Ki = 42 nM). Antidepressant and anxiolytic in vivo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:64006-44-6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>drugbank:DB00715</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>patent:EP1078925</oboInOwl:hasDbXref>

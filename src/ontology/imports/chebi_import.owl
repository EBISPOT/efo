    <!-- http://purl.obolibrary.org/obo/CHEBI_64187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A carbohydrazide that results from the formal condensation of the carboxy group of &lt;small&gt;D&lt;/small&gt;&lt;small&gt;L&lt;/small&gt;-serine with the primary amino group of 4-(hydrazinylmethyl)benzene-1,2,3-triol. An aromatic-&lt;small&gt;L&lt;/small&gt;-amino-acid decarboxylase inhibitor (DOPA decarboxylase inhibitor) that does not enter the central nervous system, it is used as its hydrochloride salt as an adjunct to levodopa in the treatment of parkinsonism. By preventing the conversion of levodopa to dopamine in the periphery, it causes an increase in the amount of levodopa reaching the central nervous system and so reduces the required dose. Benserazide has no antiparkinson actions when given alone.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:322-35-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>drugcentral:314</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>kegg.drug:D03082</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>lincs.smallmolecule:LSM-5097</oboInOwl:hasDbXref>

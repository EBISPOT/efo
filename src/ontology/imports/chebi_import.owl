        <oboInOwl:hasRelatedSynonym>Cer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ceramide</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>N-acylated sphingoid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>a ceramide</oboInOwl:hasRelatedSynonym>

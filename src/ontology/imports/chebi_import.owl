    <!-- http://purl.obolibrary.org/obo/CHEBI_64110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24532"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33853"/>
        <obo:IAO_0000115>A pyrazole that is 1&lt;em&gt;H&lt;/em&gt;-pyrazole bearing three 4-hydroxyphenyl substituents at positions 1, 3 and 5 as well as a propyl substituent at position 4. Potent, subtype-selective estrogen receptor agonist (EC&lt;small&gt;&lt;sub&gt;50&lt;/sub&gt;&lt;/small&gt; ~ 200 pM); displays 410-fold selectivity for ERα over ERβ. Prevents ovariectomy-induced weight gain and loss of bone mineral density, and induces gene expression in the hypothalamus following systemic administration in vivo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>reaxys:8798122</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>4,4&apos;,4&apos;&apos;-(4-propyl-1H-pyrazole-1,3,5-triyl)triphenol</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>1,3,5-tris(4-hydroxyphenyl)-4-propylpyrazole</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4,4&apos;,4&apos;&apos;-(4-propyl-1H-pyrazole-1,3,5-triyl)triphenol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:64110</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>4,4&apos;,4&apos;&apos;-(4-propylpyrazole-1,3,5-triyl)trisphenol</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</chemrof:charge>
        <chemrof:generalized_empirical_formula>C24H22N2O3</chemrof:generalized_empirical_formula>
        <chemrof:inchi_key_string>IOTXSIGGFRQYKW-UHFFFAOYSA-N</chemrof:inchi_key_string>
        <chemrof:inchi_string>InChI=1S/C24H22N2O3/c1-2-3-22-23(16-4-10-19(27)11-5-16)25-26(18-8-14-21(29)15-9-18)24(22)17-6-12-20(28)13-7-17/h4-15,27-29H,2-3H2,1H3</chemrof:inchi_string>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">386.451</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">386.16304</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>CCCc1c(-c2ccc(O)cc2)nn(-c2ccc(O)cc2)c1-c1ccc(O)cc1</chemrof:smiles_string>
    </owl:Class>
    <owl:Axiom>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A mucopolysaccharide composed of &lt;em&gt;N&lt;/em&gt;-acetylglucosamine and glucuronic acid subunits. It is found in the connective tissues of vertebrates. A principal constituent of the extracellular matrix (ECM), it mediates the growth and metastasis of tumour cells.</obo:IAO_0000115>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>An aromatic hydrocarbon comprising two fused benzene rings. It occurs in the essential oils of numerous plant species e.g. magnolia.</obo:IAO_0000115>

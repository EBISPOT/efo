    <!-- http://purl.obolibrary.org/obo/CHEBI_26948 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_26948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24532"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25697"/>
        <obo:IAO_0000115>Any member of the group of 1,3-thiazolium cations that exhibit biological activity against vitamin B&lt;small&gt;&lt;sub&gt;1&lt;/sub&gt;&lt;/small&gt; deficiency in animals. Symptoms of vitamin B&lt;small&gt;&lt;sub&gt;1&lt;/sub&gt;&lt;/small&gt; deficiency include constipation, loss of apetite, fatigue, nausea, delirium, blurry vision and muscle weakness. Severe vitamin B&lt;small&gt;&lt;sub&gt;1&lt;/sub&gt;&lt;/small&gt; deficiency can also lead to a disease known as &lt;a href=&quot;https://en.wikipedia.org/wiki/Thiamine_deficiency&quot; target=&quot;_blank&quot;&gt;beriberi&lt;/a&gt;. Vitamin B&lt;small&gt;&lt;sub&gt;1&lt;/sub&gt;&lt;/small&gt; consists of the vitamer thiamin and its acid, aldehyde and phosphorylated derivatives (and their corresponding ionized, salt and hydrate forms).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>pubmed:28859374</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:32554808</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>thiamine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thiamines</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>thiamins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B1 vitamer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamin B1 vitamers</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamins B1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:26948</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>vitamin B1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26948"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>pubmed:28859374</owl:annotatedTarget>
        <oboInOwl:source>pubmed</oboInOwl:source>

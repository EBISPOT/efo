    <!-- http://purl.obolibrary.org/obo/CHEBI_20717 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_20717">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15889"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35341"/>
        <obo:IAO_0000115>Typhasterol in which the oxygen atom of the keto group has been substituted by two hydrogen atoms. A member of a biosynthetic pathway to castasterone, it has been isolated from the primary roots of maize.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>beilstein:7382071</oboInOwl:hasDbXref>

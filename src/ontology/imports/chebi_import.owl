    <!-- http://purl.obolibrary.org/obo/CHEBI_63916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_63916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33575"/>
        <obo:IAO_0000115>A carbobicyclic compound that is prostaglandin I&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt; in which the endocyclic oxygen is replaced by a methylene group and in which the (1&lt;i&gt;E&lt;/i&gt;,3&lt;i&gt;S&lt;/i&gt;)-3-hydroxyoct-1-en-1-yl side chain is replaced by a (3&lt;i&gt;R&lt;/i&gt;)-3-hydroxy-4-methyloct-1-en-6-yn-1-yl group. A synthetic analogue of prostacyclin, it is used as the trometamol salt (generally by intravenous infusion) for the treatment of peripheral vascular disease and pulmonary hypertension.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:78919-13-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>drugbank:DB01088</oboInOwl:hasDbXref>

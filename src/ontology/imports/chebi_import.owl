    <!-- http://purl.obolibrary.org/obo/CHEBI_27584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>

        <oboInOwl:hasRelatedSynonym>8-bromo cGMP sodium salt</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>8-bromoguanosine 3&apos;,5&apos;-cyclic phosphate sodium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>8-bromoguanosine 3&apos;,5&apos;-cyclic phosphate sodium salt</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sodium 8-bromoguanosine 3&apos;,5&apos;-cyclic phosphate</oboInOwl:hasRelatedSynonym>

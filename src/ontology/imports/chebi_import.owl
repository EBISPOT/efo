    <!-- http://purl.obolibrary.org/obo/CHEBI_64143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A polyketide obtained from the fungus &lt;em&gt;Alternaria brassicicola&lt;/em&gt; and having a highly unusual structure of an 11-carbon chain containing two epoxides and six stereogenic centres.  It is an inhibitor of histone deacetylase (HDAC) both &lt;em&gt;in vivo&lt;/em&gt; and &lt;em&gt;in vitro&lt;/em&gt; and also exhibits anti-angiogenic activity.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:139508-73-9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:10737176</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:11562279</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:12623206</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:1500354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:1731795</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:19737099</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:8845831</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:9383455</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:9520362</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:9520369</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>reaxys:6803701</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>(1R)-1-{(2S,3S)-3-[(E)-2-{(2S,3S)-3-[(1R)-1-hydroxyethyl]oxiran-2-yl}ethenyl]oxiran-2-yl}prop-2-en-1-ol</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>(1S,3E,6S)-1,2:5,6-dianhydro-3,4-dideoxy-1-[(1R)-1-hydroxyethyl]-6-[(1R)-1-hydroxyprop-2-en-1-yl]-D-threo-hex-3-enitol</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>

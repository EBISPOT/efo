    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_34785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25705"/>
        <obo:IAO_0000115>A cyclodiene organochlorine insecticide that is 3a,4,7,7a-tetrahydro-1&lt;em&gt;H&lt;/em&gt;-4,7-methanoindene substituted by chlorine atoms at positions 1, 4, 5, 6, 7, 8 and 8. Formerly used to kill termites, ants and other insects in agricultural and domestic situations.</obo:IAO_0000115>

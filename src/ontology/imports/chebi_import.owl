    <!-- http://purl.obolibrary.org/obo/CHEBI_39025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_39025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36080"/>
        <obo:IAO_0000115>A class of lipoproteins of small size (4-13 nm) and dense (greater than 1.063 g/ml) particles. They are synthesized in the liver without a lipid core, accumulate cholesterol esters from peripheral tissues and transport them to the liver for re-utilization or elimination from the body (the reverse cholesterol transport).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>HDL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>alpha-lipoproteins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>high-density lipoproteins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:39025</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>high-density lipoprotein</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_39025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HDL</owl:annotatedTarget>
        <oboInOwl:hasDbXref>chebi</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_39025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>alpha-lipoproteins</owl:annotatedTarget>
        <oboInOwl:hasDbXref>chebi</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_39025"/>

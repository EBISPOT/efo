    <!-- http://purl.obolibrary.org/obo/CHEBI_64216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>An ergoline alkaloid that is the &lt;em&gt;N&lt;/em&gt;-benzyloxycarbonyl derivative of lysergamine. A 5-HT&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt; antagonist. Also 5-HT&lt;small&gt;&lt;sub&gt;1&lt;/sub&gt;&lt;/small&gt; antagonist and 5-HT&lt;small&gt;&lt;sub&gt;1D&lt;/sub&gt;&lt;/small&gt; ligand. Has moderate affinity for 5-HT&lt;small&gt;&lt;sub&gt;6&lt;/sub&gt;&lt;/small&gt; and high affinity for 5-HT&lt;small&gt;&lt;sub&gt;7&lt;/sub&gt;&lt;/small&gt;.</obo:IAO_0000115>

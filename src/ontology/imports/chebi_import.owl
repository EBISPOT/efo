    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_3165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16670"/>
        <obo:IAO_0000115>A linear nonapeptide messenger belonging to the kinin group of proteins, with amino acid sequence RPPGFSPFR. Enzymatically produced from kallidin in the blood, it is a powerful vasodilator that causes smooth muscle contraction, and may mediate inflammation.</obo:IAO_0000115>

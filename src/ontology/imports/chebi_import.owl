        <oboInOwl:hasDbXref>reaxys:2218363</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia.en:Chlorpropamide</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>1-(p-chlorobenzenesulfonyl)-3-propylurea</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1-(p-chlorophenylsulfonyl)-3-propylurea</oboInOwl:hasRelatedSynonym>

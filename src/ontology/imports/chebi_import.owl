    <!-- http://purl.obolibrary.org/obo/CHEBI_49375 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_49375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24532"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37622"/>
        <obo:IAO_0000115>An aminopyrimidine that is 2-methylpyrimidine which is substituted at position 4 by the primary amino group of 2-amino-1,3-thiazole-5-carboxylic acid and at position 6 by a 4-(2-hydroxyethyl)piperazin-1-yl group, and in which the carboxylic acid group has been formally condensed with 2-chloro-6-methylaniline to afford the corresponding amide. A multi-targeted kinase inhibitor, it is used, particularly as the monohydrate, for the treatment of chronic, accelerated, or myeloid or lymphoid blast phase chronic myeloid leukemia. Note that the name &apos;dasatinib&apos; is used to refer to the monohydrate (USAN) as well as to anhydrous dasatinib (INN).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:38943</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:49372</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>cas:302962-49-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>drugbank:DB01254</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>drugcentral:785</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>hmdb:HMDB0015384</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>kegg.drug:D03658</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>lincs.smallmolecule:LSM-1020</oboInOwl:hasDbXref>

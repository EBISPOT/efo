    <!-- http://purl.obolibrary.org/obo/CHEBI_17203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_17203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26271"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33709"/>
        <obo:IAO_0000115>Pyrrolidine in which the &lt;em&gt;pro&lt;/em&gt;-&lt;i&gt;S&lt;/i&gt; hydrogen at position 2 is substituted by a carboxylic acid group. &lt;small&gt;L&lt;/small&gt;-Proline is the only one of the twenty DNA-encoded amino acids which has a secondary amino group α to the carboxyl group. It is an essential component of collagen and is important for proper functioning of joints and tendons. It also helps maintain and strengthen heart muscles.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:13154</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:184637</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:21373</oboInOwl:hasAlternativeId>

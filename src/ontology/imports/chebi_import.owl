    <!-- http://purl.obolibrary.org/obo/CHEBI_32246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_32246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A racemate comprising of equimolar amounts of (&lt;i&gt;R&lt;/i&gt;)- and (&lt;i&gt;S&lt;/i&gt;)-tolvaptan. It is a selective vasopressin V&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt; receptor antagonist used to treat euvolemic and hypervolemic hyponatremia. It is also used in the treatment of rapidly progressing autosomal dominant polycystic kidney disease to slow the rate of cyst development and renal insufficiency.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:150683-30-0</oboInOwl:hasDbXref>

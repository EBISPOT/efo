    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_9467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A racemate consisting of equal amounts of (3&lt;i&gt;R&lt;/i&gt;,11b&lt;i&gt;R&lt;/i&gt;)- and (3&lt;i&gt;S&lt;/i&gt;,11b&lt;i&gt;S&lt;/i&gt;)-9,10-dimethoxy-3-isobutyl-1,3,4,6,7,11b-hexahydro-2&lt;em&gt;H&lt;/em&gt;-pyrido[2,1-&lt;em&gt;a&lt;/em&gt;]isoquinolin-2-one. An adrenergic uptake inhibitor, it was formerly used as an antipsychotic, but it is now used mainly for the treatment of various movement disorders including chorea, ballism, dystonias, and tardive dyskinesia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:58-46-8</oboInOwl:hasDbXref>

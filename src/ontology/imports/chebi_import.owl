    <!-- http://purl.obolibrary.org/obo/CHEBI_64165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A hydrobromide salt obtained by reaction of clobenpropit with two equivalents of hydrobromic acid. An extremely potent histamine H&lt;small&gt;&lt;sub&gt;3&lt;/sub&gt;&lt;/small&gt; antagonist/inverse agonist (pA&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt; = 9.93). Also displays partial agonist activity at H&lt;small&gt;&lt;sub&gt;4&lt;/sub&gt;&lt;/small&gt; receptors; induces eosinophil shape change with an EC&lt;small&gt;&lt;sub&gt;50&lt;/sub&gt;&lt;/small&gt; of 3 nM.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:145231-35-2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>reaxys:584034</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>3-(1H-imidazol-4-yl)propyl N-(4-chlorobenzyl)carbamimidothioate dihydrobromide</oboInOwl:hasExactSynonym>

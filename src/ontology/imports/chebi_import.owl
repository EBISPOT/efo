    <!-- http://purl.obolibrary.org/obo/CHEBI_64158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A hydrochloride salt obtained by reaction of 2-methyl-6-(phenylethynyl)pyridine with one equivalent of hydrochloric acid. Potent and highly selective non-competitive antagonist at the mGlu&lt;small&gt;&lt;sub&gt;5&lt;/sub&gt;&lt;/small&gt; receptor subtype (IC&lt;small&gt;&lt;sub&gt;50&lt;/sub&gt;&lt;/small&gt; = 36 nM) and a positive allosteric modulator at mGlu&lt;small&gt;&lt;sub&gt;4&lt;/sub&gt;&lt;/small&gt; receptors. Centrally active following systemic administration in vivo. Reverses mechanical hyperalgesia in the inflamed rat hind paw.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>pubmed:20347777</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>reaxys:9652435</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>2-methyl-6-(phenylethynyl)pyridine hydrochloride</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>2-methyl-6-(phenylethynyl)pyridine hydrochloride</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>2-methyl-6-(phenylethynyl)pyridinium chloride</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>6-methyl-2-(phenylethynyl)pyridine hydrochloride</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>6-methyl-2-(phenylethynyl)pyridinium chloride</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MPEP hydrochloride</oboInOwl:hasRelatedSynonym>

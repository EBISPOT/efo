    <!-- http://purl.obolibrary.org/obo/CHEBI_27744 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_27744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A phosphonic acid resulting from the formal oxidative coupling of the methyl group of methylphosphonic acid with the amino group of glycine. It is one of the most commonly used herbicides worldwide, and the only one to target the enzyme 5-enolpyruvyl-3-shikimate phosphate synthase (EPSPS).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:24423</oboInOwl:hasAlternativeId>

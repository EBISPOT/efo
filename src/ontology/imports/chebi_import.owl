    <!-- http://purl.obolibrary.org/obo/CHEBI_40036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_40036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24532"/>
        <obo:IAO_0000115>A member of the class of triazoles that is 1&lt;em&gt;H&lt;/em&gt;-1,2,4-triazole substituted by an amino group at position 3. Used to control annual grasses and aquatic weeds (but not on food crops because it causes cancer in laboratory animals). Its use within the EU was banned from September 2017 on the grounds of potential groundwater contamination and risks to aquatic life; there have also been concerns about its endocrine-disrupting properties.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:1448</oboInOwl:hasAlternativeId>

    <!-- http://purl.obolibrary.org/obo/CHEBI_64073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16670"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A bioactive polypeptide of 39 amino acid residues isolated from the saliva of the Gila monster (&lt;em&gt;Heloderma suspectum&lt;/em&gt;). High-affinity glucagon-like peptide 1 (GLP-1) receptor agonist (&lt;em&gt;K&lt;/em&gt;&lt;small&gt;&lt;sub&gt;d&lt;/sub&gt;&lt;/small&gt; = 136 pM); potently induces cAMP formation without stimulating amylase release in pancreatic acini; potentiates glucose-induced insulin secretion in isolated rat islets; protects against glutamate-induced neurotoxicity. A synthetic version is called exenatide.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:141758-74-9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>kegg.compound:C15894</oboInOwl:hasDbXref>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A hydrochloride that is the monohydrochloride salt of 3-[4-(3-chlorophenyl)piperazin-1-yl]-1,1-diphenylpropan-2-ol. A selective h5-HT&lt;small&gt;&lt;sub&gt;1D&lt;/sub&gt;&lt;/small&gt; antagonist, displaying 60-fold selectivity over h5-HT&lt;small&gt;&lt;sub&gt;1B&lt;/sub&gt;&lt;/small&gt;, and exhibiting little or no affinity for a range of other receptor types.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>chemspider:10131725</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>reaxys:9024485</oboInOwl:hasDbXref>

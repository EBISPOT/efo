    <!-- http://purl.obolibrary.org/obo/CHEBI_64081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A hydrochloride salt obtained by mixing equimolar amounts of RS 39604 with hydrochloric acid. A potent and selective 5-HT4 antagonist, with a pKi of 9.1 at 5-HT4 receptors in guinea pig striatal membranes and greater than 1000-fold selectivity over 5-HT1A, 2C, 3 and D1, D2, M1, M2, AT1, B1 and α1C receptors. The ketone group gives RS 39604 a relatively long half life; it is also orally active and so suitable for in vivo studies.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:168986-61-6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>reaxys:8889150</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>N-{2-[4-(3-{4-amino-5-chloro-2-[(3,5-dimethoxybenzyl)oxy]phenyl}-3-oxopropyl)piperidin-1-yl]ethyl}methanesulfonamide hydrochloride</oboInOwl:hasExactSynonym>

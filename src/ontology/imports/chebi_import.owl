    <!-- http://purl.obolibrary.org/obo/CHEBI_64115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A hydrochloride obtained by reaction of (1&lt;i&gt;S&lt;/i&gt;,2&lt;i&gt;R&lt;/i&gt;)-5-methoxy-1-methyl-2-(propylamino)tetralin with one equivalent of hydrochloric acid. Dopamine receptor antagonist with preferential action at presynaptic receptors (pKi values are 6.95, 6.67, 6.37, 6.21 and 6.07 at hD3. hD4, hD2S, hD2L and rD2 receptors respectively).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>reaxys:6076657</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>(1S,2R)-5-methoxy-1-methyl-N-propyl-1,2,3,4-tetrahydronaphthalen-2-amine hydrochloride</oboInOwl:hasExactSynonym>

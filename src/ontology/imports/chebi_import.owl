    <!-- http://purl.obolibrary.org/obo/CHEBI_9150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_9150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18059"/>

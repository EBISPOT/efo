        <oboInOwl:hasRelatedSynonym>S-{2-[1H-imidazol-4-yl]ethyl}isothiourea dihydrobromide</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>imetit hydrobromide</oboInOwl:hasRelatedSynonym>

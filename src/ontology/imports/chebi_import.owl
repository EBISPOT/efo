        <oboInOwl:hasRelatedSynonym>1-[4-(5-carboxy-1H-indol-3-yl)butyl]-4-phenyl-1,2,3,6-tetrahydropyridinium chloride</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3-[4-(4-phenyl-3,6-dihydropyridin-1(2H)-yl)butyl]-1H-indole-5-carboxylic acid hydrochloride</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:64199</oboInOwl:id>

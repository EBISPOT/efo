    <!-- http://purl.obolibrary.org/obo/CHEBI_3179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_3179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>The simplest member of the class of bromobenzenes, that is benzene in which a single hydrogen has been substituted by a bromine. A liquid at room temperature (m.p. −30°C; b.p.&lt;small&gt;&lt;sub&gt;760&lt;/sub&gt;&lt;/small&gt; 156°C), it is used as a solvent, particularly for large-scale crystallisations, and for the introduction of phenyl groups in organic synthesis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:108-86-1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>kegg.compound:C11036</oboInOwl:hasDbXref>

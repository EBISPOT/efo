    <!-- http://purl.obolibrary.org/obo/CHEBI_6078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_6078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A mixture consisting of ≥ 90% 22,23-dihydroavermectin B&lt;small&gt;&lt;sub&gt;1a&lt;/sub&gt;&lt;/small&gt; (R = Me) and ≤ 10% 22,23-dihydroavermectin B&lt;small&gt;&lt;sub&gt;1b&lt;/sub&gt;&lt;/small&gt; (R = H). A semi-synthetic derivative of abamectin, it is used as a broad-spectrum antiparasite medication, particularly against worms (except tapeworms), although it is also effective against most mites and some lice.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:70288-86-7</oboInOwl:hasDbXref>

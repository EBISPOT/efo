        <oboInOwl:hasRelatedSynonym>4,4&apos;-(1,1-dioxido-3H-2,1-benzoxathiole-3,3-diyl)diphenol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4,4&apos;-(3H-2,1-benzoxathiol-3-ylidene)bisphenol S,S-dioxide</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PSP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Phenol red</oboInOwl:hasRelatedSynonym>

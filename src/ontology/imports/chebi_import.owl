    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_15866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16646"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18133"/>
        <obo:IAO_0000115>A deoxyglucose that is &lt;small&gt;D&lt;/small&gt;-glucose in which the hydroxy group at position 2 has been replaced by a hydrogen. It is an antimetabolite of glucose with antiviral activity, which acts by inhibiting the glycosylation of glycoproteins and glycolipids. Used as an antiherpes agent.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:1078</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:11565</oboInOwl:hasAlternativeId>

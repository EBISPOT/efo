    <!-- http://purl.obolibrary.org/obo/CHEBI_64162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A maleate salt obtained by reaction of &lt;em&gt;N&lt;/em&gt;-methylquipazine with two equivalents of maleic acid. A 5-HT&lt;small&gt;&lt;sub&gt;3&lt;/sub&gt;&lt;/small&gt; agonist. Has almost the same affinity for 5-HT&lt;small&gt;&lt;sub&gt;3&lt;/sub&gt;&lt;/small&gt; sites as quipazine but unlike the latter, does not bind to 5-HT&lt;small&gt;&lt;sub&gt;1B&lt;/sub&gt;&lt;/small&gt; sites.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>reaxys:7614127</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>2-(4-methylpiperazin-1-yl)quinoline di[(2Z)-but-2-enedioate]</oboInOwl:hasExactSynonym>

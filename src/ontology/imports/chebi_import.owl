    <!-- http://purl.obolibrary.org/obo/CHEBI_68510 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_68510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35766"/>
        <obo:IAO_0000115>An acylglycerophosphoserine resulting from partial hydrolysis of a phosphatidylserine, which removes one of the fatty acid groups. The structure is depicted in the image where R&lt;small&gt;&lt;sup&gt;1&lt;/small&gt;&lt;/sup&gt; = acyl, R&lt;small&gt;&lt;sup&gt;2&lt;/small&gt;&lt;/sup&gt; = H or where R&lt;small&gt;&lt;sup&gt;1&lt;/small&gt;&lt;/sup&gt; = H, R&lt;small&gt;&lt;sup&gt;2&lt;/small&gt;&lt;/sup&gt; = acyl. Formula C&lt;small&gt;&lt;sub&gt;7&lt;/sub&gt;&lt;/small&gt;H&lt;small&gt;&lt;sub&gt;13&lt;/sub&gt;&lt;/small&gt;NO&lt;small&gt;&lt;sub&gt;9&lt;/sub&gt;&lt;/small&gt;PR, where R represents the hydrocarbon chain of the fatty acyl group.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>monoacylglycerophosphoserine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:68510</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>lysophosphatidylserine</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</chemrof:charge>
        <chemrof:generalized_empirical_formula>C7H13NO9PR</chemrof:generalized_empirical_formula>
        <chemrof:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">286.153</chemrof:mass>
        <chemrof:monoisotopic_mass rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">257.03005</chemrof:monoisotopic_mass>
        <chemrof:smiles_string>[1*]OC[C@H](COP(=O)(O)OC[C@H](N)C(=O)O)O[2*]</chemrof:smiles_string>
    </owl:Class>

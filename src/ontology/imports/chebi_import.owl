        <oboInOwl:hasDbXref>pubmed:17482154</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:17498396</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:18194117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:18611107</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:18996104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:19689217</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>reaxys:318158</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>wikipedia.en:Mycophenolic_acid</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>(4E)-6-(4-hydroxy-6-methoxy-7-methyl-3-oxo-1,3-dihydro-2-benzofuran-5-yl)-4-methylhex-4-enoic acid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>

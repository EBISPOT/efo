    <!-- http://purl.obolibrary.org/obo/CHEBI_64086 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A hydrochloride salt that is obtained by reaction of vanoxerine with two equivalents of hydrogen chloride. Potent, competitive inhibitor of dopamine uptake (Ki = 1 nM for inhibition of striatal dopamine uptake). Has &gt; 100-fold lower affinity for the noradrenalin and 5-HT uptake carriers. Also a potent sigma ligand (IC&lt;small&gt;&lt;sub&gt;50&lt;/sub&gt;&lt;/small&gt; = 48 nM). Centrally active following systemic administration.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:67469-78-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:10640288</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:10939577</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:16014753</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:7700571</oboInOwl:hasDbXref>

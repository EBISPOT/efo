    <!-- http://purl.obolibrary.org/obo/CHEBI_63622 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_63622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A sulfonamide that is &lt;em&gt;N&lt;/em&gt;-phenylmethanesulfonamide in which the phenyl group is substituted at position 4 by a 1-hydroxy-2-(isopropylamino)ethyl group. It has both β-adrenoreceptor blocking (Vaughan Williams Class II) and cardiac action potential duration prolongation (Vaughan Williams Class III) antiarrhythmic properties. It is used (usually as the hydrochloride salt) for the management of ventricular and supraventricular arrhythmias.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:9206</oboInOwl:hasAlternativeId>

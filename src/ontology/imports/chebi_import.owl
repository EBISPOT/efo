    <!-- http://purl.obolibrary.org/obo/CHEBI_9011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_9011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A racemate consisting of equal parts of (&lt;i&gt;R&lt;/i&gt;)- and (&lt;i&gt;S&lt;/i&gt;)-salmeterol.   It is a potent and selective β&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt;-adrenoceptor agonist (EC&lt;small&gt;&lt;sub&gt;50&lt;/sub&gt;&lt;/small&gt; = 5.3 nM). Unlike other β&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt; agonists, it binds to the exo-site domain of β&lt;small&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/small&gt; receptors, producing a slow onset of action and prolonged activation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:89365-50-4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>drugbank:DB00938</oboInOwl:hasDbXref>

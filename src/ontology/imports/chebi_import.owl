    <!-- http://purl.obolibrary.org/obo/CHEBI_15767 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_15767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>A member of the class of chloromethanes that is methane in which two of the hydrogens have been replaced by chlorine. A dense, non-flammible colourless liquid at room temperature (b.p. 40°C, d = 1.33) which is immiscible with water, it is widely used as a solvent, a paint stripper, and for the removal of caffeine from coffee and tea.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:14139</oboInOwl:hasAlternativeId>

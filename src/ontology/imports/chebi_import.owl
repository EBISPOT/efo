        <oboInOwl:hasDbXref>pubmed:22071594</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:22118289</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:22126455</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:22245565</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pubmed:22373701</oboInOwl:hasDbXref>

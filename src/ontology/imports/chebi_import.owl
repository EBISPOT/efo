    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_32120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>The dihydrochloride salt of sapropterin. It is used for the diagnosis and treatment of variant forms of phenylketonuria (hyperphenylalaninaemia) associated with tetrahydrobiopterin deficiency. Natural cofactor for phenylalanine hydroxylase, tyrosine hydroxylase, tryptophan hydroxylase, and nitric oxide synthetase.</obo:IAO_0000115>

    <!-- http://purl.obolibrary.org/obo/CHEBI_18127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_18127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <obo:IAO_0000115>An alkane-α,ω-diamine comprising a straight-chain pentane core with amino substitutents at positions 1 and 5. A colourless syrupy liquid diamine with a distinctive unpleasant odour, it is a homologue of putresceine and is formed by the bacterial decarboxylation of lysine that occurs during protein hydrolysis during putrefaction of animal tissue. It is also found in plants such as soyabean.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:13928</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:22974</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:3288</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:44370</oboInOwl:hasAlternativeId>

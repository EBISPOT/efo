    <!-- http://purl.obolibrary.org/obo/CHEBI_64119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_64119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_32168"/>
        <obo:IAO_0000115>An optically active form of sulpiride having (&lt;i&gt;S&lt;/i&gt;)-configuration. The active enantiomer of the racemic drug sulpiride. Selective D2-like dopamine antagonist (Ki values are ~ 0.015. ~ 0.013, 1, ~ 45 and ~ 77 μM at D2, D3, D4, D1 and D5 receptors respectively).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:23672-07-3</oboInOwl:hasDbXref>

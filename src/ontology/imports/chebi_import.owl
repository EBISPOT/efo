        <oboInOwl:hasRelatedSynonym>gamma-carboxy-L-glutamate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gamma-carboxyglutamate</oboInOwl:hasRelatedSynonym>

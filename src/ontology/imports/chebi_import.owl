        <rdfs:label>carmoxirole hydrochloride</rdfs:label>
        <chemrof:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</chemrof:charge>
        <chemrof:generalized_empirical_formula>C24H26N2O2.HCl</chemrof:generalized_empirical_formula>

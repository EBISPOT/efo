    <!-- http://purl.obolibrary.org/obo/CHEBI_50683 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50683">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23924"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35221"/>
        <obo:IAO_0000115>An EC 1.5.1.* (oxidoreductase acting on donor CH-NH group, NAD&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt; or NADP&lt;small&gt;&lt;sup&gt;+&lt;/small&gt;&lt;/sup&gt; as acceptor) inhibitor that interferes with the action of dihydrofolate reductase (EC 1.5.1.3).</obo:IAO_0000115>

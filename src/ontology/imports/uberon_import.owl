        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003923"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pancreatic bud that gives rise to the accessory pancreatic duct.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Pancreatic_bud</oboInOwl:hasDbXref>
    </owl:Axiom>

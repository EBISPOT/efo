    <!-- http://purl.obolibrary.org/obo/UBERON_0004746 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002513"/>

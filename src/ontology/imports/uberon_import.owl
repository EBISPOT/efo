    <!-- http://purl.obolibrary.org/obo/UBERON_0007646 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007645"/>
        <obo:IAO_0000115>The innermost layer of the mesenchymal capsule that surrounds the developing brain, primarily of neural crest origin. The endomeninx forms the leptomeninx.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>future leptomeninges</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>future leptomeninx</oboInOwl:hasExactSynonym>

        <oboInOwl:hasDbXref>VHOG:0000559</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000279</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>segmental plate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>unsegmented paraxial mesoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>PSM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>presumptive somite mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somitogenic mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somitomeric mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unsegmented mesenchyme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003059</oboInOwl:id>

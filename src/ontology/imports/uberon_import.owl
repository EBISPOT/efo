        <oboInOwl:hasDbXref>NCIT:C12256</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362138004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0007144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cardia</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cardial part of stomach</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gastric cardia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pars cardiaca (gaster)</oboInOwl:hasExactSynonym>

        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/6/65/Vestibular_system%27s_semicircular_canal-_a_cross-section.jpg</foaf:depiction>

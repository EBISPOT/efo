            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thick plate of cells derived from the neural ectoderm in the head region of the embryo that develops into the olfactory region of the nasal cavity.</obo:IAO_0000115>
        <obo:UBPROP_0000003>We conclude this section by listing some of the many synapomorphies of craniates, including (...) (2) neurogenic placodes (...).[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasDbXref>AAO:0011076</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0006222</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0003420</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA2:0001232</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:1504</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16543</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:293971</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000048</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000186</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Nasal_placode</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000048</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>olfactory placodes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>placoda nasalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>placoda olfactoria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>nasal I placode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nasal placode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003050</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>

        <oboInOwl:hasDbXref>SCTID:280682006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001329</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0229221</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001168</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Inner_plexiform_layer</oboInOwl:hasDbXref>

    <!-- http://purl.obolibrary.org/obo/UBERON_0002734 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014687"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001871"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The superior temporal sulcus is the sulcus separating the superior temporal gyrus from the middle temporal gyrus in the temporal lobe of the brain. The superior temporal sulcus is the first sulcus inferior to the lateral fissure. It is involved in the perception of where others are gazing and is thus important in determining where others&apos; emotions are being directed. It is also involved in the perception of biological motion.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>STS</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:sts</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:1534</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Tel-Cx-STS</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10629</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9378</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279344005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0228237</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Superior_temporal_sulcus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:129</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>parallel sulcus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sulcus t1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>superior temporal fissure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>sulcus temporalis primus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sulcus temporalis superior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002734</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>superior temporal sulcus</rdfs:label>
    </owl:Class>

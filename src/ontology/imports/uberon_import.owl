    <!-- http://purl.obolibrary.org/obo/UBERON_0002257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015212"/>

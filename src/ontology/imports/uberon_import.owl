    <!-- http://purl.obolibrary.org/obo/UBERON_0000994 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000062"/>

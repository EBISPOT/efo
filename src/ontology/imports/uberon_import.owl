        <oboInOwl:hasExactSynonym>inferior caval vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior vena cava</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>caudal vena cava</oboInOwl:hasRelatedSynonym>

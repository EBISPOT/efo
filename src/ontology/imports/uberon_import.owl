        <oboInOwl:hasDbXref>MIAA:0000337</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0001059</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>will be ceded to arthropod anatomy ontology</rdfs:comment>
        <rdfs:label>pars intercerebralis</rdfs:label>
    </owl:Class>

                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001911"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Projection of skin containing the outlets for 15-20 lactiferous ducts arranged cylindrically around the tip.</obo:IAO_0000115>
        <obo:UBPROP_0000008>a male mouse has no nipples - mammary tissue regresses during embryonic development</obo:UBPROP_0000008>
        <obo:UBPROP_0000012>FMA makes this part of the breast, whereas in MA it is part of the mammary gland -</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>BTO:0000821</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-2234</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:36508</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:67771</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:35</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000796</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D009558</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12299</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:265780004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0028109</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Nipple</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Nipple</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>papilla mammae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>papilla of breast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thele</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thelium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>papillary part of breast</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>teat</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>papilla mammaria</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002030</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0002073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0036150"/>

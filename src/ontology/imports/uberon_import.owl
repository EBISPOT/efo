    <!-- http://purl.obolibrary.org/obo/UBERON_0004363 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001637"/>

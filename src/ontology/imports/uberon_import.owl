        <oboInOwl:hasDbXref>Wikipedia:Spinous_process</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001336</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>processus spinosus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>processus spinosus vertebrae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spinous process of vertebra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vertebra spinous process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>neural spine</oboInOwl:hasRelatedSynonym>

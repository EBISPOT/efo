    <!-- http://purl.obolibrary.org/obo/UBERON_0015228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003103"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A hollow, muscular organ, which, by contracting rhythmically, contributes to the circulation of lymph, blood or analogs. Examples: a chambered vertebrate heart; the tubular peristaltic heart of ascidians; the dorsal vessel of an insect; the lymoh heart of a reptile.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>heart</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>cardiac pump</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>heart or heart like organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>circulatory vessel</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>cardiac structure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0015228</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#grouping_class"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>circulatory organ</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015228"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hollow, muscular organ, which, by contracting rhythmically, contributes to the circulation of lymph, blood or analogs. Examples: a chambered vertebrate heart; the tubular peristaltic heart of ascidians; the dorsal vessel of an insect; the lymoh heart of a reptile.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    



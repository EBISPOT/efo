        <oboInOwl:hasExactSynonym>alisphenoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pterosphenoids</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:2000419</oboInOwl:id>

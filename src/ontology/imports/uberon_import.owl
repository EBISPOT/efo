        <oboInOwl:ontology>VHOG</oboInOwl:ontology>
        <oboInOwl:source>http://bgee.unil.ch/</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Anatomical structure which consists of a membranous sac used to temporarily store urine until it is excreted from the body.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0000623</oboInOwl:external_class>
        <oboInOwl:ontology>AAO</oboInOwl:ontology>
        <oboInOwl:source>AAO:BJB</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>In tetrapods, the urinary bladder arises as an outpocketing of the cloaca. (...) The tetrapod urinary bladder appears first among amphibians and is present in Sphenodon, turtles, most lizards, ostriches among birds, and all mammals.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000740</oboInOwl:external_class>
        <oboInOwl:ontology>VHOG</oboInOwl:ontology>
        <oboInOwl:source>ISBN:978-0072528305 Kardong KV, Vertebrates: Comparative Anatomy, Function, Evolution (2006) p.577-78</oboInOwl:source>
        <oboInOwl:source>http://bgee.unil.ch/</oboInOwl:source>
    </owl:Axiom>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The mental foramen is one of two holes (&apos;foramina&apos;) located on the anterior surface of the mandible. It permits passage of the mental nerve and vessels. The mental foramen descends slightly in edentulous individuals.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>AAO:0000298</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:53171</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000080383</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:244686000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mental_foramen</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mental foramina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>foramen mentale</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>foramen mentalis</oboInOwl:hasRelatedSynonym>

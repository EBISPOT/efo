        <rdfs:label>occipital bone</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/2/27/Gray194.png</foaf:depiction>

        <oboInOwl:hasDbXref>EHDAA:6385</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:18609</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100379</oboInOwl:hasDbXref>

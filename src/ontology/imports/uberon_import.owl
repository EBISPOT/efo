        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>UMLS:C0036099</owl:annotatedTarget>
        <oboInOwl:source>ncithesaurus:Minor_Salivary_Gland</oboInOwl:source>

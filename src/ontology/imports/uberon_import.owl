    <!-- http://purl.obolibrary.org/obo/UBERON_0001710 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001710">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000475"/>

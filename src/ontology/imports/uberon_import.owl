        <oboInOwl:hasDbXref>BTO:0000759</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Liver</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Organ which secretes bile and participates in formation of certain blood proteins.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0010111</oboInOwl:external_class>

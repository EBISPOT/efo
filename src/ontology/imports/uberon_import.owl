        <oboInOwl:hasDbXref>UMLS:C0175196</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Entorhinal_cortex</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:168</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>entorhinal area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Brodmann&apos;s area 28</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>area entorhinalis (28,34)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>area entorhinalis ventralis et dorsalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cortex entorhinalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>entorhinal cortex</oboInOwl:hasRelatedSynonym>

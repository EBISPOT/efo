        <oboInOwl:hasDbXref>HAO:0000144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000023</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D005121</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000023</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C61460</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0598782</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VSAO:0000075</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Appendage</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000218</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>appendages</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>extremitaet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>extremity</oboInOwl:hasRelatedSynonym>

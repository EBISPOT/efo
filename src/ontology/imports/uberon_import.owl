        <oboInOwl:hasDbXref>MESH:D005123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000140</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Eye</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>light-detecting organ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>visual apparatus</oboInOwl:hasRelatedSynonym>

        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_6340"/>
        <oboInOwl:source>http://www1.pbrc.hawaii.edu/~danh/MyelinEvolution/evolution.html</oboInOwl:source>
    </owl:Axiom>

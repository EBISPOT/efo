        <oboInOwl:hasDbXref>XAO:0000009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000152</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1862</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>inner layer of eyeball</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retina of camera-type eye</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tunica interna of eyeball</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Netzhaut</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>retinas</oboInOwl:hasRelatedSynonym>

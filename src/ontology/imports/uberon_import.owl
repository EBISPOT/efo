    <!-- http://purl.obolibrary.org/obo/UBERON_0001070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005396"/>
        <obo:IAO_0000115>A terminal branch of the left or right common carotid artery which supplies oxygenated blood to to the throat, neck glands, tongue, face, mouth, ear, scalp and dura mater of the meninges[MP].</obo:IAO_0000115>
        <obo:UBPROP_0000008>not homologous to the external carotid of zebrafish (Goodrich, 1958) - http://zfish.nichd.nih.gov/zfatlas/Intro%20Page/comparative.html; check XAO</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>AAO:0010218</oboInOwl:hasDbXref>

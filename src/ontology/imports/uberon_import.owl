    <!-- http://purl.obolibrary.org/obo/UBERON_0007640 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002305"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001954"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Layer of the hippocampus lying just superficial to the stratum radiatum and bounded by the pial surface of the hippocampus. The fibers of the perforant pathway fibers from entorhinal cortex and several other brain areas terminate in this layer. Adapted from Paxinos, G. The rat central nervous system, 2nd ed, Academic Press, San Diego, 1995, pg. 460).</obo:IAO_0000115>
        <obo:UBPROP_0000010>Here the perforant path fibers form synapses onto the distal, apical dendrites of pyramidal cells.[WP]</obo:UBPROP_0000010>
        <oboInOwl:hasDbXref>BIRNLEX:1359</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:83149</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2456</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lacunar-molecular layer of hippocampus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum hippocampi moleculare et substratum lacunosum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum lacunosum moleculare</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum lacunosum-moleculare</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0007640</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>hippocampus stratum lacunosum moleculare</rdfs:label>
    </owl:Class>

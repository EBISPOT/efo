    <!-- http://purl.obolibrary.org/obo/UBERON_0007329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000058"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>

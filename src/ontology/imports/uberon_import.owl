        <oboInOwl:hasDbXref>galen:AxillaryVein</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vena axillaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>subcostal vein</oboInOwl:hasRelatedSynonym>

        <oboInOwl:hasDbXref>VHOG:0000307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Neural_tube</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003204</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001135</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1365</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>neural primordium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>presumptive central nervous system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tubus neuralis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001049</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>neural tube</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/6/64/Gray19_with_color.png</foaf:depiction>

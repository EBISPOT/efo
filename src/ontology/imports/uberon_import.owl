    <!-- http://purl.obolibrary.org/obo/UBERON_2000603 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_2000603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>

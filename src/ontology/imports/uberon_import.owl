        <rdfs:label>intermetatarsal joint</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/d/dc/Gray358.png</foaf:depiction>
    </owl:Class>

        <oboInOwl:hasDbXref>Wikipedia:Serous_membrane</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005425</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>tunica serosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>wall of serous sac</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>serosa</oboInOwl:hasRelatedSynonym>

        <owl:annotatedTarget>The mechanosensory lateral line system is widely distributed in aquatic anamniotes. It was apparently present in the earliest vertebrates, as it has been identified in agnathans, cartilaginous fishes, bony fishes, lungfishes, the crossopterygian Latimeria, and aquatic amphibians.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0001243</oboInOwl:external_class>
        <oboInOwl:ontology>VHOG</oboInOwl:ontology>
        <oboInOwl:source>ISBN:978-0471210054 Butler AB and Hodos W, Comparative vertebrate neuroanatomy: Evolution and Adaptation (2005) p.195</oboInOwl:source>
        <oboInOwl:source>http://bgee.unil.ch/</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002540"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>

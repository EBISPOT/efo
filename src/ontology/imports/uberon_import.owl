    <!-- http://purl.obolibrary.org/obo/UBERON_0006260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0004758 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004758">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002530"/>
        <obo:IAO_0000115>An organ for excreting excess salts. It is found in elasmobranchs, seabirds, and some reptiles.[WP].</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_40674"/>
        <obo:UBPROP_0000008>In sharks, salt glands are found in the rectum, but in birds and reptiles, they are found in or on the skull, in the area of the eyes, nostrils or mouth. In crocodiles, the salt is excreted through the tongue. Such glands work by active transport via sodium-potassium pump that moves salt from the blood into the gland, where it can be excreted as a concentrated solution. Salt glands function to keep salt balance, and allow marine vertebrates to drink seawater</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>BTO:0001204</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:1235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012491</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Salt_gland</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0004758</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#functional_classification"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#organ_slim"/>
        <rdfs:label>salt gland</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004758"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An organ for excreting excess salts. It is found in elasmobranchs, seabirds, and some reptiles.[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Salt_gland</oboInOwl:hasDbXref>
    </owl:Axiom>
    



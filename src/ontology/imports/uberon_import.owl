    <!-- http://purl.obolibrary.org/obo/UBERON_0011905 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011905">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004256"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Plantaris is a vestigial structure and one of the superficial muscles of the posterior crural compartment of the leg. It is innervated by the tibial nerve (S1, S2) . It is composed of a thin muscle belly and a long thin tendon. It is approximately 2-4 inches long, and is absent in 7 - 10% of the human population. It is one of the plantar flexors in the superior compartment of the leg along with the gastrocnemius, and soleus. The plantaris is considered an unimportant muscle, it mainly acts with gastrocnemius[WP].</obo:IAO_0000115>
        <obo:IAO_0000116>todo - coordinate with phenoscape-ext on representation of amphibian plantaris longus and profundus</obo:IAO_0000116>
        <oboInOwl:hasDbXref>BTO:0006312</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0001979</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:36254</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:22543</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Plantaris_muscle</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>musculus plantaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plantaris</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0011905</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>plantaris</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011905"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Plantaris is a vestigial structure and one of the superficial muscles of the posterior crural compartment of the leg. It is innervated by the tibial nerve (S1, S2) . It is composed of a thin muscle belly and a long thin tendon. It is approximately 2-4 inches long, and is absent in 7 - 10% of the human population. It is one of the plantar flexors in the superior compartment of the leg along with the gastrocnemius, and soleus. The plantaris is considered an unimportant muscle, it mainly acts with gastrocnemius[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Plantaris_muscle</oboInOwl:hasDbXref>
    </owl:Axiom>

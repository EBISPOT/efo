    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <rdfs:subClassOf>

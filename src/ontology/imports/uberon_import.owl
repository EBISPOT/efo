        <oboInOwl:hasDbXref>MA:0000280</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012590</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12784</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181163006</oboInOwl:hasDbXref>

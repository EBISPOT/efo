    <!-- http://purl.obolibrary.org/obo/UBERON_0001038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000020"/>
        <obo:IAO_0000115>Chordotonal organs are arthropod sensory structures consisting of special sensilla called the scolopidia, which are mechano-transducers and respond mainly to stretch or flexion. In insects, they consist of bundles of internal sensilla, each of which has a cap cell, an enveloping cell and one or more sense cells. The distal end of the organ is usually attached to the cuticle of the body wall, marked by a pit, a thickened disc or a nodule of chitin, and the base of the organ is connected with the hypodermis, often by a special ligament.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0000940</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00005215</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000209</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000209</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Chordotonal_organ</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>scolopophorous organ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001038</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#organ_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>To be ceded to Arthropod anatomy ontology</rdfs:comment>
        <rdfs:label>chordotonal organ</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001038"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Chordotonal organs are arthropod sensory structures consisting of special sensilla called the scolopidia, which are mechano-transducers and respond mainly to stretch or flexion. In insects, they consist of bundles of internal sensilla, each of which has a cap cell, an enveloping cell and one or more sense cells. The distal end of the organ is usually attached to the cuticle of the body wall, marked by a pit, a thickened disc or a nodule of chitin, and the base of the organ is connected with the hypodermis, often by a special ligament.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FB:FBrf0056378</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Chordotonal_organ</oboInOwl:hasDbXref>
    </owl:Axiom>

        <oboInOwl:hasDbXref>UMLS:C0029082</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001349</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ophthalmic_nerve</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cranial nerve V, branch V1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>first branch of fifth cranial nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>first division of fifth cranial nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>first division of trigeminal nerve</oboInOwl:hasExactSynonym>

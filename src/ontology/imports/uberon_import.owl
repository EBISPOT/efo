        <oboInOwl:hasDbXref>NCIT:C12789</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:110530005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0037303</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Skull</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WikipediaCategory:Skull</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Skull</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>cranial skeleton</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>skeletal system of head</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003129</oboInOwl:id>

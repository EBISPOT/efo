                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The valve-like structure found at the site of entry of the ureter into the urinary bladder, normally displays an oblique angulation through the detrusor to avoid reflux of urine up the ureters and the kidney.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EMAPA:37783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:15899</oboInOwl:hasDbXref>

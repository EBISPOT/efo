                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004054"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A duct or series of ducts that transports sperm from the gonad. In mammals this is from the seminiferous tubules through rete testis, vas efferentia, epididymis, vas deferens, ejeculatory duct to the urethra.</obo:IAO_0000115>
        <obo:UBPROP_0000008>we use this as a generic grouping class for a number of taxa</obo:UBPROP_0000008>
        <obo:UBPROP_0000012>in FMA includes as parts: seminal vesicle, efferent ductule (vas efferentia), epididymis, deferent duct (vas deferens), ejaculatory duct</obo:UBPROP_0000012>
        <oboInOwl:hasAlternativeId>UBERON:0010140</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>FMA:55678</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001268</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001268</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sperm duct</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sperm ducts</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0006947</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#grouping_class"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>male genital duct</rdfs:label>
    </owl:Class>

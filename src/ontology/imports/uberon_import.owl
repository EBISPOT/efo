        <oboInOwl:hasDbXref>UMLS:C1519967</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000351</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005133</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>foregut ventral mesentery</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005626</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>

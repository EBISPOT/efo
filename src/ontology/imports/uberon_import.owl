    <!-- http://purl.obolibrary.org/obo/UBERON_0001557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000065"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The segment of the respiratory tract that starts proximally with the nose and ends distally with the cricoid cartilage, before continuing to the trachea.</obo:IAO_0000115>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001558"/>
        <obo:UBPROP_0000012>Some specify that the glottis (vocal cords) is the defining line between the upper and lower respiratory tracts;[2] yet even others make the line at the cricoid cartilage. The FMA includes nose, nasopharynx, oropharynx and larynx[WP]</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>EHDAA2:0002136</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:17669</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:45661</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000442</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361381009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000406</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Upper_respiratory_tract</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0001557</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0000989 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000989">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>

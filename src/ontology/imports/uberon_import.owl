        <oboInOwl:hasExactSynonym>tela chorioidea fourth ventricle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tela choroidea fourth ventricle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tela choroidea of fourth ventricle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tela choroidea ventriculi quarti</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>tela choroidea ventriculi quarti</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005287</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>

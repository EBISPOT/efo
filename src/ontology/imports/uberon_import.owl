        <owl:annotatedTarget>occipital somite</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:11830559</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000313</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

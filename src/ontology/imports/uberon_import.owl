        <oboInOwl:hasDbXref>UMLS:C0006141</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Breast</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Breast</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mammary part of chest</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammary region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>mamma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000310</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>breast</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/6/6e/Closeup_of_female_breast.jpg</foaf:depiction>
    </owl:Class>

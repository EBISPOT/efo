            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A pharyngeal membrane that separates the first pharyngeal cleft from the first pharyngeal pouch.</obo:IAO_0000115>
        <obo:IAO_0000116>check EMAPA - 3 terms appear to match. We follow EMAPA in making each membrane part of the arch with the same number, though in fact it is between these arches</obo:IAO_0000116>
        <oboInOwl:hasDbXref>EHDAA:3788</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16121</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:16992</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:17281</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001427</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>1st branchial membrane</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>1st pharyngeal membrane</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>future tympanic membrane</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tympanic membrane primordium</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0009213</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>pharyngeal membrane of 1st arch</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pharyngeal membrane that separates the first pharyngeal cleft from the first pharyngeal pouch.</owl:annotatedTarget>

        <oboInOwl:hasDbXref>FMA:50865</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:838</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001105</oboInOwl:hasDbXref>

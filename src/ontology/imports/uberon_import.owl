        </rdfs:subClassOf>
        <obo:IAO_0000115>Tissue surrounding the loop of Henle in the renal medulla.</obo:IAO_0000115>
        <obo:UBPROP_0000009>It functions in renal water reabsorption by building up a high hypertonicity, which draws water out of the thin descending limb of the loop of Henle and the collecting duct system. This hypertonicity, in turn, is created by an efflux of urea from the inner medullary collecting duct.</obo:UBPROP_0000009>
        <oboInOwl:hasDbXref>EMAPA:18326</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002619</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:245693005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Bone_marrow_of_ovaryry_interstitium</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>kidney medulla interstitium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>renal medullary interstitial tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>renal medullary interstitium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>medullary interstitium</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>medullary stroma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005211</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>renal medulla interstitium</rdfs:label>
    </owl:Class>

        <oboInOwl:hasDbXref>galen:ThyroidGland</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>thyroid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>glandula thyroidea</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002046</oboInOwl:id>

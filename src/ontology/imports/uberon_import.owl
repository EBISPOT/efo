    <!-- http://purl.obolibrary.org/obo/UBERON_0001628 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004573"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006347"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0001727 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001727">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000062"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003212"/>

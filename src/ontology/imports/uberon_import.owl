    <!-- http://purl.obolibrary.org/obo/UBERON_0002347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002412"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003827"/>

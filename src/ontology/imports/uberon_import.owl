        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001013"/>
        <obo:IAO_0000115>A thermogenic form of adipose tissue that is composed of brown adipocytes[MP,modified].</obo:IAO_0000115>
        <obo:UBPROP_0000001>Adipose tissue, cells of which contain multiple small lipid droplets.[FMA]</obo:UBPROP_0000001>
        <obo:UBPROP_0000008>especially abundant in newborns and in hibernating mammals</obo:UBPROP_0000008>
        <obo:UBPROP_0000009>thermogenesis</obo:UBPROP_0000009>

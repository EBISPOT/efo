    <!-- http://purl.obolibrary.org/obo/UBERON_0004160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003104"/>

        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Anatomical structure which is a medial outgrowth of the thalamus on the dorsal surface of the brain. This structure is light sensitive and secretes melatonin when exposed to prolonged darkness.[AAO]</owl:annotatedTarget>

    <!-- http://purl.obolibrary.org/obo/UBERON_0001607 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001607">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">

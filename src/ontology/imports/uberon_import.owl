        <oboInOwl:hasDbXref>SCTID:181890004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0149543</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Base_of_skull</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>base of cranium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>base of skull</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>basis cranii</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cranial base</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0002517</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>

        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The part of the forelimb extending from the shoulder to the autopod[cjm].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Arm</oboInOwl:hasDbXref>

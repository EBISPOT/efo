        <oboInOwl:hasExactSynonym>right liver lobe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>2nd lobe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gall bladder lobe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lobus hepatis dexter</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>right hepatic lobe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>second lobe</oboInOwl:hasRelatedSynonym>

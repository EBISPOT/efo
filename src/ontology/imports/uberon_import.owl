        <oboInOwl:hasExactSynonym>processus ciliares</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>set of ciliary processes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ciliary process</oboInOwl:hasRelatedSynonym>

    <!-- http://purl.obolibrary.org/obo/UBERON_0001322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001021"/>

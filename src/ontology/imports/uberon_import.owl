                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001869"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Gray matter of the insular region of the neocortex. In gyrencephalic animals, it is part of the insular lobe and lies in the depths of the lateral fissure and covered by portions of the frontal, parietal and temporal lobes. It includes Brodmann areas 13-16.</obo:IAO_0000115>
        <obo:IAO_0000116>Consider splitting insular cortex from insular lobe. See https://github.com/obophenotype/uberon/issues/412</obo:IAO_0000116>
        <obo:UBPROP_0000012>two classes in ncit, Central_Lobe is part of temporal lobe</obo:UBPROP_0000012>
        <oboInOwl:hasAlternativeId>UBERON:0023846</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>iNS</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:AI</oboInOwl:hasDbXref>

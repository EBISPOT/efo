                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An artery that supplies blood to an eyelid.</obo:IAO_0000115>
        <obo:UBPROP_0000008>In humans, the eyelids are supplied with blood by two arches on each upper and lower lid. The arches are formed by anastamoses of the lateral palpebral arteries and medial palpebral arteries, branching off from the lacrimal artery and ophthalmic artery, respectively. In amphibians, the eyelids may be supplied by branches of the lateral pretrosal arteries.[cjm]</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>SCTID:148571007</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0014770</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>palpebral artery</rdfs:label>
    </owl:Class>
    <owl:Axiom>

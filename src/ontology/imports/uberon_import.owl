    <!-- http://purl.obolibrary.org/obo/UBERON_0000110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000105"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000068"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A chordate developmental stage defined by the formation of a tube from the flat layer of ectodermal cells known as the neural plate. This will give rise to the central nervous system.</obo:IAO_0000115>
        <obo:RO_0002174 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_7955"/>
        <obo:UBPROP_0000008>In zebrafish, the times of neurulation and segmentation overlap so extensively there is no distinct neurula period of development, such as occurs largely before segmentation in amphibian embryos.</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>BILS:0000110</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BilaDO:0000009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChirDv:0000012</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GgalDv:0000093</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HsapDv:0000012</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MmusDv:0000017</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OariDv:0000027</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RnorDv:0000007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SscrDv:0000091</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:1000006</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0000110</oboInOwl:id>
        <rdfs:label>neurula stage</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/developmental-stage-ontologies/issues/84</rdfs:seeAlso>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/343</rdfs:seeAlso>
    </owl:Class>

        <oboInOwl:hasDbXref>Wikipedia:Occipital_bone</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>occipital complex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>occipital squama</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>os occipitale</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001676</oboInOwl:id>

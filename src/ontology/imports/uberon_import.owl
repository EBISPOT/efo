    <!-- http://purl.obolibrary.org/obo/UBERON_0022336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011215"/>

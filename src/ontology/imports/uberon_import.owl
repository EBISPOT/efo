        <oboInOwl:hasDbXref>UMLS:C0004600</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Dorsum_(anatomy)</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Back</oboInOwl:hasDbXref>

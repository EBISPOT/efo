        <oboInOwl:hasDbXref>MIAA:0000044</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12263</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181247007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0013303</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000052</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Duodenum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000236</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Duodenum</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>proximal intestine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>upper intestine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002114</oboInOwl:id>

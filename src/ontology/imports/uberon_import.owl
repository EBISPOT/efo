    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004744"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>According to this theory (Reichert-Gaupp theory), the mammalian stapes is derived from the reptilian columella, the incus from the quadrate and the malleus from the articular (...).[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000690</oboInOwl:external_class>
        <oboInOwl:ontology>VHOG</oboInOwl:ontology>
        <oboInOwl:source>DOI:10.1017/S0022215100009087 Gerrie J, The phylogeny of the mammalian tympanic cavity and auditory ossicles. The Journal of Laryngology and Otology (1948</oboInOwl:source>
        <oboInOwl:source>http://bgee.unil.ch/</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004744"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000005"/>
        <owl:annotatedTarget>The presence of an anguloarticular is interpreted as a synapomorphy of the Clupeocephala (Patterson and Rosen, 1977; Arratia, 1999).[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-06</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0000467</oboInOwl:external_class>
        <oboInOwl:ontology>TAO</oboInOwl:ontology>
        <oboInOwl:source>Curator</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004744"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>TAO has a distinct class for articular - in fact we need (at least) 3 classes here - articular, anguloarticular and malleus, arranged into a single VHOG group</owl:annotatedTarget>
        <oboInOwl:external_ontology>TAO</oboInOwl:external_ontology>

        <oboInOwl:hasDbXref>galen:CapsuleOfKidney</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>capsula fibrosa renis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>capsule of kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fibrous capsule of kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>renal capsule</oboInOwl:hasExactSynonym>

        <oboInOwl:hasDbXref>ZFA:0001557</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>glomerulus of pronephros</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>glomus</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>corpuscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>glomera</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pronephric glomera</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pronephric glomeruli</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pronephric glomus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004739</oboInOwl:id>

        <oboInOwl:hasDbXref>ZFA:0001576</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pars sympathica divisionis autonomici systematis nervosi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sympathetic nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sympathetic part of autonomic division of nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>pars sympathica divisionis autonomici systematis nervosi</oboInOwl:hasRelatedSynonym>

        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A strong ring of smooth muscle at the end of the pyloric canal which lets food pass from the stomach to the duodenum. It receives sympathetic innervation from the celiac ganglion[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>

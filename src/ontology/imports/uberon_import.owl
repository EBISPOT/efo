    <!-- http://purl.obolibrary.org/obo/UBERON_0004061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005291"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034707"/>

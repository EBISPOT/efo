    <!-- http://purl.obolibrary.org/obo/UBERON_0002223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0008974 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008974">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002365"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010243"/>
        <obo:IAO_0000115>Any exocrine gland whose cells bud their secretions off through the plasma membrane producing membrane-bound vesicles in the lumen; the apical portion of the secretory cell of the gland pinches off and enters the lumen; it loses part of its cytoplasm in their secretions; apocrine secretion is functional during hormonal stress or puberty; an example of true apocrine glands are mammary glands, responsible for secreting breast milk.</obo:IAO_0000115>
        <obo:UBPROP_0000007>apocrine</obo:UBPROP_0000007>
        <obo:UBPROP_0000008>Mammary glands are modified apocrine glands present in both humans and mice; unlike humans, mice do not have axillary apocrine sweat glands[MGI:anna]</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>BTO:0001162</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35141</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0003040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D001050</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361698000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Apocrine</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>true apocrine gland</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0008974</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#organ_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>apocrine gland</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008974"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any exocrine gland whose cells bud their secretions off through the plasma membrane producing membrane-bound vesicles in the lumen; the apical portion of the secretory cell of the gland pinches off and enters the lumen; it loses part of its cytoplasm in their secretions; apocrine secretion is functional during hormonal stress or puberty; an example of true apocrine glands are mammary glands, responsible for secreting breast milk.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MGI:anna</oboInOwl:hasDbXref>
    </owl:Axiom>

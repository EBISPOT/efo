    <!-- http://purl.obolibrary.org/obo/UBERON_0003083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>

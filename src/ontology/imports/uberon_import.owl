        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003058"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Unsegmented ventral structure in the caudal region of anuran larvae; near metamorphosis the hypochord fuses to the coccyx, thereby forming the urostyle.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0000733</oboInOwl:external_class>

    <!-- http://purl.obolibrary.org/obo/UBERON_0000326 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000456"/>
        <obo:IAO_0000115>Pancreatic juice is slightly alkaline and contains numerous enzymes and inactive enzyme precursors including alpha-amylase, chymotrypsinogen, lipase, procarboxypeptidase, proelastase, prophospholipase A2, ribonuclease, and trypsinogen. Its high concentration of bicarbonate ions helps to neutralize the acid from the stomach.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0000504</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-2235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62973</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:1166</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D010189</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>pancreatic fluid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pancreatic secretion</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>succus pancreaticus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000326</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>pancreatic juice</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000326"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pancreatic juice is slightly alkaline and contains numerous enzymes and inactive enzyme precursors including alpha-amylase, chymotrypsinogen, lipase, procarboxypeptidase, proelastase, prophospholipase A2, ribonuclease, and trypsinogen. Its high concentration of bicarbonate ions helps to neutralize the acid from the stomach.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0030157</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

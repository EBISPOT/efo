    <!-- http://purl.obolibrary.org/obo/UBERON_0005419 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004357"/>
        <rdfs:subClassOf>

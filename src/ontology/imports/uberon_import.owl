        <oboInOwl:hasDbXref>Wikipedia:Artery_to_the_ductus_deferens</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>arteria ductus deferentis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>artery of ductus deferens</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ductus deferens artery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vas deferens artery</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0005192</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0000949 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015204"/>

        <oboInOwl:hasRelatedSynonym>haemorrhoidal plexus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hemorrhoidal plexus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>plexus haemorrhoidalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>plexus venosus rectalis</oboInOwl:hasRelatedSynonym>

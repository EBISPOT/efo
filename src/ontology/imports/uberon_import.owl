        <oboInOwl:hasDbXref>MA:0001564</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34210</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361410004</oboInOwl:hasDbXref>

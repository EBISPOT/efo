    <!-- http://purl.obolibrary.org/obo/UBERON_2000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_2000240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002513"/>

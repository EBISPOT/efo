        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:comment>for the vertebrate-specific structure, see UBERON:0000941 (cranial nerve II)</rdfs:comment>

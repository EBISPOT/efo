    <!-- http://purl.obolibrary.org/obo/UBERON_0002515 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000158"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001474"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The thick fibrous membrane that closely invests the entire surface of a bone except the articular cartilage at synovial joints.</obo:IAO_0000115>
        <obo:UBPROP_0000007>periosteal</obo:UBPROP_0000007>

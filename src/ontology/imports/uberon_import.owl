    <!-- http://purl.obolibrary.org/obo/UBERON_0001018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000122"/>

        <oboInOwl:hasExactSynonym>medulla ossium rubra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>parenchymal red marrow</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>red marrow</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>parenchyma of none marrow marrow</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000361</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>red bone marrow</rdfs:label>
    </owl:Class>

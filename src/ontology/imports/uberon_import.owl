                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011143"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A paired organ of the urinary tract that produces urine and maintains bodily fluid homeostasis, blood pressure, pH levels, red blood cell production and skeleton mineralization.</obo:IAO_0000115>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000160"/>
        <obo:UBPROP_0000001>One of either of a pair of structures lying on either side of the dorsal aorta in which fluid balance is regulated and waste is excreted out in the form of urine.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000007>renal</obo:UBPROP_0000007>
        <obo:UBPROP_0000202 rdf:resource="http://purl.obolibrary.org/obo/FMA_264815"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7655-4833"/>

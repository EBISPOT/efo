        <obo:IAO_0000115>A bone that is part of a forelimb region. Examples: humerus, any of the phalanges. Counter-example: scapula (a bone of the pectoral girdle). Note that we consider the forelimb to end at the shoulder.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GAID:178</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D001133</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12983</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:368532003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0003793</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>free forelimb bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>wing bone</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>UBERON:0008962</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>forelimb bone</rdfs:label>
    </owl:Class>

    <!-- http://purl.obolibrary.org/obo/UBERON_0010758 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010758">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000475"/>

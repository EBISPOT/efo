    <!-- http://purl.obolibrary.org/obo/UBERON_0034891 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016529"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The insular cortex (also insula and insular lobe) is a portion of the cerebral cortex folded deep within the lateral sulcus (the fissure separating the temporal lobe from the parietal and frontal lobes) within each hemisphere of the mammalian brain. It is the primary gustatory cortex and is involved in sensorimotor and somatosensory as well as socioemotional functions.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>iNS</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BM:Tel-Cx-Ins</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10288</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DMBA:16058</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35432</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:242223</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000909</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:369221008</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cortex of insula</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>insular neocortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ICx</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gray matter of insula</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0034891</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>insular cortex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034891"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The insular cortex (also insula and insular lobe) is a portion of the cerebral cortex folded deep within the lateral sulcus (the fissure separating the temporal lobe from the parietal and frontal lobes) within each hemisphere of the mammalian brain. It is the primary gustatory cortex and is involved in sensorimotor and somatosensory as well as socioemotional functions.</owl:annotatedTarget>

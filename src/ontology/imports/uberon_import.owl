        <oboInOwl:hasDbXref>VHOG:0001102</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>2nd pharyngeal arch mesenchyme</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>2nd branchial arch mesenchyme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pharyngeal arch 2 mesenchyme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005689</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>2nd arch mesenchyme</rdfs:label>
    </owl:Class>

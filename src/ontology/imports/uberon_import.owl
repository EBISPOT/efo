        <oboInOwl:hasDbXref>NCIT:C33166</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000046</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1518263</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000535</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003216</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000046</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>neural layer of retina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neural retina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuroretina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum nervosum (retina)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum nervosum retinae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>neural retinal epithelium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003902</oboInOwl:id>

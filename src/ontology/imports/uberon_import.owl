        <oboInOwl:hasRelatedSynonym>vena cava superior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vena maxima</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001585</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>

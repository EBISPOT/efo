        <oboInOwl:hasRelatedSynonym>lamina dessicans of entorhinal cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>layer 4 of entorhinal cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0022323</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:comment>This layer is better developed in the medial entorhinal cortex although species differences are apparent[DOI:10.1155/2008/381243]</rdfs:comment>
        <rdfs:label>entorhinal cortex layer 4</rdfs:label>
    </owl:Class>

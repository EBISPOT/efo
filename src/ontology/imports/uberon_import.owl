        <oboInOwl:hasDbXref>SCTID:279479008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:External_urethral_orifice_(female)</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>external orifice of female urethra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>external urethral orifice (female)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>female urethral meatus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ostium urethrae externum (urethra feminina)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>urethral meatus of clitoral urethra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>distal urethral opening of female</oboInOwl:hasRelatedSynonym>

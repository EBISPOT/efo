    <!-- http://purl.obolibrary.org/obo/UBERON_0000988 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>

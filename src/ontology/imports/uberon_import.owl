    <!-- http://purl.obolibrary.org/obo/UBERON_0012240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0012240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010418"/>

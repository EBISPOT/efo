    <!-- http://purl.obolibrary.org/obo/UBERON_0003711 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003711">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>

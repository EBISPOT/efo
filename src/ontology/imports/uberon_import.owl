        <oboInOwl:hasDbXref>MA:0001136</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NLXANAT:100304</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279281007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000805</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ciliary_ganglion</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ciliary ganglion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ganglion ciliare</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002058</oboInOwl:id>

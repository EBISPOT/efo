    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000002"/>
        <owl:annotatedTarget>relationship loss: subclass specialized connective tissue (AAO:0000571)[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0000047</oboInOwl:external_class>
        <oboInOwl:ontology>AAO</oboInOwl:ontology>

        <oboInOwl:hasDbXref>UMLS:C0030786</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>bone of pelvic girdle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pelvic girdle bone</oboInOwl:hasExactSynonym>

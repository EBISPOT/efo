        <oboInOwl:hasDbXref>FMA:17716</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002614</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005291</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Proximal_straight_tubule</oboInOwl:hasDbXref>

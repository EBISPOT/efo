        <oboInOwl:hasDbXref>NCIT:C33462</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:116358006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0035092</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Renal_vein</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:RenalVein</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>kidney vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>renal venous tree</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vein of kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>venae renales</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001140</oboInOwl:id>

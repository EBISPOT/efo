        <oboInOwl:hasRelatedSynonym>basal nuclei</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cerebral nuclei</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>set of basal nuclei</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>subcortical nuclei</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0010011</oboInOwl:id>

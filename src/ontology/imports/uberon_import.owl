        <oboInOwl:hasDbXref>ZFA:0000407</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>skeletal parts of pectoral girdle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>skeleton of pectoral girdle</oboInOwl:hasExactSynonym>

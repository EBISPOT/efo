        <oboInOwl:hasRelatedSynonym>physiologic blind spot</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>physiologic blind spot of mariotte</oboInOwl:hasRelatedSynonym>

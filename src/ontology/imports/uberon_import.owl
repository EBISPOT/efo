        <oboInOwl:hasExactSynonym>inter-mandibular joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>symphysis menti</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>mental symphysis</oboInOwl:hasRelatedSynonym>

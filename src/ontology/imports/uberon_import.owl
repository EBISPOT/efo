        <oboInOwl:hasDbXref>MESH:D008208</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362597000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001761</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lymphatic_system</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lymphatic system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lymphatic tree system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>lymporeticular system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006558</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>lymphatic part of lymphoid system</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006558"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An organ system subdivision that is a network of vessels capable of removing accumulating protein and fluid from the interstitial space and returning it to the vascular space. In some species, this network is connected to the immune system via lymph nodes and lymphocyte-producing organs, with the whole being the lymphoid system.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006558"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Part of the circulatory system which consists of a series of vessels which collect blood (exclusive of erythrocytes) which seep through capillary walls and return it to the veins.[AAO]</owl:annotatedTarget>

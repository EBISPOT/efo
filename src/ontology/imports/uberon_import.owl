        <oboInOwl:hasDbXref>EFO:0002548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:63916</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:520</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004727</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12481</oboInOwl:hasDbXref>

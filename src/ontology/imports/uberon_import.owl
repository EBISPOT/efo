        <oboInOwl:hasDbXref>EHDAA:8225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:32696</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:7406</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000437</oboInOwl:hasDbXref>

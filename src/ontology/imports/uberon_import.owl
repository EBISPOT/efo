        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000008"/>
        <owl:annotatedTarget>The testes are descended in metatherian and eutherian mammals, first transabdominally, then inguinoscrotally</owl:annotatedTarget>

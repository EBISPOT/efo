    <!-- http://purl.obolibrary.org/obo/UBERON_0001691 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001444"/>

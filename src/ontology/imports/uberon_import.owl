    <!-- http://purl.obolibrary.org/obo/UBERON_0001111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001630"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005175"/>

        <oboInOwl:hasNarrowSynonym>shoulder blade</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>scapula bone</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>scapulas</oboInOwl:hasRelatedSynonym>

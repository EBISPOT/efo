    <!-- http://purl.obolibrary.org/obo/UBERON_0001751 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010313"/>

        <oboInOwl:hasDbXref>ZFA:0000360</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryonic heart tube</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>endocardial heart tube</oboInOwl:hasExactSynonym>

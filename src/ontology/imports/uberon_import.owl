            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001710"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A subdivision of the face that is the anteriormost part of the lower jaw region.</obo:IAO_0000115>
        <obo:UBPROP_0000001>Surface structure that is the anteriormost region of the lower jaw.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000007>mental</obo:UBPROP_0000007>
        <obo:UBPROP_0000008>In humans, the chin is the lowermost part of the face. It is formed by the lower front of the mandible. The chin developed as a point of muscular attachment facilitating minute movements of the lips associated with speech. In human evolution, the chin is a cladistic apomorphy, partially defining anatomically modern Humans as distinct from archaic forms</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>EMAPA:37827</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:46495</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:67</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002680</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C81169</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362632004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0002254</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Chin</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Chin</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mental part of face</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mental region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mental region of face</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>regio mentalis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>mentum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0008199</oboInOwl:id>

        <oboInOwl:hasDbXref>FMA:66643</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:543</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002206</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D011667</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12776</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:430160002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0034090</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001133</oboInOwl:hasDbXref>

        <oboInOwl:hasDbXref>MA:0001130</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12350</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181097002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0037938</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000443</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>menines of spinal cord</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>meninges of spinal cord</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spinal cord meninges</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spinal cord meninx</oboInOwl:hasExactSynonym>

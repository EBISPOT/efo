    <!-- http://purl.obolibrary.org/obo/UBERON_0001552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001637"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003644"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001225"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>One of the curved arteries at the corticomedullary border of the kidney that arise from the interlobar arteries and give rise to the interlobular arteries.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>arcuate artery</oboInOwl:hasBroadSynonym>

        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>intermediate trophoblast</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:86561</oboInOwl:hasDbXref>

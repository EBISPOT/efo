    <!-- http://purl.obolibrary.org/obo/UBERON_0008845 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000211"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008846"/>
        <obo:IAO_0000115>A ligament that does not connect two skeletal elements.</obo:IAO_0000115>
        <obo:UBPROP_0000001>Ligament organ that primarily consists of dense connective tissue aggregated into fasciculi which may be admixed with smooth muscle. Examples: ligament of liver, ovarian ligament[FMA:25625].</obo:UBPROP_0000001>
        <obo:UBPROP_0000012>this class is used more generally than the FMA class, to include for example folds of mesentery such as the broad ligament of the uterus.</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>FMA:25625</oboInOwl:hasDbXref>

    <!-- http://purl.obolibrary.org/obo/UBERON_0002135 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002135">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000946"/>

        <oboInOwl:hasDbXref>XAO:0000275</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0004073</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nasal pit</oboInOwl:hasExactSynonym>

        <oboInOwl:hasRelatedSynonym>myocardial trabeculae carneae</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trabecula of heart muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trabeculae</oboInOwl:hasRelatedSynonym>

        <oboInOwl:hasExactSynonym>muscularis externa of stomach</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tunica muscularis (gaster)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tunica muscularis gastris</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0008856</oboInOwl:id>

        <oboInOwl:hasExactSynonym>secondary olfactory cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>secondary olfactory cortical area (carpenter)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>entorhinal cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002895</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>secondary olfactory cortex</rdfs:label>
    </owl:Class>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The base of skull is the most inferior area of the skull, composed of the endocranium and lower parts of the skull roof.</obo:IAO_0000115>
        <obo:UBPROP_0000007>basicranial</obo:UBPROP_0000007>
        <oboInOwl:hasDbXref>FMA:52801</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002840</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D019291</oboInOwl:hasDbXref>

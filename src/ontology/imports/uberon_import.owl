        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011156"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An unpaired bone situated at the base of the skull in front of the temporal bone and basilar part of the occipital bone. The sphenoid bone is one of the seven bones that articulate to form the orbit. Its shape somewhat resembles that of a butterfly or bat with its wings extended.</obo:IAO_0000115>
        <obo:UBPROP_0000012>part of viscerocranium (facial skeleton) in FMA</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>CALOHA:TS-2343</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:18340</oboInOwl:hasDbXref>

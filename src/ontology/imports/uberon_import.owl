        <oboInOwl:hasDbXref>SCTID:278982001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0006270</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000675</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Bronchiole</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>bronchioli</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>bronchiolus</oboInOwl:hasRelatedSynonym>

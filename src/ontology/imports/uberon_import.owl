        <owl:annotatedTarget>A subdivision of the pectoral complex consisting of the structures in the region of the shoulder joint (which connects the humerus, scapula and clavicle).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

        <oboInOwl:hasDbXref>XAO:0004162</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:PulmonaryArtery</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pulmonary arterial tree</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pulmonary arterial tree organ part</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>arteria pulmonalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pulmonary arterial subtree</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>truncus pulmonalis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002012</oboInOwl:id>

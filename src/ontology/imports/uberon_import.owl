        <oboInOwl:hasDbXref>ZFA:0001355</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>layer of meninges</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>meningeal layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>meninx primitiva</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>UBERON:0002360</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>

    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002381"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The pectoralis major is a thick, fan-shaped muscle, situated at the upper front of the chest wall. It makes up the bulk of the chest muscles in the male and lies under the breast in the female. Underneath the pectoralis major is the pectoralis minor, a thin, triangular muscle. [WP,unvetted].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Pectoralis_major_muscle</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

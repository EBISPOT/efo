    <!-- http://purl.obolibrary.org/obo/UBERON_0002401 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022350"/>
        <rdfs:subClassOf>

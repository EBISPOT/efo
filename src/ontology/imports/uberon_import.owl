    <!-- http://purl.obolibrary.org/obo/UBERON_0005170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000119"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004911"/>
        <obo:IAO_0000115>A layer of the ovarian follicle that consists of granulosa cells.</obo:IAO_0000115>
        <obo:UBPROP_0000010>At one part of the mature follicle the cells of the membrana granulosa are collected into a mass which projects into the cavity of the follicle. This is termed the discus proligerus. [Wikipedia:Membrana_granulosa, Wikipedia:Membrana_granulosa]</obo:UBPROP_0000010>
        <oboInOwl:hasBroadSynonym>membrana granulosa</oboInOwl:hasBroadSynonym>

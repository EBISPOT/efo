        <oboInOwl:hasDbXref>FMA:7199</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:295</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000328</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001524</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007422</oboInOwl:hasDbXref>

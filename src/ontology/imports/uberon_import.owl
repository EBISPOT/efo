    <!-- http://purl.obolibrary.org/obo/UBERON_0001384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>

        <oboInOwl:hasDbXref>MIAA:0000180</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000026</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000078</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000034</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000026</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>frontal gland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hgg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002538</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>

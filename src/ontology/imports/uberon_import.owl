        <oboInOwl:hasDbXref>MESH:D066194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0162434</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000325</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Olfactory_cortex</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2275</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>archaeocortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>archeocortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>olfactory areas</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>olfactory lobe</oboInOwl:hasRelatedSynonym>

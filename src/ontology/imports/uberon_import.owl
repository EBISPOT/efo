        <oboInOwl:hasDbXref>ZFA:0000505</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:3240</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>area dorsalis telencephali</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dorsal part of telencephalon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dorsal telencephalic area</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dorsal telencephalon</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0000203</oboInOwl:id>

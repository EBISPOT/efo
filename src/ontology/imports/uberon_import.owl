        <oboInOwl:hasDbXref>NCIT:C34318</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361516008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1284046</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001297</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>tubotympanic recess</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0010020</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>tubotympanic recess epithelium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010020"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The dorsal portion of the embryonic first endodermal pharyngeal pouch; it develops into the middle ear cavity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0124020607</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001297</oboInOwl:hasDbXref>

    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004124"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The layer of the myocardium composed of projections of contractile myocytes. The trabecular layer is bounded internally by the endocardium. In zebrafish, unlike the trabeculations of higher vertebrates, both atrial and ventricular trabeculae have more strut-like character, and are more uniform without apparent regional differences[ZFA].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ZFA:0005059</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

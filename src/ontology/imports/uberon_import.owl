        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Small, posteriorly directed process at the posterior margin of each neural arch lamina; it is not a neural spine.[AAO]</owl:annotatedTarget>

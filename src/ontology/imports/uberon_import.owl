        </rdfs:subClassOf>
        <obo:IAO_0000115>A skeletal joint that connects a mesopodium bone and connects a proximal phalanx.</obo:IAO_0000115>
        <obo:IAO_0000116>We include these joints as being part of the digits; this is consistent with the FMA, and makes classification easier. Note that digit and metapodial regions are part-disjoint</obo:IAO_0000116>
        <oboInOwl:hasExactSynonym>metacarpo-tarsophalangeal joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>metapodial-phalangeal joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>metapodium-phalanx joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>fetlock</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>UBERON:0009559</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>metacarpal/tarsal-phalangeal joint</rdfs:label>
    </owl:Class>
    <owl:Axiom>

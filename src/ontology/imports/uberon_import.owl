        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The specialized glial structure (non-neuronal cells) situated at the ventral midline of the embryonic neural tube; this structure spans the anteroposterior axis from the midbrain to the tail regions, separating the left and right basal plates of the developing neural tube, and serves as an organizer to ventralize tissues in the embryo as well as to guide neuronal positioning and differentiation along the dorsoventral axis of the neural tube.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0021508</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MGI:anna</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:15738958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Floor_plate</oboInOwl:hasDbXref>
    </owl:Axiom>

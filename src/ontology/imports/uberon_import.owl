    <!-- http://purl.obolibrary.org/obo/UBERON_0001673 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001673">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003496"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009141"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The central retinal vein (retinal vein) is a short vein that runs through the optic nerve and drains blood from the capillaries of the retina into the larger veins outside the eye. The anatomy of the veins of the orbit of the eye varies between individuals, and in some the central retinal vein drains into the superior ophthalmic vein, and in some it drains directly into the cavernous sinus. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0004271</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:37185</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:51799</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:524</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002213</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012169</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C53063</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280913005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0035327</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Central_retinal_vein</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>retinal vein</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>vena centralis retinae</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001673</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0003119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003119">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0004363"/>
                    <owl:Restriction>

    <!-- http://purl.obolibrary.org/obo/UBERON_0000426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000088"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The outermost layer of trophoblast, produced by cytotrophoblast where there is direct contact with maternal decidua rather than blood. The EVT cells travel into the decidua, reacting with NK cells and invading maternal blood vessels feeding the placenta, softening the walls and replacing the lining with fetal tissue, a process called conversion.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0002366</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:86561</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>intermediate trophoblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>interstitial trophoblast</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000426</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>extravillous trophoblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000426"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The outermost layer of trophoblast, produced by cytotrophoblast where there is direct contact with maternal decidua rather than blood. The EVT cells travel into the decidua, reacting with NK cells and invading maternal blood vessels feeding the placenta, softening the walls and replacing the lining with fetal tissue, a process called conversion.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>BTO:0002366</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

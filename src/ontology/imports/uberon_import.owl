    <!-- http://purl.obolibrary.org/obo/UBERON_0002026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013754"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>

        <oboInOwl:hasDbXref>ZFS:0000047</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>blastocystis trilaminaris stage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trilaminar blastocyst stage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trilaminar blastoderm stage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>trilaminar disk stage</oboInOwl:hasRelatedSynonym>

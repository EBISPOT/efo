                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007831"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A scapula endochondral element that is composed primarily of a pre-cartilage condensation.</obo:IAO_0000115>
        <obo:UBPROP_0000011>the scapula has been shown to develop from multiple tissues, such as the dermomyotome of the somites, the mesodermal portion of the soma- topleure (a domain of the lateral plate mesoderm or LPM) and neural crest cell-derived mesenchyme (Huang et al., 2000; Matsuoka et al., 2005; Wang et al., 2005).</obo:UBPROP_0000011>
        <oboInOwl:hasDbXref>EHDAA2:0001778</oboInOwl:hasDbXref>

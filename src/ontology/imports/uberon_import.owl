    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000465"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000990"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001004"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0000361 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002371"/>

        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000915"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thoracic vertebra endochondral element that is composed primarily of a bone tissue.</obo:IAO_0000115>
        <obo:UBPROP_0000008>Thoracic vertebrae in all species are defined as those vertebrae which also carry a pair of ribs, and lie caudal to the cervical vertebrae. In humans, they are distinguished by the presence of facets on the sides of the bodies for articulation with the heads of the ribs, and facets on the transverse processes of all, except the eleventh and twelfth, for articulation with the tubercles of the ribs</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>EMAPA:18011</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:9139</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:244</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000314</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013904</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12798</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181821009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0039987</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Thoracic_vertebrae</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dorsal vertebra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thorax vertebra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vertebra of thorax</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vertebra thoracica</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0002347</oboInOwl:id>

    <!-- http://purl.obolibrary.org/obo/UBERON_0001316 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005610"/>
        <obo:IAO_0000115>A large vein that connects the femoral vein to the common iliac vein. Their origin is at the inferior margin of the inguinal ligaments and they terminate when they join the internal iliac veins (to form the common iliac veins). Both external iliac veins are accompanied along their course by external iliac arteries. [WP,modified].</obo:IAO_0000115>

        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003011"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0036264"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>zygomaticotemporal branch of zygomatic nerve</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:52972</oboInOwl:hasDbXref>
    </owl:Axiom>

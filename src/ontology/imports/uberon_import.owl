        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>Kidneys and gonads (of vertebrates) develop from adjacent tissues, and after the excretory or urinary ducts have developed, the reproductive system usually taps into them or their derivatives.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>

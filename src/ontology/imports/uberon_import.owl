    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011779"/>
        <rdfs:subClassOf>

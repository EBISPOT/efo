        <oboInOwl:hasDbXref>VHOG:0000428</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003084</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001273</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lower jaw skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>mandibles</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mandibular series</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003278</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>skeleton of lower jaw</rdfs:label>
    </owl:Class>

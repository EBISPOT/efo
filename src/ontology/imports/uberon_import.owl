        <oboInOwl:hasDbXref>galen:VasDeferens</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>deferent duct</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ductus deferens</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vas deferen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>sperm duct</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vasa deferentia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001000</oboInOwl:id>

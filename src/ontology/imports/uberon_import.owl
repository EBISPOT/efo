        <oboInOwl:hasExactSynonym>posterior part of middle frontal gyrus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>caudal part of middle frontal gyrus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006445</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>caudal middle frontal gyrus</rdfs:label>
    </owl:Class>

        <oboInOwl:hasDbXref>MA:0001188</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004712</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279810008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000791</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Endolymphatic_sac</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>saccus endolymphaticus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>saccus endolymphaticus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002223</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>

        <oboInOwl:hasDbXref>GAID:486</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002941</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362047009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Circle_of_Willis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1468</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>arterial circle of Willis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebral arterial circle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Willis circle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>circulus arteriosus cerebri</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003709</oboInOwl:id>

            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A Z-shaped canal running through the temporal bone from the internal acoustic meatus to the stylomastoid foramen. It is located within the middle ear region, according to its shape it is divided into three main segments: the labyrinthine, the tympanic, and the mastoidal segment .</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:54952</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Facial_canal</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>canalis nervi facialis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>facial canal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>fallopian canal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0018413</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>facial nerve canal</rdfs:label>
    </owl:Class>

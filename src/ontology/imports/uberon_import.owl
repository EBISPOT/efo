        <oboInOwl:hasDbXref>UMLS:C0231052</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000290</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Midgut</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000103</oboInOwl:hasDbXref>

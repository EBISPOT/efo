    <!-- http://purl.obolibrary.org/obo/UBERON_0002103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000026"/>

        <oboInOwl:hasRelatedSynonym>6th branchial arch artery</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>6th pharyngeal arch artery</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pulmonary arch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003123</oboInOwl:id>

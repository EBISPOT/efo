        <oboInOwl:hasDbXref>Wikipedia:Leg#Limb</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>tetrapod leg</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>lower extremity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000978</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>

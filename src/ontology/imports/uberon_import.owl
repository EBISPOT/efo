                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004535"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An embryonic group of progenitor cells that forms from an outpouching of the septum transversum near the venous pole of the heart and gives rise to the epicardium.</obo:IAO_0000115>
        <obo:UBPROP_0000007>propepicardial</obo:UBPROP_0000007>
        <obo:UBPROP_0000008>Proepicardial clusters in Zebrafish form on the pericardial wall, adjacent to the atrioventricular (AV) junction and near the venous pole[ZFA]</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>EMAPA:36025</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005808</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>proepicardial cluster</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>proepicardial organ</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0004160</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>proepicardium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

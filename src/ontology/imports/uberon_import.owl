    <!-- http://purl.obolibrary.org/obo/UBERON_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002368"/>

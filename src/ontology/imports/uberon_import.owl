        <oboInOwl:hasExactSynonym>Wolffian duct</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Leydig&apos;s duct</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>archinephric duct</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ductus mesonephricus; ductus Wolffi</oboInOwl:hasRelatedSynonym>

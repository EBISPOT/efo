    <!-- http://purl.obolibrary.org/obo/UBERON_0001139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005610"/>

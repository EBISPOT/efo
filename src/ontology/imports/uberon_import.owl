    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A dentary bone that is the only bone in one of the lateral halves of the lower jaw skeleton.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Human_mandible</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mandible</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>Note in ZFA &apos;mandible&apos; is a syn for the ventral mandibular arch, which is a portion of the 1st pharyngeal arch; however the term &apos;mandibular symphysis&apos; refers to the dentary</owl:annotatedTarget>

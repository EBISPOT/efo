        <oboInOwl:hasDbXref>EV:0100050</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:5034</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:947</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000139</oboInOwl:hasDbXref>

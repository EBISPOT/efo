        <oboInOwl:hasExactSynonym>follicles of Lieberkühn</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>intestinal crypt</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>intestinal crypts</oboInOwl:hasExactSynonym>

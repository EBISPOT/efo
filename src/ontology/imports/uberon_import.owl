        <oboInOwl:hasDbXref>XAO:0000067</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000094</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>blood islands</oboInOwl:hasExactSynonym>

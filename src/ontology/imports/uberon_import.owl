        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Ligament organ that primarily consists of dense connective tissue aggregated into fasciculi which may be admixed with smooth muscle. Examples: ligament of liver, ovarian ligament[FMA:25625].</owl:annotatedTarget>
        <oboInOwl:source>FMA:25625</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>

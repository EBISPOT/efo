        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Organ attached to the liver which stores bile and empties into the duodenum via the bile duct as needed for digestion.[AAO]</owl:annotatedTarget>

        <oboInOwl:hasDbXref>MA:0000413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014649</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000129</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12813</oboInOwl:hasDbXref>

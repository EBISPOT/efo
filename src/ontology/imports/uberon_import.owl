    <!-- http://purl.obolibrary.org/obo/UBERON_0005609 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004573"/>

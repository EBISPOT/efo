        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/1/1c/Normal_gastric_mucosa_intermed_mag.jpg</foaf:depiction>

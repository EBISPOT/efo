        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>(...) endochondral elements of the early tetrapod shoulder develop from two centers of ossification, giving rise to a scapula and a &apos;coracoid&apos;.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000342</oboInOwl:external_class>

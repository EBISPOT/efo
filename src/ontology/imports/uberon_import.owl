        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000210"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>In humans: bone forming side and roof of cranium. Each bone is irregularly quadrilateral in form, and has two surfaces, four borders, and four angles.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Parietal_bone</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000514</oboInOwl:hasDbXref>

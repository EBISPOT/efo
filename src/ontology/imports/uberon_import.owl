        <oboInOwl:hasDbXref>VSAO:0000093</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003073</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000317</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>post-cranial axial skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0002090</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>

        <oboInOwl:hasDbXref>SCTID:362112004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005143</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0011429</oboInOwl:hasDbXref>

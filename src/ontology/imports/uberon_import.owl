    <!-- http://purl.obolibrary.org/obo/UBERON_0002106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004177"/>

        <oboInOwl:hasDbXref>FMA:14771</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0003094</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:244263001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Common_hepatic_artery</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:CommonHepaticArtery</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>arteria hepatica communis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>common hepatic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005436</oboInOwl:id>

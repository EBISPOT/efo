        <oboInOwl:hasDbXref>ZFA:0001455</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>scapulocoracoideum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>coraco-scapular cartilage</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>scapulo-coracoid cartilage</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>scapulocoracoid cartilage</oboInOwl:hasNarrowSynonym>

        <oboInOwl:hasExactSynonym>caudal vertebrae series</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>caudal region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>postsacral region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tail region</oboInOwl:hasRelatedSynonym>

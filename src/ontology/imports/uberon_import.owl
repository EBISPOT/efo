    <!-- http://purl.obolibrary.org/obo/UBERON_0006807 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005055"/>

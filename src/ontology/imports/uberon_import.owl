        <oboInOwl:hasRelatedSynonym>brachium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>upper extremity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001460</oboInOwl:id>

    <!-- http://purl.obolibrary.org/obo/UBERON_0001291 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001291">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001231"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001231"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004135"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The distal sub-portion of the ascending loop of Henle which is lined by simple cuboidal epithelium and enters the renal cortex to empty a hypotonic filtrate into the distal convoluted tubule.</obo:IAO_0000115>
        <obo:IAO_0000116>TODO - thick/thin check. Also - does the loop of Henle overlap the distal convoluted tubule? FMA divides DCT into straight and convoluted portions</obo:IAO_0000116>
        <oboInOwl:hasDbXref>EMAPA:28396</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:29671</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35512</oboInOwl:hasDbXref>

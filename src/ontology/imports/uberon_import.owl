        <oboInOwl:hasExactSynonym>m. deltoideus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>musculus deltoideus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>common shoulder muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>deltoideus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>deltoideus muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>musculus deltoideus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001476</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>

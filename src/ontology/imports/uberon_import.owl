    <!-- http://purl.obolibrary.org/obo/UBERON_0005613 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005613">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000947"/>

        <oboInOwl:hasRelatedSynonym>epimere</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>epimere mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>epithelial somite</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somites</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somitic mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>somitus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002329</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>

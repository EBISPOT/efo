        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:comment>Disease notes: implicated in rheumatoid arthritis.</rdfs:comment>
        <rdfs:label>sclera</rdfs:label>

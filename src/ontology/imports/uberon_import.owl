        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001021"/>
        <obo:IAO_0000115>Any nerve that innervates the iris.</obo:IAO_0000115>
        <obo:IAO_0000116>added for consistency with mouse ontologies. The term &apos;ciliary nerve&apos; is usually used to denote either of the two nerves (with different origins) that innervate the iris, as well as ciliary muscles and cornea</obo:IAO_0000116>
        <oboInOwl:hasDbXref>EMAPA:35449</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001291</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nerve of iris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>ciliary nerve</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>UBERON:0003438</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>iris nerve</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003438"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any nerve that innervates the iris.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UBERON:cjm</oboInOwl:hasDbXref>

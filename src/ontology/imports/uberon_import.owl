        <oboInOwl:hasDbXref>neuronames:158</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>gyrus occipitotemporalis medialis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lingula of cerebral hemisphere</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>medial occipitotemporal gyrus</oboInOwl:hasExactSynonym>

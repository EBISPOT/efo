            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A segment of the hindlimb that corresponds to the joint connecting a hindlimb stylopod and zeugopod.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0003595</oboInOwl:hasDbXref>

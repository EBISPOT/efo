        <obo:IAO_0000115>The dilated structure that is lined by endothelial cells and located at the arterial pole of the heart just above (distal to) the truncus arteriosus in mammalian embryos; it is the primordial vascular channel from which the aortic arches (and eventually the dorsal aortae) arise; the aortic sac is homologous to the ventral aorta of gill-bearing vertebrates.</obo:IAO_0000115>
        <obo:UBPROP_0000001>the merged ventral aortae of the embryo which supplies blood to the aortic arches[TMD][http://medical-dictionary.thefreedictionary.com/aortic+sac].</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>EHDAA2:0004145</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:9826</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:36461</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:71008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RETIRED_EHDAA2:0000133</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361527005</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>saccus aorticus</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0005432</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>

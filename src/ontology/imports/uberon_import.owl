    <!-- http://purl.obolibrary.org/obo/UBERON_0001608 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004121"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004234"/>
        <obo:IAO_0000115>A smooth muscle of the eye, running radially in the iris that functions as a dilator. [WP,unvetted].</obo:IAO_0000115>
        <obo:UBPROP_0000009>It is innervated by the sympathetic system, which acts by releasing noradrenaline, which acts on alpha1-receptors. Thus, when presented with a threatening stimuli that activates the fight-or-flight response, this innervation dilates the iris, thus temporarily letting more light reach the retina</obo:UBPROP_0000009>
        <oboInOwl:hasDbXref>BTO:0001371</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35286</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:49158</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001288</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32463</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:280890008</oboInOwl:hasDbXref>

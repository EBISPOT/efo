        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002542"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A small rigid plate that grows out of an animal&apos;s skin to provide protection. In lepidopteran (butterfly and moth) species, scales are plates on the surface of the insect wing, and provide coloration. Scales are quite common and have evolved multiple times with varying structure and function.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Scale_(zoology)</oboInOwl:hasDbXref>
    </owl:Axiom>

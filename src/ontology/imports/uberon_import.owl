        <oboInOwl:hasRelatedSynonym>os dentale</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sur-angulaire</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004742</oboInOwl:id>

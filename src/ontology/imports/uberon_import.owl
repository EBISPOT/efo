    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001115"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The left lobe is smaller and more flattened than the right. It is situated in the epigastric and left hypochondriac regions. Its upper surface is slightly convex and is moulded on to the diaphragm; its under surface presents the gastric impression and omental tuberosity. [WP,unvetted].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Left_lobe_of_liver</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

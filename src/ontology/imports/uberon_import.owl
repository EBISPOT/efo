        <rdfs:label>inferior vena cava</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/4/4d/Gray577.png</foaf:depiction>
    </owl:Class>

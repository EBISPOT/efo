        <oboInOwl:hasExactSynonym>phylotypic stage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>pharyngula</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004707</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>

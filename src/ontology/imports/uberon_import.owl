    <!-- http://purl.obolibrary.org/obo/UBERON_0000070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000070">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000104"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A life cycle stage of holometabolous insects in which the organism is a pupa and starts with the larval-pupal apolysis and ends with pupal-adult apolysis.</obo:IAO_0000115>
        <obo:UBPROP_0000008>The pupal stage is found only in holometabolous insects, those that undergo a complete metamorphosis, going through four life stages; embryo, larva, pupa and imago</obo:UBPROP_0000008>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-9415-5104"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-3308-6245"/>
        <oboInOwl:hasDbXref>DpseDv:0000004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DsimDv:0000004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBdv:00005349</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pupa</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pupa stage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>aurelia stage</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>chrysalides stage</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>chrysalis stage</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>UBERON:0000070</oboInOwl:id>
        <rdfs:label>pupal stage</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/562</rdfs:seeAlso>
    </owl:Class>

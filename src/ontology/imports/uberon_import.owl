    <!-- http://purl.obolibrary.org/obo/UBERON_0001516 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005800"/>

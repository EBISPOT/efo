    <!-- http://purl.obolibrary.org/obo/UBERON_0011817 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011817">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006598"/>

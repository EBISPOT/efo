    <!-- http://purl.obolibrary.org/obo/UBERON_0001150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>

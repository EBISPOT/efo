    <!-- http://purl.obolibrary.org/obo/UBERON_0004209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007503"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>

        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A continuation of the neuron projection bundle component of a nerve inside, crossing or immediately outside the central nervous system.</owl:annotatedTarget>

        <owl:annotatedTarget>branchial arch membrane</owl:annotatedTarget>
        <oboInOwl:hasDbXref>EMAPA:32749</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0009213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009210"/>

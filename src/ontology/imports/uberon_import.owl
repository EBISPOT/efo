        <oboInOwl:hasDbXref>FMA:293882</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000069</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D054259</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000069</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34226</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362852000</oboInOwl:hasDbXref>

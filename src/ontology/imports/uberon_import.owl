    <!-- http://purl.obolibrary.org/obo/UBERON_0005203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_8410077"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003126"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tubuloacinar seromucous gland that is located principally in the submucosa of the trachea. Excretory ducts from this gland pass through the lamina propria to the tracheal lumen.</obo:IAO_0000115>
        <obo:UBPROP_0000009>These glands secrete mucus, lysozyme, defensins, and other agents that help protect the lungs from particles and infectious agents.</obo:UBPROP_0000009>
        <oboInOwl:hasDbXref>EMAPA:36574</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:7473</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002937</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:197423006</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>glandula trachealis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tracheal gland</oboInOwl:hasExactSynonym>

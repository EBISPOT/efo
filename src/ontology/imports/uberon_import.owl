            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A longitudinal groove in the neural tube wall that divides the neural tube into dorsal (alar) and ventral (basal) halves (dorsal receives input from sensory neurons, ventral effects motor functions); stretches from the mesencephalon caudad[TMD].</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>sulcus limitans</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:slim</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:slm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:629</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>neural tube lateral wall sulcus limitans</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0005478</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>sulcus limitans of neural tube</rdfs:label>
    </owl:Class>

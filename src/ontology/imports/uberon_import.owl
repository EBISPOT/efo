        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001516"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Abdominal part of aorta: the distal part of the descending aorta, which is the continuation of the thoracic part and gives rise to the inferior phrenic, lumbar, median sacral, superior and inferior mesenteric, middle suprarenal, renal, and testicular or ovarian arteries, and celiac trunk[BTO]. The abdominal aorta is the largest artery in the abdominal cavity. As part of the aorta, it is a direct continuation of descending aorta(of the thorax). [WP,unvetted].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>BTO:0002976</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Abdominal_aorta</oboInOwl:hasDbXref>
    </owl:Axiom>

        <owl:annotatedTarget>margo lateralis scapulae</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:23239</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:TA</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003011"/>

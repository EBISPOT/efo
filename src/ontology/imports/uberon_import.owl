            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The outer layer of the epidermis, consisting of several layers of flat keratinized non-nucleated cells.</obo:IAO_0000115>
        <obo:UBPROP_0000001>The keratinized outermost layer of the epidermis, which is periodically shed.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000010>some oral epitehlium also has cornified layer / stratum corneum</obo:UBPROP_0000010>
        <oboInOwl:hasBroadSynonym>horny layer</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>keratinized squame layer</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>stratum corneum</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>AAO:0010597</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0000344</oboInOwl:hasDbXref>

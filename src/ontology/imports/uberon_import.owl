    <!-- http://purl.obolibrary.org/obo/UBERON_0002279 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013685"/>
        <obo:IAO_0000115>At the hinder part of the medial wall of the vestibule is the orifice of the vestibular aqueduct, which extends to the posterior surface of the petrous portion of the temporal bone. It transmits a small vein, and contains a tubular prolongation of the membranous labyrinth, the ductus endolymphaticus, which ends in a cul-de-sac between the layers of the dura mater within the cranial cavity. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:77821</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:885</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001186</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014723</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Vestibular_aqueduct</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>aqueductus vestibuli</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002279</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>vestibular aqueduct</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/1/16/Gray921.png</foaf:depiction>
    </owl:Class>

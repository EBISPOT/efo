        <oboInOwl:hasExactSynonym>midbrain arachnoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>midbrain arachnoid mater of neuraxis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>mesencephalon arachnoid mater</oboInOwl:hasRelatedSynonym>

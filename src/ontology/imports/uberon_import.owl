    <!-- http://purl.obolibrary.org/obo/UBERON_0001054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009773"/>
        <obo:IAO_0000115>A tubule that extends from the posterior part of the digestive tract which absorbs solutes, water, and wastes from the surrounding hemolymph. Each tubule consists of a single layer of cells that is closed off at the distal end with the proximal end joining the alimentary canal at the junction between the midgut and hindgut[WP,modified].</obo:IAO_0000115>
        <obo:UBPROP_0000008>It is unclear as to whether the Malpighian tubules of arachnids and those of the Uniramia are homologous or the result of convergent evolution.[Wikipedia:Malpighian_tubule_system]</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>BTO:0000810</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EFO:0000243</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00005786</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:1228</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008317</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:41055008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TADS:0000163</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGMA:0001038</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Malpighian_tubule</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Malphigian tube</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Malpighian tube</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tuba Malpighii</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001054</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>EDITOR_NOTE this will be ceded to the Arthropod Anatomy Ontology</rdfs:comment>
        <rdfs:label>Malpighian tubule</rdfs:label>
    </owl:Class>

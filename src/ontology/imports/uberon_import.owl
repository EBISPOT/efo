        <oboInOwl:hasDbXref>SCTID:181812008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0024687</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Human_mandible</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Mandible</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>inferior maxillary bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammaliam mandible</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mandibulla</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>lower mandibula</oboInOwl:hasNarrowSynonym>

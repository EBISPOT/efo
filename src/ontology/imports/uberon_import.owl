        <oboInOwl:hasDbXref>UMLS:C0224307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Longissimus#Longissimus_thoracis</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>longissimus dorsi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>longissimus dorsi muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>longissimus thoracis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>musculus longissimus dorsi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>musculus longissimus thoracis</oboInOwl:hasExactSynonym>

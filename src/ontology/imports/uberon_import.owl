        <rdfs:label>upper respiratory tract</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/9/9f/Illu_conducting_passages.svg</foaf:depiction>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/c/c3/Illu_conducting_passages.jpg</foaf:depiction>

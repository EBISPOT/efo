    <!-- http://purl.obolibrary.org/obo/UBERON_0002407 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>

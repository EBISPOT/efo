        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A large vein that connects the femoral vein to the common iliac vein. Their origin is at the inferior margin of the inguinal ligaments and they terminate when they join the internal iliac veins (to form the common iliac veins). Both external iliac veins are accompanied along their course by external iliac arteries. [WP,modified].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:External_iliac_vein</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

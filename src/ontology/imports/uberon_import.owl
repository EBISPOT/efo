        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004451"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009568"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A vertebra in the trunk region. For tetrapods, includes lumbar and thoracic vertebrae. Excludes caudal/coccygeal vertebra, which are located posteriorly. In tetrapods this includes thoracic, lumbar and sacral vertebrae, and excludes the cervical vertebrae, which are located anteriorly.</obo:IAO_0000115>
        <obo:UBPROP_0000202 rdf:resource="http://purl.obolibrary.org/obo/FMA_72066"/>
        <oboInOwl:hasExactSynonym>thoracolumbar vertebra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>presacral vertebra</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0011677</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>trunk vertebra</rdfs:label>
    </owl:Class>
    <owl:Axiom>

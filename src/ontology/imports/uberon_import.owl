        <oboInOwl:hasDbXref>VHOG:0000685</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Inferior_ganglion_of_vagus_nerve</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ganglion inferius (nervus vagus)</oboInOwl:hasExactSynonym>

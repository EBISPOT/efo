        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004068"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>medial nasal process</owl:annotatedTarget>
        <oboInOwl:hasDbXref>EHDAA2:0001076</oboInOwl:hasDbXref>

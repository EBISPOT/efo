        <oboInOwl:hasExactSynonym>chondrogenic tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cartilage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cartilages</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>portion of cartilage tissue</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002418</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>

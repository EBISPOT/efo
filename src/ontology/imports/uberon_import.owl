    <!-- http://purl.obolibrary.org/obo/UBERON_0001468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002216"/>

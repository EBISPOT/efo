    <!-- http://purl.obolibrary.org/obo/UBERON_0002663 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002663">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0007245"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>

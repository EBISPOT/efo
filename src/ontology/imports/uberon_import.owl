        <oboInOwl:hasNarrowSynonym>caeca</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>ceca</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>blind intestine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>blindgut</oboInOwl:hasRelatedSynonym>

        <oboInOwl:hasDbXref>neuronames:2054</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>autonomic division of peripheral nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>autonomic part of peripheral nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>divisio autonomica systematis nervosi peripherici</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pars autonomica systematis nervosi peripherici</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>peripheral autonomic nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>visceral nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ANS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>divisio autonomica systematis nervosi peripherici</oboInOwl:hasRelatedSynonym>

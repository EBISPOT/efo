        <oboInOwl:hasDbXref>Wikipedia:Lung</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000119</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Lung</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pulmo</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0002048</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0001016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000467"/>

        <oboInOwl:hasDbXref>MA:0002286</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32446</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181620007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0224234</oboInOwl:hasDbXref>

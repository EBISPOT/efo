        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:comment>The opercle is usually a large, flat bone that may be partially covered by the posterior region of the preopercle.</rdfs:comment>
        <rdfs:label>opercle</rdfs:label>
    </owl:Class>
    <owl:Axiom>

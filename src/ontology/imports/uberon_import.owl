        <oboInOwl:hasDbXref>GAID:505</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002031</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D011651</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12774</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181380003</oboInOwl:hasDbXref>

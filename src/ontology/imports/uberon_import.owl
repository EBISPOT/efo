        <oboInOwl:hasDbXref>http://en.wikipedia.org/wiki/Corpora_allata</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://www.cals.ncsu.edu/course/ent425/tutorial/endocrine.html</oboInOwl:hasDbXref>

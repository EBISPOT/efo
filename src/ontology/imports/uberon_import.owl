        <oboInOwl:hasDbXref>EHDAA2:0001382</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:2163</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:17066</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:79792</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000254</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0001101</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000254</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pancreatic primordium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>pancreatic anlage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pancreatic endoderm</oboInOwl:hasRelatedSynonym>

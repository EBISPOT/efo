        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000158"/>
        <obo:IAO_0000115>A cover or envelope partly or wholly surrounding a structure. Examples: egg shell, articular capsules, renal capsules[WP].</obo:IAO_0000115>
        <obo:UBPROP_0000007>capsular</obo:UBPROP_0000007>

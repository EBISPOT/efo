    <!-- http://purl.obolibrary.org/obo/UBERON_0003901 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003901">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003037"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000383"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A logitudinal sheet of continuous connective tissue partition developing at the apex of the chevron-shaped myotome and separating dorsal (epaxial) and ventral (hypaxial) body wall muscle masses; each is destined to become, respectively, the epaxial and hyopaxial musculature.</obo:IAO_0000115>
        <obo:UBPROP_0000001>A connective tissue partition developing at the apex of the chevron-shaped myotome and separating dorsal (epaxial) and ventral (hypaxial) body wall muscle masses. Kimmel et al, 1995.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000002>relationship loss: subclass myoseptum (TAO:0001089)[TAO]</obo:UBPROP_0000002>
        <oboInOwl:hasDbXref>EFO:0003555</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000671</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000671</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>horizontal myoseptum</oboInOwl:hasExactSynonym>

        <oboInOwl:hasRelatedSynonym>intercostales</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>respiratory muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rib muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001111</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>intercostal muscle</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/f/f2/Gray411.png</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The respiratory muscles that arise from the lower border of one rib and insert into the upper border of the adjoining rib.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MESH:A02.633.567.900.500</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MGI:csmith</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0002280</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>Inspiration by active expansion of the thorax evolved later, in the ancestor of reptiles, birds, and mammals. This was powered originally by the intercostal muscles (as in lizards or crocodilians) and later (in mammals only) by a muscular diaphragm.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000903</oboInOwl:external_class>
        <oboInOwl:ontology>VHOG</oboInOwl:ontology>
        <oboInOwl:source>ISBN:978-0262112789 Kent RD, The MIT Encyclopedia of Communication Disorders (20039 p.56</oboInOwl:source>
        <oboInOwl:source>http://bgee.unil.ch/</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001111"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>UMLS:C0021724</owl:annotatedTarget>
        <oboInOwl:source>ncithesaurus:Intercostal_Muscle</oboInOwl:source>
    </owl:Axiom>

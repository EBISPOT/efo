        <oboInOwl:hasDbXref>ZFA:0000151</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pronephric kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>archinephron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>embryonic kidney</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pronephron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002120</oboInOwl:id>

    <!-- http://purl.obolibrary.org/obo/UBERON_0010212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034921"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008895"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Apparatus located between the lungs and the buccal cavity. This apparatus is composed of a pair of arytenoid cartilages that are supported by the cricoid ring.</obo:IAO_0000115>

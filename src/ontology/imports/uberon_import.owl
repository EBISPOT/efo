                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002108"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The peritoneum responsible for connecting the jejunum and ileum (parts of the small intestine) to the back wall of the abdomen. Between the two sheets of peritoneum are blood vessels, lymph vessels, and nerves. This allows these parts of the small intestine to move relatively freely within the abdominopelvic cavity. The brain, however, cannot map sensation accurately, so sensation is usually referred to the midline, an example of referred pain[WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EMAPA:37745</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:14643</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001555</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:245456008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mesentery#Mesentery_.28proper.29</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mesentery (proper)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mesentery proper</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>small intestinal mesentery</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>small intestine mesentery</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0001170</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>mesentery of small intestine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The peritoneum responsible for connecting the jejunum and ileum (parts of the small intestine) to the back wall of the abdomen. Between the two sheets of peritoneum are blood vessels, lymph vessels, and nerves. This allows these parts of the small intestine to move relatively freely within the abdominopelvic cavity. The brain, however, cannot map sensation accurately, so sensation is usually referred to the midline, an example of referred pain[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Mesentery#Mesentery_.28proper.29</oboInOwl:hasDbXref>

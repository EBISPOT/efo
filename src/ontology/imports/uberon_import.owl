        <oboInOwl:hasDbXref>Wikipedia:Lingual_nerve</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lingual branch of trigeminal nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>trigeminal V nerve lingual branch</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>trigeminal nerve lingual branch</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0003721</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>

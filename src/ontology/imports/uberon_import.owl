    <!-- http://purl.obolibrary.org/obo/UBERON_0001508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001515"/>

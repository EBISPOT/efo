        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:comment>Olfactory placodes are the only ectodermal placodes to produce glia, a cell type typically derived from neural crest // Note that NBK53171 classifies this as non-neurogenic</rdfs:comment>
        <rdfs:label>olfactory placode</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003050"/>

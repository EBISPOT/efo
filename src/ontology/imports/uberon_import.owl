    <!-- http://purl.obolibrary.org/obo/UBERON_0002221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002209"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003685"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001703"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Anatomical structure that is a membranous gap between bones of the skull[TAO]. In humans: Fontanelles are soft spots on a baby&apos;s head which, during birth, enable the bony plates of the skull to flex, allowing the child&apos;s head to pass through the birth canal. The ossification of the bones of the skull cause the fontanelles to close over by a child&apos;s second birthday. The closures eventually form the sutures of the neurocranium. Although there are the two anterior and posterior fontanelles, there are two more fontanelles of interest, the mastoid fontanelle, and the sphenoidal fontanelle[WP].</obo:IAO_0000115>
        <obo:UBPROP_0000001>Anatomical structure that is a membranous gap between bones of the skull.[TAO]</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>FMA:75438</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0001465</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32621</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:272681004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0001738</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0224548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Fontanelle</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005536</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fontanel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fontanelles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fontanels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>fonticuli cranii</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002221</oboInOwl:id>

    <!-- http://purl.obolibrary.org/obo/UBERON_0001152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003703"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005171"/>
        <obo:IAO_0000115>The tubular structure that conducts gall bladder contents from the gall bladder to the common bile duct.</obo:IAO_0000115>
        <obo:UBPROP_0000001>Duct that connects the gall bladder and the common bile duct.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000001>The duct of the gallbladder which joins the common hepatic duct, thus forming the common biliary duct. [Dorian_AF, Elsevier&apos;s_encyclopaedic_dictionary_of_medicine, Part_B:_Anatomy_(1988)_Amsterdam_etc.:_Elsevier][VHOG]</obo:UBPROP_0000001>

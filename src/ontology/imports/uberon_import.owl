    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002257"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The anterior horn of the spinal cord (or anterior cornu, or anterior column, or ventral horn) is the ventral (front) grey matter section of the spinal cord. The anterior horn contains motor neurons that affect the axial muscles while the posterior horn receives information regarding touch and sensation. The anterior horn is where the cell bodies of alpha motorneurons are located[Wikipedia:Anterior_horn_of_spinal_cord].</owl:annotatedTarget>
        <oboInOwl:source>Wikipedia:Anterior_horn_of_spinal_cord</oboInOwl:source>
    </owl:Axiom>

    <!-- http://purl.obolibrary.org/obo/UBERON_0002052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003893"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002369"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The thick capsule of dense irregular connective tissue that surrounds each adrenal gland and contains scattered elastic fibers; the capsule contains a rich plexus of blood vessels (mainly small arteries) and numerous nerve fibers; some blood vessels and nerves enter the substance of the gland in the trabeculae that extend inward from the capsule and then leave the trabeculae to enter the cortex.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:69087</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32050</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1181304</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>capsule of adrenal gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>adrenal capsule</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002052</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>

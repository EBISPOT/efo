        <oboInOwl:hasDbXref>UMLS:C0225342</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Tunica_externa_(vessels)</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adventitia externa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tunica adventitia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tunica adventitia of vessel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>external coat</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tunica adventitia vasorum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tunica externa vasorum</oboInOwl:hasRelatedSynonym>

    <!-- http://purl.obolibrary.org/obo/UBERON_0002943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000200"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0015019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015019">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0002228"/>

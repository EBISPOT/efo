        <oboInOwl:hasDbXref>neuronames:365</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Purkinje cell layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebellar Purkinje cell layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebellum Purkinje cell layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebellum Purkinje layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>nuclei reticulares (thalami)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus reticularis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>nucleus reticulatus (thalami)</oboInOwl:hasRelatedSynonym>

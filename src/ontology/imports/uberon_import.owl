    <!-- http://purl.obolibrary.org/obo/UBERON_0002081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004151"/>
        <obo:IAO_0000115>Cardiac chamber in which blood enters the heart.</obo:IAO_0000115>
        <obo:UBPROP_0000001>One of four heart chambers.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000001>One of two chambers of the heart which receive blood from the veins and forces it by muscular contration to the ventricle.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000003>In the primitive vertebrate heart the four chambers are: 1. Sinus venosus (...) 2. Atrium (...) 3. Ventricle (...) 4. Conus arteriosus (...).[well established][VHOG]</obo:UBPROP_0000003>

        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:comment>&quot;The primitive gut is enveloped by a mesentery that has a dorsal and a ventral aspect. The ventral mesentery degenerates during development with the exception of the foregut ventral mesentery, which develops into specialized structures (see foregut embryology).&quot; [http://sprojects.mmi.mcgill.ca/embryology/gi/pgm.htm]. todo - check</rdfs:comment>
        <rdfs:label>ventral mesogastrium</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/c/cf/Gray984.png</foaf:depiction>
    </owl:Class>

        <oboInOwl:hasExactSynonym>liver left lobe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lobus hepaticus sinister</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>left hepatic lobe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lobus hepatis sinister</oboInOwl:hasRelatedSynonym>

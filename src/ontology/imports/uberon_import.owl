                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002049"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A vessel of the microcirculature, lying between the arterioles and venules; includes capillaries (blood and lymphatic), metarterioles and arteriovenous anastomoses.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D055806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005251</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005251</oboInOwl:hasDbXref>

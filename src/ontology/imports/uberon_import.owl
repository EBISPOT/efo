    <!-- http://purl.obolibrary.org/obo/UBERON_0005287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005287">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0005283"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002422"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005283"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002422"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Tela chorioidea that lines the fourth ventricle[ZFA]. The tela chorioidea of the fourth ventricle is the name applied to the triangular fold of pia mater which is carried upward between the cerebellum and the medulla oblongata. It consists of two layers, which are continuous with each other in front, and are more or less adherent throughout: The posterior layer covers the antero-inferior surface of the cerebellum. The anterior layer is applied to the structures which form the lower part of the roof of the ventricle, and is continuous inferiorly with the pia mater on the inferior peduncles and closed part of the medulla[WP].</obo:IAO_0000115>
        <obo:UBPROP_0000001>Tela chorioidea that lines the fourth ventricle.[TAO]</obo:UBPROP_0000001>
        <oboInOwl:hasBroadSynonym>tela choroidea</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:tc4v</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:78493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362321009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0005158</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Tela_chorioidea_of_fourth_ventricle</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005158</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:639</oboInOwl:hasDbXref>

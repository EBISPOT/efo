        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Portion of ventral mesentery closest to the stomach.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Ventral_mesentery</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

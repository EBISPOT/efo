        <oboInOwl:hasExactSynonym>segment of limb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>subdivision of limb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>extremity part</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>limb region</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>region of limb</oboInOwl:hasRelatedSynonym>

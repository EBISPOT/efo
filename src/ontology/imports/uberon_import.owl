    <!-- http://purl.obolibrary.org/obo/UBERON_5101466 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_5101466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_5102544"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012150"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_5001466"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A subdivision of the skeleton of the autopod consisting of the phalanges of pedal digit plus the associated metapodial element.</obo:IAO_0000115>
        <obo:IAO_0000232>this class represents a series of phalanges plus a metapodial element. In comparative anatomy terminology we would call this a &apos;digit&apos;, but the label &apos;digit&apos; is sometimes used to exclude metapodials and to include soft tissue. This series of elements is hypothesized to be homologous to radials.</obo:IAO_0000232>
        <oboInOwl:hasRelatedSynonym>pedal digit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pedal digit skeleton</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:5101466</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>pedal digit digitopodial skeleton</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_5101466"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A subdivision of the skeleton of the autopod consisting of the phalanges of pedal digit plus the associated metapodial element.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

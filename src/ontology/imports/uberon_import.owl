            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A skeletal ligament that connects the fibula to the calcaneus.</obo:IAO_0000115>
        <obo:UBPROP_0000008>In humans, it is a narrow, rounded cord, running from the apex of the fibular malleolus downward and slightly backward to a tubercle on the lateral surface of the calcaneus. It is covered by the tendons of the Peronæi longus and brevis.</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>FMA:44089</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:244650001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Calcaneofibular_ligament</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ligamentum calcaneofibulare</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0011971</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>calcaneofibular ligament</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/b/bf/Ankle_en.svg</foaf:depiction>
    </owl:Class>

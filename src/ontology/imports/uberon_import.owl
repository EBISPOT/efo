        <oboInOwl:hasRelatedSynonym>layer II of entorhinal cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>outermost cell layer of entorhinal cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0022337</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:label>entorhinal cortex layer 2</rdfs:label>

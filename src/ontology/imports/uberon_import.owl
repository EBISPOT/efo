    <!-- http://purl.obolibrary.org/obo/UBERON_0004726 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006544"/>
        <obo:IAO_0000115>A group of microvessels that are part of the kidney. A vasa recta has a hairpin-like shape, entering the renal medulla as the straight arterioles and surrounds the loop of Henle, forming a capillary network. Finally it leaves the renal medulla to ascend to the cortex as the straight venules. The primary function of the vasa recta is to facilitate countercurrent exchange, which is essential for the kidney&apos;s ability to concentrate urine</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EMAPA:30043</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:72006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002595</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Vasa_recta</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:ArteriaeRectae</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>kidney vasa recta</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vasa recta of kidney</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vasa recta renis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>arteriolae rectae renis</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>renal medullary capillary</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>set of straight arterioles of kidney</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>straight arterioles of kidney</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>arteriolae rectae renis</oboInOwl:hasRelatedSynonym>

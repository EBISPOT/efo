        <oboInOwl:hasDbXref>MAT:0000454</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D010496</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C13005</oboInOwl:hasDbXref>

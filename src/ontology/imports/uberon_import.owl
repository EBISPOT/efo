        <oboInOwl:hasDbXref>UMLS:C1280369</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000141</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Adenohypophysis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001282</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:407</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>anterior hypophysis</oboInOwl:hasExactSynonym>

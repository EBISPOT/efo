    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001467"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000012"/>
        <owl:annotatedTarget>In FMA, the shoulder is part of the pectoral girdle region. in MA, shoulder structures like shoulder joints, bones, nerves etc are part of the shoulder and the forelimb. E.g. humerus is a shoulder bone</owl:annotatedTarget>
        <oboInOwl:external_ontology>FMA</oboInOwl:external_ontology>
    </owl:Axiom>

    <!-- http://purl.obolibrary.org/obo/UBERON_0008783 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
        <obo:IAO_0000115>The dorsal venous arch of the foot is a superficial vein that connects the small saphenous vein and the great saphenous vein. Anatomically, it is defined by where the dorsal veins of the first and fifth digit, respectively, meet the great saphenous vein and small saphenous vein.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EMAPA:37521</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:44356</oboInOwl:hasDbXref>

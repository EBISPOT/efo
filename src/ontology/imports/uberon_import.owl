        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>1st pharyngeal membrane</owl:annotatedTarget>
        <oboInOwl:hasDbXref>VHOG:0001427</oboInOwl:hasDbXref>

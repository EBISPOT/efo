        <oboInOwl:hasDbXref>PBA:294021914</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:2702</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cerebral cortex cortical plate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>future cortical layers II-VI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neocortex cortical plate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>future neocortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005343</oboInOwl:id>

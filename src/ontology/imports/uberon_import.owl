    <!-- http://purl.obolibrary.org/obo/UBERON_0003723 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003723">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001021"/>
        <rdfs:subClassOf>
            <owl:Restriction>

        <rdfs:label>subiculum</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/9/99/Hippocampus.gif</foaf:depiction>
    </owl:Class>

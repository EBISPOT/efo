        <oboInOwl:hasDbXref>SCTID:261187001</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vesico-ureteral junction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vesico-ureteric junction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vesicoureteric junction</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0009973</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>

        <oboInOwl:hasRelatedSynonym>lateral plate mesenchyme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mesoderma laminae lateralis</oboInOwl:hasRelatedSynonym>

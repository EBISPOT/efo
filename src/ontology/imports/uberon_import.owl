    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0018251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
        <obo:IAO_0000115>One of the veins draining a meninix.</obo:IAO_0000115>
        <obo:UBPROP_0000008>In humans, any of several veins that accompany the meningeal arteries, communicate with the sinuses of the dura mater and diploic veins, and drain into the regional veins outside the cranial vault.</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>FMA:50839</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:84842006</oboInOwl:hasDbXref>

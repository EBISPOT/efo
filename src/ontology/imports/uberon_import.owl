        <oboInOwl:hasDbXref>VHOG:0001186</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cloaca</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000244</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005781</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>cloacal chamber</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vent</oboInOwl:hasRelatedSynonym>

        <oboInOwl:hasDbXref>galen:TrigoneOfUrinaryBladder</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Lieutaud&apos;s trigone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>bladder trigone</oboInOwl:hasExactSynonym>

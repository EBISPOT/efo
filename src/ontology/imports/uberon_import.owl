    <!-- http://purl.obolibrary.org/obo/UBERON_0022353 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>

    <!-- http://purl.obolibrary.org/obo/UBERON_0001173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>

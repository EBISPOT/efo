        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HANCESTRO_0304"/>
        <obo:IAO_0000115>Ancestry that is the result of cultural or geographic isolation. Generally characterised by increased genetic homogeneity and reduced genetic variation</obo:IAO_0000115>
        <rdfs:label xml:lang="en">genetically isolated ancestry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HANCESTRO_0306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HANCESTRO_0306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HANCESTRO_0304"/>
        <obo:IAO_0000115>Ancestry which is an admixture of more than one defined ancestral population. The degree and type of admixture may vary within a population and the accuracy of classification requires well-defined reference samples</obo:IAO_0000115>
        <rdfs:label xml:lang="en">admixed ancestry</rdfs:label>
    </owl:Class>
    



                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HANCESTRO_0305"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A population with increased genetic homogeneity and reduced genetic variation due to cultural or geographic isolation</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>founder population</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>population isolate</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">genetically isolated population</rdfs:label>
    </owl:Class>
    



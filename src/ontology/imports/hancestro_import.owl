        <obo:IAO_0000115 xml:lang="en">Includes individuals who either self-report or have been described by authors as Central Asian. We note that there does not appear to be a suitable reference population for this population and efforts are required to fill this gap.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Central Asian</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">Central Asian ancestry</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HANCESTRO_0290 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HANCESTRO_0290">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/HANCESTRO_0301"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HANCESTRO_0305"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HANCESTRO_0004"/>
        <rdfs:subClassOf>
            <owl:Restriction>

        <obo:IAO_0000234>NCI BBRB</obo:IAO_0000234>
        <rdfs:label>G3: Poorly differentiated</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002209 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002209">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002205"/>

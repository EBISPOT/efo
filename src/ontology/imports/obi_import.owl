    <!-- http://purl.obolibrary.org/obo/OBI_0002230 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002230">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002224"/>

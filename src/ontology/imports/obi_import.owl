        <obo:IAO_0000234>NCI BBRB</obo:IAO_0000234>
        <rdfs:label>pT3 (kidney)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002252 -->


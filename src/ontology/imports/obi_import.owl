    <!-- http://purl.obolibrary.org/obo/OBI_0000457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000457">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000417"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000458"/>
            </owl:Restriction>
        </owl:equivalentClass>

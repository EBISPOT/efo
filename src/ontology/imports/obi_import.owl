        <obo:IAO_0000111>manufacturing</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A planned process with the objective to produce a processed material which will have a function for future use.</obo:IAO_0000115>

    <!-- http://purl.obolibrary.org/obo/HP_0004755 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0004755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001649"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011675"/>
        <obo:IAO_0000115>Supraventricular tachycardia (SVT) is an abnormally increased heart rate (over 100 beats per minute at rest) with origin above the level of the ventricles.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:6456007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0039240</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1698480</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>SVT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Supraventricular tachyarrhythmia</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0004755</oboInOwl:id>
        <rdfs:comment>A narrow complex (QRS width less than 120 milliseconds) reflects rapid activation of the ventricles via the normal conduction pathway, i.e. His-Purkinje system, which in turn suggests that the tachycardia originated above the AV node and is thus supraventricular.</rdfs:comment>
        <rdfs:label>Supraventricular tachycardia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004755"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Supraventricular tachycardia (SVT) is an abnormally increased heart rate (over 100 beats per minute at rest) with origin above the level of the ventricles.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:DDD_dbrown</oboInOwl:hasDbXref>
    </owl:Axiom>

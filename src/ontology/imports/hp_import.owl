    <!-- http://purl.obolibrary.org/obo/HP_0005133 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0005133">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001707"/>
        <obo:IAO_0000115>Enlargement of the chamber of the right ventricle, which can be defined echocardiographically as a right ventricular to left ventricular ratio greater than 1:1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Fyler:1827</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Fyler:2333</oboInOwl:hasDbXref>

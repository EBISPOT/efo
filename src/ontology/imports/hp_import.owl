    <!-- http://purl.obolibrary.org/obo/HP_0033305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of fetuin-A in the blood circulation.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-28T22:09:58Z</terms:date>
        <oboInOwl:hasExactSynonym>Abnormal alpha-2-HS-glycoprotein level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal circulating fetuin-A concentration</oboInOwl:hasExactSynonym>
        <rdfs:comment>Fetuin-A (FetA) is a 64-kDa glycoprotein that is found in relatively high concentrations in human serum. In human adults, FetA is mainly expressed and secreted from the liver and adipose tissue. Epidemiologic research consistently observes elevated circulating FetA in obesity and related complications, such as type 2 diabetes mellitus, the metabolic syndrome, and nonalcoholic fatty liver disease.</rdfs:comment>
        <rdfs:label>Abnormal circulating fetuin-A concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033305"/>

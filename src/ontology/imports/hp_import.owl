        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0007803 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007803">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000551"/>
        <obo:IAO_0000115>Complete color blindness, a complete inability to distinguish colors. Affected persons cannot perceive colors, but only shades of gray.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007954</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:56852002</oboInOwl:hasDbXref>

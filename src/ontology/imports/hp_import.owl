    <!-- http://purl.obolibrary.org/obo/HP_0007973 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007973">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000479"/>
        <obo:IAO_0000115>Abnormal growth and differentiation, structure and appearance of the retina present from birth.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007770</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0008022</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:95494009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0035313</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Dysplasia/hypoplasia of the retina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Retinal dysgenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Retinal hypoplasia</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>HP:0007973</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This feature is a congenital developmental anomaly of the retina characterized by abnormal growth and differentiation. The retina contains numerous tubular structures and rosettes. Retinal dysplasia (synonym: retinal dysgenesis) is often accompanied by retinal detachment and micropthalmos, but the latter features should be coded separately.</rdfs:comment>
        <rdfs:label>Retinal dysplasia</rdfs:label>
    </owl:Class>
    <owl:Axiom>

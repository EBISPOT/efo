        <oboInOwl:hasDbXref>UMLS:C0031117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4025831</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormal peripheral nervous system structure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Peripheral nervous system disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0000759</oboInOwl:id>
        <rdfs:comment>The peripheral nervous system is divided into autonomic and somatic components, which both include afferent (sensory) and efferent (motor) nerves.</rdfs:comment>
        <rdfs:label>Abnormal peripheral nervous system morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000759"/>

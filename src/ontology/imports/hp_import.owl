    <!-- http://purl.obolibrary.org/obo/HP_0002123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001250"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002197"/>
        <obo:IAO_0000115>A generalized myoclonic seizure is a type of generalized motor seizure characterized by bilateral, sudden, brief (&lt;100 ms) involuntary single or multiple contraction of muscles or muscle groups of variable topography (axial, proximal limb, distal). Myoclonus is less regularly repetitive and less sustained than is clonus.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0006869</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0006902</oboInOwl:hasAlternativeId>

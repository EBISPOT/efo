    <!-- http://purl.obolibrary.org/obo/HP_0000741 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025780"/>
        <obo:IAO_0000115>Apathy is a quantitative reduction of interest, motivation and the initiation and persistence of goal-directed behavior, where often the accompanying emotions, thoughts, and social interactions are also diminished. The individual is typically non-reactive to provocations, positive or negative, and appears to not care. Distinguished from lethargy which involves lack of physical or mental energy.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1111-7357"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7954-5235"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2897-0458"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4298-5074"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4618-6544"/>
        <oboInOwl:hasDbXref>SNOMEDCT_US:20602000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0085632</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Lack of feeling, emotion, interest</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lack of feeling, emotion, interest, motivation, initiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>State of indifference</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000741</oboInOwl:id>
        <rdfs:comment>Apathy may co-occur with lethargy.</rdfs:comment>
        <rdfs:label>Apathy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000741"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lack of feeling, emotion, interest</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-6548-5200"/>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    



        <oboInOwl:hasDbXref>UMLS:C0700292</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Low blood oxygen level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Hypoxia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0012418</oboInOwl:id>
        <rdfs:comment>Note that hypoxemia is defined as a condition where arterial oxygen tension is below normal (80-100mmHg). Hypoxia is defined as the failure of oxygenation at the tissue level. Hypoxia is not measured directly by a standard laboratory value.</rdfs:comment>
        <rdfs:label>Hypoxemia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012418"/>

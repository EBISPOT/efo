    <!-- http://purl.obolibrary.org/obo/HP_0000848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0040084"/>
        <obo:IAO_0000115>An increased level of renin in the blood.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0003615</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C0240783</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Elevated blood renin level</oboInOwl:hasExactSynonym>

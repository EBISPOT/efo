        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010766"/>
        <obo:IAO_0000115>Intracranial calcifications refer to calcifications within the brain parenchyma or vasculature. The five major components of the brain comprise the cerebrum, cerebellum, brain stem, pituitary gland, and hypothalamus.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-01-25T08:18:11Z</terms:date>

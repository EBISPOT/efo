        <oboInOwl:hasExactSynonym>Excessive tooth attrition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Excessive wear and tear on teeth</oboInOwl:hasExactSynonym>
        <rdfs:label>Excessive dental attrition</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_4000181"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>

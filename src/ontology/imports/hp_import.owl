    <!-- http://purl.obolibrary.org/obo/HP_0000725 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011446"/>
        <obo:IAO_0000115>Periods of time during which an individual experiences significant disturbances in their thoughts, perceptions, emotions, and behavior, resulting in a loss of touch with reality. These episodes are hallmark features of psychotic disorders such as schizophrenia, schizoaffective disorder, and certain forms of bipolar disorder.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7062-8192"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7941-2961"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9221-9226"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0183-1637"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1785-7126"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2291-6952"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4958-6025"/>
        <oboInOwl:hasDbXref>UMLS:C0338614</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Psychotic episodes</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000725</oboInOwl:id>
        <rdfs:label>Psychotic episodes</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000725"/>

    <!-- http://purl.obolibrary.org/obo/HP_0002000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010938"/>
        <obo:IAO_0000115>Reduced distance from the anterior border of the naris to the subnasale.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C1857479</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4280585</oboInOwl:hasDbXref>

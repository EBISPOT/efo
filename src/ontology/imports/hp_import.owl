    <!-- http://purl.obolibrary.org/obo/HP_0000456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000436"/>
        <obo:IAO_0000115>A splitting of the nasal tip. Visually assessable vertical indentation, cleft, or depression of the nasal tip.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0005282</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:249326006</oboInOwl:hasDbXref>

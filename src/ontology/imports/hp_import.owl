        <oboInOwl:hasRelatedSynonym>Total colorblindness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0007803</oboInOwl:id>
        <rdfs:comment>Rod monochromacy is the condition of having only rods in the retina. A rod monochromat is truly unable to see any color and can see only shades of gray.</rdfs:comment>
        <rdfs:label>Monochromacy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007803"/>

    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100749"/>
        <obo:IAO_0000115>A type of chest pain that arises in the or under the left breast and often described as throbbing, stabbing, or burning, and lasting hours or longer. The pain may arise with or after effort, and may spread to the left arm or left side of the neck.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-11-22T15:23:39Z</terms:date>
        <rdfs:label>Precordial pain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032141"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of chest pain that arises in the or under the left breast and often described as throbbing, stabbing, or burning, and lasting hours or longer. The pain may arise with or after effort, and may spread to the left arm or left side of the neck.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18122452</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032153">

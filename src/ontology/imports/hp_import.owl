    <!-- http://purl.obolibrary.org/obo/HP_0011450 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002011"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032158"/>
        <obo:IAO_0000115>Increased susceptibility to infections of the central nervous system, as manifested by recurrent, severe, or invasive infections involving the brain, meninges, or spinal cord. This can include infections caused by opportunistic or atypical pathogens, or common pathogens presenting with unusual severity or in anatomical locations.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7601-9822"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9382-150X"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2029-0733"/>

        <oboInOwl:hasExactSynonym>Abnormal ERG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal electroretinography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ERG abnormal</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000512</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>The electrical responses of the photoreceptors (rods and cones), inner retinal cells (bipolar and amacrine cells), and the ganglion cells can be assessed by ERG.</rdfs:comment>
        <rdfs:label>Abnormal electroretinogram</rdfs:label>
    </owl:Class>

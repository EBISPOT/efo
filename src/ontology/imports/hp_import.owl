    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0005446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000277"/>
        <obo:IAO_0000115>Abnormally flat (obtuse) angle of the mandible. The angle of the mandibular, located at the junction between the body and the ramus of the mandible, is normally close to being a right angle. This terms describes an abnormal increase of this angle such that the mandible appears flatter than normal.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:709997007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4038738</oboInOwl:hasDbXref>

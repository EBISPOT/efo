        <owl:annotatedTarget>Abnormality of skeletal maturation</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000929 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000234"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0009121"/>
        <obo:IAO_0000115>An abnormality of the skull, the bony framework of the head which is comprised of the neurocranium (with eight cranial bones) and the viscerocranium (facial skeleton) that comprises fourteen facial bones with the mandible as its largest bone.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C0235942</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of the skull</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Abnormality of the skull bones</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>HP:0000929</oboInOwl:id>
        <rdfs:label>Abnormal skull morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000929"/>

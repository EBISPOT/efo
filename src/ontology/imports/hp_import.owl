    <!-- http://purl.obolibrary.org/obo/HP_0005920 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0005920">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0005918"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0005924"/>
        <obo:IAO_0000115>Abnormality of one or all of the epiphyses of the phalanges of the hand. Note that this includes the epiphysis of the 1st metacarpal. In contrast to the metacarpals 2-5, the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the digits 2-5 (whereas the proximal phalanx of the thumb is equivalent to the middle phalanges of the other digits).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-03-27T02:21:00Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0009151</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4021613</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0005920</oboInOwl:id>
        <rdfs:label>Abnormal epiphysis morphology of the phalanges of the hand</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0005920"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Abnormality of one or all of the epiphyses of the phalanges of the hand. Note that this includes the epiphysis of the 1st metacarpal. In contrast to the metacarpals 2-5, the first metacarpal is embryologically of phalangeal origin and as such equivalent to the proximal phalanges of the digits 2-5 (whereas the proximal phalanx of the thumb is equivalent to the middle phalanges of the other digits).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    



    <!-- http://purl.obolibrary.org/obo/HP_0002069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001250"/>
        <obo:IAO_0000115>A bilateral tonic-clonic seizure is a seizure defined by a tonic (bilateral increased tone, lasting seconds to minutes) and then a clonic (bilateral sustained rhythmic jerking) phase.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001306</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0002407</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007252</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:54200006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0494475</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Bilateral convulsive seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalised convulsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalised tonic-clonic seizure (without specification of onset)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized convulsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized tonic-clonic seizure (without specification of onset)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Grand mal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Grand mal seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Seizures, tonic-clonic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tonic-clonic convulsion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tonic-clonic convulsions</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002069</oboInOwl:id>
        <rdfs:comment>A tonic-clonic seizure may be generalized from onset or progress from a focal seizure to a bilateral tonic clonic seizure. This term describes the observed semiology of the seizure without specifying whether the onset is focal or generalized. Thus it can be used for coding bilateral tonic-clonic seizures when the onset is not known. This form of seizure was formerly commonly called grand mal seizure.</rdfs:comment>
        <rdfs:label>Bilateral tonic-clonic seizure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002069"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A bilateral tonic-clonic seizure is a seizure defined by a tonic (bilateral increased tone, lasting seconds to minutes) and then a clonic (bilateral sustained rhythmic jerking) phase.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:28276060</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002069"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Generalised convulsion</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#uk_spelling"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002069"/>

        <oboInOwl:hasAlternativeId>HP:0005889</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0008099</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1836195</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Brachydactyly of the foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypoplasia of the toe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypoplastic toes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short foot phalanges</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short toe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short toes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Stubby toes</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001831</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This finding must be distinguished from digits that are of increased girth but of normal length and that of a long mid- and hind foot with normal digit lengths. The affected digits should be specified as described in the introductory comments. Note that we designate brachydactyly as a synonym, but this use of the term is distinct from the use of the same word in Bell&apos;s classification of brachdactyly.</rdfs:comment>
        <rdfs:label>Short toe</rdfs:label>
    </owl:Class>

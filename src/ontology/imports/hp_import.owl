    <!-- http://purl.obolibrary.org/obo/HP_0200034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0200034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011355"/>
        <obo:IAO_0000115>A circumscribed, solid elevation of skin with no visible fluid, varying in size from a pinhead to less than 10mm in diameter at the widest point.</obo:IAO_0000115>

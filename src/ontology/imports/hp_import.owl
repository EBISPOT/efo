        <oboInOwl:id>HP:0011858</oboInOwl:id>
        <rdfs:comment>Severe deficiency of factor IX underlies hemophilia B.</rdfs:comment>
        <rdfs:label>Reduced factor IX activity</rdfs:label>
    </owl:Class>

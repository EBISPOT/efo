    <!-- http://purl.obolibrary.org/obo/HP_0009623 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001167"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001172"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0005922"/>
        <obo:IAO_0000115>Proximal mislocalization of the thumb.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-01-29T04:40:23Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0001170</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0005668</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1865572</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Attachment of thumb close to wrist</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Low implantation of the thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Low-set thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Proximally placed thumbs</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0009623</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>Thumb placement index greater than 0.55; or, the base of the thumb appears closer to the wrist than is typical. The technique for the thumb placement index is described in detail [Malina et al., 1973; Hall et al., 2007]. Briefly, the thumb placement index is the distance from the proximal crease of the index finger to the angle of the first interdigital space divided by the distance from the proximal crease of the index finger to the wrist flexion crease at the base of the thumb. This term should not be used with Preaxial polydactyly.</rdfs:comment>
        <rdfs:label>Proximal placement of thumb</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009623"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

    <!-- http://purl.obolibrary.org/obo/HP_0004384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0004384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001660"/>
        <obo:IAO_0000115>Truncus arteriosus (single great artery leaving the base of the heart, giving rise to the coronary, pulmonary, and systemic arteries) with a short pulmonary trunk arises from the truncus arteriosus, giving rise to both pulmonary arteries.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-03-18T08:57:00Z</terms:date>
        <oboInOwl:hasDbXref>Fyler:0510</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Fyler:510</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1834934</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Persistent truncus arteriosus type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Type 1 truncus arteriosus</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0004384</oboInOwl:id>
        <rdfs:comment>According to the Van Praagh classification (PMID:2856609). The Van Praagh classification additionally specifies the presence (subtype A) or absence (subtype B) of a ventricular septal defect.</rdfs:comment>
        <rdfs:label>Type I truncus arteriosus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004384"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Truncus arteriosus (single great artery leaving the base of the heart, giving rise to the coronary, pulmonary, and systemic arteries) with a short pulmonary trunk arises from the truncus arteriosus, giving rise to both pulmonary arteries.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:DDD_dbrown</oboInOwl:hasDbXref>
    </owl:Axiom>
    



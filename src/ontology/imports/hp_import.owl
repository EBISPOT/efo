    <!-- http://purl.obolibrary.org/obo/HP_0010877 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000486"/>
        <obo:IAO_0000115>A type of strabismus in which the fixating eye is always the same one, while the other eye is constantly deviated. Monocular strabismus is to be distinguished from alternating strabismus, in which either of the eyes &apos;squints&apos; at different times.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-08T10:47:57Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4023678</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Unilateral strabismus</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0010877</oboInOwl:id>
        <rdfs:label>Monocular strabismus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010877"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of strabismus in which the fixating eye is always the same one, while the other eye is constantly deviated. Monocular strabismus is to be distinguished from alternating strabismus, in which either of the eyes &apos;squints&apos; at different times.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    



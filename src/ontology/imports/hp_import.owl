    <!-- http://purl.obolibrary.org/obo/HP_0002224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010719"/>
        <obo:IAO_0000115>The term wooly hair refers to an abnormal variant of hair that is fine, with tightly coiled curls, and often hypopigmented. Optical microscopy may reveal the presence of tight spirals and a clear diameter reduction as compared with normal hair. Electron microscopy may show flat, oval hair shafts with reduced transversal diameter.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>Nappy hair texture</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>MEDDRA:10048017</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:52564001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0343073</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4072835</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4072836</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4073292</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Kinked hair</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wooly hair</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Afro-textured hair</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kinky hair texture</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0002224</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>See figures in PMID:20464096.</rdfs:comment>
        <rdfs:label>Woolly hair</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002224"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The term wooly hair refers to an abnormal variant of hair that is fine, with tightly coiled curls, and often hypopigmented. Optical microscopy may reveal the presence of tight spirals and a clear diameter reduction as compared with normal hair. Electron microscopy may show flat, oval hair shafts with reduced transversal diameter.</owl:annotatedTarget>

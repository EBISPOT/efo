    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001892"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011276"/>
        <obo:IAO_0000115>This term refers to an abnormally increased susceptibility to bruising (purpura, petechiae, or ecchymoses).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-02-28T07:14:00Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C0854107</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Bleeding below the skin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Subcutaneous haemorrhage</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001933</oboInOwl:id>
        <rdfs:comment>Purpura measure 0.3-1 cm (3-10 mm), whereas petechiae measure less than 3 mm, and ecchymoses greater than 1 cm.</rdfs:comment>
        <rdfs:label>Subcutaneous hemorrhage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001933"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>This term refers to an abnormally increased susceptibility to bruising (purpura, petechiae, or ecchymoses).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

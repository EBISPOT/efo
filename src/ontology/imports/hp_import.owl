    <!-- http://purl.obolibrary.org/obo/HP_0012286 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010662"/>
        <obo:IAO_0000115>Any structural anomaly of the hypothalamus.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-04-09T07:53:16Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0002443</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4021095</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormal shape of hypothalamus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of hypothalamus morphology</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of the hypothalamus</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0012286</oboInOwl:id>
        <rdfs:comment>The hypothalamus is a cone-shaped cerebral structure that projects downward, ending in the pituitary (infundibular) stalk, a tubular connection to the pituitary gland. It is linked vascularly with the anterior lobe of the pituitary gland and thereby controls the secretion of pituitary hormones.</rdfs:comment>
        <rdfs:label>Abnormal hypothalamus morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012286"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

        <oboInOwl:hasExactSynonym>Narrow, bell-shaped thorax</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001591</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>A bell-shaped thorax is a non-specific finding. In newborns, bell-spahed thorax can indicate a history of intrauterine neuromuscular abnormalities.</rdfs:comment>
        <rdfs:label>Bell-shaped thorax</rdfs:label>
    </owl:Class>

        <oboInOwl:hasDbXref>UMLS:C3714497</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Asthma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bronchial asthma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Reactive airway disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0002099</oboInOwl:id>
        <rdfs:label>Asthma</rdfs:label>
    </owl:Class>
    <owl:Axiom>

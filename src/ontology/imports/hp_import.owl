    <!-- http://purl.obolibrary.org/obo/HP_0007010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002311"/>
        <obo:IAO_0000115>An abnormality of the ability (skills) to perform a precise movement of small muscles with the intent to perform a specific act. Fine motor skills are required to mediate movements of the wrists, hands, fingers, feet, and toes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C1867864</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Fine motor disability</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fine motor impairment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fine motor skill dysfunction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Impaired fine motor skills</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0007010</oboInOwl:id>
        <rdfs:label>Poor fine motor coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0007021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0007328"/>
        <obo:IAO_0000115>Inability to perceive painful stimuli.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0003404</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:38433004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0344307</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Absence of pain sensation</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0007021</oboInOwl:id>
        <rdfs:comment>The word Anesthesia is occasionally used to refer to lack of pain sensation, although it is more usually used to denote a medical procedure design to relieve pain.</rdfs:comment>
        <rdfs:label>Pain insensitivity</rdfs:label>
    </owl:Class>
    <owl:Axiom>

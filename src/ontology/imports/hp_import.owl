    <!-- http://purl.obolibrary.org/obo/HP_0002521 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011198"/>
        <obo:IAO_0000115>Hypsarrhythmia is abnormal interictal high amplitude waves and a background of irregular spikes. There is continuous (during wakefulness), high-amplitude (&gt;200 Hz), generalized polymorphic slowing with no organized background and multifocal spikes demonstrated by electroencephalography (EEG).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:28055006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0684276</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Hypsarrhythmia by EEG</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002521</oboInOwl:id>
        <rdfs:label>Hypsarrhythmia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002521"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Hypsarrhythmia is abnormal interictal high amplitude waves and a background of irregular spikes. There is continuous (during wakefulness), high-amplitude (&gt;200 Hz), generalized polymorphic slowing with no organized background and multifocal spikes demonstrated by electroencephalography (EEG).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    



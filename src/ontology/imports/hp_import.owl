    <!-- http://purl.obolibrary.org/obo/HP_0002396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002063"/>
        <obo:IAO_0000115>A type of rigidity in which a muscle responds with cogwheellike jerks to the use of constant force in bending the limb (i.e., it gives way in little, repeated jerks when the muscle is passively stretched).</obo:IAO_0000115>

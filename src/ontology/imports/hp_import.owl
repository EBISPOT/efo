    <!-- http://purl.obolibrary.org/obo/HP_0009916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000615"/>
        <obo:IAO_0000115>Anisocoria, or unequal pupil size, may represent a benign physiologic variant or a manifestation of disease.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-02T05:46:50Z</terms:date>

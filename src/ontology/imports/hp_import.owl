    <!-- http://purl.obolibrary.org/obo/HP_0011138 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011138">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001574"/>
        <obo:IAO_0000115>An abnormality of the skin adnexa (skin appendages), which are specialized skin structures located within the dermis and focally within the subcutaneous fatty tissue, comprising three histologically distinct structures: (1) the pilosebaceous unit (hair follicle and sebaceous glands); (2) the eccrine sweat glands; and (3) the apocrine glands.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-06-19T06:25:34Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4023518</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormal skin appendage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of skin adnexa morphology</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0011138</oboInOwl:id>
        <rdfs:label>Abnormal skin adnexa morphology</rdfs:label>
    </owl:Class>

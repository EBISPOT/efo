        <owl:annotatedTarget>An abnormal concentration of corticotropin in the blood.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>

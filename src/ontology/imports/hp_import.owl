    <!-- http://purl.obolibrary.org/obo/HP_0009829 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0009815"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011314"/>
        <obo:IAO_0000115>Missing or malformed long bones of the extremities with the distal parts (such as hands and/or feet) connected to the variably shortened or even absent extremity, leading to a flipper-like appearance, as opposed to other forms of limb malformations were either the entire limb is missing (such as amelia), or the distal part of a limb is absent (peromelia).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-02-23T05:17:25Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0002994</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>MEDDRA:10034923</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:22841008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0031575</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0009829</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:label>Phocomelia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Missing or malformed long bones of the extremities with the distal parts (such as hands and/or feet) connected to the variably shortened or even absent extremity, leading to a flipper-like appearance, as opposed to other forms of limb malformations were either the entire limb is missing (such as amelia), or the distal part of a limb is absent (peromelia).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

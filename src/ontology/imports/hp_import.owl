    <!-- http://purl.obolibrary.org/obo/HP_0030016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000080"/>
        <obo:IAO_0000115>Recurrent or persistent genital pain associated with sexual intercourse.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:71315007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1384606</oboInOwl:hasDbXref>
        <rdfs:comment>In females, dyspareunia can develop secondary to medical problems such as vestibulitis, vaginal atrophy, or vaginal infection. It can be either physiologically or psychologically based, or a combination of the two. In males, dyspareunia may be related to conditions of the prepuce, glans penis, penile shaft, testicles, and urethra and prostate gland.</rdfs:comment>
        <rdfs:label>Dyspareunia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Recurrent or persistent genital pain associated with sexual intercourse.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:1225983</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:16391543</oboInOwl:hasDbXref>
    </owl:Axiom>
    



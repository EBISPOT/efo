    <!-- http://purl.obolibrary.org/obo/HP_0000729 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000708"/>
        <obo:IAO_0000115>Persistent deficits in social interaction and communication and interaction as well as a markedly restricted repertoire of activity and interest as well as repetitive patterns of behavior.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C0856975</oboInOwl:hasDbXref>

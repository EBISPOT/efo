        <oboInOwl:hasDbXref>SNOMEDCT_US:20607006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:61170000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0038362</oboInOwl:hasDbXref>

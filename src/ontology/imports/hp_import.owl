    <!-- http://purl.obolibrary.org/obo/HP_0001655 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001655">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011994"/>
        <obo:IAO_0000115>Failure of the foramen ovale to seal postnatally, leaving a potential conduit between the left and right cardiac atria.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Fyler:2020</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD-10:Q21.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:204317008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0016522</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>PFO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Persistent foramen ovale</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001655</oboInOwl:id>
        <rdfs:comment>The foramen ovale is located in the atrial septum and is essential for proper fetal circulation. With separation from the placenta and with the first few breaths, the left atrium fills with blood returning from the lungs and closes the foramen ovale. Subsequently, during the first years of life, the foramen ovale seals shut.</rdfs:comment>
        <rdfs:label>Patent foramen ovale</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001655"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Failure of the foramen ovale to seal postnatally, leaving a potential conduit between the left and right cardiac atria.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:DDD_dbrown</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001655"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>PFO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#abbreviation"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001657 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001657">

    <!-- http://purl.obolibrary.org/obo/HP_0100523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0100523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032251"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0410042"/>
        <obo:IAO_0000115>A localized, circumscribed collection of purulent material (pus) within the liver parenchyma, typically resulting from a bacterial, parasitic, or fungal infection. Unlike hepatitis, which is often diffuse, an abscess is a focal lesion.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7601-9822"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9382-150X"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2029-0733"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-3577-9021"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4315-9105"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0004-8124-8864"/>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-20T11:13:14Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0001400</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:27916005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0023885</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Hepatic abscess</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Liver abscess</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Purulent hepatic collection</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0100523</oboInOwl:id>
        <rdfs:comment>Unlike hepatitis, which is typically a diffuse inflammatory process, a liver abscess is a focal, localized collection of pus within the liver parenchyma. In addition to being a secondary complication of biliary or intra-abdominal infections, it is a characteristic manifestation of phagocytic defects (e.g., chronic granulomatous disease) and specific innate immune defects, such as NEMO deficiency.</rdfs:comment>
        <rdfs:label>Liver abscess</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100523"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Liver abscess</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    



    <!-- http://purl.obolibrary.org/obo/HP_0011995 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011995">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011994"/>
        <obo:IAO_0000115>A bulging of the interatrial septum towards one side. In adults, atrial septal aneurysm can be defined as a protrusion of the aneurysm of &gt;10 mm beyond the plane of the atrial septum as measured by transesophageal echocardiography.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-07-19T11:35:07Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:95440004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0521533</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>Atrial septal aneurysm</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>HP:0011995</oboInOwl:id>
        <rdfs:comment>Atrial septal aneurysm formation may be secondary to raised interatrial pressure gradients, producing a bulging septal shift toward the low-pressure side. However, it has been also found in patients with normal atrial pressures, suggesting a primary (congenital) malformation.</rdfs:comment>
        <rdfs:label>Atrial septal dilatation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011995"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A bulging of the interatrial septum towards one side. In adults, atrial septal aneurysm can be defined as a protrusion of the aneurysm of &gt;10 mm beyond the plane of the atrial septum as measured by transesophageal echocardiography.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:7758185</oboInOwl:hasDbXref>
    </owl:Axiom>
    



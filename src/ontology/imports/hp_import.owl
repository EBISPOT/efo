    <!-- http://purl.obolibrary.org/obo/HP_0010815 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011355"/>
        <obo:IAO_0000115>A congenital, hairless plaque consisting of overgrown epidermis, sebaceous glands, hair follicles, apocrine glands and connective tissue. They are a variant of epidermal naevi. Sebaceous naevi most often appear on the scalp, but they may also arise on the face, neck or forehead. At birth, a sevaceous nevus typically appears as a solitary, smooth, yellow-orange hairless patch. Sebaceous naevi become more pronounced around adolescence, often appearing bumpy, warty or scaly.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-07-10T12:07:03Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:239112008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:52298009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:707136009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C3854181</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Naevus sebaceous</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Organoid nevus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sebaceous mole</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sebaceous naevus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sebaceous nevus</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0010815</oboInOwl:id>
        <rdfs:label>Nevus sebaceous</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A congenital, hairless plaque consisting of overgrown epidermis, sebaceous glands, hair follicles, apocrine glands and connective tissue. They are a variant of epidermal naevi. Sebaceous naevi most often appear on the scalp, but they may also arise on the face, neck or forehead. At birth, a sevaceous nevus typically appears as a solitary, smooth, yellow-orange hairless patch. Sebaceous naevi become more pronounced around adolescence, often appearing bumpy, warty or scaly.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010815"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Sebaceous mole</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0001-5208-3432"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0010818 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001250"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002197"/>
        <obo:IAO_0000115>A generalized tonic seizure is a type of generalized motor seizure characterized by bilateral limb stiffening or elevation, often with neck stiffening without a subsequent clonic phase. The tonic activity can be a sustained abnormal posture, either in extension or flexion, sometimes accompanied by tremor of the extremities.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-07-10T03:03:51Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0002184</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1836508</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Generalised hypertonic seizure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalised tonic seizure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalised tonic seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized hypertonic seizure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized tonic seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Hypertonic seizures</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0010818</oboInOwl:id>
        <rdfs:comment>Characterized by a sudden increase in muscle tone whereby the body, arms, or legs make sudden stiffening movements and consciousness is usually preserved. Tonic seizures can occur during sleep. Tonic seizures usually affect both sides of the body, and cause a fall if the affected person was standing when the seizure started.</rdfs:comment>
        <rdfs:label>Generalized tonic seizure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010818"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A generalized tonic seizure is a type of generalized motor seizure characterized by bilateral limb stiffening or elevation, often with neck stiffening without a subsequent clonic phase. The tonic activity can be a sustained abnormal posture, either in extension or flexion, sometimes accompanied by tremor of the extremities.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:jalbers</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:11580774</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:28276060</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:28276064</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010818"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Generalised tonic seizure</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#uk_spelling"/>

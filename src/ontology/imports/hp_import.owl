    <!-- http://purl.obolibrary.org/obo/HP_0002797 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002797">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003330"/>
        <obo:IAO_0000115>Osteolysis refers to the destruction of bone through bone resorption with removal or loss of calcium.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0010737</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:203522001</oboInOwl:hasDbXref>

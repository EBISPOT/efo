    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011873"/>
        <obo:IAO_0000115>Increased numbers of platelets in the peripheral blood.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:415115007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:6631009</oboInOwl:hasDbXref>

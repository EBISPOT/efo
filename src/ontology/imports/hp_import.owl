    <!-- http://purl.obolibrary.org/obo/HP_0012130 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0005561"/>
        <obo:IAO_0000115>An anomaly of erythroid lineage cells, that is, of the erythropoietic cells in the lineage leading to and including erythrocytes.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-09-16T07:14:03Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4020862</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of cells of the erythroid lineage</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0012130</oboInOwl:id>
        <rdfs:comment>Proerythroblasts are the earliest recognizable erythroid precursors. They are followined during the process of hematopoiesis by basophilic erythroblasts, polychromatic (polychromatophilic) erythroblasts, orthochromatic erythroblasts (normoblasts), reticulocytes, and finally mature erythrocytes (red blood cells). This term encompasses structural anomalies of erythroblast precursors in the bone marrow.</rdfs:comment>
        <rdfs:label>Abnormal erythroid lineage cell morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012130"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An anomaly of erythroid lineage cells, that is, of the erythropoietic cells in the lineage leading to and including erythrocytes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-2945-4463"/>
    </owl:Axiom>
    



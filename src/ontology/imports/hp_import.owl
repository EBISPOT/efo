        <oboInOwl:hasDbXref>UMLS:C0010278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0277827</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4072853</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Early closure of the fontanelles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Obliterated fontanelles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Premature fontanel closure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Early closure of the bregma sutures</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Premature closure of the bregma sutures</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>HP:0005458</oboInOwl:id>
        <rdfs:label>Premature closure of fontanelles</rdfs:label>
    </owl:Class>

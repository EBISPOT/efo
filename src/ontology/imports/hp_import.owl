    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0030961 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0008063"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011526"/>
        <obo:IAO_0000115>Microspherophakia is a rare congenital anomaly characterized by the abnormal spherical shape of the crystalline lens. It is characterized by an increased anteroposterior thickness of the lens associated with reduced equatorial diameter. The primary pathology lies in the development of zonules. The condition is often bilateral and is characterized by small, thick, and spherical lenses.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-04-18T12:55:01Z</terms:date>
        <rdfs:label>Microspherophakia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030961"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Microspherophakia is a rare congenital anomaly characterized by the abnormal spherical shape of the crystalline lens. It is characterized by an increased anteroposterior thickness of the lens associated with reduced equatorial diameter. The primary pathology lies in the development of zonules. The condition is often bilateral and is characterized by small, thick, and spherical lenses.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:35015420</oboInOwl:hasDbXref>
    </owl:Axiom>
    



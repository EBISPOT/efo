    <!-- http://purl.obolibrary.org/obo/HP_0010609 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011355"/>
        <obo:IAO_0000115>Cutaneous skin tags also known as acrochorda or fibroepithelial polyps are small benign tumors that may either form secondarily over time primarily in areas where the skin forms creases, such as the neck, armpit or groin or may also be present at birth, in which case they usually occur in the periauricular region.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-10-27T11:41:03Z</terms:date>

    <!-- http://purl.obolibrary.org/obo/HP_0001848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0008119"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0008364"/>
        <obo:IAO_0000115>This is a postural deformity in which the foot is positioned up against the tibia. The heel (calcaneus) is positioned downward (that is, the ankle is flexed upward), and the heel is turned outward (valgus).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001774</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0008120</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Foot and ankle bend up toward shin of leg</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>UMLS:C1860450</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Calcaneovalgus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Calcaneovalgus Foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Valgus position of the calcaneus</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001848</oboInOwl:id>
        <rdfs:comment>Calcaneovalgus deformity may be related to abnormal positioning of the foot in utero and can resolve spontaneously after birth.</rdfs:comment>
        <rdfs:label>Calcaneovalgus deformity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001848"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>This is a postural deformity in which the foot is positioned up against the tibia. The heel (calcaneus) is positioned downward (that is, the ankle is flexed upward), and the heel is turned outward (valgus).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001848"/>

    <!-- http://purl.obolibrary.org/obo/HP_0012529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012484"/>
        <obo:IAO_0000115>A deviation from the normal contents of the platelet alpha granules, which normally contain adenosine triphosphate (ATP), adenosine diphosphate (ADP), serotonin, calcium, and pyrophosphate, which are secreted when platelets are activated.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-12-15T09:12:44Z</terms:date>

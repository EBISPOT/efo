    <!-- http://purl.obolibrary.org/obo/HP_0009917 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009917">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000615"/>
        <obo:IAO_0000115>The presence of remnants of a fetal membrane that persist as strands of tissue crossing the pupil.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-02T05:51:28Z</terms:date>

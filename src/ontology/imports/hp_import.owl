    <!-- http://purl.obolibrary.org/obo/HP_0000482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001120"/>
        <obo:IAO_0000115>A congenital abnormality of the cornea in which the cornea and the anterior segment of the eye are smaller than normal. The horizontal diameter of the cornea does not reach 10 mm even in adulthood.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0100688</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:26098002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0266544</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1167713</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Cornea of eye less than 10mm in diameter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased corneal diameter</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000482</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>Note that the cornea&apos;s diameter is normally about 9.5-10.0 mm at birth and reaches 10.0-12-5 mm in adulthood.</rdfs:comment>
        <rdfs:label>Microcornea</rdfs:label>
    </owl:Class>

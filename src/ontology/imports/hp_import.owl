    <!-- http://purl.obolibrary.org/obo/HP_0011198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011182"/>
        <obo:IAO_0000115>EEG discharges recorded on the entire scalp typically seen in persons with epilepsy.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-6996-5279"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-11-19T11:15:46Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0010842</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4023476</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>EEG with generalised epileptiform discharges</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0011198</oboInOwl:id>
        <rdfs:comment>Spikes (&lt;70 ms) and sharp waves (70-200 ms) are sharp transient waves that have a strong association with epilepsy. No difference is noted in terms of clinical significance of spikes and sharp waves. Significant spikes usually are followed by a slow wave.</rdfs:comment>
        <rdfs:label>EEG with generalized epileptiform discharges</rdfs:label>
    </owl:Class>

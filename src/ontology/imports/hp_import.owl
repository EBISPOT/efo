    <!-- http://purl.obolibrary.org/obo/HP_0020179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0020179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of haptoglobin in the blood circulation.</obo:IAO_0000115>

    <!-- http://purl.obolibrary.org/obo/HP_0010543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000496"/>
        <obo:IAO_0000115>Bursts of large-amplitude multidirectional saccades without intersaccadic interval</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

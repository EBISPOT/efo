    <!-- http://purl.obolibrary.org/obo/HP_0000657 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000657">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000496"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002186"/>
        <obo:IAO_0000115>Ocular motor apraxia is a deficiency in voluntary, horizontal, lateral, fast eye movements (saccades) with retention of slow pursuit movements. The inability to follow objects visually is often compensated by head movements. There may be decreased smooth pursuit, and cancelation of the vestibulo-ocular reflex.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0000628</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007764</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:193662007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C3489733</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4020886</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Ocular motor apraxia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Defective or absent horizontal voluntary eye movements</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0000657</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>Oculomotor apraxia leads defective or absent horizontal voluntary eye movements with head thrusting to look at objects to the side as well as jerky, abnormal eye movements.</rdfs:comment>
        <rdfs:label>Oculomotor apraxia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000657"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Ocular motor apraxia is a deficiency in voluntary, horizontal, lateral, fast eye movements (saccades) with retention of slow pursuit movements. The inability to follow objects visually is often compensated by head movements. There may be decreased smooth pursuit, and cancelation of the vestibulo-ocular reflex.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:20615230</oboInOwl:hasDbXref>
    </owl:Axiom>
    



    <!-- http://purl.obolibrary.org/obo/HP_0001156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011927"/>
        <obo:IAO_0000115>Digits that appear disproportionately short compared to the hand/foot. The word brachydactyly is used here to describe a series distinct patterns of shortened digits (brachydactyly types A-E). This is the sense used here.</obo:IAO_0000115>

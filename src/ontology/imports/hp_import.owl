        <oboInOwl:hasExactSynonym>Delayed puberty</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pubertal delay</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000823</oboInOwl:id>

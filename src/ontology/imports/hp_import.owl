    <!-- http://purl.obolibrary.org/obo/HP_0040087 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0040087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0020350"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of folate in the blood circulation.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-5316-1399"/>
        <oboInOwl:hasAlternativeId>HP:0012335</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4021037</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormal blood folate concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal serum folate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of folate in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Abnormality of folate metabolism</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Folate is an essential water-soluble vitamin (vitamin B9) that is found in green leafy vegetables, cereals, legumes, and fruit. As a major methyl group donor, it plays an important role in one-carbon metabolism and is involved in DNA, RNA, and protein synthesis, in addition to its significant role in energy production and normal cell division. Low blood folate concentration is associated with an increased risk for neural tube defects during pregnancy.</rdfs:comment>
        <rdfs:label>Abnormal circulating folate concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040087"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Abnormal serum folate</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-5316-1399"/>
    </owl:Axiom>
    



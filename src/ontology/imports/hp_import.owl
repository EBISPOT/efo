    <!-- http://purl.obolibrary.org/obo/HP_0040194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0040194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000240"/>
        <obo:IAO_0000115>An abnormally increased head circumference in a growing child. Head circumference is measured with a nonelastic tape and comprises the distance from above the eyebrows and ears and around the back of the head. The measured HC is then plotted on an appropriate growth chart.</obo:IAO_0000115>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-09-24T14:57:07Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4083076</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Increased head circumference</oboInOwl:hasExactSynonym>
        <rdfs:label>Increased head circumference</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040194"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Increased head circumference</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0040195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0040195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000240"/>
        <obo:IAO_0000115>An abnormally reduced head circumference in a growing child. Head circumference is measured with a nonelastic tape and comprises the distance from above the eyebrows and ears and around the back of the head. The measured HC is then plotted on an appropriate growth chart. Microcephaly is defined as a head circumference (HC) that is great than two standard deviations below the mean of age- and gender-matched population based samples. Severe microcephaly is defined with an HC that is three standard deviations below the mean.</obo:IAO_0000115>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-09-24T14:57:07Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:271611007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0424688</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Decreased head circumference</oboInOwl:hasExactSynonym>
        <rdfs:comment>Although HC measures skull size, it typically also reflects overall brain volume and has been described as a widely used proxy of neural growth and brain size. Brain size outside of normal values is an important risk factor for cognitive and motor delay. Microcephaly at birth has been termed primary microcephaly and that acquired after birth is secondary microcephaly.</rdfs:comment>
        <rdfs:label>Decreased head circumference</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040195"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An abnormally reduced head circumference in a growing child. Head circumference is measured with a nonelastic tape and comprises the distance from above the eyebrows and ears and around the back of the head. The measured HC is then plotted on an appropriate growth chart. Microcephaly is defined as a head circumference (HC) that is great than two standard deviations below the mean of age- and gender-matched population based samples. Severe microcephaly is defined with an HC that is three standard deviations below the mean.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:26505062</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0040195"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Decreased head circumference</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0040196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0040196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0040195"/>
        <obo:IAO_0000115>Decreased occipito-frontal (head) circumference (OFC). For the microcephaly OFC must be between -3 SD and -2 SD compared to appropriate, age matched, normal standards (i.e. -3 SD &lt;= OFC &lt; -2 SD).</obo:IAO_0000115>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-09-24T14:57:07Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C1836806</oboInOwl:hasDbXref>
        <rdfs:label>Mild microcephaly</rdfs:label>
    </owl:Class>
    



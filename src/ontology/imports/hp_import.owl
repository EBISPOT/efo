    <!-- http://purl.obolibrary.org/obo/HP_0000726 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001268"/>
        <obo:IAO_0000115>A loss of global cognitive ability of sufficient amount to interfere with normal social or occupational function. Dementia represents a loss of previously present cognitive abilities, generally in adults, and can affect memory, thinking, language, judgment, and behavior.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002274</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007122</oboInOwl:hasAlternativeId>

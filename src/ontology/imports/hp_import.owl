    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003693"/>
        <obo:IAO_0000115>Atrophy of the interosseus muscles (including the palmar interossei that lie on the anterior aspect of the metacarpals, the dorsal interosseus muscles of the hand, which lie between the intercarpals, the plantar interosseus muscles, which lie underneath the metatarsal bones, and the dorsal interossei, which are located between the metatarsal bones.</obo:IAO_0000115>

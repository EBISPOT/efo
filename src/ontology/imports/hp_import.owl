    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033460"/>
        <obo:IAO_0000115>The concentration of apolipoprotein A-IV in the blood circulation is above the upper limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-10T12:56:05Z</terms:date>
        <oboInOwl:hasExactSynonym>Elevated apolipoprotein A-IV concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated apolipoprotein A-IV level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated apolipoprotein A-IV level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated circulating apolipoprotein A-IV concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased apolipoprotein A-IV concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased apolipoprotein A-IV level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased apolipoprotein A-IV level in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Apolipoprotein A-IV, a major component of HDL and chylomicrons that has a role in VLDL secretion and catabolism and is required for efficient activation of lipoprotein lipase by ApoC-II.</rdfs:comment>
        <rdfs:label>Elevated circulating apolipoprotein A-IV concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002360"/>
        <obo:IAO_0000115>A clinically observable or self-reported abnormal behavior, experience, or physiological event that occurs in association with sleep, specific sleep stages, or sleep-wake transitions.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6262-8264"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9446-5121"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1592-0825"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4672-4923"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5554-6946"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7367-663X"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-14T11:50:48Z</terms:date>
        <oboInOwl:hasExactSynonym>Event that disrupts sleep</oboInOwl:hasExactSynonym>
        <rdfs:comment>Parasomnias are distinct from the primary sleep disorders insomnia, hypersomnia, and circadian rhythm disturbances. They can involve motor, sensory, autonomic, or cognitive activation.</rdfs:comment>
        <rdfs:label>Parasomnia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025234"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A clinically observable or self-reported abnormal behavior, experience, or physiological event that occurs in association with sleep, specific sleep stages, or sleep-wake transitions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22965264</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:35956054</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:40132982</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025234"/>
        <obo:IAO_0000115>Ambulation during sleep with lack awareness and limited or no recall of the event.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6262-8264"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9446-5121"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1592-0825"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4672-4923"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5554-6946"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7367-663X"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-14T12:01:00Z</terms:date>
        <oboInOwl:hasExactSynonym>Sleep walking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Somnambulism</oboInOwl:hasExactSynonym>
        <rdfs:comment>During an episode of sleepwalking, the somnambulating child typically appears clumsy and might perform unusual actions, such as urinating in a closet. Injuries can occur during sleepwalking, including falling downstairs or when leaving the house.</rdfs:comment>
        <rdfs:label>Sleep walking</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025236"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Ambulation during sleep with lack awareness and limited or no recall of the event.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:30458142</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:32644427</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025236"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Sleep walking</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011355"/>
        <obo:IAO_0000115>Nontender, round and firm, but slightly compressible, intradermal or subcutaneous cyst measuring 0.5-5 cm in diameter. Trichilemmal cysts are acquired rather than congenital, and tend to appear on the scalp rather than the face, and to be intradermal rather than subcutaneous.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-17T13:45:04Z</terms:date>
        <oboInOwl:hasExactSynonym>Pilar cyst</oboInOwl:hasExactSynonym>
        <rdfs:comment>Epidermal cysts and trichilemmal cysts are clinically indistinguishable. The wall of the epidermal cyst conserves the epidermal layers, but the wall of the trichilemmal cysts, which arise from the external root sheath, shows palisading of unlayered epithelial cells. Homogeneous horny material that is further degraded to fat and cholesterol forms within both types of cysts.</rdfs:comment>
        <rdfs:label>Trichilemmal cyst</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001387"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0005986"/>
        <obo:IAO_0000115>A sensation of tightness in the neck when attempting to move it, especially after a period of inactivity. Neck stiffness often involves soreness and difficulty moving the neck, especially when trying to turn the head to the side.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-18T01:06:15Z</terms:date>
        <oboInOwl:hasExactSynonym>Neck stiffness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Stiff neck</oboInOwl:hasExactSynonym>
        <rdfs:label>Stiff neck</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025258"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Neck stiffness</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025258"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Stiff neck</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002360"/>
        <obo:IAO_0000115>Deep, noisy breathing during sleep, accompanied by hoarse or harsh sounds, is caused by the vibration of respiratory structures, especially the soft palate. This vibration results in sound due to obstructed air movement during breathing while sleeping.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6262-8264"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9446-5121"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1592-0825"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4672-4923"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5554-6946"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7367-663X"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-12-18T13:24:58Z</terms:date>
        <oboInOwl:hasExactSynonym>Snore</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Snores</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Snoring symptoms</oboInOwl:hasExactSynonym>
        <rdfs:label>Snoring</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0025267"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Deep, noisy breathing during sleep, accompanied by hoarse or harsh sounds, is caused by the vibration of respiratory structures, especially the soft palate. This vibration results in sound due to obstructed air movement during breathing while sleeping.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:35216759</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002167"/>
        <obo:IAO_0000115>Disruptions in the production of speech sounds, with involuntary repetitions of words or parts of words, prolongations of speech sounds, or complete blockage of speech production for several seconds.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

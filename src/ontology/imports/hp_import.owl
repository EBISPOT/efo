    <!-- http://purl.obolibrary.org/obo/HP_0003376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0003376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001288"/>
        <obo:IAO_0000115>An abnormal gait pattern that arises from weakness of the pretibial and peroneal muscles due to a lower motor neuron lesion. Affected patients have footdrop and are unable to dorsiflex and evert the foot. The leg is lifted high on walking so that the toes clear the ground, and there may be a slapping noise when the foot strikes the ground again.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:27253007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0427149</oboInOwl:hasDbXref>

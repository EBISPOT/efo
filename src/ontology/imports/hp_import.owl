    <!-- http://purl.obolibrary.org/obo/HP_0000750 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002167"/>

    <!-- http://purl.obolibrary.org/obo/HP_0000759 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012639"/>
        <obo:IAO_0000115>A structural abnormality of the peripheral nervous system, which is composed of the nerves that lead to or branch off from the central nervous system. This includes the cranial nerves (olfactory and optic nerves are technically part of the central nervous system).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0003483</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:302226006</oboInOwl:hasDbXref>

        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025454"/>
        <obo:IAO_0000115>The concentration of folate or one of its metabolites in the cerebrospinal fluid (CSF) is outside the limits of normal.</obo:IAO_0000115>

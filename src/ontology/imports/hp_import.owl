        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This finding is distinguished from an Exaggerated Cupid&apos;s bow by the alteration of the shape of the oral aperture.</rdfs:comment>

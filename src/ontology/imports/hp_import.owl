    <!-- http://purl.obolibrary.org/obo/HP_0002092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033578"/>
        <obo:IAO_0000115>Pulmonary hypertension is defined mean pulmonary artery pressure of 25mmHg or more and pulmonary capillary wedge pressure of 15mmHg or less when measured by right heart catheterisation at rest and in a supine position.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0006546</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:11399002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:697898008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:70995007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0020542</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C2973725</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C3203102</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Increased blood pressure in blood vessels of lungs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pulmonary artery hypertension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Primary pulmonary hypertension</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0002092</oboInOwl:id>
        <rdfs:comment>Pulmonary hypertension can be secondary to known cardiac, pulmonary, or hepatic disease. If no cause is identifiable, the term primary pulmonary hypertension is used.</rdfs:comment>
        <rdfs:label>Pulmonary arterial hypertension</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002092"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pulmonary hypertension is defined mean pulmonary artery pressure of 25mmHg or more and pulmonary capillary wedge pressure of 15mmHg or less when measured by right heart catheterisation at rest and in a supine position.</owl:annotatedTarget>

        <oboInOwl:hasBroadSynonym>Rhomboid shaped head</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>SNOMEDCT_US:21850008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:254024005</oboInOwl:hasDbXref>

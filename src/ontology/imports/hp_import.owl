    <!-- http://purl.obolibrary.org/obo/HP_0001399 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001410"/>

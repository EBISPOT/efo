    <!-- http://purl.obolibrary.org/obo/HP_0002683 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002683">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000929"/>
        <obo:IAO_0000115>Abnormality of the morphology (structure) of the calvaria (skullcap), that is, of that part of the skull that is made up of the superior portions of the frontal bone, occipital bone, and parietal bones and covers the cranial cavity that contains the brain.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002648</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Abnormality of cranium</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>UMLS:C4025691</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4280561</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of calvarium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of cranial vault</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of the calvaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of the shape of calvarium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of the skull cap</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of the skullcap</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002683</oboInOwl:id>
        <rdfs:comment>The calvaria, or skull cap, is the upper part of the skull (cranium) and comprises the frontal, occipital and right and left parietal bones. Occasionally, calvaria is misspelled as &apos;calvarium&apos; in the medical literature.</rdfs:comment>
        <rdfs:label>Abnormal calvaria morphology</rdfs:label>
    </owl:Class>

        <oboInOwl:hasDbXref>SNOMEDCT_US:31069005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:80801001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0037293</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Acrochorda</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0010609</oboInOwl:id>
        <rdfs:label>Skin tags</rdfs:label>
    </owl:Class>
    <owl:Axiom>

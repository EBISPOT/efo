    <!-- http://purl.obolibrary.org/obo/HP_0002064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001257"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001288"/>
        <obo:IAO_0000115>Spasticity is manifested by increased stretch reflex which is intensified with movement velocity. This results in excessive and inappropriate muscle activation which can contribute to muscle hypertonia. Spastic gait is characterized by manifestations such as muscle hypertonia, stiff knee, and circumduction of the leg.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:9447003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0231687</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Spastic walk</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002064</oboInOwl:id>
        <rdfs:label>Spastic gait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002064"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Spasticity is manifested by increased stretch reflex which is intensified with movement velocity. This results in excessive and inappropriate muscle activation which can contribute to muscle hypertonia. Spastic gait is characterized by manifestations such as muscle hypertonia, stiff knee, and circumduction of the leg.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25649546</oboInOwl:hasDbXref>
    </owl:Axiom>

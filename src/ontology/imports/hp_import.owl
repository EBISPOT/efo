    <!-- http://purl.obolibrary.org/obo/HP_0012255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0005938"/>
        <obo:IAO_0000115>An anomaly of the dynein arms of motile cilia. This feature is usually appreciated by electron microscopy.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-04-07T09:20:03Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4022990</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0012255</oboInOwl:id>
        <rdfs:comment>The peripheral microtubules in the canonical 9 + 2 microtubular pattern of motile cilia are studded with dynein arms that contain adenosine triphosphatases and act as molecular motors to effect the sliding of the peripheral microtubular pairs relative to one another.</rdfs:comment>
        <rdfs:label>Dynein arm defect of respiratory motile cilia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An anomaly of the dynein arms of motile cilia. This feature is usually appreciated by electron microscopy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:19606528</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0012259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012255"/>
        <obo:IAO_0000115>Complete absence of the dynein arms of respiratory motile cilia, that is, absence of the inner and the outer dynein arms, which normally are situated inside and outside of the peripheral microtubules of motile cilia. This feature is usually appreciated by electron microscopy.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-04-07T09:40:14Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4022986</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0012259</oboInOwl:id>
        <rdfs:label>Absent inner and outer dynein arms</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012259"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Complete absence of the dynein arms of respiratory motile cilia, that is, absence of the inner and the outer dynein arms, which normally are situated inside and outside of the peripheral microtubules of motile cilia. This feature is usually appreciated by electron microscopy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:19606528</oboInOwl:hasDbXref>
    </owl:Axiom>
    



    <!-- http://purl.obolibrary.org/obo/HP_0000090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100957"/>
        <obo:IAO_0000115>Presence of cysts at the corticomedullary junction of the kidney in combination with tubulointerstitial fibrosis.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0004748</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:204958008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0687120</oboInOwl:hasDbXref>

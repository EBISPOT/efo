    <!-- http://purl.obolibrary.org/obo/HP_6000968 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6000968">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>The concentration of cationic trypsinogen in the blood circulation is below the lower limit of normal.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/8207"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-07-07T12:56:35Z</terms:date>
        <oboInOwl:hasExactSynonym>Decreased circulating cationic trypsinogen concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased serine protease 1 concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased serine protease 1 level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased serine protease 1 level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced serine protease 1 concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced serine protease 1 level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced serine protease 1 level in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Cationic trypsinogen is one of the several isoforms of trypsinogen. Serum cationic trypsinogen when low, is known to be associated with reduced pancreatic exocrine function in a number of disorders, including Shwachman&apos;s syndrome and type 1 diabetes mellitus.</rdfs:comment>
        <rdfs:label>Decreased circulating cationic trypsinogen concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_6001025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001025">

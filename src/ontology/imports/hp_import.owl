    <!-- http://purl.obolibrary.org/obo/HP_0009830 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032120"/>
        <obo:IAO_0000115>Peripheral neuropathy is a general term for any disorder of the peripheral nervous system. The main clinical features used to classify peripheral neuropathy are distribution, type (mainly demyelinating versus mainly axonal), duration, and course.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-03-01T07:49:18Z</terms:date>

    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031411 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025461"/>
        <obo:IAO_0000115>Any structural anomaly of a chromosome, which is a thread like molecule consisting of DNA and proteins (chromatin) that contains DNA sequences for genes and other genetic elements in linear order.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-09-04T15:22:36Z</terms:date>
        <oboInOwl:hasDbXref>Fyler:4013</oboInOwl:hasDbXref>
        <rdfs:label>Abnormal chromosome morphology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031411"/>
        <obo:IAO_0000115>An abnormal reduction in telomere length. Telomeres are non-coding, repetitive sequences of DNA at the ends of the chromosomes of eukaryotic cells which become shorter as cells divide, and when telomere attrition reaches its limit, cell proliferation arrest, senescence, and apoptosis can occur.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-09-04T17:14:08Z</terms:date>
        <rdfs:comment>Telomeres are made of repeating TTAGGG/AATCCC units. The overall length of the telomere is over 10 kb at birth and progressively declines with age.</rdfs:comment>
        <rdfs:label>Short telomere length</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031419 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031438"/>
        <obo:IAO_0000115>The concentration of sex hormone-binding globulin in the blood circulation is below the lower limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-09-12T02:20:36Z</terms:date>
        <oboInOwl:hasExactSynonym>Decreased circulating sex hormone-binding globulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased sex hormone-binding globulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased sex hormone-binding globulin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased sex hormone-binding globulin level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced androgen-binding protein level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced sex hormone-binding globulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced sex hormone-binding globulin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced sex hormone-binding globulin level in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Sex hormone binding globulin (NCBI Gene 6462) is also known as sex hormone binding protein and androgen binding protein.</rdfs:comment>
        <rdfs:label>Decreased circulating sex hormone-binding globulin concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025465"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of sex hormone-binding globulin in the blood circulation.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-09-17T12:29:14Z</terms:date>
        <oboInOwl:hasExactSynonym>Abnormal circulating sex hormone-binding globulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal sex hormone-binding globulin level</oboInOwl:hasExactSynonym>
        <rdfs:comment>Sex hormone-binding globulin (SHBG, Gene ID: 6462) binds the three sex hormones estrogen, dihydrotestosterone (DHT), and testosterone. Reduction in the level of SHBG can result in an increased level of free (unbound, and therefore active) sex hormones.</rdfs:comment>
        <rdfs:label>Abnormal circulating sex hormone-binding globulin concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000001"/>
        <obo:IAO_0000115>A pregnancy in which the fertilized egg inserts in a location outside of the main cavity of the uterus (usually in the Fallopian tube).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-09-17T15:55:36Z</terms:date>
        <rdfs:label>Ectopic pregnancy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031458 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_3000033"/>
        <obo:IAO_0000115>An inflammation of the adenoid tissue.</obo:IAO_0000115>

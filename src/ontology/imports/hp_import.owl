        <oboInOwl:hasExactSynonym>Blurred vision</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000622</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This is a very nonspecific term and it is preferable to describe the correlates of blurred vision with the corresponding terms if possible.</rdfs:comment>
        <rdfs:label>Blurred vision</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000622"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

        <oboInOwl:hasNarrowSynonym>Brain calcification</oboInOwl:hasNarrowSynonym>
        <rdfs:comment>pineal gland, choroid plexus, habenula, falx cerebri and tentorium cerebelli</rdfs:comment>
        <rdfs:label>Intracranial calcification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0430048"/>

    <!-- http://purl.obolibrary.org/obo/HP_0031678 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011004"/>
        <obo:IAO_0000115>A lesion associated with atherosclerosis, a multifactorial and multipart progressive disease manifested by the focal development within the arterial wall of lesions, that ranges from the development of a fatty streak, plaque progression, and plaque disruption. Atherosclerotic lesions demonstrate consistent morphological characteristics, which indicate that each type may stabilize temporarily or permanently and that progression to the next type may require an additional stimulus.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-12-17T17:19:49Z</terms:date>
        <rdfs:label>Atherosclerotic lesion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A lesion associated with atherosclerosis, a multifactorial and multipart progressive disease manifested by the focal development within the arterial wall of lesions, that ranges from the development of a fatty streak, plaque progression, and plaque disruption. Atherosclerotic lesions demonstrate consistent morphological characteristics, which indicate that each type may stabilize temporarily or permanently and that progression to the next type may require an additional stimulus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:8172861</oboInOwl:hasDbXref>
    </owl:Axiom>
    



    <!-- http://purl.obolibrary.org/obo/HP_0009908 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009908">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000363"/>
        <obo:IAO_0000115>Sharply demarcated, typically linear and approximately horizontal, indentations in the outer surface of the ear lobe.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-01T03:00:22Z</terms:date>

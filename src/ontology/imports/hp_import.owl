    <!-- http://purl.obolibrary.org/obo/HP_0010832 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003474"/>
        <obo:IAO_0000115>Pain is an unpleasant sensation that can range from mild, localized discomfort to agony, whereby the physical part of pain results from nerve stimulation and is often accompanied by an emotional component. This term groups abnormalities in pain sensation presumed to result from abnormalities related to the specific nerve fibers that carry the pain impulses to the brain.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-07-10T07:15:58Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4023691</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0010832</oboInOwl:id>
        <rdfs:label>Abnormality of pain sensation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010280"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011830"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031815"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032158"/>
        <obo:IAO_0000115>Recurrent episodes of ulceration of the oral mucosa, typically presenting as painful, sharply circumscribed fibrin-covered mucosal defects with a hyperemic border.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7601-9822"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9382-150X"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2029-0733"/>

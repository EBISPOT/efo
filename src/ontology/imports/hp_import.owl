        <owl:annotatedTarget>Focal impaired awareness seizures</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#plural_form"/>
    </owl:Axiom>
    <owl:Axiom>

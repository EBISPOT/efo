    <!-- http://purl.obolibrary.org/obo/HP_0007027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011283"/>
        <obo:IAO_0000115>A morphological abnormality of the metencephalon.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4024951</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0007027</oboInOwl:id>
        <rdfs:comment>The metencephalon comprises the pons and the cerebellum; contains a portion of the fourth ventricle; and the trigeminal nerve, abducens nerve, facial nerve, and a portion of the vestibulocochlear nerve. The metencephalon is part of the hindbrain.</rdfs:comment>
        <rdfs:label>Poorly formed metencephalon</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007027"/>

        <oboInOwl:hasExactSynonym>Squint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Squint eyes</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000486</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:label>Strabismus</rdfs:label>
    </owl:Class>

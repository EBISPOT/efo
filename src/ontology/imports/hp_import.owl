    <!-- http://purl.obolibrary.org/obo/HP_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000032"/>
        <obo:IAO_0000115>Superior margin of the scrotum superior to the base of the penis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C1858539</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Overriding scrotum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Scrotum surrounds penis</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000049</oboInOwl:id>
        <rdfs:comment>A congenital overriding scrotum may disappear with growth and development, especially during puberty. If the entire scrotum is located superior to the penis, the term Penoscrotal transposition is used instead.</rdfs:comment>
        <rdfs:label>Shawl scrotum</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000049"/>

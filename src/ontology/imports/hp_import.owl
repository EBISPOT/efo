    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001172"/>
        <obo:IAO_0000115>A thumb with three phalanges in a single, proximo-distal axis. Thus, this term applies if the thumb has an accessory phalanx, leading to a digit like appearance of the thumb.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0005846</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0006194</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0009610</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0009619</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:205308004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0241397</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Accessory phalanx of the thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Digitalized thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Finger-like thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Triphalangeal thumbs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Triphalangy of thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001199</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>The requirement for a single PD axis relates to the issue that partial forms of Preaxial polydactyly may comprise a partially duplicated thumb with two distal phalanges and a single proximal phalanx. That finding is instead coded as a mild form of thumb polydactyly. Note that this finding can be readily assessed by examination and/or physical manipulation of the thumb.</rdfs:comment>
        <rdfs:label>Triphalangeal thumb</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001199"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A thumb with three phalanges in a single, proximo-distal axis. Thus, this term applies if the thumb has an accessory phalanx, leading to a digit like appearance of the thumb.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:19125433</oboInOwl:hasDbXref>
    </owl:Axiom>

    <!-- http://purl.obolibrary.org/obo/HP_0100825 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0100825">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000159"/>
        <obo:IAO_0000115>Inflammation of the lip.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-06-09T05:18:41Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:7847004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0007971</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4280288</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Inflammation of the lips</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Red and sore lips</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0100825</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>It is associated with many conditions, including megaloblastic anemia from vitamin B12 deficiency, iron deficiency anemia (which in severe cases can lead to Plummer-Vinson syndrome) and oral candidiasis. It can also be a symptom of allergies, such as allergy to Balsam of Peru. Cheilitis can also be caused by taking the (retinoid) drug Isotretinoin. It may also be a pre-malignant lesion for squamous cell carcinoma.</rdfs:comment>
        <rdfs:label>Cheilitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100825"/>

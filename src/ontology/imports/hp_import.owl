    <!-- http://purl.obolibrary.org/obo/HP_0012432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012378"/>
        <obo:IAO_0000115>Subjective feeling of tiredness characterized by a lack of energy and motivation that persists for six months or longer.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-11-13T07:49:08Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C0518656</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Chronic extreme exhaustion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic fatigue</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0012432</oboInOwl:id>
        <rdfs:comment>Note that chronic fatigue can be a symptom of chronic fatigue syndrome (CFS), which is characterized by profound fatigue that is not improved by bed rest and that may be worsened by physical or mental activity. Symptoms of CFS may include weakness, muscle pain, impaired memory, impaired mental concentration, and insomnia, which can result in reduced participation in daily activities.</rdfs:comment>
        <rdfs:label>Chronic fatigue</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012432"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

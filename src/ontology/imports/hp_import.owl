    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011337"/>
        <obo:IAO_0000115>Distance between the oral commissures more than 2 SD above the mean. Alternatively, an apparently increased width of the oral aperture (subjective).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0000181</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0002052</oboInOwl:hasAlternativeId>

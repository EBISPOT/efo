        <oboInOwl:hasExactSynonym>Abnormality of the foetal circulation system</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0010948</oboInOwl:id>
        <rdfs:label>Abnormal fetal cardiovascular morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>

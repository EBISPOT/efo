        <oboInOwl:hasDbXref>UMLS:C1849937</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Brachymelic dwarfism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Disproportionate short limb dwarfism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dwarfism, short-limbed</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Micromelic dwarfism</oboInOwl:hasExactSynonym>

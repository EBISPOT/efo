    <!-- http://purl.obolibrary.org/obo/HP_0033117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002246"/>
        <obo:IAO_0000115>Inflammation of the lining of the upper small intestine (duodenum).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-03T12:01:20Z</terms:date>
        <oboInOwl:hasExactSynonym>Duodenal inflammation</oboInOwl:hasExactSynonym>
        <rdfs:comment>The diagnosis of duodenitis is made when there is infiltration by inflammatory cells with changes in villous architecture and surface and crypt epithelium. Duodenitis can be graded according to the amount of neutrophilic and plasma cell infiltration, villous height, Brunner&apos;s gland hyperplasia with prolapse into the lamina propria and gastric metaplasia.</rdfs:comment>
        <rdfs:label>Duodenitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033117"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Inflammation of the lining of the upper small intestine (duodenum).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:16679353</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>The concentration of osteopontin in the blood circulation is above the upper limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-05T12:56:32Z</terms:date>
        <oboInOwl:hasExactSynonym>Elevated circulating osteopontin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated osteopontin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated osteopontin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated osteopontin level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased osteopontin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased osteopontin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased osteopontin level in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Osteopontin (OPN, also known as Eta-1) is a noncollagenous matrix protein produced by macrophages and T lymphocytes. Plasma OPN levels can be elevated in a range of diseases including tuberculosis and systemic lupus erythematosus.</rdfs:comment>
        <rdfs:label>Elevated circulating osteopontin concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>An anomaly of the musculoskeletal system, which consists of the bones of the skeleton, muscles, cartilage, tendons, ligaments, joints, and other connective tissue. The musculoskeletal system supports the weight of the body, maintains body position and produces movements of the body or of parts of the body.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-05T13:35:03Z</terms:date>
        <rdfs:label>Abnormality of the musculoskeletal system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033132">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012210"/>
        <obo:IAO_0000115>Increased echogenecity of the kidney cortex.</obo:IAO_0000115>

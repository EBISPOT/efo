    <!-- http://purl.obolibrary.org/obo/HP_0032309 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001911"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011893"/>
        <obo:IAO_0000115>Abnormal increase or decrease of absolute number of granulocytes in the blood, per microliter, compared to a reference range for a given sex and age-group.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-14T10:54:57Z</terms:date>
        <rdfs:comment>Granulocytes belong to the innate immune system and make up the largest proportion of white blood cells. They are myeloid cells and can be classified as neutrophil granulocytes (neutrophils), eosinophils, basophils, monocytes, and mast cells.</rdfs:comment>
        <rdfs:label>Abnormal granulocyte count</rdfs:label>
    </owl:Class>
    



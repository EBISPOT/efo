    <!-- http://purl.obolibrary.org/obo/HP_0025085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002014"/>
        <obo:IAO_0000115>Passage of many stools containing blood.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-10-15T13:58:14Z</terms:date>
        <oboInOwl:hasBroadSynonym>Blood in stool</oboInOwl:hasBroadSynonym>

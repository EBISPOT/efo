    <!-- http://purl.obolibrary.org/obo/HP_0012073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033097"/>
        <obo:IAO_0000115>An abnormal distribution of N-acylglycines in the urine. There are numerous different N-acylglycines, and this term refers to pathological alterations in their level or distribution.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-6996-5279"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-08-11T09:46:03Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4023057</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0012073</oboInOwl:id>
        <rdfs:comment>N-acylglycines result from glycine conjugation with exogenous compounds to enhance their excretion in urine. Glycine conjugation is also an effective detoxification system for preventing accumulation of acyl-CoA esters in several inherited metabolic disorders.</rdfs:comment>
        <rdfs:label>Abnormal urinary acylglycine profile</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An abnormal distribution of N-acylglycines in the urine. There are numerous different N-acylglycines, and this term refers to pathological alterations in their level or distribution.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:10870848</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0012075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000708"/>
        <obo:IAO_0000115>A personality disorder is a deeply ingrained pattern of behavior of a specified kind that deviates markedly from the norms of generally accepted behavior. It is typically apparent by the time of adolescence and causes long-term difficulties in personal relationships or functioning in society.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1111-7357"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7954-5235"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2897-0458"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4298-5074"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4618-6544"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-6996-5279"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-08-11T02:20:27Z</terms:date>
        <oboInOwl:hasDbXref>ICD-10:F60</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:33449004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0031212</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0012075</oboInOwl:id>
        <rdfs:comment>A personality disorder is generally associated with significant problems and limitations in relationships, social encounters, work, and school. It usually manifests since childhood or adolescence and continues throughout adulthood.</rdfs:comment>
        <rdfs:label>Personality disorder</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012075"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>ICD-10:F60</owl:annotatedTarget>
        <rdfs:label>Specific personality disorders</rdfs:label>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0012076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012075"/>
        <obo:IAO_0000115>A personality disorder characterized by impulsive behavior and unpredictable, capricious mood. Affected individuals show a tendency to have outbursts of emotion and an inability to control these behavioral explosions. They generally experience an intense fear of abandonment or instability and also struggle with feelings of emptiness.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1111-7357"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7954-5235"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2897-0458"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4298-5074"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4618-6544"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-6996-5279"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-08-11T02:26:02Z</terms:date>
        <oboInOwl:hasDbXref>ICD-10:F60.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:20010003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0006012</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>BPD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>EUPD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Emotionally unstable personality disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0012076</oboInOwl:id>
        <rdfs:label>Borderline personality disorder</rdfs:label>
    </owl:Class>

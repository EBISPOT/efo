        <oboInOwl:hasAlternativeId>HP:0007172</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:162294008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:229721007</oboInOwl:hasDbXref>

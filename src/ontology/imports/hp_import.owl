    <!-- http://purl.obolibrary.org/obo/HP_0000396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000377"/>
        <obo:IAO_0000115>A condition in which the helix is folded over to a greater degree than normal. That is, excessive curling of the helix edge, whereby the free edge is parallel to the plane of the ear.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001758</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0008570</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1837731</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Over-folded helices</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Overfolded ears</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Overfolded helices</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000396</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This is most often seen in the superior helix where it must be distinguished from a Lop ear (where the usual convexity of the posterior border of the ear is lost). Helix folding is highly variable.</rdfs:comment>
        <rdfs:label>Overfolded helix</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A condition in which the helix is folded over to a greater degree than normal. That is, excessive curling of the helix edge, whereby the free edge is parallel to the plane of the ear.</owl:annotatedTarget>

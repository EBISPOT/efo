        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012649"/>
        <obo:IAO_0000115>A general term for inflammation of the muscles without respect to the underlying cause.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-28T11:14:59Z</terms:date>

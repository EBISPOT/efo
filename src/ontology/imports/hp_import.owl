        <oboInOwl:hasDbXref>SNOMEDCT_US:59073000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0020580</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Sensory impairment</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0003474</oboInOwl:id>
        <rdfs:comment>This term does not include abnormalities of cortical sensation such as two-point discrimination, stereognosis, and graphesthesia.</rdfs:comment>
        <rdfs:label>Somatic sensory dysfunction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

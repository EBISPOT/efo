    <!-- http://purl.obolibrary.org/obo/HP_0001924 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010972"/>
        <obo:IAO_0000115>Sideroblastic anemia results from a defect in the incorporation of iron into the heme molecule. A sideroblast is an erythroblast that has stainable deposits of iron in cytoplasm (this can be demonstrated by Prussian blue staining).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0100791</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:41841004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0002896</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Hypersideremic anaemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypersideremic anemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sideroblastic anaemia</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001924</oboInOwl:id>
        <rdfs:comment>Sideroblastic anemia may be either congenital or acquired. In sideroblastic anemia, the hematocrit tends to be around 20 to 30 percent, and the mean corpuscular volume is normal or low.</rdfs:comment>
        <rdfs:label>Sideroblastic anemia</rdfs:label>
    </owl:Class>
    <owl:Axiom>

    <!-- http://purl.obolibrary.org/obo/HP_0030500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001103"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0030506"/>
        <obo:IAO_0000115>A type of white and/or yellow lesion located anywhere within the macula. These lesions can be flat or raised and can vary in size from very small to bigger.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4072987</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Yellow/white lesion of the macula</oboInOwl:hasExactSynonym>
        <rdfs:label>Yellow/white macular lesion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0030506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000479"/>
        <obo:IAO_0000115>An area anywhere within the retina showing pale yellow or white discoloration. Such lesions can be flat or raised and there size can range from very small to big.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4072991</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Yellow/white lesions of the retina</oboInOwl:hasExactSynonym>
        <rdfs:label>Yellow/white retinal lesion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0030666 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0008046"/>
        <obo:IAO_0000115>In ischemic retinal disease, neovascularization (NV) involves the sprouting of new vessels from pre-existent vessels. Ischemia invariably leads to the upregulation of Vascular Endothelial Growth Factor (VEGF) production. Most frequently the new vessels grow internal to the plane of the retina. However, intraretinal proliferation of new vessels can also occur.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-12-21T23:35:47Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0007850</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:61267008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0035320</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Retinal vascular proliferation</oboInOwl:hasExactSynonym>
        <rdfs:label>Retinal neovascularization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>In ischemic retinal disease, neovascularization (NV) involves the sprouting of new vessels from pre-existent vessels. Ischemia invariably leads to the upregulation of Vascular Endothelial Growth Factor (VEGF) production. Most frequently the new vessels grow internal to the plane of the retina. However, intraretinal proliferation of new vessels can also occur.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:23329331</oboInOwl:hasDbXref>
    </owl:Axiom>
    



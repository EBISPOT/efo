        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:26229557</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

        <oboInOwl:hasDbXref>UMLS:C3489396</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Hypogonadotrophic hypogonadism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Low gonadotropins (secondary hypogonadism)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Isolated hypogonadotropic hypogonadism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0000044</oboInOwl:id>
        <rdfs:label>Hypogonadotropic hypogonadism</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000044"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Hypogonadotropic hypogonadism is characterized by reduced function of the gonads (testes in males or ovaries in females) and results from the absence of the gonadal stimulating pituitary hormones: follicle stimulating hormone (FSH) and luteinizing hormone (LH).</owl:annotatedTarget>

        <oboInOwl:hasExactSynonym>Skull defect</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Calvarial defect</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>HP:0001362</oboInOwl:id>

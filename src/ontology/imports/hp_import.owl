    <!-- http://purl.obolibrary.org/obo/HP_0009193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004288"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0005913"/>
        <obo:IAO_0000115>A pseudoepiphysis is a secondary ossification center distinct from the normal epiphysis. The normal metacarpal epiphyses are located at the distal ends of the metacarpal bones. Accessory epiphyses (which are also known as pseudoepiphyses) can also occasionally be observed at the proximal ends of the metacarpals, usually involving the 2nd metacarpal bone.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-12-30T02:03:34Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0006091</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0006164</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1860253</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Accessory proximal metacarpal ossification centers</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Accessory proximal metacarpal ossification centres</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Metacarpal pseudoepiphyses</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pseudoepiphyses of the metacarpals</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0009193</oboInOwl:id>
        <rdfs:label>Metacarpal pseudoepiphysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0009193"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pseudoepiphysis is a secondary ossification center distinct from the normal epiphysis. The normal metacarpal epiphyses are located at the distal ends of the metacarpal bones. Accessory epiphyses (which are also known as pseudoepiphyses) can also occasionally be observed at the proximal ends of the metacarpals, usually involving the 2nd metacarpal bone.</owl:annotatedTarget>

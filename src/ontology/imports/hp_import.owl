        <rdfs:label>Abnormal urinary mineral level</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025659 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0040081"/>
        <obo:IAO_0000115>The activity of creatine kinase in the blood circulation is below the lower limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-11-10T10:35:36Z</terms:date>

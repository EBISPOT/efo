    <!-- http://purl.obolibrary.org/obo/HP_0010762 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011842"/>
        <obo:IAO_0000115>A chordoma is a tumor that arises from embryonic remnants of the notochord along the length of the neuraxis. Chordomas generally occur in the sacrum, intracranially at the clivus, or along the spinal axis.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-06-25T09:00:39Z</terms:date>
        <oboInOwl:hasDbXref>NCIT:C2947</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:50007008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0008487</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0010762</oboInOwl:id>
        <rdfs:comment>The notochord is a mesodermal embryonic structure that defines the primitive axis of the embryo and which survives in the adult vertebral column as the intervertebral disks.</rdfs:comment>
        <rdfs:label>Chordoma</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010762"/>

        <oboInOwl:hasDbXref>UMLS:C0497327</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Dementia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Dementia, progressive</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Progressive dementia</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000726</oboInOwl:id>
        <rdfs:label>Dementia</rdfs:label>

    <!-- http://purl.obolibrary.org/obo/HP_0002843 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004332"/>
        <obo:IAO_0000115>Abnormal increase or decrease of total or subset T cell count. T cells are commonly characterized as CD3+ lymphocytes, or their subpopulations, in the blood, compared to a reference range for a given sex and age-group, measured ex vivo. These may include both TCR alpha/beta and gamma/delta T cells.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002734</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0030332</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0030333</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1855752</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormal T cells</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of T cells</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cellular immune defect</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Defective cellular immunity</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002843</oboInOwl:id>
        <rdfs:comment>T-cells are lymphocytes whose principle function in the adaptive immune system is to mediate cell-mediated immunity.</rdfs:comment>
        <rdfs:label>Abnormal T cell morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002843"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Abnormal increase or decrease of total or subset T cell count. T cells are commonly characterized as CD3+ lymphocytes, or their subpopulations, in the blood, compared to a reference range for a given sex and age-group, measured ex vivo. These may include both TCR alpha/beta and gamma/delta T cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002843"/>

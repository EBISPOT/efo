        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Mid upper eyelash length &gt;10 mm or increased length of the eyelashes (subjective).</owl:annotatedTarget>

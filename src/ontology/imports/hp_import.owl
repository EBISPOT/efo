    <!-- http://purl.obolibrary.org/obo/HP_0011705 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001678"/>
        <obo:IAO_0000115>Delay of conduction through the atrioventricular node, which is manifested as prolongation of the PR interval in the electrocardiogram (EKG). All atrial impulses reach the ventricles.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-04-11T07:17:18Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:270492004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0085614</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0011705</oboInOwl:id>
        <rdfs:comment>The conduction of the cardiac impulse through the atrioventricular node is manifested in the EKG by the PR interval, which is normally less that 200 milliseconds in adults. Normal values are age-dependent in children, but normal values are less that 160 milliseconds in young children.</rdfs:comment>
        <rdfs:label>First degree atrioventricular block</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0011705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Delay of conduction through the atrioventricular node, which is manifested as prolongation of the PR interval in the electrocardiogram (EKG). All atrial impulses reach the ventricles.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:DDD_dbrown</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0011706 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011706">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001678"/>
        <obo:IAO_0000115>An intermittent atrioventricular block with failure of some atrial impulses to conduct to the ventricles, i.e., some but not all atrial impulses are conducted through the atrioventricular node and trigger ventricular contraction.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

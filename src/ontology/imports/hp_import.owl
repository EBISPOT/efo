    <!-- http://purl.obolibrary.org/obo/HP_0001988 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001943"/>

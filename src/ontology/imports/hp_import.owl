    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001510"/>
        <obo:IAO_0000115>An abnormal restriction of fetal growth with fetal weight below the tenth percentile for gestational age.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001515</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0008862</oboInOwl:hasAlternativeId>

        <oboInOwl:hasDbXref>SNOMEDCT_US:42658009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0031117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0442874</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Peripheral nerve damage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Peripheral neuritis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Neuropathy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0009830</oboInOwl:id>
        <rdfs:comment>Terms from this subhierarchy should be used to describe functional abnormalities seen in peripheral neuropathy. Morphological abnormalities should be coded separately.</rdfs:comment>
        <rdfs:label>Peripheral neuropathy</rdfs:label>
    </owl:Class>

        <obo:IAO_0000115>A severe congenital heart defect characterized by underdevelopment of the left ventricle.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-03-18T08:56:00Z</terms:date>

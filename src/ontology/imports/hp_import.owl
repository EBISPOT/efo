        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012718"/>
        <obo:IAO_0000115>A developmental defect resulting in complete obliteration of the lumen of the esophagus such that the esophagus ends in a blind pouch rather than connecting to the stomach.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Fyler:4412</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:26179002</oboInOwl:hasDbXref>

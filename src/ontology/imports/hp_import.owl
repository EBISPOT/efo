    <!-- http://purl.obolibrary.org/obo/HP_0002169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001347"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004305"/>
        <obo:IAO_0000115>A series of rhythmic and involuntary muscle contractions (at a frequency of about 5 to 7 Hz) that occur in response to an abruptly applied and sustained stretch.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:36649002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0009024</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Involuntary rhythmic muscular contractions and relaxations</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002169</oboInOwl:id>
        <rdfs:comment>Clonus is a manifestation of spasticity that can occur with lesions of the corticospinal tract. Only sustained clonus (5 beats or more) is considered abnormal.</rdfs:comment>
        <rdfs:label>Clonus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002169"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A series of rhythmic and involuntary muscle contractions (at a frequency of about 5 to 7 Hz) that occur in response to an abruptly applied and sustained stretch.</owl:annotatedTarget>

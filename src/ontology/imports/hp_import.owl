        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Tic disorder</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0001-8430-6039"/>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-4142-7153"/>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-4422-1708"/>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-3777-1389"/>

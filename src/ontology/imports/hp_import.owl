    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003749"/>
        <obo:IAO_0000115>Reduced ability to flex the femur, that is, to pull the knee upward.</obo:IAO_0000115>

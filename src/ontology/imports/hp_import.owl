    <!-- http://purl.obolibrary.org/obo/HP_0001272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001317"/>
        <obo:IAO_0000115>Cerebellar atrophy is defined as a cerebellum with initially normal structures, in a posterior fossa with normal size, which displays enlarged fissures (interfolial spaces) in comparison to the foliae secondary to loss of tissue. Cerebellar atrophy implies irreversible loss of tissue and result from an ongoing progressive disease until a final stage is reached or a single injury, e.g. an intoxication or infectious event.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002364</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0006839</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007072</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007203</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:95646004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0262404</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0740279</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4020873</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Atrophic cerebellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Degeneration of cerebellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Infratentorial atrophy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0001272</oboInOwl:id>
        <rdfs:comment>Cerebellar atrophy can be diagnosed if the cerebellum is small with shrunken folia and large cerebellar fissures or if it has been shown to undergo progressive volume loss.</rdfs:comment>
        <rdfs:label>Cerebellar atrophy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001272"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cerebellar atrophy is defined as a cerebellum with initially normal structures, in a posterior fossa with normal size, which displays enlarged fissures (interfolial spaces) in comparison to the foliae secondary to loss of tissue. Cerebellar atrophy implies irreversible loss of tissue and result from an ongoing progressive disease until a final stage is reached or a single injury, e.g. an intoxication or infectious event.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:12169461</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:26331051</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001272"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Degeneration of cerebellum</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0001-5208-3432"/>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>

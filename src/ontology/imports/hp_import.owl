    <!-- http://purl.obolibrary.org/obo/HP_0001097 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000491"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000509"/>
        <obo:IAO_0000115>Dryness of the eye related to deficiency of the tear film components (aqueous, mucin, or lipid), lid surface abnormalities, or epithelial abnormalities. Keratoconjunctivitis sicca often results in a scratchy or sandy sensation (foreign body sensation) in the eyes, and may also be associated with itching, inability to produce tears, photosensitivity, redness, pain, and difficulty in moving the eyelids.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:302896008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:363677007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:46152009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0013238</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0022575</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0043349</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C2930821</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Dry eyes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Keratitis sicca</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Xerophthalmia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Dry eye syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0001097</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:label>Keratoconjunctivitis sicca</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001097"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Dryness of the eye related to deficiency of the tear film components (aqueous, mucin, or lipid), lid surface abnormalities, or epithelial abnormalities. Keratoconjunctivitis sicca often results in a scratchy or sandy sensation (foreign body sensation) in the eyes, and may also be associated with itching, inability to produce tears, photosensitivity, redness, pain, and difficulty in moving the eyelids.</owl:annotatedTarget>

    <!-- http://purl.obolibrary.org/obo/HP_0002453 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002134"/>
        <obo:IAO_0000115>An abnormality of the globus pallidus.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007040</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4025706</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0002453</oboInOwl:id>
        <rdfs:comment>The globus pallidus is a cerebral nucleus located medially to the putamen and laterally to the internal capsule.</rdfs:comment>
        <rdfs:label>Abnormal globus pallidus morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002453"/>

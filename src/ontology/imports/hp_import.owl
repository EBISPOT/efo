    <!-- http://purl.obolibrary.org/obo/HP_0001837 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001780"/>
        <obo:IAO_0000115>Visible increase in width of the non-hallux digit without an increase in the dorso-ventral dimension.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C1865038</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Broad toe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wide toe</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001837</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>Note that the girth may be increased in a broad toe, but this must be distinguished from Macrodactyly because in Macrodactyly the length is increased as well. The affected digit should be specified. Note that this assessment may be difficult when the toes are short. This term is not used for the first digit, see Broad hallux. If all five digits are broad, both terms should be used for that patient.</rdfs:comment>
        <rdfs:label>Broad toe</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001837"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

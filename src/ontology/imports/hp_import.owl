    <!-- http://purl.obolibrary.org/obo/HP_0000275 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000274"/>
        <obo:IAO_0000115>Bizygomatic (upper face) and bigonial (lower face) width are both more than 2 standard deviations below the mean (objective); or, an apparent reduction in the width of the upper and lower face (subjective).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0000318</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1837463</oboInOwl:hasDbXref>

    <!-- http://purl.obolibrary.org/obo/HP_0001257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001276"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011442"/>
        <obo:IAO_0000115>A motor disorder characterized by a velocity-dependent increase in tonic stretch reflexes with increased muscle tone, exaggerated (hyperexcitable) tendon reflexes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:221360009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:397790002</oboInOwl:hasDbXref>

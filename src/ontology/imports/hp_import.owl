    <!-- http://purl.obolibrary.org/obo/HP_0001931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010972"/>
        <obo:IAO_0000115>A type of anemia characterized by an abnormally low concentration of hemoglobin in the erythrocytes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:44452003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0002884</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Hypochromic anemia</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001931</oboInOwl:id>
        <rdfs:comment>The low concentration of hemoglobin in the erythrocytes causes them to be abnormally pale, i.e., to have less color (be hypochromic).</rdfs:comment>
        <rdfs:label>Hypochromic anemia</rdfs:label>
    </owl:Class>
    <owl:Axiom>

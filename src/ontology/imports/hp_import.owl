    <!-- http://purl.obolibrary.org/obo/HP_0000543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012795"/>
        <obo:IAO_0000115>A pale yellow discoloration of the optic disc (the area of the optic nerve head in the retina). The optic disc normally has a pinkish hue with a central yellowish depression.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001148</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001484</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:302200001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0554970</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Pale optic disc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Disc pallor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pale optic discs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0000543</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>Optic disc pallor can be judged clinically with serial color photographs or by comparison to the other eye. The pallor reflects replacement of dead axons by glial tissue. The loss of the small capillaries within the nerve accounts for the shift from orange-pink to white.</rdfs:comment>
        <rdfs:label>Optic disc pallor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000543"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

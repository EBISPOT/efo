        <oboInOwl:hasDbXref>UMLS:C0018801</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0018802</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CHF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cardiac failure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cardiac failures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cardiac insufficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Chronic heart failure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Heart failure</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001635</oboInOwl:id>
        <rdfs:label>Congestive heart failure</rdfs:label>
    </owl:Class>
    <owl:Axiom>

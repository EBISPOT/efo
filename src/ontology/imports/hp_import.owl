    <!-- http://purl.obolibrary.org/obo/HP_0000712 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000708"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025766"/>

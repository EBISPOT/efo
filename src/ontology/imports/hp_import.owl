        <oboInOwl:hasDbXref>UMLS:C0152173</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0011841</oboInOwl:id>
        <rdfs:comment>If untreated, ventricular flutter typically progresses to ventricular fibrillation.</rdfs:comment>
        <rdfs:label>Ventricular flutter</rdfs:label>
    </owl:Class>

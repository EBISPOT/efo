        <rdfs:comment>Haptoglobin is primarily produced in the liver and is functionally important for binding free hemoglobin fromlysed red cells in vivo, preventing its toxic effects.</rdfs:comment>
        <rdfs:label>Abnormal circulating haptoglobin concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0020180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0020180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0020179"/>
        <obo:IAO_0000115>The concentration of haptoglobin in the blood circulation is above the upper limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-07-11T20:30:03Z</terms:date>
        <oboInOwl:hasExactSynonym>Elevated circulating haptoglobin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated haptoglobin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated haptoglobin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated haptoglobin level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased haptoglobin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased haptoglobin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased haptoglobin level in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Haptoglobin is an acute-phase reactant whose levels can become elevated in the presence of infection and inflammation.</rdfs:comment>
        <rdfs:label>Elevated circulating haptoglobin concentration</rdfs:label>
    </owl:Class>
    



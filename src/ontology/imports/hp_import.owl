    <!-- http://purl.obolibrary.org/obo/HP_0000243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002683"/>
        <obo:IAO_0000115>Wedge-shaped, or triangular head, with the apex of the triangle at the midline of the forehead and the base of the triangle at the occiput.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>Triangular head shape</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Wedge shaped head</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>SNOMEDCT_US:28740008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0265535</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4280665</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4280666</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Triangular cranium shape</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Triangular skull shape</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wedge shaped cranium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Wedge shaped skull</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000243</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This shape should be assessed from above, with the examiner looking down on the head of the patient. Trigonocephaly can be caused by premature fusion of the metopic suture.</rdfs:comment>
        <rdfs:label>Trigonocephaly</rdfs:label>
    </owl:Class>

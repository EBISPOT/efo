    <!-- http://purl.obolibrary.org/obo/HP_6001187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_6001187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>The concentration of progranulin in the blood circulation is below the lower limit of normal.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/human-phenotype-ontology/issues/10918"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-03-01T11:10:50Z</terms:date>
        <oboInOwl:hasExactSynonym>Decreased circulating progranulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased progranulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased progranulin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased progranulin level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced progranulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced progranulin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced progranulin level in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Progranulin, a secreted glycoprotein, maintains cerebrocortical viability. It has been identified as an important factor controlling neural function while also suppressing neuroinflammation and playing roles in neuronal lysosome function. Loss of one allele of GRN, the gene encoding progranulin, leads to the development of frontotemporal dementia, and loss of both alleles leads to the development of neuronal ceroid lipofuscinosis.</rdfs:comment>
        <rdfs:label>Decreased circulating progranulin concentration</rdfs:label>
    </owl:Class>

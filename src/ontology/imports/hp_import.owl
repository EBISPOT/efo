    <!-- http://purl.obolibrary.org/obo/HP_0002151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001941"/>
        <obo:IAO_0000115>Abnormally increased level of blood lactate (2-hydroxypropanoic acid). Lactate is produced from pyruvate by lactate dehydrogenase during normal metabolism. The terms lactate and lactic acid are often used interchangeably but lactate (the component measured in blood) is strictly a weak base whereas lactic acid is the corresponding acid. Lactic acidosis is often used clinically to describe elevated lactate but should be reserved for cases where there is a corresponding acidosis (pH below 7.35).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0003638</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Higher than normal levels of lactate in blood</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>UMLS:C1836440</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Increased blood lactate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased serum lactate</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002151</oboInOwl:id>
        <rdfs:label>Increased circulating lactate concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002151"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Abnormally increased level of blood lactate (2-hydroxypropanoic acid). Lactate is produced from pyruvate by lactate dehydrogenase during normal metabolism. The terms lactate and lactic acid are often used interchangeably but lactate (the component measured in blood) is strictly a weak base whereas lactic acid is the corresponding acid. Lactic acidosis is often used clinically to describe elevated lactate but should be reserved for cases where there is a corresponding acidosis (pH below 7.35).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:24079682</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

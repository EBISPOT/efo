    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0010968 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010968">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032243"/>
        <obo:IAO_0000115>An abnormality of liposaccharide metabolism.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-01-27T09:22:56Z</terms:date>

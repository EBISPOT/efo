    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004359"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of fatty acid anion in the blood circulation.</obo:IAO_0000115>

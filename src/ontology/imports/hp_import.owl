        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6581-7754"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7674-1767"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2598-6622"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4014-4490"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-01-13T22:59:58Z</terms:date>
        <oboInOwl:hasExactSynonym>Alcohol addiction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Alcoholism</oboInOwl:hasExactSynonym>
        <rdfs:label>Addictive alcohol use</rdfs:label>
    </owl:Class>
    



        <oboInOwl:hasAlternativeId>HP:0006987</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Brain and/or spinal cord issue</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>SNOMEDCT_US:88425004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0497552</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of the nervous system</oboInOwl:hasExactSynonym>

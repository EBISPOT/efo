        <oboInOwl:hasDbXref>UMLS:C4082168</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Bifid thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Notching of thumb phalanges</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Partial duplication of the phalanges of the thumb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Partial duplication of the thumb bones</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0009944</oboInOwl:id>
        <rdfs:label>Partial duplication of thumb phalanx</rdfs:label>
    </owl:Class>
    <owl:Axiom>

    <!-- http://purl.obolibrary.org/obo/HP_0002099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002795"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100326"/>
        <obo:IAO_0000115>Asthma is characterized by increased responsiveness of the tracheobronchial tree to multiple stimuli, leading to narrowing of the air passages with resultant dyspnea, cough, and wheezing.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002112</oboInOwl:hasAlternativeId>

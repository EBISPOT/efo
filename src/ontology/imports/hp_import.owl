    <!-- http://purl.obolibrary.org/obo/HP_0000674 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0009804"/>
        <obo:IAO_0000115>The absence of all teeth from the normal series by a failure to develop.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0006484</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:16958000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:26624006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0399352</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4280622</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Anodontia vera</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Complete agenesis of all teeth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Complete dental agenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Failure of development of all teeth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Complete anodontia</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Total anodontia</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>Missing all teeth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Total absence of all teeth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0000674</oboInOwl:id>
        <rdfs:comment>Anodontia can affect both primary and permanent teeth. Alternatively, there can be anodontia of just the permanent teeth. Anodontia must be distinguished from non-erupted teeth.</rdfs:comment>
        <rdfs:label>Anodontia</rdfs:label>

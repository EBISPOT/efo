    <!-- http://purl.obolibrary.org/obo/HP_0000719 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000719">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_5200029"/>
        <obo:IAO_0000115>An explicit or perceived action, demonstration, conduct, or language (verbal and written) that is contrary to generally accepted norms, rules, procedures, or unacceptable within the context in which it is carried out. Inappropriate behaviors could take place in a sexual or social context and could be aggressive, violent, impulsive, intimidating, or threatening in nature.</obo:IAO_0000115>

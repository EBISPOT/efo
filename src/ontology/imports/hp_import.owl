        <oboInOwl:hasAlternativeId>HP:0100667</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:43476002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0221357</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Brachydactyly syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Short fingers or toes</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001156</oboInOwl:id>
        <rdfs:label>Brachydactyly</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001156"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Digits that appear disproportionately short compared to the hand/foot. The word brachydactyly is used here to describe a series distinct patterns of shortened digits (brachydactyly types A-E). This is the sense used here.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

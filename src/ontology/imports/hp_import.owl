        <oboInOwl:id>HP:0003547</oboInOwl:id>
        <rdfs:label>Shoulder girdle muscle weakness</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003547"/>

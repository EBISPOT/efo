        <oboInOwl:hasDbXref>UMLS:C4021210</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of the fetal cardiovascular system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of the fetal circulation system</oboInOwl:hasExactSynonym>

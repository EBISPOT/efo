    <!-- http://purl.obolibrary.org/obo/HP_0025163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000587"/>
        <obo:IAO_0000115>A structural abnormality of the optic chiasm.The optic chiasm, located below the hypothalamus, is a partial crossing of the optic nerves.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

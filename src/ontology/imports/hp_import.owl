    <!-- http://purl.obolibrary.org/obo/HP_0012371 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000271"/>
        <obo:IAO_0000115>Abnormally anterior positioning of the infraorbital and perialar regions, or increased convexity of the face, or increased nasolabial angle. The midface includes the maxilla, the cheeks, the zygomas, and the infraorbital and perialar regions of the face</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-10-13T02:55:54Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0010279</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Big midface</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Large midface</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>UMLS:C0240309</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Midface hyperplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Midfacial excess</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Midfacial prominence</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Hypertrophy of midface</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Overgrowth of the midface</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0012371</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This term represents increased size of the maxilla (upper jaw) in length (increased midface height) or anterior-posterior projection (midface prominence). In the presence of normal mandible size, maxillary prominence may give the appearance of retrognathia.</rdfs:comment>
        <rdfs:label>Hyperplasia of midface</rdfs:label>
    </owl:Class>

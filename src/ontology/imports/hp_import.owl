        <oboInOwl:hasExactSynonym>FGR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Fetal growth restriction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>IUGR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>In utero growth retardation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Intrauterine growth failure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Intrauterine growth restriction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Intrauterine growth retardation, IUGR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Intrauterine retardation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Prenatal growth deficiency</oboInOwl:hasExactSynonym>

    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002027"/>
        <obo:IAO_0000115>A type of abdominal pain characterized by a feeling of contractions and typically fluctuating in intensity.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-02T14:21:11Z</terms:date>

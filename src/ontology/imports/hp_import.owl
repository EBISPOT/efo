    <!-- http://purl.obolibrary.org/obo/HP_0004448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0004448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0006554"/>
        <obo:IAO_0000115>Hepatic failure refers to the inability of the liver to perform its normal synthetic and metabolic functions, which can result in coagulopathy and alteration in the mental status of a previously healthy individual. Hepatic failure is defined as fulminant if there is onset of encephalopathy within 4 weeks of the onset of symptoms in a patient with a previously healthy liver.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-03-18T10:09:00Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:197270009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:235884008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0162557</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0004448</oboInOwl:id>
        <rdfs:label>Fulminant hepatic failure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Hepatic failure refers to the inability of the liver to perform its normal synthetic and metabolic functions, which can result in coagulopathy and alteration in the mental status of a previously healthy individual. Hepatic failure is defined as fulminant if there is onset of encephalopathy within 4 weeks of the onset of symptoms in a patient with a previously healthy liver.</owl:annotatedTarget>

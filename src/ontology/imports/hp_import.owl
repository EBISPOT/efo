        <oboInOwl:hasDbXref>UMLS:C0014550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0751778</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4021759</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Generalised epileptic myoclonus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalised myoclonic seizure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalised myoclonic seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized epileptic myoclonus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized myoclonic seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Myoclonus seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Myoclonic epilepsy, progressive</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0002123</oboInOwl:id>
        <rdfs:label>Generalized myoclonic seizure</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002814"/>
        <obo:IAO_0000115>An abnormality of the skeleton of foot.</obo:IAO_0000115>

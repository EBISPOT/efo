        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000622 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000504"/>
        <obo:IAO_0000115>Lack of sharpness of vision resulting in the inability to see fine detail.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007723</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:111516008</oboInOwl:hasDbXref>

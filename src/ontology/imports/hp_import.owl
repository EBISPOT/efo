    <!-- http://purl.obolibrary.org/obo/HP_0033258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001699"/>
        <obo:IAO_0000115>Sudden unexpected death in epilepsy (SUDEP) is a sudden, unexpected, witnessed or unwitnessed, non-traumatic and non-drowning death, occurring in benign circumstances, in an individual with epilepsy, with or without evidence for a seizure and excluding documented status epilepticus, in which postmortem examination has not revealed a cause of death.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-11-28T14:34:03Z</terms:date>
        <oboInOwl:hasExactSynonym>SUDEP</oboInOwl:hasExactSynonym>
        <rdfs:label>Sudden unexpected death in epilepsy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0033258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Sudden unexpected death in epilepsy (SUDEP) is a sudden, unexpected, witnessed or unwitnessed, non-traumatic and non-drowning death, occurring in benign circumstances, in an individual with epilepsy, with or without evidence for a seizure and excluding documented status epilepticus, in which postmortem examination has not revealed a cause of death.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-1735-8178"/>

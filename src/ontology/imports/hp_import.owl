    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0009888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001595"/>
        <obo:IAO_0000115>Abnormality of the growth of secondary sexual hair, which normally ensues during puberty. In males, secondary sexual hair usually comprises body hair, including underarm, abdominal, chest, and pubic hair. In females, secondary sexual hair usually comprises a lesser degree of body hair, most prominently underarm and pubic hair.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-04-30T06:18:33Z</terms:date>

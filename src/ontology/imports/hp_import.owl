        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0020045"/>
        <obo:IAO_0000115>A form of strabismus with one or both eyes turned inward (&apos;crossed&apos;) to a relatively severe degree, usually defined as 10 diopters or more.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:16596007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0014877</oboInOwl:hasDbXref>

    <!-- http://purl.obolibrary.org/obo/HP_0012668 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001279"/>
        <obo:IAO_0000115>A vasovagal episode or vasovagal syncope is the most common form of reflex syncope. Reflex syncope is a general term used to describe types of syncope resulting from a failure in autoregulation of blood pressure, and ultimately, in cerebral perfusion pressure resulting in transient loss of consciousness. The mechanisms responsible for this are complex and involve both depression of cardiac output as well as a decrease in vascular tone.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2014-02-15T01:33:13Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:234167006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:398652001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:398665005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0042420</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0340854</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Neurocardiogenic syncope</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reflex syncope</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Situational syncope</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Vasovagal episode</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0012668</oboInOwl:id>
        <rdfs:label>Vasovagal syncope</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012668"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A vasovagal episode or vasovagal syncope is the most common form of reflex syncope. Reflex syncope is a general term used to describe types of syncope resulting from a failure in autoregulation of blood pressure, and ultimately, in cerebral perfusion pressure resulting in transient loss of consciousness. The mechanisms responsible for this are complex and involve both depression of cardiac output as well as a decrease in vascular tone.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29262088</oboInOwl:hasDbXref>
    </owl:Axiom>
    



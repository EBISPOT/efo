    <!-- http://purl.obolibrary.org/obo/HP_0002311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011443"/>
        <obo:IAO_0000115>A deficit in coordination of muscle movements. Coordination is defined as the orchestrated movement of multiple body parts as required to accomplish intended actions, like walking.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002275</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0002276</oboInOwl:hasAlternativeId>

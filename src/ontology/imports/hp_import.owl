        <oboInOwl:hasAlternativeId>HP:0000203</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Glossal hypertrophy</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Lingual hyperplasia</oboInOwl:hasBroadSynonym>

        <oboInOwl:hasDbXref>UMLS:C0221352</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Partial syndactyly</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0006101</oboInOwl:id>
        <rdfs:label>Finger syndactyly</rdfs:label>
    </owl:Class>

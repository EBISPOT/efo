    <!-- http://purl.obolibrary.org/obo/HP_0032245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001939"/>
        <obo:IAO_0000115>An abnormality in the function of the chemical reactions related to processes including conversion of food to enter, synthesis of proteins, lipids, nucleic acids, and carbohydrates, or the elimination of waste products.</obo:IAO_0000115>

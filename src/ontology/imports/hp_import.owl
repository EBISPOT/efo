    <!-- http://purl.obolibrary.org/obo/HP_0000360 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000364"/>
        <obo:IAO_0000115>Tinnitus is an auditory perception that can be described as the experience of sound, in the ear or in the head, in the absence of external acoustic stimulation.</obo:IAO_0000115>

    <!-- http://purl.obolibrary.org/obo/HP_0006695 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0006695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001671"/>
        <obo:IAO_0000115>A defect of the atrioventricular septum of the heart.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0005139</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0005298</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0010439</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Hole in center of heart</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Hole in centre of heart</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>Fyler:0606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Fyler:1100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Fyler:606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:15459006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0014116</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1389016</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Atrioventricular septal defect</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Endocardial cushion defect</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0006695</oboInOwl:id>
        <rdfs:comment>During atrioventricular valvuloseptal morphogenesis, the endocardial cushions expand as they are infiltrated by extracellular matrix secreted from the surrounding myocardium. The cushions then fuse and are remodeled to form the atrioventricular valves and septa. Failure of this process results in AVSD, with the degree of severity dependent on the stage at which the developmental failure occurs. AVSD are a spectrum of cardiac malformations that result in a persistent common atrioventricular canal.</rdfs:comment>
        <rdfs:label>Atrioventricular canal defect</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0006695"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A defect of the atrioventricular septum of the heart.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:12632326</oboInOwl:hasDbXref>
    </owl:Axiom>

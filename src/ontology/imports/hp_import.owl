    <!-- http://purl.obolibrary.org/obo/HP_0032156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011355"/>
        <obo:IAO_0000115>Loss of sections of skin either spontaneously or after gentle handling.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-12-02T15:19:00Z</terms:date>
        <oboInOwl:hasExactSynonym>Detached skin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Epidermal detachment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Skin sloughing</oboInOwl:hasExactSynonym>
        <rdfs:label>Skin detachment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032156"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Loss of sections of skin either spontaneously or after gentle handling.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:RGD_gthayman</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:27656858</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032101"/>
        <obo:IAO_0000115>An unusual infection classified by the affected body part.</obo:IAO_0000115>

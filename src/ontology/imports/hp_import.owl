        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-0986-4123"/>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:DDD_ncarter</oboInOwl:hasDbXref>
    </owl:Axiom>

        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-02-14T10:57:40Z</terms:date>
        <oboInOwl:hasExactSynonym>Granulocytosis</oboInOwl:hasExactSynonym>
        <rdfs:label>Increased total granulocyte count</rdfs:label>
    </owl:Class>
    



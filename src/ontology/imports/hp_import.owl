    <!-- http://purl.obolibrary.org/obo/HP_0002078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001251"/>
        <obo:IAO_0000115>Truncal ataxia is a sign of ataxia characterized by instability of the trunk. It usually occurs during sitting.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007014</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:250067008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0427190</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Instability or lack of coordination of central trunk muscles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Trunk ataxia</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002078</oboInOwl:id>
        <rdfs:comment>Truncal ataxia is generally caused by midline damage to the cerebellar vermis and associated pathways. Patients with truncal ataxia may not be able to sit or stand without support.</rdfs:comment>
        <rdfs:label>Truncal ataxia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Truncal ataxia is a sign of ataxia characterized by instability of the trunk. It usually occurs during sitting.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:UKT_rschuele</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

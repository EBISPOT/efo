    <!-- http://purl.obolibrary.org/obo/HP_0002500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010993"/>
        <obo:IAO_0000115>An abnormality of the cerebral white matter.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0200100</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C0948163</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4020851</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of subcortical white matter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of the cerebral white matter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cerebral white matter abnormalities</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Leukoaraiosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>White matter abnormalities</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>White matter alterations</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Cortical white matter abnormalities seen on MRI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0002500</oboInOwl:id>
        <rdfs:comment>This finding can be demonstrated by magnetic resonance imaging, especially with t2 signaling. The cerebral white matter is the region of the central nervous system that consists mostly of glial cells and myelinated axons that interconnect the various regions of the cerebrum and the lower brain centers. It is located in the subcortex.</rdfs:comment>
        <rdfs:label>Abnormal cerebral white matter morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0002500"/>

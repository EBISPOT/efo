    <!-- http://purl.obolibrary.org/obo/HP_0010867 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001251"/>
        <obo:IAO_0000115>A type of ataxia characterized by the impairment of the ability to smoothly perform the elements of a voluntary movement in the appropriate order and speed. With dyssynergia, a voluntary movement appears broken down into its component parts.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-08-18T01:17:10Z</terms:date>

    <!-- http://purl.obolibrary.org/obo/HP_0001831 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001991"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011927"/>
        <obo:IAO_0000115>A toe that appears disproportionately short compared to the foot.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001767</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001781</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001855</oboInOwl:hasAlternativeId>

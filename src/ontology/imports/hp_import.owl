    <!-- http://purl.obolibrary.org/obo/HP_0025020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>The concentration of prostate-specific antigen in the blood circulation is above the upper limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-08-12T12:13:13Z</terms:date>
        <oboInOwl:hasExactSynonym>Elevated circulating prostate-specific antigen concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated prostate-specific antigen concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated prostate-specific antigen level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated prostate-specific antigen level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased prostate-specific antigen concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased prostate-specific antigen level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased prostate-specific antigen level in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Prostate-specific antigen (PSA) screening for prostate cancer has been common practice although the utility of general PSA screening has been called into question.</rdfs:comment>
        <rdfs:label>Elevated circulating prostate-specific antigen concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0025031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-08-27T13:44:32Z</terms:date>
        <rdfs:comment>Any anomaly of the digestive system, a collection of organs that is made up of the gastrointestinal tract and the liver, pancreas, and gallbladder. The gastrointestinal tract is a series of hollow organs joined in a long, twisting tube from the mouth to the anus, including the mouth, esophagus, stomach, small intestine, large intestine and anus.</rdfs:comment>
        <rdfs:label>Abnormality of the digestive system</rdfs:label>
    </owl:Class>
    



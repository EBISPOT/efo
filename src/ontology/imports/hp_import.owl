        <oboInOwl:hasExactSynonym>Lens opacity</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000518</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>

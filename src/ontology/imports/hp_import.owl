        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>Esotropia is analogous to but more severe than esophoria. Affected children are more likely to have amblyopia or require corrective eye muscle surgery than children with esophoria.</rdfs:comment>
        <rdfs:label>Esotropia</rdfs:label>
    </owl:Class>

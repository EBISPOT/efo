    <!-- http://purl.obolibrary.org/obo/HP_0000938 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000938">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004349"/>
        <obo:IAO_0000115>Osteopenia is a term to define bone density that is not normal but also not as low as osteoporosis. By definition from the World Health Organization osteopenia is defined by bone densitometry as a T score -1 to -2.5.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002768</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0002799</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0002800</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:312894000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:78441005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0029453</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0747078</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Generalised osteopenia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Generalized osteopenia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteopaenia</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000938</oboInOwl:id>
        <rdfs:label>Osteopenia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000938"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

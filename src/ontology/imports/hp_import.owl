    <!-- http://purl.obolibrary.org/obo/HP_0012185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0009830"/>
        <obo:IAO_0000115>Injury to the median nerve caused by its entrapment at the wrist as it traverses through the carpal tunnel. Clinically, constrictive median neuropathy is characterized by pain, paresthesia, and weakness in the median nerve distribution of the hand.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-02-24T09:24:32Z</terms:date>

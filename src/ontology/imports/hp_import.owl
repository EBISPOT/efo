    <!-- http://purl.obolibrary.org/obo/HP_0032039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000315"/>
        <obo:IAO_0000115>An anomaly of the adjacent structures (i.e., adnexa) of the eye, defined as the lacrimal apparatus, the extraocular muscles and the eyelids, eyelashes, eyebrows and the conjunctiva.</obo:IAO_0000115>

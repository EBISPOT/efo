        <oboInOwl:hasExactSynonym>Abnormal circulating C-reactive protein concentration</oboInOwl:hasExactSynonym>
        <rdfs:comment>C-reactive protein (CRP) is produced by the liver, and increases in concentration in response to inflammation.</rdfs:comment>
        <rdfs:label>Abnormal circulating C-reactive protein concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032437">

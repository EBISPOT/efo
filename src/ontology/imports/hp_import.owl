        <oboInOwl:hasDbXref>UMLS:C0151564</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0002396</oboInOwl:id>
        <rdfs:comment>Cogwheel rigidity is a typical manifestation of Parkinson disease.</rdfs:comment>
        <rdfs:label>Cogwheel rigidity</rdfs:label>
    </owl:Class>
    <owl:Axiom>

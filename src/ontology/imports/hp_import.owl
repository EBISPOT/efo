        <oboInOwl:hasDbXref>UMLS:C4280807</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Flat head syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flattening of cranial vault</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flattening of cranium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flattening of skull</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rhomboid shaped cranium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rhomboid shaped skull</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Deformational plagiocephaly</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Flattening of head</oboInOwl:hasNarrowSynonym>

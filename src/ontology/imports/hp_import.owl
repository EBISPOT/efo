        <oboInOwl:hasAlternativeId>HP:0004650</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0200139</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:249321001</oboInOwl:hasDbXref>

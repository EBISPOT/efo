    <!-- http://purl.obolibrary.org/obo/HP_0030376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0030376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025539"/>
        <obo:IAO_0000115>A deviation from normal proportion of immature B cells (CD19+/ CD21low) in circulation relative to total number of B cells. Immature B cells (IgM+) are still in final stages of development within the bone marrow. Naive B cells are those which have left the bone marrow, before they bind to the antigen for which they&apos;re specific (IgM+/IgD+).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4072915</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormal proportion of CD19+/CD21low B cells</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal proportion of immature B cells</oboInOwl:hasExactSynonym>
        <rdfs:label>Abnormal immature B cell proportion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0030376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A deviation from normal proportion of immature B cells (CD19+/ CD21low) in circulation relative to total number of B cells. Immature B cells (IgM+) are still in final stages of development within the bone marrow. Naive B cells are those which have left the bone marrow, before they bind to the antigen for which they&apos;re specific (IgM+/IgD+).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    



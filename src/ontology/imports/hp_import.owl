    <!-- http://purl.obolibrary.org/obo/HP_0033100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003355"/>
        <obo:IAO_0000115>An elevated level of a proteinogenic amino acid in the urine. These are the 23 alpha-amino acids that are precursors to proteins, and are incorporated into proteins during translation. The group includes the 20 amino acids encoded by the nuclear genes of eukaryotes together with selenocysteine, pyrrolysine, and N-formylmethionine.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-17T16:35:12Z</terms:date>
        <rdfs:label>Increased proteinogenic amino acid level in urine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>The concentration of CHI3L1 in the blood circulation is above the upper limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-29T08:40:26Z</terms:date>
        <oboInOwl:hasExactSynonym>Elevated chitinase-3-like protein 1 concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated chitinase-3-like protein 1 level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated chitinase-3-like protein 1 level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated circulating CHI3L1 concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated circulating YKL40 level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated circulating chitinase 3-like 1 level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased chitinase-3-like protein 1 concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased chitinase-3-like protein 1 level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased chitinase-3-like protein 1 level in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Chitinase 3-like 1 (CHI3L1; previously known as YKL-40) is a glycoprotein with homology to the chitinase protein family, but without chitinase activity. Elevations of serum CHI3L1 can be measured by ELISA and are related to some kinds of bone disease.</rdfs:comment>
        <rdfs:label>Elevated circulating CHI3L1 concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0033107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003112"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of proteinogenic amino acid in the blood circulation.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-08-29T11:59:15Z</terms:date>
        <oboInOwl:hasExactSynonym>Abnormal circulating proteinogenic amino acid concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal proteinogenic amino acid level</oboInOwl:hasExactSynonym>
        <rdfs:comment>Proteinogenic amino acids are the 23 alpha-amino acids that are precursors to proteins, and are incorporated into proteins during translation. The group includes the 20 amino acids encoded by the nuclear genes of eukaryotes together with selenocysteine, pyrrolysine, and N-formylmethionine.</rdfs:comment>
        <rdfs:label>Abnormal circulating proteinogenic amino acid concentration</rdfs:label>
    </owl:Class>
    



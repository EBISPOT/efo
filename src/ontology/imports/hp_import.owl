        <oboInOwl:hasDbXref>NCIT:C3869</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:21191518</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011012"/>
        <obo:IAO_0000115>A deviation from the normal concentration of hyaluronic acid in the blood.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-02T11:00:02Z</terms:date>
        <rdfs:comment>Serum hyaluronic acid (HA) is considered to be a marker of liver function. HA is a glycosaminoglycan that is rapidly cleared from the circulation by the liver via receptor mediated endocytosis into sinusoidal endothelial cells.</rdfs:comment>
        <rdfs:label>Abnormal circulating hyaluronic acid concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031210"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A deviation from the normal concentration of hyaluronic acid in the blood.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:11861239</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003107"/>
        <obo:IAO_0000115>An elevated concentration of circulating cholesterol esters, which are fatty acid esters of cholesterol and make up about two-thirds of total plasma cholesterol.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-02T11:04:47Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0500010</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>Elevated cholesteryl ester level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased cholesterol esters</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased cholesteryl esters</oboInOwl:hasExactSynonym>
        <rdfs:comment>The accumulation of cholesterol esters in the arterial intima is a characteristic feature of atherosclerosis.</rdfs:comment>
        <rdfs:label>Elevated cholesterol ester level</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033799"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-02T11:20:51Z</terms:date>
        <rdfs:label>Abnormal circulating progesterone level</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031212"/>
        <obo:IAO_0000115>An elevated concentration of progesterone in the blood.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-02T11:33:47Z</terms:date>
        <rdfs:label>Increased circulating progesterone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025142"/>
        <obo:IAO_0000115>Sudden feelings of warmth that are generally most pronounced over the face, neck and chest.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-02T11:38:24Z</terms:date>
        <rdfs:comment>Hot flashes are most commonly due to menopause but may be observed with other conditions.</rdfs:comment>
        <rdfs:label>Hot flashes</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034590"/>
        <obo:IAO_0000115>The concentration of thyroxine-binding globulin in the blood circulation is above the upper limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-07-02T12:03:22Z</terms:date>
        <oboInOwl:hasExactSynonym>Elevated circulating thyroxine-binding globulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated thyroxine-binding globulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated thyroxine-binding globulin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated thyroxine-binding globulin level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased thyroxine-binding globulin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased thyroxine-binding globulin level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased thyroxine-binding globulin level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Thyroxine-binding globulin high in blood</oboInOwl:hasExactSynonym>
        <rdfs:comment>Thyroxine-binding globulin is one of the proteins that binds thyroid hormones in the circulation.</rdfs:comment>
        <rdfs:label>Elevated circulating thyroxine-binding globulin concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010981"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031887"/>
        <obo:IAO_0000115>Reduced plasma concentrations of chylomicrons, the large lipid droplet (up to 100 mm in diameter) of reprocessed lipid synthesized in epithelial cells of the small intestine and containing triacylglycerols, cholesterol esters, and several apolipoproteins.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-08T11:26:34Z</terms:date>
        <oboInOwl:hasExactSynonym>Decreased circulating chylomicron levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypochylomicronemia</oboInOwl:hasExactSynonym>
        <rdfs:label>Decreased circulating chylomicron concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010981"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031889"/>
        <obo:IAO_0000115>The concentration of very-low-density lipoprotein cholesterol in the blood circulation is below the lower limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-08T11:27:32Z</terms:date>
        <oboInOwl:hasExactSynonym>Decreased circulating VLDL-C concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased circulating very-low-density lipoprotein levels</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased very-low-density lipoprotein cholesterol concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased very-low-density lipoprotein cholesterol level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased very-low-density lipoprotein cholesterol level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced very-low-density lipoprotein cholesterol concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced very-low-density lipoprotein cholesterol level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced very-low-density lipoprotein cholesterol level in blood</oboInOwl:hasExactSynonym>
        <rdfs:label>Decreased circulating VLDL-C concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012735"/>
        <obo:IAO_0000115>A type of cough characterized by a burst of numerous and rapid coughs followed by a long inhaling effort that is accompanied by a high-pitched whooping sound produced by the inhalation of air.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-12T13:22:51Z</terms:date>
        <rdfs:comment>The term whooping cough is usually used to describe the disease caused by infection of the respiratory tract with Bordatella pertussis. This HPO term refers to the major symptom of that disease.</rdfs:comment>
        <rdfs:label>Whooping cough</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031247"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of cough characterized by a burst of numerous and rapid coughs followed by a long inhaling effort that is accompanied by a high-pitched whooping sound produced by the inhalation of air.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:24219484</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001289"/>
        <obo:IAO_0000115>A state of sudden and severe confusion.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6262-8264"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9446-5121"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1592-0825"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4672-4923"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5554-6946"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7367-663X"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-12T16:00:36Z</terms:date>
        <oboInOwl:hasExactSynonym>Altered consciousness or cognition</oboInOwl:hasExactSynonym>
        <rdfs:label>Delirium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011035"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012575"/>
        <obo:IAO_0000115>Any anomalous structure of the renal corpuscle, which is the initial component of the nephron that filters blood. The renal corpuscle consists of a knot of capillaries (glomerulus) that is surrounded by a double-walled capsule (Bowman capsule) that opens into a renal tubule.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-12T18:30:25Z</terms:date>
        <rdfs:label>Abnormal renal corpuscle morphology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011025"/>
        <obo:IAO_0000115>The state in which profound and widespread reduction of effective tissue perfusion leads first to reversible, and then if prolonged, to irreversible cellular injury.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-12T20:50:38Z</terms:date>
        <rdfs:label>Shock</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011354"/>
        <obo:IAO_0000115>Recurrent episodes of redness of the skin together with a sensation of warmth or burning of the affected areas of skin.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-13T20:14:18Z</terms:date>
        <rdfs:comment>Flushing can occur on the face, neck and, less frequently, the upper trunk and abdomen.</rdfs:comment>
        <rdfs:label>Flushing</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011123"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032251"/>
        <obo:IAO_0000115>A circumscribed area of pus or necrotic debris in the skin (within the epidermis or dermis).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-13T21:21:54Z</terms:date>
        <oboInOwl:hasExactSynonym>Skin abscess</oboInOwl:hasExactSynonym>
        <rdfs:label>Cutaneous abscess</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031292"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Skin abscess</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031295 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025579"/>
        <obo:IAO_0000115>Increase in size of the left atrium.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-13T21:38:04Z</terms:date>
        <oboInOwl:hasDbXref>Fyler:3011</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Fyler:3020</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Enlarged heart left atrium</oboInOwl:hasExactSynonym>
        <rdfs:label>Left atrial enlargement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025465"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of properdin in the blood circulation.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-13T22:01:48Z</terms:date>
        <oboInOwl:hasExactSynonym>Abnormal circulating properdin concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal properdin level</oboInOwl:hasExactSynonym>
        <rdfs:comment>There are three pathways of complement activation, the classical pathway, lectin pathway, and alternative pathway. Each generates a C3 convertase, a serine protease that cleaves the central complement protein, C3. Nearly all the biological consequences of complement are dependent on the resulting cleavage products. Properdin is a positive regulator of complement activation that stabilizes the alternative pathway convertases (C3bBb). Properdin is composed of multiple identical protein subunits, with each subunit carrying a separate ligand-binding site.</rdfs:comment>
        <rdfs:label>Abnormal circulating properdin concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003207"/>
        <obo:IAO_0000115>An accumulation of calcium and phosphate in arteries with mineral deposits in the intimal or medial layer of the vessel wall.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2017-08-26T20:56:01Z</terms:date>
        <oboInOwl:hasExactSynonym>Peripheral artery calcification</oboInOwl:hasExactSynonym>
        <rdfs:comment>Peripheral arterial calcification can be observed on radiographs and may be classified as either medial (linear calcifications in a train-track pattern) or atherosclerotic (distinct, nodular calcifications). A number of other techniques may also be used to detect peripheral arterial calcification including computed tomographic (CT) and magnetic resonance (MR) imaging, duplex ultrasonography, measurement of pulse wave velocity, echocardiography, planar radiographs, and indirectly, the ankle-brachial index. A discussion on the ontological description of peripheral arterial calcification can be found here: https://github.com/obophenotype/human-phenotype-ontology/issues/6877.</rdfs:comment>
        <rdfs:label>Peripheral arterial calcification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031301"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An accumulation of calcium and phosphate in arteries with mineral deposits in the intimal or medial layer of the vessel wall.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:24402839</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:26811161</oboInOwl:hasDbXref>
    </owl:Axiom>
    



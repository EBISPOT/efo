    <!-- http://purl.obolibrary.org/obo/HP_0100324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0100324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001072"/>
        <obo:IAO_0000115>A chronic autoimmune phenomenon characterized by fibrosis (or hardening) and vascular alterations of the skin.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-08-10T04:14:42Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0001594</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007426</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:403524003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:89155008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0011644</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1274865</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Progressive systemic scleroderma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pseudoscleroderma</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0100324</oboInOwl:id>
        <rdfs:comment>A chronic autoimmune phenomenon characterised by fibrosis (or hardening), vascular alterations, and autoantibodies. Sclerosis of the skin occurs in association with disorders as diverse as mixed connective tissue disease and systemic sclerosis. This term is intended to represent the phenotypic feature scleroderma rather than a particular disease.</rdfs:comment>
        <rdfs:label>Scleroderma</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0100324"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A chronic autoimmune phenomenon characterized by fibrosis (or hardening) and vascular alterations of the skin.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
    </owl:Axiom>
    



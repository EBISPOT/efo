        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#uk_spelling"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0040228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0040228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010990"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032312"/>
        <obo:IAO_0000115>The concentration of plasminogen in the blood circulation is below the lower limit of normal.</obo:IAO_0000115>

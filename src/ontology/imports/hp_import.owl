    <!-- http://purl.obolibrary.org/obo/HP_0002375 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002374"/>
        <obo:IAO_0000115>Abnormally diminished motor activity. In contrast to paralysis, hypokinesia is not characterized by a lack of motor strength, but rather by a poverty of movement. The typical habitual movements (e.g., folding the arms, crossing the legs) are reduced in frequency.</obo:IAO_0000115>

    <!-- http://purl.obolibrary.org/obo/HP_0010926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000518"/>
        <obo:IAO_0000115>A kind of nuclear cataract characterized by fiberglasslike or needlelike crystals projecting in different directions, through or close to the axial region of the lens.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-12-19T03:47:35Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C1861832</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Fasciculiform cataract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Frosted cataract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Needle-shaped cataract</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0010926</oboInOwl:id>
        <rdfs:comment>This phenotype is characterized by fiberglasslike or needlelike crystals projecting in different directions, through or close to the axial region of the lens. Some crystals may be 11 mm in length, and their biochemical composition is not known. This type of cataract is considered to be different from the corraliform cataract, which does not show the needlelike projections. This opacity does not appear to respect the sutures or the direction of the lens fibers (Francois 1963) and appears to originate from the fetal and postnatal nuclei, suggesting a congenital origin with some postnatal progression, if any. See Figure 1 of PMID:10521291.</rdfs:comment>
        <rdfs:label>Aculeiform cataract</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010926"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A kind of nuclear cataract characterized by fiberglasslike or needlelike crystals projecting in different directions, through or close to the axial region of the lens.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:10521291</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:9718335</oboInOwl:hasDbXref>
    </owl:Axiom>
    



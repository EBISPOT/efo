    <!-- http://purl.obolibrary.org/obo/HP_0001284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001315"/>
        <obo:IAO_0000115>Absence of neurologic reflexes such as the knee-jerk reaction.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001314</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Absent reflexes</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>SNOMEDCT_US:349006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:37280007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0234146</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0241772</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0278124</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Absent deep tendon reflexes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Absent tendon reflexes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Deep tendon reflexes absent</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Loss of deep tendon reflexes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lost deep tendon reflexes</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001284</oboInOwl:id>
        <rdfs:comment>The stretch reflexes (also called deep tendon reflexes) include the knee-jerk reflex (patellar reflex, the biceps reflex, the triceps reflex, and the ankle jerk reflex or Achilles tendon reflex).</rdfs:comment>
        <rdfs:label>Areflexia</rdfs:label>
    </owl:Class>

        <owl:annotatedTarget>Low or weak muscle tone</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-6548-5200"/>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025780"/>
        <obo:IAO_0000115>A state of fatigue, either physical or mental slowness and sluggishness, with difficulties in initiating or performing simple tasks. Distinguished from apathy which implies indifference and a lack of desire or interest in the task. A person with lethargy may have the desire, but not the energy to engage in personal or socially relevant tasks.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6262-8264"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9446-5121"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1592-0825"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4672-4923"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5554-6946"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7367-663X"/>
        <oboInOwl:hasDbXref>SNOMEDCT_US:214264003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0023380</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Dullness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inactivity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Languor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Lethargy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Slowness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Torpor</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001254</oboInOwl:id>
        <rdfs:comment>Apathy and lethargy may co-occur.</rdfs:comment>
        <rdfs:label>Lethargy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001254"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Lethargy</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001249"/>
        <obo:IAO_0000115>Mild intellectual disability (ID) is defined as a type of ID characterized by mildly sub-average adaptive functioning and intellectual functioning, with an intelligence quotient (IQ) the range of 50-69.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0006908</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007119</oboInOwl:hasAlternativeId>

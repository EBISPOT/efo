    <!-- http://purl.obolibrary.org/obo/HP_0001328 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012759"/>
        <obo:IAO_0000115>Impairment of certain skills such as reading or writing, coordination, self-control, or attention that interfere with the ability to learn. The impairment is not related to a global deficiency of intelligence.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0007234</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4025790</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0001328</oboInOwl:id>
        <rdfs:comment>The term learning disability is used with different meanings in different contexts. Significant impairments of mental functioning with a reduction in IQ below 70 should be coded as mental retardation.</rdfs:comment>
        <rdfs:label>Specific learning disability</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001328"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Impairment of certain skills such as reading or writing, coordination, self-control, or attention that interfere with the ability to learn. The impairment is not related to a global deficiency of intelligence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002060"/>
        <obo:IAO_0000115>Absence of the septum pellucidum (meaning translucent wall in Latin - SP), also known as the ventricle of Sylvius. The septum pellucidum is a thin, triangular double membrane separating the frontal horns of the right and left lateral ventricles of the brain. It extends between the anterior portion of the corpus callosum, and the body of the fornix and its width varies from 1.5 to 3.0 mm.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0006969</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:253143001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0431371</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Absence of septum pellucidum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Absence of the septum pellucidum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Agenesis of the septum pellucidum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Missing septum pellucidum</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001331</oboInOwl:id>
        <rdfs:comment>In contrast to the septum pellucidum, the cavum septum pellucidum (CSP) is a potential cavity between the membranous leaves of the septum pellucidum, separated by at least 1 mm, and is considered a normal anatomical variation.</rdfs:comment>
        <rdfs:label>Absent septum pellucidum</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001331"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Absence of the septum pellucidum (meaning translucent wall in Latin - SP), also known as the ventricle of Sylvius. The septum pellucidum is a thin, triangular double membrane separating the frontal horns of the right and left lateral ventricles of the brain. It extends between the anterior portion of the corpus callosum, and the body of the fornix and its width varies from 1.5 to 3.0 mm.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:30725733</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001331"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Missing septum pellucidum</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-6548-5200"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001332 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100022"/>
        <obo:IAO_0000115>An abnormally increased muscular tone that causes fixed abnormal postures. There is a slow, intermittent twisting motion that leads to exaggerated turning and posture of the extremities and trunk.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002328</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C0013421</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4020871</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Dystonic movements</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Dystonic disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0001332</oboInOwl:id>
        <rdfs:label>Dystonia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001332"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An abnormally increased muscular tone that causes fixed abnormal postures. There is a slow, intermittent twisting motion that leads to exaggerated turning and posture of the extremities and trunk.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004305"/>
        <obo:IAO_0000115>Very brief, involuntary random muscular contractions occurring at rest, in response to sensory stimuli, or accompanying voluntary movements.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002535</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007087</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Jerking</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>SNOMEDCT_US:127324008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:17450006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0027066</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1854302</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Myoclonic jerks</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Involuntary jerking movements</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0001336</oboInOwl:id>
        <rdfs:comment>Myoclonus may be synchronous (several muscle contracting simultaneously), spreading (several muscles contracting in sequence), or asynchronous (several muscles contracting with varying and unpredictable relative timing). Myoclonus is characterized by sudden unidirectional movement due to muscle contraction (positive myoclonus) or due to sudden brief muscle relaxation (negative myoclonus). Electrophysiological tests are very helpful in determining whether myoclonus is cortical, subcortical or spinal.</rdfs:comment>
        <rdfs:label>Myoclonus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001336"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Very brief, involuntary random muscular contractions occurring at rest, in response to sensory stimuli, or accompanying voluntary movements.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:20589866</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget>Jerking</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004305"/>
        <obo:IAO_0000115>An unintentional, oscillating to-and-fro muscle movement about a joint axis.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001295</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001309</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:26079004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0040822</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Tremor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tremors</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001337</oboInOwl:id>
        <rdfs:comment>Tremor is differentiated from other involuntary movement disorders, such as chorea, athetosis, ballism, tics, and myoclonus, by its repetitive, stereotyped movements of a regular amplitude and frequency. Clonus, unlike tremor, represents a rhythmic movement, which is increased by muscle stretching.</rdfs:comment>
        <rdfs:label>Tremor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An unintentional, oscillating to-and-fro muscle movement about a joint axis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:16344298</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20589866</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

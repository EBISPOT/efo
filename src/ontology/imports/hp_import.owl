    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001103"/>
        <obo:IAO_0000115>A so-called macular coloboma is characterized by a sharply defined, usually excavated, area without neuroretina and RPE tissues in the central area of the fundus. This lesion is not related to classical colobomas associated with optic fissure closure defects.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C1852767</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Coloboma of the macula</oboInOwl:hasExactSynonym>

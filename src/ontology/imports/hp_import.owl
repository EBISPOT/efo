    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000436"/>
        <obo:IAO_0000115>Increase in width of the nasal tip.</obo:IAO_0000115>

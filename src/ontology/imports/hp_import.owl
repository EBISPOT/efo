        <oboInOwl:hasExactSynonym>Asymmetric pupil sizes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Asymmetry of the pupils</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Unequal pupil dilatation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Unequal pupil size</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0009916</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>Pathologic anisocoria can reflect an abnormality of the musculature of the iris or of the sympathetic or prasympathetic innervation of the iris.</rdfs:comment>
        <rdfs:label>Anisocoria</rdfs:label>
    </owl:Class>

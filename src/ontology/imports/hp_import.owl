    <!-- http://purl.obolibrary.org/obo/HP_0004390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0004390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002242"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010566"/>

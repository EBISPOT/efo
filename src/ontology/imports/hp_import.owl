        <oboInOwl:hasExactSynonym>Decreased cystatin C level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased cystatin-C concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased cystatin-C level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased cystatin-C level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced cystatin-C concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced cystatin-C level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced cystatin-C level in blood</oboInOwl:hasExactSynonym>
        <rdfs:label>Decreased circulating cystatin-C concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032998 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032996"/>
        <obo:IAO_0000115>The concentration of cystatin-C in the blood circulation is above the upper limit of normal.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-8169-9049"/>

        <obo:IAO_0000115>Focal proliferation of glial cells in the basal ganglia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C1864114</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C2750915</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Gliosis in the basal ganglia</oboInOwl:hasExactSynonym>

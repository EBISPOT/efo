        <oboInOwl:hasExactSynonym>Hooked nose</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polly beak nasal deformity</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000444</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:label>Convex nasal ridge</rdfs:label>

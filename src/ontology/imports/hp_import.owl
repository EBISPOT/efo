    <!-- http://purl.obolibrary.org/obo/HP_0012418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0500165"/>
        <obo:IAO_0000115>An abnormally low level of blood oxygen.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-11-10T05:07:07Z</terms:date>

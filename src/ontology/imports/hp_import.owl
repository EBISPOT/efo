    <!-- http://purl.obolibrary.org/obo/HP_0001427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034345"/>
        <obo:IAO_0000115>A mode of inheritance that is observed for traits related to a gene encoded on the mitochondrial genome. Because the mitochondrial genome is essentially always maternally inherited, a mitochondrial condition can only be transmitted by females, although the condition can affect both sexes. The proportion of mutant mitochondria can vary (heteroplasmy).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001431</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001458</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001506</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C0887941</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Mitochondrial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mitochondrial</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001427</oboInOwl:id>
        <rdfs:label>Mitochondrial inheritance</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001427"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mode of inheritance that is observed for traits related to a gene encoded on the mitochondrial genome. Because the mitochondrial genome is essentially always maternally inherited, a mitochondrial condition can only be transmitted by females, although the condition can affect both sexes. The proportion of mutant mitochondria can vary (heteroplasmy).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    <owl:Axiom>

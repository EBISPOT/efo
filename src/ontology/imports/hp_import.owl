    <!-- http://purl.obolibrary.org/obo/HP_0010864 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001249"/>
        <obo:IAO_0000115>Severe intellectual disability (ID) is defined as a type of ID characterized by severely sub-average adaptive functioning and intellectual functioning, with an intelligence quotient (IQ) the range of 20-34.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-08-03T06:29:35Z</terms:date>

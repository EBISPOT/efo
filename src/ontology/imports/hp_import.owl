    <!-- http://purl.obolibrary.org/obo/HP_0007720 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100691"/>
        <obo:IAO_0000115>Cornea plana is an abnormally flat shape of the cornea such that the normal protrusion of the cornea from the sclera is missing. The reduced corneal curvature can lead to hyperopia, and a hazy corneal limbus and arcus lipoides may develop at an early age.</obo:IAO_0000115>

    <!-- http://purl.obolibrary.org/obo/HP_0000191 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000163"/>
        <obo:IAO_0000115>Extra fold of tissue extending from the alveolar ridge to the inner surface of the upper or lower lip.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4021814</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Accessory oral frenum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Extra oral frenulum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Extra oral frenum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Multiple oral frenula</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Supernumerary oral frenulum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Supernumerary oral frenum</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000191</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This finding is assessed by gently retracting the oral mucosa from the alveolar ridge. Typically there is a single maxillary and a single mandibular frenulum located in the midline between the two central incisors. Abnormalities of the alveolar ridges may accompany accessory frenula, but these should be assessed separately.</rdfs:comment>
        <rdfs:label>Accessory oral frenulum</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000191"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Extra fold of tissue extending from the alveolar ridge to the inner surface of the upper or lower lip.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:19125428</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011337"/>
        <obo:IAO_0000115>Distance between the commissures of the mouth more than 2 SD below the mean. Alternatively, an apparently decreased width of the oral aperture (subjective).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002261</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0009095</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0009096</oboInOwl:hasAlternativeId>

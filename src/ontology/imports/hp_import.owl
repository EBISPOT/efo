    <!-- http://purl.obolibrary.org/obo/HP_0003487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0003487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0007256"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031826"/>
        <obo:IAO_0000115>Upturning of the big toe (and sometimes fanning of the other toes) in response to stimulation of the sole of the foot. If the Babinski sign is present it can indicate damage to the corticospinal tract.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001352</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:246586009</oboInOwl:hasDbXref>

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0500165"/>
        <obo:IAO_0000115>An abnormally high level of blood oxygen.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

        <obo:IAO_0000115>A loss of the ability to move the vocal folds.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001606</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0006847</oboInOwl:hasAlternativeId>

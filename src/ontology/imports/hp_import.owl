    <!-- http://purl.obolibrary.org/obo/HP_0034251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0034251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012373"/>
        <obo:IAO_0000115>An anomaly of the corneal reflex that normally induces involuntary blinking of the eyelids following contact of the cornea.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-04-23T11:42:49Z</terms:date>
        <rdfs:comment>The corneal reflex can be tested by touching the cornea lightly with a cotton tip. The normal response to to blink (shut the eyelids) immediately. To evaluate the corneal reflex, the examiner uses a cotton-tipped applicator, the tip of which has been pulled into a thin strand. The examiner stabilizes the patient&apos;s head by placing a hand on the patient&apos;s eyebrow and head. The patient is asked to look to the left side as the cotton tip is brought in from the right side to touch the right cornea gently.</rdfs:comment>
        <rdfs:label>Abnormal corneal reflex</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0034251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An anomaly of the corneal reflex that normally induces involuntary blinking of the eyelids following contact of the cornea.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:30480980</oboInOwl:hasDbXref>
    </owl:Axiom>
    



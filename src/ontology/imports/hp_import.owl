        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000929"/>
        <obo:IAO_0000115>A characteristic appearance resulting from defective ossification of craniofacial bones.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-03-18T09:58:00Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:28861008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0010273</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Crouzon syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0004439</oboInOwl:id>
        <rdfs:comment>Note: This term is used in the medical literature to describe an appearance of the face of patients with Crouzon syndrome (also called craniofacial dysostosis), which is characterized by acrocephaly, exophthalmos, hypertelorism, strabismus, parrot-beaked nose, and hypoplastic maxilla. This is thus probably mainly used as a bundled term and should be replaced by better descriptions in the future.</rdfs:comment>
        <rdfs:label>Craniofacial dysostosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0004439"/>

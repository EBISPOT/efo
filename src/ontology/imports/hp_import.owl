    <!-- http://purl.obolibrary.org/obo/HP_0000436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010938"/>
        <obo:IAO_0000115>An abnormality of the nasal tip.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UMLS:C4025852</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of the nasal tip</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of tip of nose</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Deformity of the nasal tip</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Deformity of tip of nose</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Malformation of the nasal tip</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Malformation of tip of nose</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>HP:0000436</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>The nasal tip is located at the junction of the inferior margin of the nasal ridge and the columella. Commonly, it is the part of the nose furthest from the plane of the face. In rare circumstances, such as markedly prominent and convex nasal profiles, other parts of the ridge may be further removed from the facial plane.</rdfs:comment>
        <rdfs:label>Abnormal nasal tip morphology</rdfs:label>
    </owl:Class>

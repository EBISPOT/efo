    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100886"/>
        <obo:IAO_0000115>An eye that is protruding anterior to the plane of the face to a greater extent than is typical.</obo:IAO_0000115>

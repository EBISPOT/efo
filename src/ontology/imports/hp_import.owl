    <!-- http://purl.obolibrary.org/obo/HP_0000037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000032"/>
        <obo:IAO_0000115>Hermaphroditism refers to a discrepancy between the morphology of the gonads and that of the external genitalia. In male pseudohermaphroditism, the genotype is male (XY) and the external genitalia are imcompletely virilized, ambiguous, or complete female. If gonads are present, they are testes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:111332007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0238395</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0000037</oboInOwl:id>
        <rdfs:label>Male pseudohermaphroditism</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Hermaphroditism refers to a discrepancy between the morphology of the gonads and that of the external genitalia. In male pseudohermaphroditism, the genotype is male (XY) and the external genitalia are imcompletely virilized, ambiguous, or complete female. If gonads are present, they are testes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000036"/>
        <obo:IAO_0000115>Penile length more than 2 SD above the mean for age.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:88673001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0269011</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Enlarged penis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Long penis</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000040</oboInOwl:id>
        <rdfs:comment>Penile length is the distance between the midline attachment of the gently stretched, flaccid penis above the pubic symphysis and tip of the glans.</rdfs:comment>
        <rdfs:label>Long penis</rdfs:label>
    </owl:Class>

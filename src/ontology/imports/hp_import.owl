    <!-- http://purl.obolibrary.org/obo/HP_0001935 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010972"/>
        <obo:IAO_0000115>A kind of anemia in which the volume of the red blood cells is reduced.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:234349007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0085576</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Microcytic anaemia</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001935</oboInOwl:id>
        <rdfs:comment>In normocytic anemia, the mean corpuscular volume (MCV) is below normal limits (&gt;80 fl in adults).</rdfs:comment>
        <rdfs:label>Microcytic anemia</rdfs:label>
    </owl:Class>

    <!-- http://purl.obolibrary.org/obo/HP_0004279 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0004279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001155"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0005927"/>
        <obo:IAO_0000115>Short palm.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001165</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1843108</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Short palm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Hypoplastic hands</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Short hands</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Short palms</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0004279</oboInOwl:id>
        <rdfs:comment>This term refers to a developmental finding resulting in short palms. This term is reserved for individuals with shortening of all four metacarpals 2-5. Individuals with fewer than four shortened metacarpals (in a eudactylous hand, the metacarpals of F2-5) should be coded as Metacarpal, short. See the entry for Hand, small for a discussion of this finding. &quot;Short hand&quot; should not be used as it is a bundle of two readily separable terms, Fingers, short (which, as noted above, can itself be a bundled term) and Palm, short.</rdfs:comment>
        <rdfs:label>Short palm</rdfs:label>
    </owl:Class>
    <owl:Axiom>

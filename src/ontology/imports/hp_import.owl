    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0003534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012379"/>
        <obo:IAO_0000115>An abnormal reduction in xanthine dehydrogenase level.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:124147007</oboInOwl:hasDbXref>

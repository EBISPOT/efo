        <oboInOwl:hasExactSynonym>Pterygium colli</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Webbed neck</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000465</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:label>Webbed neck</rdfs:label>

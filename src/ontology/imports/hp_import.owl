        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>The American Optometric Association subdivides hypermetropia into (i) low (up to +2D), moderate (2 to 5D), and high (over 5D).</rdfs:comment>
        <rdfs:label>Hypermetropia</rdfs:label>
    </owl:Class>

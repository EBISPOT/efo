        <oboInOwl:id>HP:0000294</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This feature gives the appearance of a short forehead. It is distinct from hirsutism of the forehead. In the latter, orientation of hair growth is lateral and texture and density of hair differs from scalp hair.</rdfs:comment>
        <rdfs:label>Low anterior hairline</rdfs:label>
    </owl:Class>

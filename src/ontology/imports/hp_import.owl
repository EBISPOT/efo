    <!-- http://purl.obolibrary.org/obo/HP_0011298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011121"/>
        <obo:IAO_0000115>A soft tissue prominence of the ventral aspects of the fingertips or toe tips.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-02-11T07:18:29Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C4023424</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Prominent digit pad</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0011298</oboInOwl:id>
        <rdfs:comment>The prominence of the finger or toe pads varies throughout life, being greater in neonates and dependent on the state of hydration. This term should not be used if the digit has clubbing. Note that the synonym &quot;fetal fingertip pads&quot; should not be interpreted to mean that the prominent pad necessarily was present in this individual since fetal life. We do not endorse the use of the term &quot;Persistent fetal pads&quot; as this term implies knowledge of the natural history of this finding, which may or may not be known.</rdfs:comment>
        <rdfs:label>Prominent digit pad</rdfs:label>
    </owl:Class>
    <owl:Axiom>

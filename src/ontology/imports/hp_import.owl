        <obo:IAO_0000115>Delayed myelination in the central nervous system.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0005770</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0006974</oboInOwl:hasAlternativeId>

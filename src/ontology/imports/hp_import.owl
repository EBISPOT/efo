    <!-- http://purl.obolibrary.org/obo/HP_0011841 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001649"/>
        <obo:IAO_0000115>A potentially lethal cardiac arrhythmia characterized by an extremely rapid, hemodynamically unstable ventricular tachycardia (150-300 beats/min) with a large oscillating sine-wave appearance.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-05-06T06:46:54Z</terms:date>

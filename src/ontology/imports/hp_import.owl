        <oboInOwl:hasExactSynonym>Decreased creatine kinase level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Decreased creatine kinase level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced creatine kinase concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced creatine kinase level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Reduced creatine kinase level in blood</oboInOwl:hasExactSynonym>

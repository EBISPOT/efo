    <!-- http://purl.obolibrary.org/obo/HP_0001344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000750"/>
        <obo:IAO_0000115>Complete lack of development of speech and language abilities.</obo:IAO_0000115>

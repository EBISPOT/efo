    <!-- http://purl.obolibrary.org/obo/HP_0002714 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011338"/>
        <obo:IAO_0000115>A morphological abnormality of the mouth in which the angle of the mouth is downturned. The oral commissures are positioned inferior to the midline labial fissure.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0000192</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C1866195</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Downturned corners of mouth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Downturned corners of the mouth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Downturned mouth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Downturned oral commisures</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002714</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>This finding should be assessed with the mouth closed, the lips in relaxed contact, and the face relaxed. The finding may be difficult to assess if the lower lip is enlarged. Previous terms for downturned corners of mouth included Carp mouth andFish mouth which are no longer recommended (pejorative terms).</rdfs:comment>
        <rdfs:label>Downturned corners of mouth</rdfs:label>
    </owl:Class>
    <owl:Axiom>

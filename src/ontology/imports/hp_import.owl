    <!-- http://purl.obolibrary.org/obo/HP_0000272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010668"/>
        <obo:IAO_0000115>Underdevelopment of the malar prominence of the jugal bone (zygomatic bone in mammals), appreciated in profile, frontal view, and/or by palpation.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0000312</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0000332</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0004642</oboInOwl:hasAlternativeId>

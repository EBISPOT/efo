        <oboInOwl:hasDbXref>UMLS:C0086543</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1510497</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Cataracts</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Clouding of the lens of the eye</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cloudy lens</oboInOwl:hasExactSynonym>

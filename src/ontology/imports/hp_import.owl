        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003256"/>
        <obo:IAO_0000115>An abnormality of coagulation related to a decreased concentration of vitamin K-dependent protein S. Protein S is a cofactor of protein C.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:1563006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0242666</oboInOwl:hasDbXref>

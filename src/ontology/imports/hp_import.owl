    <!-- http://purl.obolibrary.org/obo/HP_0001339 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002536"/>
        <obo:IAO_0000115>A spectrum of malformations of cortical development caused by insufficient neuronal migration that subsumes the terms agyria, pachygyria and subcortical band heterotopia. See also neuropathological definitions for 2-, 3-, and 4-layered lissencephaly.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002537</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:204036008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0266463</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1879312</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Fewer or absent grooves in brain</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001339</oboInOwl:id>
        <rdfs:comment>Lissencephaly (LIS, which subsumes the terms agyria and pachygyria), together with subcortical-band heterotopia (SBH) comprises a spectrum of malformations of cortical development caused by insufficient neuronal migration. The key features of LIS are an abnormally thick cortex with reduced or absent formation of the cerebral convolutions, while SBH consists of abnormal bands of neurons beneath a normal cortex, although the cerebral gyri may be separated by unusually shallow sulci.</rdfs:comment>
        <rdfs:label>Lissencephaly</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001339"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A spectrum of malformations of cortical development caused by insufficient neuronal migration that subsumes the terms agyria, pachygyria and subcortical band heterotopia. See also neuropathological definitions for 2-, 3-, and 4-layered lissencephaly.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="http://www.wikidata.org/entity/Q90573458"/>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <oboInOwl:hasDbXref>PMID:28440899</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

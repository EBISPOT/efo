    <!-- http://purl.obolibrary.org/obo/HP_0025102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0025102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002134"/>

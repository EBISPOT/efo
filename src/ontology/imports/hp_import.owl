    <!-- http://purl.obolibrary.org/obo/HP_0006292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0006292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000164"/>
        <obo:IAO_0000115>An abnormality of tooth eruption.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:1086101000119107</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:234949000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0012767</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1859363</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C3874458</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormal dental eruption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormality of tooth eruption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Anomaly of dental eruption</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Anomaly of tooth eruption</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Disorder of dental eruption</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Disorder of tooth eruption</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>Disturbance of dental eruption</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Disturbance of tooth eruption</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0006292</oboInOwl:id>
        <rdfs:comment>The average ages for eruption of the primary teeth are: 6 months: lower central incisor, 7 months: upper central incisor, 8 months: upper lateral incisor, 9 months: lower lateral incisor, 12 months first molars, 18 months, canines, 2 years, second molars.</rdfs:comment>
        <rdfs:label>Abnormality of dental eruption</rdfs:label>
    </owl:Class>

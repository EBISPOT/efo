    <!-- http://purl.obolibrary.org/obo/HP_0002381 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002167"/>
        <obo:IAO_0000115>An acquired language impairment of some or all of the abilities to produce or comprehend speech and to read or write.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0002357</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:87486003</oboInOwl:hasDbXref>

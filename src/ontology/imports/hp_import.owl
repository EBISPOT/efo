    <!-- http://purl.obolibrary.org/obo/HP_0032464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025633"/>
        <obo:IAO_0000115>Underdevelopment of the ureter.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-04T09:26:25Z</terms:date>
        <oboInOwl:hasExactSynonym>Hypoplasia of the ureter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ureter hypoplasia</oboInOwl:hasExactSynonym>
        <rdfs:label>Ureteral hypoplasia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032464"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Underdevelopment of the ureter.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0001-5208-3432"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001197"/>
        <obo:IAO_0000115>It is estimated that about 40-70 percent of human embryos produced in vitro fertilization (IVF) and intracytoplasmic sperm injection (ICSI) are viable embryos, whereas others arrest at different early stages of development. The phenotype of preimplantation lethality is inferred if IVF and ICSI cycles fail because all of an individual&apos;s embryos are arrested at early stages of development.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-04-09T12:33:42Z</terms:date>
        <oboInOwl:hasExactSynonym>Early embryonic arrest</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Preimplantation embryonic lethality</oboInOwl:hasExactSynonym>
        <rdfs:label>Preimplantation lethality</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032479"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>It is estimated that about 40-70 percent of human embryos produced in vitro fertilization (IVF) and intracytoplasmic sperm injection (ICSI) are viable embryos, whereas others arrest at different early stages of development. The phenotype of preimplantation lethality is inferred if IVF and ICSI cycles fail because all of an individual&apos;s embryos are arrested at early stages of development.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:27545678</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100261"/>
        <obo:IAO_0000115>An abnormal increase in the thickness (diameter) of a tendon.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-05-26T11:35:27Z</terms:date>
        <rdfs:label>Tendon thickening</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An abnormal increase in the thickness (diameter) of a tendon.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:24932450</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012373"/>
        <obo:IAO_0000115>An abnormal decrease of the pressure within the eye.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-12T10:37:45Z</terms:date>
        <oboInOwl:hasExactSynonym>Ocular hypotony</oboInOwl:hasExactSynonym>
        <rdfs:comment>Ocular hypotony is defined statistically as an intraocular pressure (IOP) of less than 6.5 mmHg, three standard deviations below the mean. Clinically significant hypotony is when the IOP is so low that there is resultant visual loss. Hypotony has also been described as low pressure in an individual eye, leading to functional changes and structural changes.</rdfs:comment>
        <rdfs:label>Low intraocular pressure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An abnormal decrease of the pressure within the eye.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:26253854</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000142"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-06-19T10:17:59Z</terms:date>
        <rdfs:comment>A breach of the continuity of the mucous membrane of the vagina caused by sloughing out of inflamed necrotic tissue, usually associated with eschars (slough or piece of dead tissue) and with violaceous to erythematous borders.</rdfs:comment>
        <rdfs:label>Vaginal mucosal ulceration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032565"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>A breach of the continuity of the mucous membrane of the vagina caused by sloughing out of inflamed necrotic tissue, usually associated with eschars (slough or piece of dead tissue) and with violaceous to erythematous borders.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18427055</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033354"/>
        <obo:IAO_0000115>A deviation from the normal level of a nucleobase in the urine. Nucleobases are nitrogen-containing biological compounds that form nucleosides: adenine (A), cytosine (C), guanine (G), thymine (T), and uracil (U).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-10T07:58:17Z</terms:date>
        <rdfs:label>Abnormal urinary nucleobase concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000091"/>
        <obo:IAO_0000115>Any structural anomaly of the renal tubular epithelial cells (RTEC), a layer of cells in the outer layer of the renal tubule. These cells play a role in the absorption of substances such as glucose and amino from the primary urine.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-12-22T09:54:52Z</terms:date>
        <rdfs:label>Abnormal renal tubular epithelial morphology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032640 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>The concentration of CCL18 in the blood circulation is above the upper limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-09T08:20:25Z</terms:date>
        <oboInOwl:hasExactSynonym>Elevated C-C motif chemokine 18 concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated C-C motif chemokine 18 level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated C-C motif chemokine 18 level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated circulating CCL18 concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased C-C motif chemokine 18 concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased C-C motif chemokine 18 level</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased C-C motif chemokine 18 level in blood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Increased C-C motif chemokine ligand 18 concentration</oboInOwl:hasExactSynonym>
        <rdfs:label>Elevated circulating CCL18 concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032647 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032599"/>
        <obo:IAO_0000115>Increased apoptosis (programmed cell death) of tubular epithelial cells. The cells are rounded with increased eosinophilia and contain fragmented, densely basophilic nuclear debris.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-09T09:38:49Z</terms:date>
        <rdfs:label>Renal tubular epithelial cell apoptosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032647"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Increased apoptosis (programmed cell death) of tubular epithelial cells. The cells are rounded with increased eosinophilia and contain fragmented, densely basophilic nuclear debris.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-2356-950X"/>
        <oboInOwl:hasDbXref>PMID:29537990</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032660 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001250"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002069"/>
        <obo:IAO_0000115>A type of status epilepticus characterized by a prolonged bilateral tonic-clonic seizure, or repeated bilateral tonic-clonic seizures without recovery between.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-02-22T11:14:28Z</terms:date>
        <oboInOwl:hasExactSynonym>Tonic-clonic status epilepticus</oboInOwl:hasExactSynonym>
        <rdfs:comment>In 2015, the ILAE Task Force on Classification of Status Epilepticus did proposed that time t1 (indicating the time that emergency treatment should be started because the seizure is unlikely to terminate spontaneously) is 5 minutes and t2 (the time at which long-term consequences of the seizure may be expected) is 30 minutes for convulsive (tonic-clonic) status epilepticus.This 5-minute timeframe has been endorsed by the 2012 Neurocritical Care Society Guidelines and the 2016 American Epilepsy Society Guidelines to guide when emergent treatment for convulsive status epilepticus should start. This term includes convulsive status epilepticus of focal, generalized or unknown onset.</rdfs:comment>
        <rdfs:label>Convulsive status epilepticus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032660"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of status epilepticus characterized by a prolonged bilateral tonic-clonic seizure, or repeated bilateral tonic-clonic seizures without recovery between.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-1735-8178"/>
        <oboInOwl:hasDbXref>PMID:22528274</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:26336950</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:26900382</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:9924914</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032807 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001250"/>
        <obo:IAO_0000115>A seizure occurring within the neonatal period (28 days beyond the full term date).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-17T06:23:05Z</terms:date>
        <rdfs:comment>This term encompasses clinical only (motor or non-motor without electrographic confirmation), electro-clinical and electrographic only seizures. Where the seizure also meets the definition of status epilepticus it should be coded twice.</rdfs:comment>
        <rdfs:label>Neonatal seizure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0032807"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A seizure occurring within the neonatal period (28 days beyond the full term date).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:28276060</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:33522601</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003110"/>
        <obo:IAO_0000115>A deviation of urine pH from the normal range of 4.5 to 7.8.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-03-22T17:17:31Z</terms:date>
        <rdfs:comment>Urine pH typically is 5 as a result of daily net acid excretion. The interpretation of the urine pH depends on the medical context.</rdfs:comment>
        <rdfs:label>Abnormal urine pH</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032996 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032996">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010876"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of cystatin-C in the blood circulation.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-8169-9049"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-09T08:08:53Z</terms:date>
        <oboInOwl:hasExactSynonym>Abnormal circulating cystatin-C concentration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Abnormal cystatin-C level</oboInOwl:hasExactSynonym>
        <rdfs:comment>The cysteine protease inhibitor cystatin C is thought to be secreted by most cells and eliminated in the kidneys, so its concentration in plasma is diagnostic of kidney function.</rdfs:comment>
        <rdfs:label>Abnormal circulating cystatin-C concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0032997 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0032997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0032996"/>
        <obo:IAO_0000115>The concentration of cystatin-C in the blood circulation is below the lower limit of normal.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-8169-9049"/>

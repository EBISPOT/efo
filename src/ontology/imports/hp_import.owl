    <!-- http://purl.obolibrary.org/obo/HP_0001830 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001830">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001780"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001829"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0010442"/>
        <obo:IAO_0000115>Polydactyly of the foot most commonly refers to the presence of six toes on one foot. Postaxial polydactyly affects the lateral ray and the duplication may range from a well-formed articulated digit to a rudimentary digit.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0010346</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C2112129</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4020865</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Extra toe attached near the little toe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Polydactyly affecting the 5th toe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Postaxial polydactyly of feet</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Postaxial polydactyly of foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Posterior polydactyly of foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Fibular polydactyly</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0001830</oboInOwl:id>
        <rdfs:comment>The modifier postaxial means that the supernumerary digit is not a hallux.</rdfs:comment>
        <rdfs:label>Postaxial foot polydactyly</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001830"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Polydactyly of the foot most commonly refers to the presence of six toes on one foot. Postaxial polydactyly affects the lateral ray and the duplication may range from a well-formed articulated digit to a rudimentary digit.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

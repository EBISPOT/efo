        <owl:annotatedTarget>A reduced concentration of zinc in the blood.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>HPO_CONTRIBUTOR:RGD_gthayman</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:16518702</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031844 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100851"/>
        <obo:IAO_0000115>Elevation of emotional tone or mood that significantly deviates from normative affective functioning. This state is characterized by an overwhelming and all-encompassing sense of joyous well-being; it is associated with unfounded grandiosity, or grossly inflated self-esteem, rapid speech, impulsivity, and an impaired capacity for self-regulation, irrespective of context.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1111-7357"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7954-5235"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-2897-0458"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4298-5074"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4618-6544"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-05-05T15:29:11Z</terms:date>
        <oboInOwl:hasAlternativeId>HP:0025767</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0025768</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>Hyperthymia</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Hyperthymic state</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>Jubilation</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>Euphoric mood</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Extreme elation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inappropriate elation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Abnormally elevated mood</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Excessive joyfulness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Inappropriately happy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pathological cheerfulness</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>Euphoria may be experienced in the course of normal human activity, including sporting victory, sexual, substance use, or communal spiritual experiences; all manifestations of euphoria refer to profound elation and positive mood experiences. Euphoria in the normal context, is typically very brief and short-lived. Severe pathological euphoria may last hours to days and frequently results in marked impairments in judgment, behavior, and social or occupational functioning.</rdfs:comment>
        <rdfs:label>Euphoria</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0031844"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Elevation of emotional tone or mood that significantly deviates from normative affective functioning. This state is characterized by an overwhelming and all-encompassing sense of joyous well-being; it is associated with unfounded grandiosity, or grossly inflated self-esteem, rapid speech, impulsivity, and an impaired capacity for self-regulation, irrespective of context.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:37636238</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031860 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011675"/>
        <obo:IAO_0000115>Any abnormality in the variability of the time interval between successive heartbeats.</obo:IAO_0000115>

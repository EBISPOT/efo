    <!-- http://purl.obolibrary.org/obo/HP_0031970 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0004364"/>
        <obo:IAO_0000115>Any deviation from the normal concentration of urea nitrogen in the blood.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

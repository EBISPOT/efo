    <!-- http://purl.obolibrary.org/obo/HP_0010885 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011843"/>
        <obo:IAO_0000115>A disease where there is cellular death (necrosis) of bone components due to interruption of the blood supply.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-24T10:11:05Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:240196003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:398199007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:72756009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0029445</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0085660</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0520474</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0877326</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Aseptic bone necrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Aseptic necrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bone infarction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Death of bone due to decreased blood supply</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ischaemic bone necrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ischemic bone necrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteochondronecrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Osteonecrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0010885</oboInOwl:id>
        <rdfs:comment>The interruption of the blood supply may have many different causes such as rapid growth, heredity causes, trauma or overuse, anatomic conformation, dietary imbalances or secondary effects of other diseases.</rdfs:comment>
        <rdfs:label>Avascular necrosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010885"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A disease where there is cellular death (necrosis) of bone components due to interruption of the blood supply.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0009-0006-4530-3154"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0010885"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Death of bone due to decreased blood supply</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-6548-5200"/>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>

        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0045010"/>
        <obo:IAO_0000115>Any structural anomaly of the glossopharyngeal nerve, the ninth paired cranial nerve (CN IX).</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0001-5208-3432"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-08-07T01:08:41Z</terms:date>

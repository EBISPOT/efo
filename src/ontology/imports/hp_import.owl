        <oboInOwl:hasDbXref>UMLS:C0034935</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Extensor plantar reflexes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Extensor plantar response</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Extensor plantar responses</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Positive Babinski sign</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0003487</oboInOwl:id>
        <rdfs:comment>A positive Babinski sign can indicate damage to the corticospinal tract.</rdfs:comment>
        <rdfs:label>Babinski sign</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0003487"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

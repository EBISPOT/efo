    <!-- http://purl.obolibrary.org/obo/HP_0000713 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_5200263"/>
        <obo:IAO_0000115>A state of excessive motor activity that is associated with mental distress or a feeling of substantial unease or inner tension. Distinguished from restlessness by the increased level of emotional distress and negative intensity of the experience. Agitation has a significant level of physical activity that is typically threatening to the self or others.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-8430-6039"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0736-9199"/>

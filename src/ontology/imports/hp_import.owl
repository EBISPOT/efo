    <!-- http://purl.obolibrary.org/obo/HP_0007894 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0031605"/>
        <obo:IAO_0000115>Generalized or focal reduced pigmentation of the fundus, evaluated in the context of skin and hair color. Fundoscopy may reveal a low level pigment.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0001111</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001487</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007680</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007746</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0007752</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>Decreased fundus pigmentation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Depigmented fundus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Hypopigmentation of the fundus</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0007894</oboInOwl:id>
        <rdfs:comment>Fundus hypopigmentation is consistently observed in albinism. Pigmentation is also reduced with age in some individuals, high myopia, and in chronic inflammation, such as Harada disease. Ocular pigmentation is essential for normal vision, and persons with ocular albinism tend to have severely reduced visual acuity often associated with nystagmus, strabismus, and photophobia.</rdfs:comment>
        <rdfs:label>Fundus hypopigmentation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007894"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Generalized or focal reduced pigmentation of the fundus, evaluated in the context of skin and hair color. Fundoscopy may reveal a low level pigment.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0003-0986-4123"/>
    </owl:Axiom>
    



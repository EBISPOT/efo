    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011119"/>
        <obo:IAO_0000115>Nasal ridge curving anteriorly to an imaginary line that connects the nasal root and tip. The nose appears often also prominent, and the columella low.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0003683</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C0240538</oboInOwl:hasDbXref>

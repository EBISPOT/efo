    <!-- http://purl.obolibrary.org/obo/HP_0010829 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010829">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003474"/>
        <obo:IAO_0000115>A reduced ability to discriminate between different temperatures.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-07-10T07:08:10Z</terms:date>

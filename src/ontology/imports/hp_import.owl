    <!-- http://purl.obolibrary.org/obo/HP_0011858 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0003256"/>
        <obo:IAO_0000115>Decreased activity of coagulation factor IX. Factor IX, which itself is activated by factor Xa or factor VIIa to form factor IXa, activates factor X into factor Xa.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2012-05-26T11:35:57Z</terms:date>

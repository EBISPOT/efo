    <!-- http://purl.obolibrary.org/obo/HP_0500149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0500149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0500148"/>
        <obo:IAO_0000115>Concentration of glutamate in the blood circulation above the upper limit of normal.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0001-7941-2961"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-04T14:29:35Z</terms:date>

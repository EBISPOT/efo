    <!-- http://purl.obolibrary.org/obo/HP_0012368 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0012368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001999"/>
        <obo:IAO_0000115>Absence of concavity or convexity of the face when viewed in profile.</obo:IAO_0000115>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-10-13T01:49:13Z</terms:date>
        <oboInOwl:hasDbXref>UMLS:C1853241</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Flat face</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flat facial profile</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flat facial shape</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Flat facies</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0012368</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:comment>A useful guide is to imagine that a line connecting the glabella to the anterior most part of the mandible touches the top of the philtrum where it meets the base of the columella. The glabella is the most prominent point on the frontal bone above the root of the nose. If the superior philtrum is anterior to this line the face is convex, if the superior philtrum is posterior to this line the face is concave.</rdfs:comment>
        <rdfs:label>Flat face</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0012368"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Absence of concavity or convexity of the face when viewed in profile.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:19125436</oboInOwl:hasDbXref>
    </owl:Axiom>

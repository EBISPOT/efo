        <oboInOwl:hasAlternativeId>HP:0004838</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0008175</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0008268</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0008302</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:302215000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:415116008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0040034</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0392386</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Low platelet count</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0001873</oboInOwl:id>
        <rdfs:comment>Thrombocytopenia can be divided into three major causes; 1) low production of platelets in the bone marrow; 2) intravascular breakdown of thrombocytes; and 3) increased turnover of platelets in spleen or liver (extravascular).</rdfs:comment>
        <rdfs:label>Thrombocytopenia</rdfs:label>
    </owl:Class>

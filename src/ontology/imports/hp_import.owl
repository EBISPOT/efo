        <oboInOwl:hasExactSynonym>Aspartate aminotransferase increased</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated serum AST</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated serum aspartate aminotransferase</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Elevated serum glutamic oxaloacetic transaminase</oboInOwl:hasExactSynonym>
        <rdfs:label>Elevated circulating aspartate aminotransferase concentration</rdfs:label>
    </owl:Class>
    <owl:Axiom>

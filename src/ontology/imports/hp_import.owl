    <!-- http://purl.obolibrary.org/obo/HP_0010535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0010535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002360"/>
        <obo:IAO_0000115>An intermittent cessation of airflow at the mouth and nose during sleep is known as sleep apnea. Apneas that last at least 10 seconds are considered significant, but individuals with sleep apnea may experience apneas lasting from 20 seconds up to 2 or 3 minutes. Patients may have up to 15 events per hour of sleep.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6262-8264"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9446-5121"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-1592-0825"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4672-4923"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-5554-6946"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7367-663X"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T08:53:35Z</terms:date>
        <oboInOwl:hasDbXref>SNOMEDCT_US:73430006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0037315</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Pauses in breathing while sleeping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sleep apnea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Sleep apnoea</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0010535</oboInOwl:id>
        <rdfs:label>Sleep apnea</rdfs:label>
    </owl:Class>

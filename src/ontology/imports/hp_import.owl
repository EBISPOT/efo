    <!-- http://purl.obolibrary.org/obo/HP_0000490 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100886"/>
        <obo:IAO_0000115>An eye that is more deeply recessed into the plane of the face than is typical.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>HP:0000663</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:246923005</oboInOwl:hasDbXref>

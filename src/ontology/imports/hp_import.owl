    <!-- http://purl.obolibrary.org/obo/HP_0007802 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0007802">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0001131"/>
        <obo:IAO_0000115>The presence of central, fine, whitish granular lesions in the stroma of the cornea. This type of corneal dystrophy is usually asymptomatic and begins in childhood and shows a slow progression. Later in the course, the corneal epithelium and Bowman&apos;s layer may be affected. Histologically, the cornea shows a uniform deposition of hyaline material.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US:45283008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0018179</oboInOwl:hasDbXref>
        <oboInOwl:id>HP:0007802</oboInOwl:id>
        <rdfs:label>Granular corneal dystrophy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0007802"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

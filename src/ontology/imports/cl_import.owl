        <oboInOwl:hasExactSynonym>memory B lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>memory B-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>memory B-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>Memory B-cells are also reportedly CD5-negative, CD10-negative, CD21-positive, CD22-positive, CD23-negative, CD24-positive, CD25-positive, CD27-positive, CD34-negative, CD38-negative, CD40-positive, CD43-negative, CD44-positive, CD45-positive, CD53-positive, CD80-negative, CD81-negative, CD86-positive, and CD196/CCR6-positive.</rdfs:comment>
        <rdfs:label>memory B cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000787</rdfs:seeAlso>
    </owl:Class>

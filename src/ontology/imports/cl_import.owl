        <oboInOwl:hasDbXref>ZFA:0009138</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mesoblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mesoderm cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>mesodermal cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000222</rdfs:seeAlso>

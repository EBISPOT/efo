        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4052061"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Keratinocytes are reportedly CDw210a(IL-10RA)-negative , CDw210b(IL-10RB)-positive, IL22Ra1-positive, Human keratinocytes are reportedly capable of secreting BD-2, BD-3, hCAP-18, CXCL1, CXCL5, CXCL8, elafin, MMP-3, NGAL, PDGF-A, S100A7, S100A8, and S100A9. Transcription factors: STAT3-positive.</owl:annotatedTarget>

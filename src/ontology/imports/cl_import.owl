    <!-- http://purl.obolibrary.org/obo/CL_0002258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000163"/>

        <oboInOwl:hasDbXref>KUPO:0001055</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>kidney distal tubule epithelial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#kidney_upper_slim"/>
        <rdfs:label>epithelial cell of distal tubule</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0002305</rdfs:seeAlso>
    </owl:Class>

        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000785"/>
        <obo:IAO_0000115>A mature B cell that produces cytokines that can influence CD4 T cell differentiation.</obo:IAO_0000115>

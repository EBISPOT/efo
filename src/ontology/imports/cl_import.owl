        <oboInOwl:hasDbXref>DOI:10.1161/HYPERTENSIONAHA.115.04739</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1681/ASN.2009070759</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1681/ASN.2015050515</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_1000850"/>

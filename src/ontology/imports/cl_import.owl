        <oboInOwl:hasDbXref>DOI:10.1002/glia.10244</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1016/S0070-2153(05)69004-7</oboInOwl:hasDbXref>

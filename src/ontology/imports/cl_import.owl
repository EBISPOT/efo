        <oboInOwl:hasDbXref>CALOHA:TS-0283</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62411</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000078404</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009183</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cell of epidermis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>epithelial cell of skin</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>epidermal cell</rdfs:label>

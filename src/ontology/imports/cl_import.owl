        <oboInOwl:hasDbXref>FMA:63368</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005957</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>animal stem cell</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#general_cell_types_upper_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>stem cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000034</rdfs:seeAlso>
        <skos:prefLabel>stem cell</skos:prefLabel>
    </owl:Class>

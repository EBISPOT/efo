        <owl:annotatedTarget>NK cell that has the phenotype CD56-bright, CD16-negative, and CD84-positive with the function to secrete interferon-gamma but is not cytotoxic.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:add</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:pam</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GO_REF:0000031</oboInOwl:hasDbXref>

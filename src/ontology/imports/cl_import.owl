        <owl:annotatedTarget>ZFA:0009001</owl:annotatedTarget>
        <sssom:mapping_justification rdf:resource="https://w3id.org/semapv/vocab/UnspecifiedMatching"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002321"/>
        <obo:IAO_0000115>A cell found in the embryo before the formation of all the gem layers is complete.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ZFA:0009002</oboInOwl:hasDbXref>

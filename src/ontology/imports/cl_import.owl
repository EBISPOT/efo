    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011026"/>
        <obo:IAO_0000115>A progenitor cell that is able to differentiate into the pancreas alpha, beta and delta endocrine cells. This cell type expresses neurogenin-3 and Isl-1.</obo:IAO_0000115>

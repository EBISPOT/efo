        <oboInOwl:hasDbXref>FMA:9727</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009115</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>skeletal muscle cell</oboInOwl:hasExactSynonym>

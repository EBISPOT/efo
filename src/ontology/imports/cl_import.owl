        <oboInOwl:hasDbXref>MESH:D008544</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001679</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009091</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>melanophore</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>

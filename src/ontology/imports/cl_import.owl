        <oboInOwl:hasDbXref>ZFA:0009082</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adipose cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fat cell</oboInOwl:hasExactSynonym>

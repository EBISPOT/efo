        <oboInOwl:hasDbXref>DOI:10.1016/j.immuni.2022.08.002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1038/nri.2017.11</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1111/j.1478-3231.2006.01342.x</oboInOwl:hasDbXref>
    </owl:Axiom>

        <owl:annotatedTarget>A basal cell found in the bronchus epithelium.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_1000349"/>
        <owl:annotatedProperty rdf:resource="http://purl.org/dc/terms/description"/>

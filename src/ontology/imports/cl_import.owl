    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000845 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000785"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000074"/>
        <obo:IAO_0000115>A mature B cell that is located in the marginal zone of the spleen with the phenotype CD23-negative and CD21-positive and expressing a B cell receptor usually reactive to bacterial cell wall components or senescent self components such as oxidized-LDL. This cell type is also described as being CD19-positive, B220-positive, IgM-high, AA4-negative, CD35-high.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym>MZ B cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>MZ B lymphocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>MZ B-cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>MZ B-lymphocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>marginal zone B cell</oboInOwl:hasBroadSynonym>

        <oboInOwl:hasDbXref>ZFA:0009118</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>SMCs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>myocytes, smooth muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>smooth muscle fiber</oboInOwl:hasExactSynonym>

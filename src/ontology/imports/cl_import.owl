        <oboInOwl:hasDbXref>DOI:10.1016/j.biocel.2010.07.006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1038/nrgastro.2013.36</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3998/panc.2020.15</oboInOwl:hasDbXref>
    </owl:Axiom>

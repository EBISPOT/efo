    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4052015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002144"/>
        <obo:IAO_0000115>Any capillary endothelial cell that is part of an endocrine gland.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>

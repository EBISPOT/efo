        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#kidney_upper_slim"/>
        <rdfs:label>kidney venous blood vessel cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1000893</rdfs:seeAlso>
    </owl:Class>

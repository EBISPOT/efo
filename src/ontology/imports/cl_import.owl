        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta immature T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta immature T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SP CD8 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>CD8-positive, alpha-beta immature T cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>CD8-positive, alpha-beta thymocyte</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000811</rdfs:seeAlso>
    </owl:Class>

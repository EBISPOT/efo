        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000844"/>
        <obo:IAO_0000115>A germinal center B cell that has the phenotype CD77-negative, IgD-negative, and CD38-positive. These cells have undergone somatic mutation of the B cell receptor.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bm4 B lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bm4 B-cell</oboInOwl:hasExactSynonym>

        <oboInOwl:hasDbXref>FMA:66782</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009084</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cartilage cell</oboInOwl:hasExactSynonym>

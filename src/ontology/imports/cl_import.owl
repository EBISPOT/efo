        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>Abnormalities in glutametergic neurons of the thalamic complex are associated with pathologies such as schizophrenia, colorectal visceral pain and Parkinson&apos;s disease.</rdfs:comment>
        <rdfs:label>thalamic excitatory neuron</rdfs:label>
    </owl:Class>

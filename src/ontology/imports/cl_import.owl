        <oboInOwl:hasDbXref>DOI:10.1016/j.pneurobio.2010.04.008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1042/NS20160009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1093/brain/awx289</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1111/j.1399-6576.2005.00786.x</oboInOwl:hasDbXref>
    </owl:Axiom>

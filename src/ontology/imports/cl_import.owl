    <!-- http://purl.obolibrary.org/obo/CL_0002028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000763"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002191"/>
        <obo:IAO_0000115>A cell type that can give rise to basophil and mast cells. This cell is CD34-positive, CD117-positive, CD125-positive, FceRIa-negative, and T1/ST2-negative, and expresses Gata-1, Gata-2, C/EBPa</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-04-27T12:46:33Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>BMCP</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>There may be an intermediate cell type. These cells also CD13-positive, CD16-positive, CD32-positive, and integrin beta 7-positive. Transcription factors: GATA1-positive, MCP-1-positive, mitf-positive, PU.1-positive, and CEBP/a-low.</rdfs:comment>
        <rdfs:label>basophil mast progenitor cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>

        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_2000021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any native cell that is part of a sebaceous gland.</owl:annotatedTarget>

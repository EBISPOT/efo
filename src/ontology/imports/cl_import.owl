        <owl:annotatedTarget>An endothelial cell that lines the vasculature.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000071"/>

        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000898"/>
        <obo:IAO_0000115>An antigen inexperienced CD4-positive, alpha-beta T cell with the phenotype CCR7-positive, CD127-positive and CD62L-positive. This cell type develops in the thymus. This cell type is also described as being CD25-negative, CD62L-high, and CD44-low.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym>naive CD4+ T cell</oboInOwl:hasBroadSynonym>

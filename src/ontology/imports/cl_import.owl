        <oboInOwl:hasDbXref>FMA:84645</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>free macrophage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>wandering histiocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>Markers: CD11b+, CD68+; Mouse: F4/80+; role or process: immune, inflammation (inflammatory response).</rdfs:comment>
        <rdfs:label>elicited macrophage</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000861</rdfs:seeAlso>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000861"/>

        <oboInOwl:hasDbXref>CALOHA:TS-1150</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:29655</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:72297</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007985</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009108</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>interstitial cell of Leydig</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>Note that the Amphibian Anatomy Ontology (AA) has a class &apos;leydig cells&apos; but this is unrelated</rdfs:comment>
        <rdfs:label>Leydig cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000178</rdfs:seeAlso>
    </owl:Class>

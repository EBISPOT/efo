        <oboInOwl:hasExactSynonym>B2 B-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B2 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>B-0 B cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>B-2 B cells are reportedly CD48-positive, CD244-negative, and CD352-positive.</rdfs:comment>
        <rdfs:label>B-2 B cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000822</rdfs:seeAlso>
    </owl:Class>

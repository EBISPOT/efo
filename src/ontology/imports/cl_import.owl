    <!-- http://purl.obolibrary.org/obo/CL_0002355 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002417"/>
        <obo:IAO_0000115>A large nucleated basophilic erythrocyte found in mammalian embryos. This cell type arises from the blood islands of yolk sacs and expresses different types of hemoglobins (beta-H1, gamma-1 and zeta) than adult erythrocytes. Considered a type of erythroblast as this cell type can enucleate in circulation.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-22T09:27:05Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>primitive erythroblast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>primitive erythrocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>primitive erythroid cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>primitive red blood cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002355"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

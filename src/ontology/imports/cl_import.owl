        <oboInOwl:hasRelatedSynonym>seminal vesicle glandular cells</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>seminal vesicle glandular cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1001597</rdfs:seeAlso>
    </owl:Class>

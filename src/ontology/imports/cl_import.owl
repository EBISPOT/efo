    <!-- http://purl.obolibrary.org/obo/CL_0000612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000772"/>

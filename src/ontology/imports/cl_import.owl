    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000112"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>Columnar neurons have been widely studied in Diptera, locusts, honey bees and other insects. In the mammalian brain, a &quot;columnar organisation&quot; is referred to neurons of the neocortex, however these differ from columnar neurons which are found in the insects central nervous system.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18837039</oboInOwl:hasDbXref>

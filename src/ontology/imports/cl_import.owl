        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000972"/>
        <obo:IAO_0000115>A class switched memory B cell that expresses IgA.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>IgA memory B lymphocyte</oboInOwl:hasExactSynonym>

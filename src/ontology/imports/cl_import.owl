    <!-- http://purl.obolibrary.org/obo/CL_7770004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_7770004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000066"/>
        <obo:IAO_0000115>An epithelial cell that resides in the layer(s) immediately above the basal layer in stratified or pseudostratified epithelia. This cell mainly originates from basal cells and is found across various tissues, including skin, esophagus, oral mucosa, airway, and cornea.</obo:IAO_0000115>

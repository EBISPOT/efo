        <owl:annotatedTarget>A cell that, by division or terminal differentiation, can give rise to other cell types.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dos</oboInOwl:hasDbXref>
    </owl:Axiom>

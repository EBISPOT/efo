    <!-- http://purl.obolibrary.org/obo/CL_0002451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000048"/>
        <obo:IAO_0000115>A multi-fate stem cell that is the source of cells for growth of the mammary gland during puberty and gestation. This cell type gives rise to both the luminal and myoepithelial cell types of the gland, and have been shown to have the ability to regenerate the entire organ in mice. This cell type also plays an important role in carcinogenesis of the breast. This cell type is Lin-, CD24-positive, CD29-hi.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-11-10T01:46:51Z</oboInOwl:creation_date>
        <rdfs:label>mammary stem cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002451"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-fate stem cell that is the source of cells for growth of the mammary gland during puberty and gestation. This cell type gives rise to both the luminal and myoepithelial cell types of the gland, and have been shown to have the ability to regenerate the entire organ in mice. This cell type also plays an important role in carcinogenesis of the breast. This cell type is Lin-, CD24-positive, CD29-hi.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:hjd</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:15987436</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:16397499</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:17851544</oboInOwl:hasDbXref>

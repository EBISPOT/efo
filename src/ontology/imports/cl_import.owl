        <oboInOwl:hasDbXref>FMA:67310</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:86775</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NIFSTD:sao862606388</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009273</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>projection neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pyramidal cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#BDS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>pyramidal neuron</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000598</rdfs:seeAlso>
        <skos:prefLabel>pyramidal neuron</skos:prefLabel>
    </owl:Class>

    <!-- http://purl.obolibrary.org/obo/GO_0005777 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043231"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0005737"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A small organelle enclosed by a single membrane, and found in most eukaryotic cells. Contains peroxidases and other enzymes involved in a variety of metabolic processes including free radical detoxification, lipid catabolism and biosynthesis, and hydrogen peroxide metabolism.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0019818</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>peroxisome vesicle</oboInOwl:hasBroadSynonym>

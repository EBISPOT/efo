        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:comment>Note that this term differs from &apos;cytokinesis ; GO:0000910&apos; in that cytokinesis does not include nuclear division.</rdfs:comment>

    <!-- http://purl.obolibrary.org/obo/GO_0021510 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048856"/>

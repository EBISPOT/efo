    <!-- http://purl.obolibrary.org/obo/GO_0046952 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0046952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006091"/>

    <!-- http://purl.obolibrary.org/obo/GO_0014002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0021782"/>
        <rdfs:subClassOf>
            <owl:Restriction>

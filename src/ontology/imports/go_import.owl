    <!-- http://purl.obolibrary.org/obo/GO_0007588 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003008"/>

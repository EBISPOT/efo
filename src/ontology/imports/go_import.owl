    <!-- http://purl.obolibrary.org/obo/GO_0010468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0010468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0010556"/>
        <obo:IAO_0000115>Any process that modulates the frequency, rate or extent of gene expression. Gene expression is the process in which a gene&apos;s coding sequence is converted into a mature gene product (protein or RNA).</obo:IAO_0000115>

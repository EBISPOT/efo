        <oboInOwl:hasDbXref>Reactome:R-HSA-375342</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>innexin channel activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>innexin</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>molecular_function</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>connexin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0005243</oboInOwl:id>
        <rdfs:label>gap junction channel activity</rdfs:label>

    <!-- http://purl.obolibrary.org/obo/GO_0035316 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0035316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0120036"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0035315"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A process that is carried out at the cellular level which results in the assembly, arrangement of constituent parts, or disassembly of non-sensory hairs. These hairs are polarized cellular extensions that cover much of the insect epidermis.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/cellular_anatomical_entity_organization.yaml"/>
        <oboInOwl:hasBroadSynonym>trichome organisation</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>trichome organization and biogenesis</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>non-sensory hair organization and biogenesis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0035316</oboInOwl:id>
        <rdfs:comment>See also the fly_anatomy.ontology term &apos;trichome ; FBbt:00004979&apos;.</rdfs:comment>
        <rdfs:label>non-sensory hair organization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0035316"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A process that is carried out at the cellular level which results in the assembly, arrangement of constituent parts, or disassembly of non-sensory hairs. These hairs are polarized cellular extensions that cover much of the insect epidermis.</owl:annotatedTarget>

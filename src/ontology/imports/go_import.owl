        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process resulting in the physical partitioning and separation of a myoblast into daughter cells. A myoblast is a mononucleate cell type that, by fusion with other myoblasts, gives rise to the myotubes that eventually develop into skeletal muscle fibers.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:0000056</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:ef</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mtg_muscle</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0014881 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014881">

    <!-- http://purl.obolibrary.org/obo/GO_0060574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0060574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0002069"/>

                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0048708"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process aimed at the progression of an astrocyte over time, from initial commitment of the cell to a specific fate, to the fully functional differentiated cell. An astrocyte is the most abundant type of glial cell. Astrocytes provide support for neurons and regulate the environment in which they function.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>astrocyte cell development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0014002</oboInOwl:id>

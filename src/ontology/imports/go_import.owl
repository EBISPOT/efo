    <!-- http://purl.obolibrary.org/obo/GO_0015636 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0015636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015245"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0015912"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Enables the transfer of short-chain fatty acids from one side of a membrane to the other. A short-chain fatty acid has an aliphatic tail containing fewer than 6 carbons.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/26445</obo:IAO_0000233>
        <oboInOwl:hasAlternativeId>GO:0015635</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>molecular_function</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>short-chain fatty acid transporter activity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>short-chain fatty acid uptake transporter activity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0015636</oboInOwl:id>
        <rdfs:comment>While there is not universal consensus on the lengths of short-, medium-, long- and very-long-chain fatty acids, the GO uses the definitions in ChEBI (see CHEBI:26666, CHEBI:59554, CHEBI:15904 and CHEBI:27283).</rdfs:comment>
        <rdfs:label>short-chain fatty acid transmembrane transporter activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>

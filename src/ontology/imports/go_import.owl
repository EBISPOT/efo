    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0014002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process aimed at the progression of an astrocyte over time, from initial commitment of the cell to a specific fate, to the fully functional differentiated cell. An astrocyte is the most abundant type of glial cell. Astrocytes provide support for neurons and regulate the environment in which they function.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dgh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:ef</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0014003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0021782"/>
        <rdfs:subClassOf>

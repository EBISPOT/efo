    <!-- http://purl.obolibrary.org/obo/GO_0051180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0051180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006810"/>
        <obo:IAO_0000115>The directed movement of vitamins into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore. A vitamin is one of a number of unrelated organic substances that occur in many foods in small amounts and that are necessary in trace amounts for the normal metabolic functioning of the body.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/chemical_transport.yaml"/>
        <oboInOwl:hasBroadSynonym>vitamin or cofactor transport</oboInOwl:hasBroadSynonym>

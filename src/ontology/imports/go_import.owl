        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/GO_0032502"/>
        <obo:IAO_0000115>The internally coordinated responses (actions or inactions) of animals (individuals or groups) to internal or external stimuli, via a mechanism that involves nervous system activity.</obo:IAO_0000115>
        <oboInOwl:created_by>jl</oboInOwl:created_by>
        <oboInOwl:creation_date>2012-09-20T14:06:08Z</oboInOwl:creation_date>
        <oboInOwl:hasAlternativeId>GO:0023032</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0044708</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0044709</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Wikipedia:Behavior</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>behavioral response to stimulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>behaviour</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>behavioural response to stimulus</oboInOwl:hasExactSynonym>

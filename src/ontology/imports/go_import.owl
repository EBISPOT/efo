        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/24794</obo:IAO_0000233>
        <oboInOwl:hasDbXref>Reactome:R-HSA-212165</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-8986944</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>regulation of gene expression, epigenetic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0040029</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_plant"/>
        <rdfs:label>epigenetic regulation of gene expression</rdfs:label>
    </owl:Class>

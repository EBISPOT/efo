    <!-- http://purl.obolibrary.org/obo/GO_0000224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0000224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0016787"/>
        <obo:IAO_0000115>Catalysis of the reaction: 4-N-(N-acetyl-D-glucosaminyl)-protein + H2O = N-acetyl-beta-D-glucosaminylamine + peptide L-aspartate. This reaction is the hydrolysis of an N4-(acetyl-beta-D-glucosaminyl)asparagine residue in which the N-acetyl-D-glucosamine residue may be further glycosylated, to yield a (substituted) N-acetyl-beta-D-glucosaminylamine and the peptide containing an aspartic residue.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/30193</obo:IAO_0000233>
        <oboInOwl:hasBroadSynonym>glycopeptidase activity</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>glycopeptide N-glycosidase activity</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>EC:3.5.1.52</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MetaCyc:3.5.1.52-RXN</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-8850594</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>PNGase</oboInOwl:hasExactSynonym>

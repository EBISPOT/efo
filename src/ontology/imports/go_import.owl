    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_1905192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0033043"/>
        <obo:IAO_0000115>Any process that modulates the frequency, rate or extent of chloroplast fission.</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_28009"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_33208"/>

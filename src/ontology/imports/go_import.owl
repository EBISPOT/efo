        <obo:IAO_0000115>A process carried out by the nervous system that is required for the proper control of respiratory gaseous exchange. This process occurs in the respiratory center of the brain in vertebrates.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/regulation_by.yaml"/>
        <oboInOwl:hasExactSynonym>neurological control of breathing</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>regulation of respiratory gaseous exchange by neurological system process</oboInOwl:hasExactSynonym>

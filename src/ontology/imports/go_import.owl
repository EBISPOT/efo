    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0001990"/>
        <obo:IAO_0000115>The regulation of blood pressure mediated by the signaling molecule vasopressin. Vasopressin is produced in the hypothalamus, and affects vasoconstriction, and renal water transport.</obo:IAO_0000115>

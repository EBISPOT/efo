    <!-- http://purl.obolibrary.org/obo/GO_0021703 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048857"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0021548"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the locus ceruleus over time, from its formation to the mature structure. The locus ceruleus is a dense cluster of neurons within the dorsorostral pons. This nucleus is the major location of neurons that release norepinephrine throughout the brain, and is responsible for physiological responses to stress and panic.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_development.yaml"/>
        <oboInOwl:hasExactSynonym>locus caeruleus development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>locus coeruleus development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0021703</oboInOwl:id>
        <rdfs:label>locus ceruleus development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0021703"/>

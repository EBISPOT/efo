            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which a relatively unspecialized cell acquires specialized features of a neuroblast. There are at least four stages through which the pluripotent cells of epiblast or blastula become neuroblasts.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/cell_differentiation_by_mature_cell_type.yaml"/>

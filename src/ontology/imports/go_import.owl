    <!-- http://purl.obolibrary.org/obo/GO_0021501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048646"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0007399"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The formation of the prechordal plate. The prechordal plate is a thickening of the endoderm at the cranial end of the primitive streak formed by the involution of Spemann&apos;s organizer cells. The prechordal plate and the notochord induce the formation of the neural plate from the overlying ectodermal cells.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0021501</oboInOwl:id>

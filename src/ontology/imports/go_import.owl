                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0014016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process aimed at the progression of a neuroblast over time, from initial commitment of the cell to a specific state, to the mature neuroblast. It does not include processes where the neuroblast turns into a glial cell or a neuron.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0014019</oboInOwl:id>

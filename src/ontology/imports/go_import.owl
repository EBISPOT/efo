    <!-- http://purl.obolibrary.org/obo/GO_0048627 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048468"/>

        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/regulation_by.yaml"/>
        <oboInOwl:created_by>lr</oboInOwl:created_by>
        <oboInOwl:creation_date>2016-05-10T19:07:34Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>regulation of chloroplast division</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:1905192</oboInOwl:id>
        <rdfs:comment>Any process that modulates the rate, frequency or extent of chloroplast fission. Chloroplast fission is the division of a chloroplast within a cell to form two or more separate chloroplast compartments.</rdfs:comment>
        <rdfs:label>regulation of chloroplast fission</rdfs:label>
    </owl:Class>

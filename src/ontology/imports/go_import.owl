        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0005244"/>
        <obo:IAO_0000115>A cation channel that opens in response to binding by extracellular glutmate, but only if glycine or D-serine is also bound and the membrane is depolarized. Voltage gating is indirect, due to ejection of bound magnesium from the pore at permissive voltages.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:NMDA_receptor</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>N-methyl-D-aspartate selective glutamate receptor activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>NMDA receptor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>molecular_function</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0004972</oboInOwl:id>
        <rdfs:comment>The name of this receptor comes from its selective activation by N-methyl-D-aspartate (NMDA). Note that this term represents an activity and not a gene product.</rdfs:comment>
        <rdfs:label>NMDA glutamate receptor activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0004972"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cation channel that opens in response to binding by extracellular glutmate, but only if glycine or D-serine is also bound and the membrane is depolarized. Voltage gating is indirect, due to ejection of bound magnesium from the pore at permissive voltages.</owl:annotatedTarget>

        <oboInOwl:hasNarrowSynonym>IgG2c</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>IgG3</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>IgG4</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0071735</oboInOwl:id>
        <rdfs:comment>Note that an IgG immunoglobulin complex has the function of antigen binding if a suitable antigen is available. Also, IgG isotypes vary by species.</rdfs:comment>
        <rdfs:label>IgG immunoglobulin complex</rdfs:label>
    </owl:Class>

        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/regulation_by.yaml"/>
        <oboInOwl:hasDbXref>Reactome:R-HSA-163767</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-9752946</oboInOwl:hasDbXref>

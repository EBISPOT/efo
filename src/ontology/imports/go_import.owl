    <!-- http://purl.obolibrary.org/obo/GO_0003164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0003164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003229"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0003161"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the His-Purkinje system over time, from its formation to the mature structure. The His-Purkinje system receives signals from the AV node and is composed of the fibers that regulate cardiac muscle contraction in the ventricles.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_development.yaml"/>
        <oboInOwl:created_by>dph</oboInOwl:created_by>

        <oboInOwl:hasDbXref>GOC:dph</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0060009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0060009">

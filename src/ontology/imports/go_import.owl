        <oboInOwl:hasRelatedSynonym>N-glycanase activity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>N-linked-glycopeptide-(N-acetyl-beta-D-glucosaminyl)-L-asparagine amidohydrolase activity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>N-oligosaccharide glycopeptidase activity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PNGase A</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PNGase F</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>peptide:N-glycanase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0000224</oboInOwl:id>
        <rdfs:label>peptide-N4-(N-acetyl-beta-glucosaminyl)asparagine amidase activity</rdfs:label>

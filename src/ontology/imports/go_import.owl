    <!-- http://purl.obolibrary.org/obo/GO_0005694 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005694">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043232"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0000262"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0000803"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0030849"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0042648"/>
        </owl:disjointUnionOf>
        <obo:IAO_0000115>A structure composed of a very long molecule of DNA and associated proteins (e.g. histones) that carries hereditary information.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Chromosome</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>interphase chromosome</oboInOwl:hasNarrowSynonym>

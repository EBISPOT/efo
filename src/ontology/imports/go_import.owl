                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0021766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the ammon gyrus over time, from its formation to the mature structure. The ammon gyrus, often subdivided into the CA1 and CA3 regions, is one of the two interlocking gyri of the hippocampus that is rich in large pyramidal neurons.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_development.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Ammon&apos;s horn development</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cornu ammonis development</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0021541</oboInOwl:id>
        <rdfs:label>ammon gyrus development</rdfs:label>
    </owl:Class>

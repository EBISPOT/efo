    <!-- http://purl.obolibrary.org/obo/GO_0035882 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0035882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007624"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0030421"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The rhythmic process of defecation that consists of an intestinal oscillator which regulates calcium waves. These waves in turn control a stereotypical, three-part pattern of muscle contractions. In some organisms, defecation can recur with a regularity more frequent than every 24 hours. For example, in a well-fed Caenorhabditis elegans, the defecation motor program occurs approximately every 45 seconds, and is temperature- and touch-compensated.</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2157"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4896"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4932"/>
        <oboInOwl:created_by>bf</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-06-06T11:36:35Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>DMP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>defecation cycle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>defecation motor program</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>defecation behavior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0035882</oboInOwl:id>
        <rdfs:label>defecation rhythm</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0035882"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The rhythmic process of defecation that consists of an intestinal oscillator which regulates calcium waves. These waves in turn control a stereotypical, three-part pattern of muscle contractions. In some organisms, defecation can recur with a regularity more frequent than every 24 hours. For example, in a well-fed Caenorhabditis elegans, the defecation motor program occurs approximately every 45 seconds, and is temperature- and touch-compensated.</owl:annotatedTarget>

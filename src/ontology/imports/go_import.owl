    <!-- http://purl.obolibrary.org/obo/GO_0071735 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0071735">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0019814"/>
        <obo:IAO_0000115>A protein complex composed of two identical immunoglobulin heavy chains of an IgG isotype and two identical immunoglobulin light chains, held together by disulfide bonds. An IgG immunoglobulin complex may be embedded in the plasma membrane or present in the extracellular space, in mucosal areas or other tissues, or circulating in the blood or lymph.</obo:IAO_0000115>
        <oboInOwl:created_by>mah</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-03-24T01:44:53Z</oboInOwl:creation_date>
        <oboInOwl:hasNarrowSynonym>IgG1</oboInOwl:hasNarrowSynonym>

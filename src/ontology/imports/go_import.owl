    <!-- http://purl.obolibrary.org/obo/GO_0014019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048468"/>

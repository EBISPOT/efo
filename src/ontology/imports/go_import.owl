        <oboInOwl:hasExactSynonym>oleosome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spherosome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0012511</oboInOwl:id>
        <rdfs:label>monolayer-surrounded lipid storage body</rdfs:label>
    </owl:Class>

    <!-- http://purl.obolibrary.org/obo/GO_0043583 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0043583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007423"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the ear over time, from its formation to the mature structure. The ear is the sense organ in vertebrates that is specialized for the detection of sound, and the maintenance of balance. Includes the outer ear and middle ear, which collect and transmit sound waves; and the inner ear, which contains the organs of balance and (except in fish) hearing. Also includes the pinna, the visible part of the outer ear, present in some mammals.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_development.yaml"/>
        <oboInOwl:hasExactSynonym>hearing organ development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0043583</oboInOwl:id>
        <rdfs:label>ear development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0043583"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of the ear over time, from its formation to the mature structure. The ear is the sense organ in vertebrates that is specialized for the detection of sound, and the maintenance of balance. Includes the outer ear and middle ear, which collect and transmit sound waves; and the inner ear, which contains the organs of balance and (except in fish) hearing. Also includes the pinna, the visible part of the outer ear, present in some mammals.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:jl</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0192801023</oboInOwl:hasDbXref>
    </owl:Axiom>
    



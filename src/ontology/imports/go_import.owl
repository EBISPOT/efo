    <!-- http://purl.obolibrary.org/obo/GO_0014072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043279"/>
        <obo:IAO_0000115>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of an isoquinoline alkaloid stimulus. An isoquinoline alkaloid is any member of a group of compounds with the heterocyclic ring structure of benzo(c)pyridine which is a structure characteristic of the group of opium alkaloids.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/response_to_stimulus_by_stimulus.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0014072</oboInOwl:id>
        <rdfs:label>response to isoquinoline alkaloid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0014072"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of an isoquinoline alkaloid stimulus. An isoquinoline alkaloid is any member of a group of compounds with the heterocyclic ring structure of benzo(c)pyridine which is a structure characteristic of the group of opium alkaloids.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ef</oboInOwl:hasDbXref>
    </owl:Axiom>
    



        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0071873</oboInOwl:id>
        <rdfs:comment>Note that epinephrine and norepinephrine are ligands for the same receptors, and there are multiple adrenergic receptors.</rdfs:comment>
        <rdfs:label>response to norepinephrine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0071873"/>

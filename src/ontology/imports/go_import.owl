    <!-- http://purl.obolibrary.org/obo/GO_0048749 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0001654"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the compound eye over time, from its formation to the mature structure. The compound eye is an organ of sight that contains multiple repeating units, often arranged hexagonally. Each unit has its own lens and photoreceptor cell(s) and can generate either a single pixelated image or multiple images, per eye.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_development.yaml"/>
        <oboInOwl:hasAlternativeId>GO:0007456</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>insect-type retina development</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0048749</oboInOwl:id>
        <rdfs:label>compound eye development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048749"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of the compound eye over time, from its formation to the mature structure. The compound eye is an organ of sight that contains multiple repeating units, often arranged hexagonally. Each unit has its own lens and photoreceptor cell(s) and can generate either a single pixelated image or multiple images, per eye.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:jid</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:mtg_sensu</oboInOwl:hasDbXref>

                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0007417"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which a relatively unspecialized cell acquires specialized features of a microglial cell. Microglia are glial cells that act as the immune cells of the central nervous system. They form part of the supporting structure of this system.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/cell_differentiation_by_mature_cell_type.yaml"/>
        <oboInOwl:hasExactSynonym>microglial cell differentiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0014004</oboInOwl:id>
        <rdfs:label>microglia differentiation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0014004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which a relatively unspecialized cell acquires specialized features of a microglial cell. Microglia are glial cells that act as the immune cells of the central nervous system. They form part of the supporting structure of this system.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ef</oboInOwl:hasDbXref>
    </owl:Axiom>
    



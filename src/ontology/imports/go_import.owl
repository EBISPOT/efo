    <!-- http://purl.obolibrary.org/obo/GO_0030098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0030098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0046649"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_1903131"/>
        <obo:IAO_0000115>The process in which a relatively unspecialized precursor cell acquires specialized features of a lymphocyte. A lymphocyte is a leukocyte commonly found in the blood and lymph that has the characteristics of a large nucleus, a neutral staining cytoplasm, and prominent heterochromatin.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/cell_differentiation_by_mature_cell_type.yaml"/>
        <oboInOwl:hasAlternativeId>GO:0046650</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>lymphocyte cell differentiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lymphocytic blood cell differentiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>lymphocyte development</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0030098</oboInOwl:id>
        <rdfs:comment>Note that immunologists typically use the word &apos;development&apos; to refer to cells of B or T cell lineages undergoing the process that GO describes as &apos;cell differentiation&apos;.</rdfs:comment>
        <rdfs:label>lymphocyte differentiation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0030098"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

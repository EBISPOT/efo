    <!-- http://purl.obolibrary.org/obo/GO_0021654 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021654">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048859"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0021594"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process that gives rise to a rhombomere boundary. This process pertains to the initial formation of a boundary delimiting a rhombomere. Rhombomeres are transverse segments of the developing rhombencephalon that are lineage restricted, express different genes from one another, and adopt different developmental fates. Rhombomeres are numbered in anterior to posterior order.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_formation.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>

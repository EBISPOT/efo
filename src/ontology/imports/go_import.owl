    <!-- http://purl.obolibrary.org/obo/GO_0045109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0045109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0045104"/>

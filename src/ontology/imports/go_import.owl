            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A developmental process, independent of morphogenetic (shape) change, that is required for a myoblast to attain its fully functional state. A myoblast is a mononucleate cell type that, by fusion with other myoblasts, gives rise to the myotubes that eventually develop into skeletal muscle fibers.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_maturation.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>

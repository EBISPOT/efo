        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which the anatomical structures of the pronephric glomerulus are generated and organized. The pronephric glomerulus is part of the pronephric nephron and is restricted to one body segment.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_morphogenesis.yaml"/>

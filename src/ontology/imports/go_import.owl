    <!-- http://purl.obolibrary.org/obo/GO_0042462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0042462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042461"/>

        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0072560</oboInOwl:id>
        <rdfs:comment>These processes continue to 60 DPA in Gossypium spp.</rdfs:comment>
        <rdfs:label>type B pancreatic cell maturation</rdfs:label>
    </owl:Class>

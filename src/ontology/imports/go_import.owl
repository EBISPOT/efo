                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0048850"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which the anatomical structures of the adenohypophysis are generated and organized. The adenohypophysis is the anterior part of the pituitary. It secretes a variety of hormones and its function is regulated by the hypothalamus.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_morphogenesis.yaml"/>
        <oboInOwl:hasExactSynonym>adenophysis morphogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anterior pituitary gland morphogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anterior pituitary morphogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0048855</oboInOwl:id>
        <rdfs:label>adenohypophysis morphogenesis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0048855"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which the anatomical structures of the adenohypophysis are generated and organized. The adenohypophysis is the anterior part of the pituitary. It secretes a variety of hormones and its function is regulated by the hypothalamus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:cvs</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dgh</oboInOwl:hasDbXref>

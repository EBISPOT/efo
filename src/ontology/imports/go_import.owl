    <!-- http://purl.obolibrary.org/obo/GO_0001579 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015908"/>
        <obo:IAO_0000115>The directed movement of a medium-chain fatty acid into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore. A medium-chain fatty acid has an aliphatic tail containing 6 to 12 carbons.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/26445</obo:IAO_0000233>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/chemical_transport.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0001579</oboInOwl:id>
        <rdfs:comment>While there is not universal consensus on the lengths of short-, medium-, long- and very-long-chain fatty acids, the GO uses the definitions in ChEBI (see CHEBI:26666, CHEBI:59554, CHEBI:15904 and CHEBI:27283).</rdfs:comment>
        <rdfs:label>medium-chain fatty acid transport</rdfs:label>

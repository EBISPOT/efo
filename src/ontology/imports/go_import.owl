    <!-- http://purl.obolibrary.org/obo/GO_0051384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0051384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0031960"/>
        <obo:IAO_0000115>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a glucocorticoid stimulus. Glucocorticoids are hormonal C21 corticosteroids synthesized from cholesterol with the ability to bind with the cortisol receptor and trigger similar effects. Glucocorticoids act primarily on carbohydrate and protein metabolism, and have anti-inflammatory effects.</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4751"/>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/response_to_stimulus_by_stimulus.yaml"/>
        <oboInOwl:hasExactSynonym>response to glucocorticoid stimulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0051384</oboInOwl:id>
        <rdfs:label>response to glucocorticoid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0051384"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a glucocorticoid stimulus. Glucocorticoids are hormonal C21 corticosteroids synthesized from cholesterol with the ability to bind with the cortisol receptor and trigger similar effects. Glucocorticoids act primarily on carbohydrate and protein metabolism, and have anti-inflammatory effects.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ai</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:9884123</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

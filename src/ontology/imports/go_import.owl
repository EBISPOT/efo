        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:comment>Note that &apos;cell body&apos; and &apos;cell soma&apos; are not used in the literature for cells that lack projections, nor for some cells (e.g. yeast with mating projections) that do have projections.</rdfs:comment>
        <rdfs:label>neuronal cell body</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0043025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The portion of a neuron that includes the nucleus, but excludes cell projections such as axons and dendrites.</owl:annotatedTarget>

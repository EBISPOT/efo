    <!-- http://purl.obolibrary.org/obo/GO_0035883 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0035883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0030855"/>
        <obo:IAO_0000115>The process in which a relatively unspecialized cell acquires specialized structural and/or functional features of an enteroendocrine cell. Enteroendocrine cells are hormonally active epithelial cells in the gut that constitute the diffuse neuroendocrine system.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/cell_differentiation_by_mature_cell_type.yaml"/>
        <oboInOwl:created_by>bf</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-06-06T11:48:51Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0035883</oboInOwl:id>
        <rdfs:label>enteroendocrine cell differentiation</rdfs:label>

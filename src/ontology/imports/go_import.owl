    <!-- http://purl.obolibrary.org/obo/GO_0014020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0001838"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0001841"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The formation of the neural tube from an epithelial cell sheet (the neuroepithelium or neural plate). In primary neurulation, the cells surrounding the neural plate direct the neural plate cells to proliferate, invaginate, and pinch off from the surface to form a hollow epithelial tube. Primary neurulation is the typical mechanism of formation of the anterior neural tube.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0014024</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>primary neural tube morphogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>primary neurulation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>neural rod cavitation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0014020</oboInOwl:id>
        <rdfs:label>primary neural tube formation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0014020"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The formation of the neural tube from an epithelial cell sheet (the neuroepithelium or neural plate). In primary neurulation, the cells surrounding the neural plate direct the neural plate cells to proliferate, invaginate, and pinch off from the surface to form a hollow epithelial tube. Primary neurulation is the typical mechanism of formation of the anterior neural tube.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ef</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0878932585</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:15327780</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0014020"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>primary neural tube morphogenesis</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dph</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0014023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048646"/>
        <rdfs:subClassOf>
            <owl:Restriction>

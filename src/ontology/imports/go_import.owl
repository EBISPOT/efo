        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Ensuring that tracheal cells form and maintain tubular structures with the correct size and shape for their position in the network. This is essential for efficient flow of gases through the tracheal network.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mtg_sensu</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:14570584</oboInOwl:hasDbXref>

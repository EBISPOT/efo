    <!-- http://purl.obolibrary.org/obo/GO_0006259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0090304"/>
        <obo:IAO_0000115>Any cellular metabolic process involving deoxyribonucleic acid. This is one of the two main types of nucleic acid, consisting of a long, unbranched macromolecule formed from one, or more commonly, two, strands of linked deoxyribonucleotides.</obo:IAO_0000115>

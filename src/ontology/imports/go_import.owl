        <owl:annotatedTarget>The process aimed at the progression of an oligodendrocyte over time, from initial commitment of the cell to a specific fate, to the fully functional differentiated cell. An oligodendrocyte is a type of glial cell involved in myelinating the axons in the central nervous system.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dgh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:ef</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0014004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0010001"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0030225"/>

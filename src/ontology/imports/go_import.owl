    <!-- http://purl.obolibrary.org/obo/GO_0001658 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001658">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0001763"/>
                    <owl:Restriction>

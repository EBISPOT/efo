    <!-- http://purl.obolibrary.org/obo/GO_0005315 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015291"/>
        <obo:IAO_0000115>Enables the transfer of phosphate ions from one side of a membrane to the other, up its concentration gradient. The transporter binds the solute and undergoes a series of conformational changes. Transport works equally well in either direction and is driven by a chemiosmotic source of energy. Secondary active transporters include symporters and antiporters.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/27121</obo:IAO_0000233>

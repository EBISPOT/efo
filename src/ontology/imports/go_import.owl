        <oboInOwl:hasExactSynonym>ketone body catabolism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ketone body degradation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>utilization of ketone bodies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0046952</oboInOwl:id>

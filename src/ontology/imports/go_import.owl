        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:comment>Note that this term refers to a projection from a single cell, and should not be confused with &apos;microvillus&apos; as used to refer to a multicellular structure such as that found in the placenta.</rdfs:comment>
        <rdfs:label>microvillus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005902"/>

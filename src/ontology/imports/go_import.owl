    <!-- http://purl.obolibrary.org/obo/GO_0048628 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048469"/>
        <rdfs:subClassOf>

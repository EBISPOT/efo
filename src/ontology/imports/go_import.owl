    <!-- http://purl.obolibrary.org/obo/GO_0048519 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050789"/>
        <obo:IAO_0000115>Any process that stops, prevents, or reduces the frequency, rate or extent of a biological process. Biological processes are regulated by many means; examples include the control of gene expression, protein modification or interaction with a protein or substrate molecule.</obo:IAO_0000115>

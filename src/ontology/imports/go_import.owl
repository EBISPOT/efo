    <!-- http://purl.obolibrary.org/obo/GO_0098815 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0098815">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009966"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0031644"/>

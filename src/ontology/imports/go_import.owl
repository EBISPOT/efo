        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>Reactome:R-HSA-5357956</owl:annotatedTarget>
        <rdfs:label>TNFR1-induced NF-kappa-B signaling pathway</rdfs:label>

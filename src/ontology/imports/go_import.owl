        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0072234"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the metanephric distal tubule over time, from its formation to the mature structure. The metanephric distal tubule is a metanephric nephron tubule that begins at the metanephric macula densa and extends to the metanephric connecting tubule.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_development.yaml"/>
        <oboInOwl:created_by>mah</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-03-18T03:45:37Z</oboInOwl:creation_date>

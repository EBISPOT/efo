    <!-- http://purl.obolibrary.org/obo/GO_0006911 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006911">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0010324"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0006909"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The internalization of bacteria, immune complexes and other particulate matter or of an apoptotic cell by phagocytosis, including the membrane and cytoskeletal processes required, which involves one of three mechanisms: zippering of pseudopods around a target via repeated receptor-ligand interactions, sinking of the target directly into plasma membrane of the phagocytosing cell, or induced uptake via an enhanced membrane ruffling of the phagocytosing cell similar to macropinocytosis.</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4751"/>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/involved_in_x_y.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>phagosome biosynthesis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>phagosome formation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0006911</oboInOwl:id>
        <rdfs:label>phagocytosis, engulfment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0006911"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The internalization of bacteria, immune complexes and other particulate matter or of an apoptotic cell by phagocytosis, including the membrane and cytoskeletal processes required, which involves one of three mechanisms: zippering of pseudopods around a target via repeated receptor-ligand interactions, sinking of the target directly into plasma membrane of the phagocytosing cell, or induced uptake via an enhanced membrane ruffling of the phagocytosing cell similar to macropinocytosis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0781735149</oboInOwl:hasDbXref>
    </owl:Axiom>
    



    <!-- http://purl.obolibrary.org/obo/GO_0005891 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0034704"/>

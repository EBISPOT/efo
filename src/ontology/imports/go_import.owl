        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The aggregation, arrangement and bonding together of a set of components to form a synapse. This process ends when the synapse is mature (functional).</owl:annotatedTarget>

    <!-- http://purl.obolibrary.org/obo/GO_0021606 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0021605"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0021565"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A developmental process, independent of morphogenetic (shape) change, that is required for the accessory nerve to attain its fully functional state. The spinal branch of this motor nerve innervates the trapezius and the sternocleidomastoid muscles. The cranial branch joins the vagus nerve and innervates the same targets as the vagus nerve.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_maturation.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>CN XI maturation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>spinal accessory nerve maturation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0021606</oboInOwl:id>
        <rdfs:label>accessory nerve maturation</rdfs:label>
    </owl:Class>

        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4932"/>
        <oboInOwl:hasDbXref>Wikipedia:Sleep</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>diapause</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dormancy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lethargus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0030431</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:label>sleep</rdfs:label>
    </owl:Class>

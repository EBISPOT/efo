        <owl:annotatedTarget>The process in which pentose is transported across a lipid bilayer, from one side of a membrane to the other. A pentose is any aldose with a chain of five carbon atoms in the molecule.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ai</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0015752 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0015752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015750"/>
        <obo:IAO_0000115>The process in which D-ribose is transported across a lipid bilayer, from one side of a membrane to the other. As beta-D-ribofuranose, D-ribose forms the glycose group of all ribonucleosides, ribonucleotides and ribonucleic acids, and also of ribose phosphates, various glycosides, some coenzymes and some forms of vitamin B12.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/transmembrane_transport.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>

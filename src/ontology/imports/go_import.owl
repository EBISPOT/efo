    <!-- http://purl.obolibrary.org/obo/GO_0007565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0044703"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0044706"/>
        <obo:IAO_0000115>The set of physiological processes that allow an embryo or foetus to develop within the body of a female animal. It covers the time from fertilization of a female ovum by a male spermatozoon until birth.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Gestation</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>gestation</oboInOwl:hasExactSynonym>

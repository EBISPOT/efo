    <!-- http://purl.obolibrary.org/obo/GO_0120223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0120223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009887"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0120224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which the larynx is generated and organized. The larynx is a continuation of the pharynx that is involved in breathing, sound production, and protecting the trachea against food aspiration.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/geneontology/go-ontology/issues/18924</obo:IAO_0000233>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_morphogenesis.yaml"/>
        <oboInOwl:created_by>krc</oboInOwl:created_by>
        <oboInOwl:creation_date>2020-02-22T01:42:04Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>laryngeal morphogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0120223</oboInOwl:id>
        <rdfs:label>larynx morphogenesis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0120223"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which the larynx is generated and organized. The larynx is a continuation of the pharynx that is involved in breathing, sound production, and protecting the trachea against food aspiration.</owl:annotatedTarget>

    <!-- http://purl.obolibrary.org/obo/GO_0021550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048856"/>

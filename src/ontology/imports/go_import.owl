        <oboInOwl:hasAlternativeId>GO:0019642</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>MetaCyc:GLYCOLYSIS-VARIANTS</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Embden-Meyerhof pathway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Embden-Meyerhof-Parnas pathway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>anaerobic glycolysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>glycolysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>modified Embden-Meyerhof pathway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0006096</oboInOwl:id>
        <rdfs:label>glycolytic process</rdfs:label>
    </owl:Class>

    <!-- http://purl.obolibrary.org/obo/GO_0043217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0043217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0007009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042552"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process of preserving the structure and function of mature myelin. This includes maintaining the compact structure of myelin necessary for its electrical insulating characteristics as well as the structure of non-compact regions such as Schmidt-Lantermann clefts and paranodal loops. This does not include processes responsible for maintaining the nodes of Ranvier, which are not part of the myelin sheath.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>myelin sheath maintenance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0043217</oboInOwl:id>
        <rdfs:label>myelin maintenance</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0043217"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process of preserving the structure and function of mature myelin. This includes maintaining the compact structure of myelin necessary for its electrical insulating characteristics as well as the structure of non-compact regions such as Schmidt-Lantermann clefts and paranodal loops. This does not include processes responsible for maintaining the nodes of Ranvier, which are not part of the myelin sheath.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dgh</oboInOwl:hasDbXref>
    </owl:Axiom>
    



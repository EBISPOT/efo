            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which the anatomical structure of the rhombomere is generated and organized. Rhombomeres are transverse segments of the developing rhombencephalon. Rhombomeres are lineage restricted, express different genes from one another, and adopt different developmental fates.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_morphogenesis.yaml"/>

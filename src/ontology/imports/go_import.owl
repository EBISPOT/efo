    <!-- http://purl.obolibrary.org/obo/GO_0060285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0060285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0001539"/>
        <obo:IAO_0000115>Cell motility due to the motion of one or more eukaryotic cilia. A eukaryotic cilium is a specialized organelle that consists of a filiform extrusion of the cell surface. Each cilium is bounded by an extrusion of the cytoplasmic (plasma) membrane, and contains a regular longitudinal array of microtubules, anchored basally in a centriole.</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3176"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3378"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3398"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4890"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_5782"/>
        <oboInOwl:hasAlternativeId>GO:0071974</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>cilium cell motility</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>microtubule-based flagellar cell motility</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>ciliary cell motility</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0060285</oboInOwl:id>
        <rdfs:comment>Note that we deem eukaryotic cilia and microtubule-based flagella to be equivalent.</rdfs:comment>
        <rdfs:label>cilium-dependent cell motility</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0060285"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cell motility due to the motion of one or more eukaryotic cilia. A eukaryotic cilium is a specialized organelle that consists of a filiform extrusion of the cell surface. Each cilium is bounded by an extrusion of the cytoplasmic (plasma) membrane, and contains a regular longitudinal array of microtubules, anchored basally in a centriole.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:cilia</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:dgh</oboInOwl:hasDbXref>

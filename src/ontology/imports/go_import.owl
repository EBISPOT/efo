        <oboInOwl:hasDbXref>Reactome:R-HSA-5617833</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ciliogenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cilium formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>microtubule-based flagellum assembly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cilium biogenesis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cilium morphogenesis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cilium organization</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0060271</oboInOwl:id>
        <rdfs:comment>Note that we deem cilium and microtubule-based flagellum to be equivalent.</rdfs:comment>
        <rdfs:label>cilium assembly</rdfs:label>
    </owl:Class>

        <oboInOwl:id>GO:0015752</oboInOwl:id>
        <rdfs:label>D-ribose transmembrane transport</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0015752"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which D-ribose is transported across a lipid bilayer, from one side of a membrane to the other. As beta-D-ribofuranose, D-ribose forms the glycose group of all ribonucleosides, ribonucleotides and ribonucleic acids, and also of ribose phosphates, various glycosides, some coenzymes and some forms of vitamin B12.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:ai</oboInOwl:hasDbXref>
    </owl:Axiom>
    



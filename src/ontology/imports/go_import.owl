    <!-- http://purl.obolibrary.org/obo/GO_0048852 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0048852">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009653"/>

    <!-- http://purl.obolibrary.org/obo/GO_0001839 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0001839">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0016331"/>
        <rdfs:subClassOf>
            <owl:Restriction>

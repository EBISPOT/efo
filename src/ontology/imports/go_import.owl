            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which a relatively unspecialized satellite cell acquires specialized features of a myoblast. This occurs as part of skeletal muscle regeneration. A myoblast is a mononucleate cell type that, by fusion with other myoblasts, gives rise to the myotubes that eventually develop into skeletal muscle fibers.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/involved_in_x_y.yaml"/>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0014835</oboInOwl:id>
        <rdfs:label>myoblast differentiation involved in skeletal muscle regeneration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0014835"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>

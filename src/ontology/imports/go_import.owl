    <!-- http://purl.obolibrary.org/obo/GO_0035349 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0035349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0015880"/>

    <!-- http://purl.obolibrary.org/obo/GO_0021563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0021545"/>
        <obo:IAO_0000115>Various sensory and motor branches of the glossopharyngeal nerve supply nerve connections to the pharynx and back of the tongue. The branchial motor component contains motor fibers that innervate muscles that elevate the pharynx and larynx, and the tympanic branch supplies parasympathetic fibers to the otic ganglion.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/anatomical_structure_development.yaml"/>
        <oboInOwl:hasExactSynonym>cranial nerve 9 development</oboInOwl:hasExactSynonym>

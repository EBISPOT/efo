    <!-- http://purl.obolibrary.org/obo/GO_0005228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0005267"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0022839"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0099094"/>
        <obo:IAO_0000115>Enables the transmembrane transfer of potassium by a channel that opens in response to stimulus by a sodium ion or ions. Transport by a channel involves facilitated diffusion of a solute (by an energy-independent process) involving passage through a transmembrane aqueous pore or channel, without evidence for a carrier-mediated mechanism. Sodium activated potassium channels have distinctive properties, including a large single channel conductance, subconductance states, and a block of single channel currents at positive potentials, similar to inward rectification.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>intracellular sodium activated potassium channel activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>molecular_function</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0005228</oboInOwl:id>
        <rdfs:label>intracellular sodium-activated potassium channel activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005228"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Enables the transmembrane transfer of potassium by a channel that opens in response to stimulus by a sodium ion or ions. Transport by a channel involves facilitated diffusion of a solute (by an energy-independent process) involving passage through a transmembrane aqueous pore or channel, without evidence for a carrier-mediated mechanism. Sodium activated potassium channels have distinctive properties, including a large single channel conductance, subconductance states, and a block of single channel currents at positive potentials, similar to inward rectification.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:mtg_transport</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12628167</oboInOwl:hasDbXref>
    </owl:Axiom>
    



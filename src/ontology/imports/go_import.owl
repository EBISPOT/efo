    <!-- http://purl.obolibrary.org/obo/GO_0036179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0036179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048469"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0036035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A developmental process, independent of morphogenetic (shape) change, that is required for an osteoclast cell to attain its fully functional state. An osteoclast is a specialized phagocytic cell associated with the absorption and removal of the mineralized matrix of bone tissue, and which typically differentiates from monocytes.</obo:IAO_0000115>

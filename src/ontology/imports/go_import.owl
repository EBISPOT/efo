        <oboInOwl:id>GO:0051180</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:label>vitamin transport</rdfs:label>
    </owl:Class>

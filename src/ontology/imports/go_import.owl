    <!-- http://purl.obolibrary.org/obo/GO_0035990 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0035990">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0030154"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0035992"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which a relatively unspecialized cell acquires the specialized features of a tendon cell. Tendon cell are elongated fibrocytes in which the cytoplasm is stretched between the collagen fibres of the tendon. Tendon cells have a central cell nucleus with a prominent nucleolus, a well-developed rough endoplasmic reticulum, and are responsible for synthesis and turnover of tendon fibres and ground substance.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/cell_differentiation_by_mature_cell_type.yaml"/>
        <oboInOwl:created_by>bf</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-08-26T04:16:06Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>muscle attachment cell differentiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>tenocyte differentiation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0035990</oboInOwl:id>
        <rdfs:label>tendon cell differentiation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0035990"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which a relatively unspecialized cell acquires the specialized features of a tendon cell. Tendon cell are elongated fibrocytes in which the cytoplasm is stretched between the collagen fibres of the tendon. Tendon cells have a central cell nucleus with a prominent nucleolus, a well-developed rough endoplasmic reticulum, and are responsible for synthesis and turnover of tendon fibres and ground substance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:0000388</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:yaf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:21412429</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>

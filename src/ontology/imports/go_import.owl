                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0005929"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>All of the contents of a cilium, excluding the plasma membrane surrounding the cilium.</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3176"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3378"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_3398"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4890"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_5782"/>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/part_of_cell_component.yaml"/>
        <oboInOwl:created_by>pr</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-03-23T01:52:31Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>cilium plasm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>microtubule-based flagellar matrix</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>microtubule-based flagellum matrix</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cilial cytoplasm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ciliary cytoplasm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cilium cytoplasm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>microtubule-based flagellar cytoplasm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>microtubule-based flagellum cytoplasm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0097014</oboInOwl:id>
        <rdfs:comment>Note that we deem cilium and microtubule-based flagellum to be equivalent. Also, researchers consider the composition of both the plasm and the membrane of the cilium to be detectably different from that in the non-ciliary cytosol and plasma membrane (e.g. in terms of calcium ion concentration, membrane lipid composition, and more). For this reason, the term &quot;ciliary plasm&quot; is not linked to &quot;cytoplasm&quot;.</rdfs:comment>
        <rdfs:label>ciliary plasm</rdfs:label>
    </owl:Class>

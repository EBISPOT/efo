        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115>Behavior directed towards society, or taking place between members of the same species. Occurs predominantly, or only, in individuals that are part of a group.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Social_behavior</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>social behaviour</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cooperative behavior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0035176</oboInOwl:id>
        <rdfs:comment>Behavior such as predation which involves members of different species is not social. Communication between members of different species is also not social behavior.</rdfs:comment>
        <rdfs:label>social behavior</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0035176"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Behavior directed towards society, or taking place between members of the same species. Occurs predominantly, or only, in individuals that are part of a group.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:jh2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12848939</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Social_behavior</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0035190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0035190">

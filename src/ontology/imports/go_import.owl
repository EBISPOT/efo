    <!-- http://purl.obolibrary.org/obo/GO_0006590 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0042403"/>
        <obo:IAO_0000115>The formation of either of the compounds secreted by the thyroid gland, mainly thyroxine and triiodothyronine. This is achieved by the iodination and joining of tyrosine molecules to form the precursor thyroglobin, proteolysis of this precursor gives rise to the thyroid hormones.</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4895"/>
        <oboInOwl:hasDbXref>Reactome:R-HSA-209968</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0006590</oboInOwl:id>
        <rdfs:comment>Note that this term does not fall under the general GO definition for biosynthetic processes, which is &apos;The chemical reactions and pathways resulting in the formation of... &apos;, because thyroid hormones can only be formed by the proteolysis of a larger molecule (see term definition). The word &apos;generation&apos; is therefore used in place of biosynthesis.</rdfs:comment>
        <rdfs:label>thyroid hormone generation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0006590"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The formation of either of the compounds secreted by the thyroid gland, mainly thyroxine and triiodothyronine. This is achieved by the iodination and joining of tyrosine molecules to form the precursor thyroglobin, proteolysis of this precursor gives rise to the thyroid hormones.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:jl</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0716720094</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0006590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>Reactome:R-HSA-209968</owl:annotatedTarget>
        <rdfs:label>Thyroxine biosynthesis</rdfs:label>
    </owl:Axiom>
    



        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>HDL2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HDL3</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0034364</oboInOwl:id>
        <rdfs:label>high-density lipoprotein particle</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0034364"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A lipoprotein particle with a high density (typically 1.063-1.21 g/ml) and a diameter of 5-10 nm that contains APOAs and may contain APOCs and APOE; found in blood and carries lipids from body tissues to the liver as part of the reverse cholesterol transport process.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:BHF</oboInOwl:hasDbXref>

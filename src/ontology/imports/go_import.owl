    <!-- http://purl.obolibrary.org/obo/GO_0021683 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021683">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009653"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0021681"/>

        <oboInOwl:id>GO:0005798</oboInOwl:id>
        <rdfs:comment>Note that this definition includes vesicles that are transiently associated with the Golgi.</rdfs:comment>
        <rdfs:label>Golgi-associated vesicle</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005798"/>

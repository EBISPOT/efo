        <oboInOwl:hasDbXref>CL:0000542</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:curators</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0030098"/>

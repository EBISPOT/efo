        <oboInOwl:hasDbXref>Reactome:R-HSA-9616222</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>granulocyte cell differentiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0030851</oboInOwl:id>
        <rdfs:label>granulocyte differentiation</rdfs:label>
    </owl:Class>

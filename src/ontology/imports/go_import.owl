    <!-- http://purl.obolibrary.org/obo/GO_0071873 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0071873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0071869"/>
        <obo:IAO_0000115>Any process that results in a change in state or activity of a cell or an organism (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a norepinephrine stimulus. Norepinephrine is a catecholamine that has the formula C8H11NO3; it acts as a hormone, and as a neurotransmitter in most of the sympathetic nervous system.</obo:IAO_0000115>
        <terms:conformsTo rdf:resource="http://purl.obolibrary.org/obo/go/patterns/response_to_stimulus_by_stimulus.yaml"/>
        <oboInOwl:created_by>mah</oboInOwl:created_by>

        <oboInOwl:hasDbXref>GOC:mtg_kidney_jan10</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0072227 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0072227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0072024"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0072243"/>

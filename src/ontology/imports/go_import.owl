    <!-- http://purl.obolibrary.org/obo/GO_0021651 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0021651">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0021593"/>

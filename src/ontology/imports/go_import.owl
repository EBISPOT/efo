    <!-- http://purl.obolibrary.org/obo/GO_0035295 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0035295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048856"/>
